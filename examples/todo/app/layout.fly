// What every page shows around itself.

import { Ui, el, text, attr, cls } from "../../../web/ui";

function link<M>(href: str, label: str, here: bool): void uses Ui<M> {
  el("a", () => {
    attr("href", href);
    if (here) { cls("here"); }
    text(label);
  });
}

export function nav<M>(current: str): void uses Ui<M> {
  el("nav", () => {
    el("span", () => { cls("brand"); text("Flyscript"); });
    link("/", "Things to do", current == "todos");
    link("/about", "About", current == "about");
  });
}
