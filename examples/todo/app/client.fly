// The page's handler of `Todos`: each operation asks the server, and gives what it answers.

import { stringify, parse, FromJson } from "std/json";
import { fetch } from "../../../web/dom";
import { Todos } from "./api";

function call<R extends FromJson>(op: str, args: String): R {
  const text = fetch(`/_fly/rpc/${op}`.asStr(), args.asStr());
  try { parse(text.asStr()) } catch (_) { panic(`the server's answer to \`${op}\` was not what it should be`) }
}

export function viaServer<T>(body: once () => T uses Todos, Io): T uses Io {
  handle { body() } with Todos {
    list() resumes k => k(call("list", "{}".toString())),
    add(title) resumes k => k(call("add", stringify({ title: title.clone() }))),
    toggle(id) resumes k => k(call("toggle", stringify({ id }))),
    clearDone() resumes k => k(call("clearDone", "{}".toString())),
  }
}
