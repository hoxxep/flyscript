// The list of things to do: rendered by the server, then run by the page, which asks the server
// to change it. Each title links to its own page.

import { Ui, Event, el, text, cls, attr, on, key, link } from "web/ui";
import { Page } from "web/dom";
import { Todo, TodoErr, Todos, add, why } from "../api";

// `adding` while the server has yet to answer for a new one.
export type Model = { todos: Vec<Todo>; draft: String; error: String; adding: bool };
export type Msg = #Draft | #Add | #Toggle(u32) | #ClearDone;

export const title: str = "Things to do";
export const description: str = "A list of things to do, kept on the server and changed in place.";

export function load(): Model uses Todos {
  { todos: Todos.list(), draft: String.new(), error: String.new(), adding: false }
}

export function view(m: readonly Model): void uses Ui<Msg> {
  el("h1", () => text("Things to do"));
  el("form", () => {
    on("submit", #Add);
    el("input", () => {
      attr("placeholder", "What needs doing?");
      attr("value", m.draft.asStr());
      on("input", #Draft);
    });
    el("button", () => {
      attr("type", "submit");
      if (m.adding) { attr("disabled", "disabled"); text("Adding…"); } else { text("Add"); }
    });
  });
  if (m.error.len() > 0) {
    el("p", () => { cls("error"); text(m.error.asStr()); });
  }
  el("ul", () => {
    cls("todos");
    for (const t of m.todos) {
      el("li", () => {
        key(`${t.id}`.asStr());
        if (t.done) { cls("done"); }
        el("span", () => { cls("check"); on("click", #Toggle(t.id)); if (t.done) { text("✓"); } });
        link(`/todos/${t.id}`.asStr(), () => { cls("title"); text(t.title.asStr()); });
      });
    }
  });
  let left: u32 = 0;
  let done: u32 = 0;
  for (const t of m.todos) { if (t.done) { done += 1; } else { left += 1; } }
  el("footer", () => {
    el("span", () => text(`${left} left`.asStr()));
    if (done > 0) {
      el("button", () => { cls("quiet"); on("click", #ClearDone); text(`Clear ${done} done`.asStr()); });
    }
  });
}

export function update(m: mut Model, msg: Msg, ev: readonly Event): void uses Todos, Page<Model> {
  // What went wrong last is shown until something else is done.
  m.error = String.new();
  match (msg) {
    #Draft => { m.draft = ev.text.clone(); }
    #Add => {
      // The page says it is adding while the server answers.
      m.adding = true;
      Page.show(m);
      defer { m.adding = false; };
      try {
        m.todos = add(m.draft.clone());
        m.draft = String.new();
      } catch (e) {
        m.error = why(e).toString();
      }
    }
    #Toggle(id) => { m.todos = Todos.toggle(id); }
    #ClearDone => { m.todos = Todos.clearDone(); }
  }
}
