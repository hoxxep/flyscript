// The about page, in the browser.

import { parse } from "std/json";
import { run, initial } from "../../../web/dom";
import { Model, view, update } from "../app/routes/about";

export function main(): void uses Io {
  const m: Model = try { parse(initial().asStr()) } catch (_) { panic("the page's state is not what it should be") };
  run(m, view, update);
}
