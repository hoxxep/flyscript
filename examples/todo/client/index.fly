// The list's page, in the browser: it takes over the page the server rendered, from the state the
// server rendered it with, and asks the server for what it changes.

import { parse } from "std/json";
import { run, initial } from "../../../web/dom";
import { Model, view, update } from "../app/routes/index";
import { viaServer } from "../app/client";

export function main(): void uses Io {
  const m: Model = try { parse(initial().asStr()) } catch (_) { panic("the page's state is not what it should be") };
  viaServer(() => run(m, view, update));
}
