// Mini, a compiler written in Flyscript as a test of goal 6 (§1): Hindley–Milner inference over types allocated in a region, each variable
// carrying its own union-find link; algebraic data types; errors reported through `Diag`.
import { HashMap, HashSet } from "std/collections";
import { Cell } from "std/region";
import { Span, Problem, Diag } from "./lexer";
import { Expr, Op, Arm, TypeExpr, Program, spanOf } from "./syntax";

// ---- Types: inference by unification, the types themselves in a region ----

// A type lives in the checker's region: `Ref`s to it are `Copy`, so nothing is cloned, and a
// variable carries its own union-find link, set once it is solved.
// A record is a row: some fields, then a tail that is `#Empty` or a variable standing for more.
export enum Type<region R> {
  #Error, #Int, #Bool, #Data(usize, Ref<str>),
  #Var(usize, Cell<Option<Ref<Type>>>),
  // Parameters, result, and the effects calling it performs: a row like a record's (§5.1).
  #Fn(Ref<Ref<Type>[]>, Ref<Type>, Ref<Type>),
  #Record(Ref<Field[]>, Ref<Type>),
  #Empty,
  // What an entry of an effect row carries: rows serve records and effects alike.
  #Performed,
}
export type Field<region R> = { name: Ref<R, str>; ty: Ref<R, Type<R>> };

// A constructor: its type's index, its tag (unique across the program), its fields, its type.
// Everything in it is in the region, so a `Ctor` is `Copy`: read out of the table, it holds nothing.
export type Ctor<region R> = { data: usize; tag: usize; fields: Ref<R, Ref<R, Type<R>>[]>; result: Ref<R, Type<R>> };

// A type with variables quantified: each use of a `let`-bound name gets fresh copies of them.
export type Scheme<region R> = { vars: Vec<usize>; ty: Ref<R, Type<R>> };

export struct Checker<region R> {
  // Numbers type variables, in the region so unification can make them too.
  ids: Cell<R, usize>;
  scopes: Vec<HashMap<String, Scheme<R>>>;
  int: Ref<R, Type<R>>;
  bool: Ref<R, Type<R>>;
  ctors: HashMap<String, Ctor<R>>;
  // Each type's constructors, by name, for the exhaustiveness of `case`.
  ctorsOf: Vec<Vec<String>>;
  // The effects the code being checked performs: a row, open while it is inferred.
  effects: Ref<R, Type<R>>;
}

impl<region R> Checker<R> {
  function fresh(self: readonly Self): Ref<Type> uses Region<R> {
    Checker.var(self.ids)
  }
  function func(params: readonly Ref<Type>[], ret: Ref<Type>, effects: Ref<Type>): Ref<Type> uses Region<R> {
    alloc(#Fn(allocAll(params), ret, effects))
  }

  // The type a variable stands for, followed to its end, compressing the path as it goes.
  function resolve(t: Ref<Type>): Ref<Type> uses Region<R> {
    match (t) {
      #Var(_, link) => match (link.get()) {
        #Some(bound) => {
          const end = Checker.resolve(bound);
          link.set(#Some(end));
          end
        }
        #None => t,
      },
      _ => t,
    }
  }
  function occurs(v: usize, t: Ref<Type>): bool uses Region<R> {
    match (Checker.resolve(t)) {
      #Var(w, _) => v == w,
      #Fn(ps, r, e) => ps.iter().some((p) => Checker.occurs(v, p)) || Checker.occurs(v, r) || Checker.occurs(v, e),
      #Record(fs, tail) => fs.iter().some((f) => Checker.occurs(v, f.ty)) || Checker.occurs(v, tail),
      _ => false,
    }
  }
  function var(ids: Cell<R, usize>): Ref<Type> uses Region<R> {
    ids.set(ids.get() + 1);
    alloc(#Var(ids.get(), Cell.new(#None)))
  }

  function unify(ids: Cell<R, usize>, a: Ref<Type>, b: Ref<Type>, span: Span): void uses Region<R>, Diag {
    const [x, y] = [Checker.resolve(a), Checker.resolve(b)];
    match ([x, y]) {
      [#Error, _] | [_, #Error] | [#Int, #Int] | [#Bool, #Bool] => {},
      [#Data(d, _), #Data(e, _)] if d == e => {},
      [#Empty, #Empty] | [#Performed, #Performed] => {},
      [#Empty, #Record(fs, _)] | [#Record(fs, _), #Empty] => {
        const names = fs.iter().map((f) => `\`${f.name}\``).join(", ");
        const effect = fs.iter().some((f) => match (Checker.resolve(f.ty)) { #Performed => true, _ => false });
        const message = if (effect) { `this performs ${names}, which is not allowed here` } else { `the record has no field ${names}` };
        Diag.report(#Type { span, message });
      }
      [#Record(_, _), #Record(_, _)] => Checker.unifyRows(ids, x, y, span),
      [#Var(v, _), #Var(w, _)] if v == w => {},
      [#Var(v, link), _] => Checker.bind(v, link, y, span),
      [_, #Var(v, link)] => Checker.bind(v, link, x, span),
      [#Fn(ps, r, e), #Fn(qs, s, f)] => {
        if (ps.len() != qs.len()) { Diag.report(#Type { span, message: `expected ${ps.len()} arguments, found ${qs.len()}` }); return; }
        for (const [p, q] of ps.iter().zip(qs.iter())) { Checker.unify(ids, p, q, span); }
        Checker.unify(ids, r, s, span);
        Checker.unify(ids, e, f, span);
      }
      // `b` is what was expected of `a`.
      _ => Diag.report(#Type { span, message: `expected ${Checker.show(y)}, found ${Checker.show(x)}` }),
    }
  }
  // Rémy's rows: shared fields unify; each side's tail takes the fields only the other has.
  function unifyRows(ids: Cell<R, usize>, a: Ref<Type>, b: Ref<Type>, span: Span): void uses Region<R>, Diag {
    let [fa, ta] = Checker.flatten(a);
    let [fb, tb] = Checker.flatten(b);
    let onlyA: Vec<Field<R>> = Vec.new();
    for (const f of fa) {
      match (fb.iter().find((g) => g.name == f.name)) {
        #Some(g) => Checker.unify(ids, f.ty, g.ty, span),
        #None => onlyA.push(f),
      }
    }
    const onlyB: Vec<Field<R>> = fb.iter().filter((g) => !fa.iter().some((f) => f.name == g.name)).cloned().collect();
    if (onlyA.len() == 0 && onlyB.len() == 0) {
      Checker.unify(ids, ta, tb, span);
      return;
    }
    const rest = Checker.var(ids);
    // `b` is what was expected: its tail must hold what only `a` has, and the other way round.
    Checker.unify(ids, Checker.record(onlyA, rest), tb, span);
    Checker.unify(ids, ta, Checker.record(onlyB, rest), span);
  }
  // A record's fields, following its tail through solved variables and further records.
  function flatten(t: Ref<Type>): [Vec<Field<R>>, Ref<Type>] uses Region<R> {
    match (Checker.resolve(t)) {
      #Record(fs, tail) => {
        let [more, end] = Checker.flatten(tail);
        let all: Vec<Field<R>> = fs.iter().cloned().collect();
        for (const f of more.drain()) { all.push(f); }
        [all, end]
      }
      other => [Vec.new(), Checker.resolve(t)],
    }
  }
  function record(fields: readonly Field<R>[], tail: Ref<Type>): Ref<Type> uses Region<R> {
    if (fields.len() == 0) { tail } else { alloc(#Record(allocAll(fields), tail)) }
  }
  function bind(v: usize, link: Cell<Option<Ref<Type>>>, t: Ref<Type>, span: Span): void uses Region<R>, Diag {
    if (Checker.occurs(v, t)) {
      Diag.report(#Type { span, message: `a function cannot take itself` });
      link.set(#Some(alloc(#Error)));
      return;
    }
    link.set(#Some(t));
  }
  function show(t: Ref<Type>): String uses Region<R> {
    match (Checker.resolve(t)) {
      #Error => `?`,
      #Int => `int`,
      #Data(_, name) => name.toString(),
      #Empty => `{}`,
      #Performed => `effect`,
      #Record(_, _) => {
        const [fs, tail] = Checker.flatten(t);
        const shown = fs.iter().map((f) => `${f.name}: ${Checker.show(f.ty)}`).join(", ");
        match (tail) { #Empty => `{${shown}}`, _ => `{${shown}, ...}` }
      }
      #Bool => `bool`,
      #Var(v, _) => `t${v}`,
      #Fn(ps, r, e) => {
        const [effects, _] = Checker.flatten(e);
        const performs = if (effects.len() == 0) { `` } else { ` uses ${effects.iter().map((f) => f.name.toString()).join(", ")}` };
        `(${ps.iter().map((p) => Checker.show(p)).join(", ")}) => ${Checker.show(r)}${performs}`
      }
    }
  }

  // The variables a type still leaves open.
  function freeIn(t: Ref<Type>, out: mut HashSet<usize>): void uses Region<R> {
    match (Checker.resolve(t)) {
      #Var(v, _) => { out.insert(v); }
      #Fn(ps, r, e) => {
        for (const p of ps) { Checker.freeIn(p, mut out); }
        Checker.freeIn(r, mut out);
        Checker.freeIn(e, mut out);
      }
      #Record(fs, tail) => {
        for (const f of fs) { Checker.freeIn(f.ty, mut out); }
        Checker.freeIn(tail, mut out);
      }
      _ => {},
    }
  }
  // The type with each quantified variable replaced by its fresh copy.
  function copy(t: Ref<Type>, map: readonly HashMap<usize, Ref<Type>>): Ref<Type> uses Region<R> {
    match (Checker.resolve(t)) {
      #Var(v, _) => match (map.get(v)) { #Some(fresh) => fresh, #None => t },
      #Fn(ps, r, e) => {
        let params: Vec<Ref<Type>> = Vec.new();
        for (const p of ps) { params.push(Checker.copy(p, map)); }
        Checker.func(params, Checker.copy(r, map), Checker.copy(e, map))
      }
      #Record(fs, tail) => {
        let fields: Vec<Field<R>> = Vec.new();
        for (const f of fs) { fields.push({ name: f.name, ty: Checker.copy(f.ty, map) }); }
        Checker.record(fields, Checker.copy(tail, map))
      }
      _ => t,
    }
  }

  function lookup(self: readonly Self, name: str, span: Span): Ref<Type> uses Region<R>, Diag {
    // A constructor is a function of its fields, or a value if it has none.
    if (const #Some(c) = self.ctors.get(name)) {
      // Building a value performs nothing, so it fits any row.
      return if (c.fields.len() == 0) { c.result } else { Checker.func(c.fields, c.result, self.fresh()) };
    }
    // `print` writes its argument and gives it back, performing `Io`.
    if (name == "print") {
      const a = self.fresh();
      return Checker.func([a], a, Checker.record([{ name: fmt("Io"), ty: alloc(#Performed) }], self.fresh()));
    }
    let i = self.scopes.len();
    while (i > 0) {
      i -= 1;
      // The scheme stays borrowed from `self.scopes` while `self.ids` counts on: they are
      // different fields (§4.1).
      if (const #Some(s) = self.scopes[i].get(name)) {
        let map: HashMap<usize, Ref<Type>> = HashMap.new();
        for (const v of s.vars) {
          map.insert(v, Checker.var(self.ids));
        }
        return Checker.copy(s.ty, map);
      }
    }
    Diag.report(#Unbound { span, name: name.toString() });
    alloc(#Error)
  }

  // Quantifies the variables of `t` that no enclosing scope leaves open.
  function generalize(self: readonly Self, t: Ref<Type>): Scheme<R> uses Region<R> {
    let inEnv: HashSet<usize> = HashSet.new();
    for (const scope of self.scopes) {
      for (const s of scope.values()) {
        let open: HashSet<usize> = HashSet.new();
        Checker.freeIn(s.ty, mut open);
        for (const v of open.iter()) { if (!s.vars.includes(v)) { inEnv.insert(v); } }
      }
    }
    let mine: HashSet<usize> = HashSet.new();
    Checker.freeIn(t, mut mine);
    { vars: mine.iter().filter((v) => !inEnv.has(v)).cloned().collect(), ty: t }
  }

  function mono(t: Ref<Type>): Scheme<R> { { vars: Vec.new(), ty: t } }

  // Definitions are inferred together, each seeing the others at one type while their bodies
  // are checked (no polymorphic recursion), then generalized.
  function program(self: mut Self, p: readonly Program): Ref<Type> uses Region<R>, Diag {
    // Data types first: their constructors' fields may name any of them.
    let types: HashMap<String, Ref<Type>> = HashMap.new();
    for (const [i, d] of p.datas.iter().enumerate()) { types.insert(d.name.clone(), alloc(#Data(i, fmt(d.name)))); }
    let tag: usize = 0;
    for (const [i, d] of p.datas.iter().enumerate()) {
      let names: Vec<String> = Vec.new();
      for (const c of d.ctors) {
        let fields: Vec<Ref<Type>> = Vec.new();
        for (const f of c.fields) {
          fields.push(match (f) {
            #TInt => self.int,
            #TBool => self.bool,
            #TNamed(n, at) => match (types.get(n)) {
              #Some(t) => t,
              #None => { Diag.report(#Unbound { span: at, name: n.clone() }); alloc(#Error) }
            },
          });
        }
        self.ctors.insert(c.name.clone(), { data: i, tag, fields: allocAll(fields), result: types.get(d.name).unwrap() });
        names.push(c.name.clone());
        tag += 1;
      }
      self.ctorsOf.push(names);
    }
    let globals: HashMap<String, Scheme<R>> = HashMap.new();
    let own: Vec<Ref<Type>> = Vec.new();
    for (const d of p.defs) {
      const t = self.fresh();
      globals.insert(d.name.clone(), Checker.mono(t));
      own.push(t);
    }
    self.scopes.push(globals);
    for (const [i, d] of p.defs.iter().enumerate()) {
      const tf = self.function(d.params, d.body);
      Checker.unify(self.ids, own[i], tf, d.span);
      // A pure definition's row is closed empty: what it would perform is reported by name.
      if (d.pure) {
        match (Checker.resolve(tf)) {
          #Fn(_, _, e) => {
            const [effects, tail] = Checker.flatten(e);
            if (effects.len() > 0) {
              Diag.report(#Type { span: d.span, message: `\`${d.name}\` is declared pure, but it performs ${effects.iter().map((f) => f.name.toString()).join(", ")}` });
            } else {
              Checker.unify(self.ids, tail, alloc(#Empty), d.span);
            }
          }
          _ => {},
        }
      }
    }
    self.scopes.pop();
    let general: HashMap<String, Scheme<R>> = HashMap.new();
    for (const [i, d] of p.defs.iter().enumerate()) {
      general.insert(d.name.clone(), self.generalize(own[i]));
    }
    self.scopes.push(general);
    // The program may perform what it likes; the runtime handles `Io`.
    self.effects = self.fresh();
    const t = self.infer(p.main);
    self.scopes.pop();
    t
  }

  function function(self: mut Self, params: readonly String[], body: readonly Expr): Ref<Type> uses Region<R>, Diag {
    let scope: HashMap<String, Scheme<R>> = HashMap.new();
    let pts: Vec<Ref<Type>> = Vec.new();
    for (const p of params) {
      const t = self.fresh();
      scope.insert(p.clone(), Checker.mono(t));
      pts.push(t);
    }
    // The body's effects are its own row, open for whatever it calls.
    const outer = replace(mut self.effects, self.fresh());
    self.scopes.push(scope);
    const tr = self.infer(body);
    self.scopes.pop();
    const performs = replace(mut self.effects, outer);
    Checker.func(pts, tr, performs)
  }

  function infer(self: mut Self, e: readonly Expr): Ref<Type> uses Region<R>, Diag {
    match (e) {
      #Int(_, _) => self.int,
      #Bool(_, _) => self.bool,
      #Var(name, span) => self.lookup(name, span),
      #Bin(op, a, b, span) => {
        const [ta, tb] = [self.infer(a), self.infer(b)];
        Checker.unify(self.ids, ta, self.int, spanOf(a));
        Checker.unify(self.ids, tb, self.int, spanOf(b));
        match (op) { #Lt => self.bool, _ => self.int }
      }
      #If(c, t, f, span) => {
        const tc = self.infer(c);
        Checker.unify(self.ids, tc, self.bool, spanOf(c));
        const [tt, tf] = [self.infer(t), self.infer(f)];
        Checker.unify(self.ids, tt, tf, span);
        tt
      }
      #Let(name, value, body, _) => {
        const tv = self.infer(value);
        let scope: HashMap<String, Scheme<R>> = HashMap.new();
        scope.insert(name.clone(), self.generalize(tv));
        self.scopes.push(scope);
        const tb = self.infer(body);
        self.scopes.pop();
        tb
      }
      #Fn(params, body, _) => self.function(params, body),
      #Record(fields, _) => {
        let fs: Vec<Field<R>> = Vec.new();
        for (const [name, value] of fields) { fs.push({ name: fmt(name), ty: self.infer(value) }); }
        alloc(#Record(allocAll(fs), alloc(#Empty)))
      }
      // `r.x` asks only that `r` have an `x`: whatever else it has is the row's tail.
      #Field(target, name, span) => {
        const tr = self.infer(target);
        const [tf, rest] = [self.fresh(), self.fresh()];
        Checker.unify(self.ids, tr, Checker.record([{ name: fmt(name), ty: tf }], rest), span);
        tf
      }
      #Case(scrutinee, arms, span) => {
        const ts = self.infer(scrutinee);
        const result = self.fresh();
        let seen: HashSet<String> = HashSet.new();
        let data: Option<usize> = #None;
        for (const arm of arms) {
          // A `Ctor` is `Copy`, so `c` is a copy and the table is not held while the body is
          // checked (§4.1).
          let scope: HashMap<String, Scheme<R>> = HashMap.new();
          match (self.ctors.get(arm.ctor)) {
            #None => Diag.report(#Unbound { span: arm.span, name: arm.ctor.clone() }),
            #Some(c) => {
              const [d, fields] = [c.data, c.fields];
              Checker.unify(self.ids, ts, c.result, arm.span);
              if (fields.len() != arm.binds.len()) {
                Diag.report(#Type { span: arm.span, message: `\`${arm.ctor}\` has ${fields.len()} fields, not ${arm.binds.len()}` });
              }
              for (const [b, t] of arm.binds.iter().zip(fields.iter())) { scope.insert(b.clone(), Checker.mono(t)); }
              if (!seen.insert(arm.ctor.clone())) {
                Diag.report(#Type { span: arm.span, message: `\`${arm.ctor}\` is matched twice` });
              }
              data = #Some(d);
            }
          }
          self.scopes.push(scope);
          const tb = self.infer(arm.body);
          self.scopes.pop();
          Checker.unify(self.ids, tb, result, spanOf(arm.body));
        }
        if (const #Some(d) = data) {
          const missing: Vec<String> = self.ctorsOf[d].iter().filter((c) => !seen.has(c)).cloned().collect();
          if (missing.len() > 0) {
            Diag.report(#Type { span, message: `this \`case\` does not handle ${missing.join(", ")}` });
          }
        }
        result
      }
      #Call(f, args, span) => {
        const tf = self.infer(f);
        let tas: Vec<Ref<Type>> = Vec.new();
        for (const a of args) { tas.push(self.infer(a)); }
        const tr = self.fresh();
        // The function's own type is what the call is expected to fit.
        // A call performs the callee's effects where it is made.
        Checker.unify(self.ids, Checker.func(tas, tr, self.effects), tf, span);
        tr
      }
    }
  }
}


// The types live for the checking only: the region is released when it ends.
export function check(prog: readonly Program): String uses Diag {
  region (R) {
    let c: Checker<R> = Checker { ids: Cell.new(0), scopes: Vec.new(), int: alloc(#Int), bool: alloc(#Bool), ctors: HashMap.new(), ctorsOf: Vec.new(), effects: alloc(#Empty) };
    Checker.show(c.program(prog))
  }
}
