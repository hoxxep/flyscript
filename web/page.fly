// A page as the server sends it: the view rendered inside `#app`, the state the page's program
// starts from, and the program, which takes the page over (web/dom.fly) and runs it from there.

import { Ui, html, escape } from "./ui";

export function page<M>(title: str, state: str, program: str, view: () => void uses Ui<M>): String {
  let out = "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>".toString();
  escape(title, mut out);
  out.push("</title><link rel=\"stylesheet\" href=\"/style.css\"></head><body><div id=\"app\">");
  html(mut out, view);
  // The state is JSON, which may hold `</`, which would end the script it is in.
  out.push("</div><script id=\"fly-state\" type=\"application/json\">");
  out.push(state.replaceAll("</", "<\\/").asStr());
  out.push("</script><script type=\"module\">import { start } from \"/_fly/flynext.js\"; start(\"");
  out.push(program);
  out.push("\");</script></body></html>\n");
  out
}
