// User interfaces as an effect. A view is a function that performs `Ui<M>`: it opens elements,
// gives them attributes, keys and events, adds text, and closes them, in order — with `if`, `for`
// and `match` as anywhere else. What handles it decides what that becomes: HTML on the server, the
// page's DOM in the browser. An event gives the program a message, an `M`, which its `update`
// turns into a new model, and the view shows that.

import { stringify, ToJson } from "std/json";

export effect Ui<M> {
  // Starts an element, whose attributes, events and children follow, until `close`. Its attributes,
  // key and events may come in any order with its children: each is the innermost open element's.
  open(tag: str): void;
  // Who the element is among its siblings, for a list whose items move.
  key(k: str): void;
  attr(name: str, value: str): void;
  // When `event` happens on the element, the program is given `msg`.
  on(event: str, msg: M): void;
  text(s: str): void;
  close(): void;
  // A part of the view shown as the render before showed it, if `key` is what it was then: false if
  // the handler has that render's and keeps it, true if the part must be shown afresh, which
  // `unmemo` ends.
  memo(key: u64): bool;
  unmemo(): void;
}

// What an event says besides its message: the text of the input it happened on, the key pressed,
// whether a checkbox is checked.
export type Event = { text: String; key: String; checked: bool };

// ---- building ----

// An element: `el("li", () => { cls("done"); text(item.title); })`.
export function el<M>(tag: str, body: () => void uses Ui<M>): void uses Ui<M> {
  Ui.open(tag);
  body();
  Ui.close();
}

export function text<M>(s: str): void uses Ui<M> { Ui.text(s); }
export function attr<M>(name: str, value: str): void uses Ui<M> { Ui.attr(name, value); }
export function cls<M>(name: str): void uses Ui<M> { Ui.attr("class", name); }
export function key<M>(k: str): void uses Ui<M> { Ui.key(k); }
export function on<M>(event: str, msg: M): void uses Ui<M> { Ui.on(event, msg); }

// A message every `ms` milliseconds, for as long as the element just opened is shown: a clock, a
// poll of the server. Like any event's, it is the message the latest render gave.
export function every<M>(ms: u32, msg: M): void uses Ui<M> { Ui.on(`every:${ms}`.asStr(), msg); }

// A message once, `ms` milliseconds after the element just opened is first shown, if it still is.
export function after<M>(ms: u32, msg: M): void uses Ui<M> { Ui.on(`after:${ms}`.asStr(), msg); }

// A link to another page of the site. Followed, it takes the page there without loading it again:
// the program fetches what the page shows and renders it (web/dom.fly); without the program it is
// an ordinary link.
export function link<M>(href: str, body: () => void uses Ui<M>): void uses Ui<M> {
  Ui.open("a");
  Ui.attr("href", href);
  body();
  Ui.close();
}

// A part of a view whose events give its own messages, `A`s, made part of a view whose events give
// `B`s: each of its messages becomes `f`'s. So a component is a view, an update and a model like any
// page's, and a page shows it by `map((c) => #Counter(c), () => counter.view(m.counter))`.
export function map<A, B>(f: (a: A) => B, body: () => void uses Ui<A>): void uses Ui<B> {
  handle { body() } with Ui<A> {
    open(tag) resumes k => { Ui.open(tag); k() }
    key(s) resumes k => { Ui.key(s); k() }
    attr(name, value) resumes k => { Ui.attr(name, value); k() }
    on(event, msg) resumes k => { Ui.on(event, f(msg)); k() }
    text(s) resumes k => { Ui.text(s); k() }
    close() resumes k => { Ui.close(); k() }
    memo(key) resumes k => k(Ui.memo(key))
    unmemo() resumes k => { Ui.unmemo(); k() }
  }
}

// A React component of the page's, `name` as the page registered it (web/flynext.js's
// `registerReact`), shown with `props` and rendered again when they change: an element its own, which
// a render leaves as React made it. What it emits is an event giving `msg`, the event's text what it
// emitted, a string or JSON. On the server, and before React has loaded, the element is empty.
export function react<P extends ToJson, M>(name: str, props: readonly P, msg: M): void uses Ui<M> {
  Ui.open("div");
  Ui.attr("data-fly-react", name);
  Ui.attr("data-fly-props", stringify(props).asStr());
  Ui.on("fly-react", msg);
  Ui.close();
}

// A part of a view that the page shows as it showed it in the render before, without calling `body`
// or diffing what it shows, if `key` is what it was then: a row of a table whose data is the same.
// `key` must change whenever what `body` shows would: `hashOf` of what it shows, say. What `body`
// shows is one element. On the server, and the first time, `body` is called.
export function memo<M>(key: u64, body: () => void uses Ui<M>): void uses Ui<M> {
  if (Ui.memo(key)) {
    body();
    Ui.unmemo();
  }
}

// A value's hash, as `memo`'s key: what changes whenever the value does, but by chance.
export function hashOf<T extends Hash>(v: readonly T): u64 {
  let h = Hasher.new();
  v.hash(mut h);
  h.finish()
}

// ---- without the page's program ----

// What lets an event's message reach the server where the page's program has not taken the page
// over, by an element's attributes: a form posts to its page, saying which message submitting it
// gives; a button submits the page's form (`#_fly`, which every page has) for its click's; an input
// is a field its form posts, named for the message it gives. The program renders the same, so it
// takes the server's nodes over as they are, and its handlers keep the browser from posting.
export function posting(tag: str, event: str, k: usize): Vec<[String, String]> {
  match ([tag, event]) {
    ["form", "submit"] => [["method".toString(), "post".toString()], ["action".toString(), `?_fly=${k}`]],
    ["button", "click"] => [["form".toString(), "_fly".toString()], ["formaction".toString(), `?_fly=${k}`]],
    ["input", "input"] | ["input", "change"] | ["textarea", "input"] | ["select", "change"] => [["name".toString(), `_fly_${k}`]],
    _ => Vec.new(),
  }
}

// `posting`'s attributes, written as HTML.
function writePosting(tag: str, event: str, k: usize, out: mut String): void {
  match ([tag, event]) {
    ["form", "submit"] => out.push(` method="post" action="?_fly=${k}"`),
    ["button", "click"] => out.push(` form="_fly" formaction="?_fly=${k}"`),
    ["input", "input"] | ["input", "change"] | ["textarea", "input"] | ["select", "change"] => out.push(` name="_fly_${k}"`),
    _ => {}
  }
}

// The messages `view`'s events give, in order: what a posted form's message numbers count.
export function messages<M extends Send & Clone>(view: () => void uses Ui<M>): Vec<M> {
  let out: Vec<M> = Vec.new();
  handle { view() } with Ui<M> {
    open(_) resumes k => k(),
    key(_) resumes k => k(),
    attr(_, _) resumes k => k(),
    on(_, msg) resumes k => {
      out.push(msg.clone());
      k()
    }
    text(_) resumes k => k(),
    close() resumes k => k(),
    memo(_) resumes k => k(true),
    unmemo() resumes k => k(),
  };
  out
}

// ---- HTML ----

// Elements that have no end tag.
function isVoid(tag: str): bool {
  match (tag) { "area" | "base" | "br" | "col" | "embed" | "hr" | "img" | "input" | "link" | "meta" | "source" | "track" | "wbr" => true, _ => false }
}

// Text as HTML shows it: `&`, `<`, `>` and quotes escaped.
export function escape(s: str, out: mut String): void {
  const bytes = s.asBytes();
  let start: usize = 0;
  for (const i of 0..bytes.len()) {
    const b = bytes[i];
    const sub = match (b) { b'&' => "&amp;", b'<' => "&lt;", b'>' => "&gt;", b'"' => "&quot;", b'\'' => "&#39;", _ => "" };
    if (sub.len() > 0) {
      out.push(s.slice(start, i));
      out.push(sub);
      start = i + 1;
    }
  }
  out.push(s.slice(start, bytes.len()));
}

// The HTML of what `view` shows, appended to `out`. Events are left out — the page's code adds them
// when it takes the page over, as it renders the same view again — but for what posts their
// messages without it (`posting`).
export function html<M>(out: mut String, view: () => void uses Ui<M>): void {
  // Whether a start tag is still open, waiting for its attributes; the elements open, innermost last,
  // with where each's start tag ends once it has, for an attribute given after its children; how
  // many messages the events so far give.
  let starting = false;
  let open: Vec<String> = Vec.new();
  let ends: Vec<usize> = Vec.new();
  let events: usize = 0;
  handle { view() } with Ui<M> {
    open(tag) resumes k => {
      if (starting) { endTag(mut out, mut ends); }
      out.push("<");
      out.push(tag);
      open.push(tag.toString());
      ends.push(0);
      starting = true;
      k()
    }
    key(_) resumes k => k(),
    attr(name, value) resumes k => {
      let a = String.new();
      a.push(" ");
      a.push(name);
      a.push("=\"");
      escape(value, mut a);
      a.push("\"");
      lateAttr(mut out, starting, mut ends, a.asStr());
      k()
    }
    on(event, _) resumes k => {
      if (const #Some(tag) = open.last()) {
        let a = String.new();
        writePosting(tag.asStr(), event, events, mut a);
        lateAttr(mut out, starting, mut ends, a.asStr());
      }
      events += 1;
      k()
    }
    text(s) resumes k => {
      if (starting) { endTag(mut out, mut ends); starting = false; }
      escape(s, mut out);
      k()
    }
    close() resumes k => {
      if (starting) { endTag(mut out, mut ends); starting = false; }
      const tag = match (open.pop()) { #Some(t) => t, #None => String.new() };
      ends.pop();
      if (!isVoid(tag.asStr())) {
        out.push("</");
        out.push(tag.asStr());
        out.push(">");
      }
      k()
    }
    memo(_) resumes k => k(true),
    unmemo() resumes k => k(),
  };
}

// The innermost open element's start tag ends here.
function endTag(out: mut String, ends: mut Vec<usize>): void {
  const n = ends.len();
  if (n > 0) { ends[n - 1] = out.len(); }
  out.push(">");
}

// An attribute of the innermost open element: in its start tag, still being written, or put back
// into it, before its `>`, after those put there before it, once its children have followed it.
function lateAttr(out: mut String, starting: bool, ends: mut Vec<usize>, a: str): void {
  if (a.len() == 0) { return; }
  const n = ends.len();
  if (starting || n == 0) {
    out.push(a);
    return;
  }
  const at = ends[n - 1];
  const rest = out.asStr().slice(at, out.len()).toString();
  let s = out.asStr().slice(0, at).toString();
  s.push(a);
  s.push(rest.asStr());
  out = s;
  ends[n - 1] = at + a.len();
}

// ---- recorded ----

// What a view does, as a flat list: each element's `#Open`, with where its operations end; its
// attributes, key and events, whatever order the view gave them in; its children; and its `#Close`.
// A memo of the page's program's (web/dom.fly) is `#Memo` and the memo's number: its operations its own.
export enum Op { #Open(String, usize), #Key(String), #Attr(String, String), #On(String, usize), #Text(String), #Close, #Memo(usize) }
impl Clone for Op;

// The operations `view` does, each element's own before its children, and the messages its events
// give, numbered as its `#On`s say, with what posts each of them without the page's program.
export function record<M extends Send & Clone>(view: () => void uses Ui<M>): [Vec<Op>, Vec<M>] {
  let ops: Vec<Op> = Vec.new();
  let msgs: Vec<M> = Vec.new();
  // The elements open, innermost last, and whether each has had a child yet; whether any element's
  // own came after a child of its.
  let open: Vec<String> = Vec.new();
  let fed: Vec<bool> = Vec.new();
  let late = false;
  handle { view() } with Ui<M> {
    open(tag) resumes k => {
      if (fed.len() > 0) { fed[fed.len() - 1] = true; }
      ops.push(#Open(tag.toString(), 0));
      open.push(tag.toString());
      fed.push(false);
      k()
    }
    key(s) resumes k => {
      late = late || (fed.len() > 0 && fed[fed.len() - 1]);
      ops.push(#Key(s.toString()));
      k()
    }
    attr(name, value) resumes k => {
      late = late || (fed.len() > 0 && fed[fed.len() - 1]);
      ops.push(#Attr(name.toString(), value.toString()));
      k()
    }
    on(event, msg) resumes k => {
      late = late || (fed.len() > 0 && fed[fed.len() - 1]);
      ops.push(#On(event.toString(), msgs.len()));
      const tag = match (open.last()) { #Some(t) => t.clone(), #None => String.new() };
      for (const [name, value] of posting(tag.asStr(), event, msgs.len())) { ops.push(#Attr(name.clone(), value.clone())); }
      msgs.push(msg.clone());
      k()
    }
    text(s) resumes k => {
      if (fed.len() > 0) { fed[fed.len() - 1] = true; }
      addText(mut ops, s);
      k()
    }
    close() resumes k => {
      ops.push(#Close);
      open.pop();
      fed.pop();
      k()
    }
    memo(_) resumes k => k(true),
    unmemo() resumes k => k(),
  };
  let all = if (late) { ownFirst(ops) } else { ops };
  spans(mut all);
  [all, msgs]
}

// Text after what is there: text next to text is one text, as HTML parses it, so the page the
// server rendered is taken over node for node; text of nothing is none.
export function addText(ops: mut Vec<Op>, s: str): void {
  if (s.len() == 0) { return; }
  const n = ops.len();
  if (n > 0) {
    if (const #Text(t) = ops[n - 1]) {
      t.push(s);
      return;
    }
  }
  ops.push(#Text(s.toString()));
}

// An element's own operations — attributes, key, events — moved before its children.
export function ownFirst(ops: Vec<Op>): Vec<Op> {
  let all = ops;
  // For each element open, innermost last: its `#Open`, its own, and its children's so far.
  let opens: Vec<Op> = Vec.new();
  let owns: Vec<Vec<Op>> = [Vec.new()];
  let bodies: Vec<Vec<Op>> = [Vec.new()];
  for (const op of all.drain()) {
    match (op) {
      #Open(_, _) => {
        opens.push(op);
        owns.push(Vec.new());
        bodies.push(Vec.new());
      }
      #Key(_) | #Attr(_, _) | #On(_, _) => {
        const n = owns.len();
        owns[n - 1].push(op);
      }
      #Text(t) => {
        const n = bodies.len();
        addText(mut bodies[n - 1], t.asStr());
      }
      #Memo(_) => {
        const n = bodies.len();
        bodies[n - 1].push(op);
      }
      #Close => {
        const o = match (opens.pop()) { #Some(o) => o, #None => continue };
        let own = match (owns.pop()) { #Some(v) => v, #None => Vec.new() };
        let body = match (bodies.pop()) { #Some(v) => v, #None => Vec.new() };
        const n = bodies.len();
        bodies[n - 1].push(o);
        for (const x of own.drain()) { bodies[n - 1].push(x); }
        for (const x of body.drain()) { bodies[n - 1].push(x); }
        bodies[n - 1].push(#Close);
      }
    }
  }
  match (bodies.pop()) { #Some(v) => v, #None => Vec.new() }
}

// Each `#Open` told where its element's operations end.
export function spans(ops: mut Vec<Op>): void {
  let open: Vec<usize> = Vec.new();
  for (const i of 0..ops.len()) {
    match (ops[i]) {
      #Open(_, _) => open.push(i),
      #Close => {
        if (const #Some(at) = open.pop()) {
          if (const #Open(tag, _) = ops[at]) { ops[at] = #Open(tag.clone(), i + 1); }
        }
      }
      _ => {}
    }
  }
}
