// HTTP/1.1, as library code over sockets: requests read, responses written whole or streamed, and
// a server running each connection in a task of its own. Against a simulated world the same code
// serves the world's requests, and what it writes is the program's output.

import { Listener, Socket } from "std/net";

export type Header = { name: String; value: String };

// A request: its method, its path and query, its protocol's version, its headers, and its body, its
// bytes as they came.
export struct Request { method: String; path: String; query: String; version: String; headers: Vec<Header>; body: Vec<u8>; }

export type HttpErr = #BadRequest | IoErr;

impl Request {
  // A header's value, its name compared without case.
  export function header(self: readonly Self, name: str): Option<str> from self {
    for (const h of self.headers) {
      if (h.name.asStr().toLowerCase() == name.toLowerCase()) { return #Some(h.value.asStr()); }
    }
    #None
  }

  // The body as text, any bytes that are not UTF-8 each U+FFFD.
  export function text(self: readonly Self): String { String.fromUtf8Lossy(self.body.clone()) }
}

// A whole response.
export struct Response { status: u16; headers: Vec<Header>; body: String }

impl Response {
  export function new(status: u16, contentType: str, body: String): Response {
    Response { status, headers: [{ name: "Content-Type".toString(), value: contentType.toString() }], body }
  }
  export function text(status: u16, body: str): Response { Response.new(status, "text/plain; charset=utf-8", body.toString()) }
  export function html(body: String): Response { Response.new(200, "text/html; charset=utf-8", body) }
  export function json(body: String): Response { Response.new(200, "application/json", body) }
  export function header(self: mut Self, name: str, value: str): void {
    self.headers.push({ name: name.toString(), value: value.toString() });
  }
}

export function reason(status: u16): str {
  match (status) {
    200 => "OK", 201 => "Created", 204 => "No Content", 301 => "Moved Permanently", 302 => "Found", 303 => "See Other",
    304 => "Not Modified", 307 => "Temporary Redirect", 308 => "Permanent Redirect", 400 => "Bad Request",
    401 => "Unauthorized", 403 => "Forbidden", 404 => "Not Found", 405 => "Method Not Allowed", 409 => "Conflict",
    413 => "Content Too Large", 422 => "Unprocessable Content", 429 => "Too Many Requests", 500 => "Internal Server Error",
    503 => "Service Unavailable",
    _ => if (status < 400) { "OK" } else { "Error" },
  }
}

// ---- reading ----

// A connection's bytes, read as they are needed; and whether it stays open after the response to
// the request read last, as the request's version and its `Connection` header say.
export struct Conn { socket: Socket; buf: Vec<u8>; pos: usize; closed: bool; keep: bool; old: bool }

impl Conn {
  export function new(socket: Socket): Conn { Conn { socket, buf: Vec.new(), pos: 0, closed: false, keep: false, old: false } }

  // Reads more of what the client sent: false once it has sent all it will.
  function fill(self: mut Self): bool uses Io, Fail<IoErr> {
    if (self.closed) { return false; }
    // What was taken is dropped before more is read.
    if (self.pos > 0) {
      let rest: Vec<u8> = Vec.new();
      for (const i of self.pos..self.buf.len()) { rest.push(self.buf[i]); }
      self.buf = rest;
      self.pos = 0;
    }
    let chunk: u8[4096] = repeat(0 as u8);
    const n = self.socket.read(mut chunk);
    if (n == 0) {
      self.closed = true;
      return false;
    }
    for (const i of 0..n) { self.buf.push(chunk[i]); }
    true
  }

  // The next line, without its ending, or none at the end of what the client sent.
  function line(self: mut Self): Option<String> uses Io, Fail<IoErr> {
    while (true) {
      let i = self.pos;
      while (i < self.buf.len()) {
        if (self.buf[i] == b'\n') {
          let end = i;
          if (end > self.pos && self.buf[end - 1] == b'\r') { end -= 1; }
          let bytes: Vec<u8> = Vec.new();
          for (const j of self.pos..end) { bytes.push(self.buf[j]); }
          self.pos = i + 1;
          return String.fromUtf8(bytes);
        }
        i += 1;
      }
      if (!self.fill()) { return #None; }
    }
  }

  // The next `n` bytes, or none if the client sends fewer.
  function take(self: mut Self, n: usize): Option<Vec<u8>> uses Io, Fail<IoErr> {
    while (self.buf.len() - self.pos < n) {
      if (!self.fill()) { return #None; }
    }
    let out: Vec<u8> = Vec.new();
    for (const i of self.pos..self.pos + n) { out.push(self.buf[i]); }
    self.pos += n;
    #Some(out)
  }

  // The next request, or none if the client closed the connection before sending one.
  export function request(self: mut Self): Option<Request> uses Io, Fail<HttpErr> {
    let first = match (self.line()) { #Some(l) => l, #None => return #None };
    // Blank lines before a request are allowed.
    while (first.len() == 0) {
      first = match (self.line()) { #Some(l) => l, #None => return #None };
    }
    const parts = first.asStr().split(" ");
    if (parts.len() < 2) { throw #BadRequest }
    const target = parts[1].asStr();
    const [path, query] = match (target.indexOf("?")) {
      #Some(q) => [target.slice(0, q).toString(), target.slice(q + 1, target.len()).toString()],
      #None => [target.toString(), String.new()],
    };
    let headers: Vec<Header> = Vec.new();
    while (true) {
      const l = match (self.line()) { #Some(l) => l, #None => throw #BadRequest };
      if (l.len() == 0) { break; }
      const colon = match (l.asStr().indexOf(":")) { #Some(c) => c, #None => throw #BadRequest };
      headers.push({ name: l.asStr().slice(0, colon).trim().toString(), value: l.asStr().slice(colon + 1, l.len()).trim().toString() });
    }
    const version = if (parts.len() > 2) { parts[2].clone() } else { "HTTP/1.0".toString() };
    let req: Request = { method: parts[0].clone(), path, query, version, headers, body: Vec.new() };
    // HTTP/1.1 keeps a connection open unless asked not to; HTTP/1.0 closes it unless asked not to.
    const asked = match (req.header("connection")) { #Some(v) => v.toLowerCase(), #None => String.new() };
    self.old = req.version == "HTTP/1.0";
    self.keep = if (self.old) { asked == "keep-alive" } else { asked != "close" };
    // A body sent in chunks is read whole, and is then as if its length had been given.
    const chunked = match (req.header("transfer-encoding")) { #Some(v) => v.toLowerCase().asStr().includes("chunked"), #None => false };
    if (chunked) {
      req.body = self.chunks();
      req.headers.retain((h) => h.name.asStr().toLowerCase() != "transfer-encoding");
      req.headers.push({ name: "Content-Length".toString(), value: `${req.body.len()}` });
      return #Some(req);
    }
    const length: usize = match (req.header("content-length")) {
      #Some(v) => match (parseInt(v)) { #Some(n) => if (n >= 0) { n as usize } else { throw #BadRequest }, #None => throw #BadRequest },
      #None => 0,
    };
    if (length > 0) {
      req.body = match (self.take(length)) { #Some(b) => b, #None => throw #BadRequest };
    }
    #Some(req)
  }

  // A body sent in chunks (RFC 9112 §7.1): each a length in hexadecimal and its bytes, until one of
  // none, after which come trailers, which are dropped.
  function chunks(self: mut Self): Vec<u8> uses Io, Fail<HttpErr> {
    let body: Vec<u8> = Vec.new();
    while (true) {
      const l = match (self.line()) { #Some(l) => l, #None => throw #BadRequest };
      const size = match (parseHex(match (l.asStr().indexOf(";")) { #Some(k) => l.asStr().slice(0, k), #None => l.asStr() }.trim())) { #Some(n) => n, #None => throw #BadRequest };
      if (size == 0) {
        while (true) {
          const t = match (self.line()) { #Some(t) => t, #None => throw #BadRequest };
          if (t.len() == 0) { return body; }
        }
      }
      const bytes = match (self.take(size)) { #Some(b) => b, #None => throw #BadRequest };
      body.extend(bytes);
      match (self.line()) { #Some(e) if e.len() == 0 => {}, _ => throw #BadRequest }
    }
    body
  }

  // ---- writing ----

  export function write(self: mut Self, r: readonly Response): void uses Io, Fail<IoErr> {
    let head = `HTTP/1.1 ${r.status} ${reason(r.status)}\r\n`;
    for (const h of r.headers) { head.push(`${h.name}: ${h.value}\r\n`); }
    head.push(self.connection().asStr());
    head.push(`Content-Length: ${r.body.len()}\r\n\r\n`);
    // One write, not two: each is a call into the kernel, which costs more than copying the body.
    head.push(r.body.asStr());
    self.socket.write(head.asStr().asBytes());
  }

  // A whole response of bytes: a file's, say.
  export function writeBytes(self: mut Self, status: u16, contentType: str, body: readonly u8[]): void uses Io, Fail<IoErr> {
    let head = `HTTP/1.1 ${status} ${reason(status)}\r\nContent-Type: ${contentType}\r\n`;
    head.push(self.connection().asStr());
    head.push(`Content-Length: ${body.len()}\r\n\r\n`);
    self.socket.write(head.asStr().asBytes());
    self.socket.write(body);
  }

  // A file's bytes, with how long a browser may keep them (`Cache-Control`) and the cookies it sets.
  export function writeFile(self: mut Self, contentType: str, cache: str, cookies: readonly Vec<String>, body: readonly u8[]): void uses Io, Fail<IoErr> {
    let head = `HTTP/1.1 200 OK\r\nContent-Type: ${contentType}\r\nCache-Control: ${cache}\r\n`;
    for (const c of cookies) { head.push(`Set-Cookie: ${c}\r\n`.asStr()); }
    head.push(self.connection().asStr());
    head.push(`Content-Length: ${body.len()}\r\n\r\n`);
    self.socket.write(head.asStr().asBytes());
    self.socket.write(body);
  }

  // Starts `r` streamed: its status and headers, then its body in chunks, as `send` gives them,
  // until `end`; what `r` holds as its body is not sent.
  export function start(self: mut Self, r: readonly Response): void uses Io, Fail<IoErr> {
    let head = `HTTP/1.1 ${r.status} ${reason(r.status)}\r\n`;
    for (const h of r.headers) { head.push(`${h.name}: ${h.value}\r\n`); }
    head.push(self.connection().asStr());
    head.push("Transfer-Encoding: chunked\r\n\r\n");
    self.socket.write(head.asStr().asBytes());
  }

  export function send(self: mut Self, chunk: str): void uses Io, Fail<IoErr> {
    if (chunk.len() == 0) { return; }
    self.socket.write(`${hex(chunk.len())}\r\n${chunk}\r\n`.asStr().asBytes());
  }

  export function end(self: mut Self): void uses Io, Fail<IoErr> {
    self.socket.write("0\r\n\r\n".asBytes());
  }

  export function close(self: mut Self): void uses Io { self.socket.close(); }

  // Up to `max` bytes of what the other end sends, as they come: none once it has sent all.
  function some(self: mut Self, max: usize): Vec<u8> uses Io, Fail<IoErr> {
    if (self.pos >= self.buf.len() && !self.fill()) { return Vec.new(); }
    const end = min(self.buf.len(), self.pos + max);
    let out: Vec<u8> = Vec.new();
    out.extend(self.buf[self.pos..end]);
    self.pos = end;
    out
  }

  // What the response says of the connection: closed after it, or, to HTTP/1.0, kept open.
  function connection(self: readonly Self): String {
    if (!self.keep) { "Connection: close\r\n".toString() } else if (self.old) { "Connection: keep-alive\r\n".toString() } else { String.new() }
  }
}

// A length in hexadecimal, as a chunk gives it; none if it is not one, or is too long to be one.
function parseHex(s: str): Option<usize> {
  if (s.len() == 0 || s.len() > 15) { return #None; }
  let n: usize = 0;
  for (const c of s.bytes()) {
    const d: usize = if (c >= b'0' && c <= b'9') { (c - b'0') as usize } else if (c >= b'a' && c <= b'f') { (c - b'a' + 10) as usize } else if (c >= b'A' && c <= b'F') { (c - b'A' + 10) as usize } else { return #None };
    n = n * 16 + d;
  }
  #Some(n)
}

function hex(n: usize): String {
  const digits = "0123456789abcdef";
  if (n == 0) { return "0".toString(); }
  let out = String.new();
  let k = n;
  let rev: Vec<usize> = Vec.new();
  while (k > 0) {
    rev.push(k % 16);
    k = k / 16;
  }
  let i = rev.len();
  while (i > 0) {
    i -= 1;
    out.push(digits.slice(rev[i], rev[i] + 1));
  }
  out
}

// ---- forwarding ----

// Headers that are about one connection, not the request or the response (RFC 9110 §7.6.1): a
// proxy drops them, and says what it needs of each connection itself.
const HOP: str[] = ["connection", "keep-alive", "proxy-connection", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade"];

function hop(name: str): bool { HOP.includes(name.toLowerCase().asStr()) }

// Forwards `req` to the server at `host` and `port`, `extra` headers added, and relays its answer to
// `conn` as it comes, `cookies` set on it besides its own: a body of a given length copied, one in chunks relayed chunk by chunk, and one
// that ends when the server closes its connection sent on in chunks, so `conn` may stay open. An
// answer to `HEAD`, or of a status that has no body, has none. A request to switch protocols, a
// WebSocket, is answered 501: the connection is not relayed both ways.
export function forward(conn: mut Conn, req: readonly Request, host: str, port: u16, extra: readonly Vec<Header>, cookies: readonly Vec<String>): void uses Io, Fail<IoErr> {
  const upgrade = match (req.header("upgrade")) { #Some(_) => true, #None => false };
  if (upgrade) {
    conn.write(Response.text(501, "this server does not relay a connection that switches protocols\n"));
    return;
  }
  // An app that cannot be reached is a gateway's failure to answer, whatever kept it from answering.
  let up = match (try { #Ok(Socket.connect(host, port)) } catch (e) { #Err(e) }) {
    #Ok(s) => Conn.new(s),
    #Err(_) => {
      conn.write(Response.text(502, `the app at ${host}:${port} does not answer\n`.asStr()));
      return;
    }
  };
  const target = if (req.query.len() > 0) { `${req.path}?${req.query}` } else { req.path.clone() };
  let head = `${req.method} ${target} HTTP/1.1\r\n`;
  for (const h of req.headers) {
    if (!hop(h.name.asStr()) && h.name.asStr().toLowerCase() != "content-length") { head.push(`${h.name}: ${h.value}\r\n`.asStr()); }
  }
  for (const h of extra) { head.push(`${h.name}: ${h.value}\r\n`.asStr()); }
  if (req.body.len() > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH") { head.push(`Content-Length: ${req.body.len()}\r\n`.asStr()); }
  head.push("Connection: close\r\n\r\n");
  up.socket.write(head.asStr().asBytes());
  if (req.body.len() > 0) { up.socket.write(req.body); }
  // The answer's status line and headers, 1xx answers before it skipped.
  let status: u16 = 0;
  let statusLine = String.new();
  let headers: Vec<Header> = Vec.new();
  while (status < 200) {
    statusLine = match (up.line()) { #Some(l) => l, #None => { conn.write(Response.text(502, "the upstream server closed the connection\n")); up.close(); return; } };
    const parts = statusLine.asStr().split(" ");
    status = if (parts.len() > 1) { match (parseInt(parts[1].asStr())) { #Some(n) => n as u16, #None => 0 } } else { 0 };
    if (status == 0) { conn.write(Response.text(502, "the upstream server's answer is not HTTP\n")); up.close(); return; }
    headers = Vec.new();
    while (true) {
      const l = match (up.line()) { #Some(l) => l, #None => { conn.write(Response.text(502, "the upstream server closed the connection\n")); up.close(); return; } };
      if (l.len() == 0) { break; }
      if (const #Some(c) = l.asStr().indexOf(":")) { headers.push({ name: l.asStr().slice(0, c).trim().toString(), value: l.asStr().slice(c + 1, l.len()).trim().toString() }); }
    }
  }
  const find = (name: str) => match (headers.iter().find((h) => h.name.asStr().toLowerCase() == name)) { #Some(h) => #Some(h.value.clone()), #None => #None };
  const none = req.method == "HEAD" || status == 204 || status == 304;
  const chunked = match (find("transfer-encoding")) { #Some(v) => v.toLowerCase().asStr().includes("chunked"), #None => false };
  const length: Option<usize> = match (find("content-length")) { #Some(v) => match (parseInt(v.asStr())) { #Some(n) => #Some(n as usize), #None => #None }, #None => #None };
  // The status line as the server gave it, but for the version, which is this connection's.
  const reasonAt = match (statusLine.asStr().indexOf(" ")) { #Some(k) => k + 1, #None => statusLine.len() };
  let out = `HTTP/1.1 ${statusLine.asStr().slice(reasonAt, statusLine.len())}\r\n`;
  for (const h of headers) {
    const name = h.name.asStr().toLowerCase();
    if (hop(h.name.asStr()) || name == "content-length") { continue; }
    // Where the server sends the browser, if it names the server itself, is here: the browser came
    // here, and cannot reach the server.
    const value = if (name == "location") { local(h.value.asStr(), host, port) } else { h.value.clone() };
    out.push(`${h.name}: ${value}\r\n`.asStr());
  }
  for (const c of cookies) { out.push(`Set-Cookie: ${c}\r\n`.asStr()); }
  out.push(conn.connection().asStr());
  if (none) {
    if (const #Some(n) = length) { out.push(`Content-Length: ${n}\r\n`.asStr()); }
    out.push("\r\n");
    conn.socket.write(out.asStr().asBytes());
  } else if (chunked) {
    out.push("Transfer-Encoding: chunked\r\n\r\n");
    conn.socket.write(out.asStr().asBytes());
    relayChunks(mut up, mut conn);
  } else if (const #Some(n) = length) {
    out.push(`Content-Length: ${n}\r\n\r\n`.asStr());
    conn.socket.write(out.asStr().asBytes());
    let left = n;
    while (left > 0) {
      const bytes = up.some(min(left, 65536));
      if (bytes.len() == 0) { break; }
      conn.socket.write(bytes);
      left -= bytes.len();
    }
    // An answer shorter than it said cannot be finished: the connection must end with it.
    if (left > 0) { conn.keep = false; }
  } else {
    out.push("Transfer-Encoding: chunked\r\n\r\n");
    conn.socket.write(out.asStr().asBytes());
    while (true) {
      const bytes = up.some(65536);
      if (bytes.len() == 0) { break; }
      conn.socket.write(`${hex(bytes.len())}\r\n`.asStr().asBytes());
      conn.socket.write(bytes);
      conn.socket.write("\r\n".asBytes());
    }
    conn.socket.write("0\r\n\r\n".asBytes());
  }
  up.close();
}

// An address the server at `host` and `port` gave, as the browser should follow it here: its path,
// if it names that server — by its host, or as `localhost` or `127.0.0.1`, which is how a server
// behind another names itself — and else as it is.
function local(url: str, host: str, port: u16): String {
  const rest = if (url.startsWith("http://")) { url.slice(7, url.len()) } else if (url.startsWith("https://")) { url.slice(8, url.len()) } else { return url.toString() };
  const slash = match (rest.indexOf("/")) { #Some(k) => k, #None => rest.len() };
  const authority = rest.slice(0, slash);
  const at = match (authority.lastIndexOf(":")) { #Some(c) => [authority.slice(0, c), authority.slice(c + 1, authority.len())], #None => [authority, "80"] };
  const named = at[0] == host || at[0] == "localhost" || at[0] == "127.0.0.1";
  if (!named || parseInt(at[1]) != #Some(port as i64)) { return url.toString(); }
  const path = rest.slice(slash, rest.len());
  if (path.len() == 0) { "/".toString() } else { path.toString() }
}

// A body in chunks, relayed from `up` to `conn` a chunk at a time as each comes, its trailers too.
function relayChunks(up: mut Conn, conn: mut Conn): void uses Io, Fail<IoErr> {
  while (true) {
    const l = match (up.line()) { #Some(l) => l, #None => { conn.keep = false; return; } };
    const size = match (parseHex(match (l.asStr().indexOf(";")) { #Some(k) => l.asStr().slice(0, k), #None => l.asStr() }.trim())) { #Some(n) => n, #None => { conn.keep = false; return; } };
    conn.socket.write(`${hex(size)}\r\n`.asStr().asBytes());
    if (size == 0) {
      // The trailers, and the blank line that ends them.
      while (true) {
        const t = match (up.line()) { #Some(t) => t, #None => { conn.socket.write("\r\n".asBytes()); return; } };
        conn.socket.write(`${t}\r\n`.asStr().asBytes());
        if (t.len() == 0) { return; }
      }
    }
    let left = size;
    while (left > 0) {
      const bytes = up.some(min(left, 65536));
      if (bytes.len() == 0) { conn.keep = false; return; }
      conn.socket.write(bytes);
      left -= bytes.len();
    }
    match (up.line()) { #Some(_) => {}, #None => { conn.keep = false; return; } }
    conn.socket.write("\r\n".asBytes());
  }
}

// ---- serving ----

// What a server does with each request: given the connection, it writes the response. Its state is
// shared by the tasks serving connections, so it is `Send`, and changed only under a lock.
export interface Handler extends Send {
  function handle(self: readonly Self, req: readonly Request, conn: mut Conn): void uses Io;
}

// Serves the connections `listener` accepts, each in a task of its own: every request on it is given
// to `app`, until the client closes it or asks to. A request that cannot be read gets a 400.
export function serve<H extends Handler>(listener: mut Listener, app: readonly H): void uses Io, Fail<IoErr> {
  Io.scope((s) => {
    for (const socket of listener.accept()) {
      let c = Conn.new(socket);
      s.spawn(() => serveConn<H>(c, app));
    }
  });
}

function serveConn<H extends Handler>(conn: Conn, app: readonly H): void uses Io {
  let c = conn;
  try {
    while (const #Some(req) = c.request()) {
      app.handle(req, mut c);
      if (!c.keep) { break; }
    }
  } catch (e) {
    match (e) {
      #BadRequest => try { c.write(Response.text(400, "bad request\n")); } catch (_) {},
      _ => {},
    }
  }
  c.close();
}
