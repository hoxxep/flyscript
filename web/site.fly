// What a site's server does for any site, which the server `flynext` makes from an app calls: a
// page answered — whole, for a browser, or as its data, for the page's program following a link —
// the site's files, and the address of a build, which a page in development watches to reload.

import { File } from "std/io";
import { stringify } from "std/json";
import { Request, Response, Conn } from "./http";
import { Ui, Event, html, escape, messages } from "./ui";
import { Page } from "./dom";
import { decode } from "./router";
import { Http } from "./request";

// What every page of the site has around what it shows: what goes in its `<head>`, and, in
// development, the build it was made by.
export type Shell = { head: String; build: String };

// What a page's program is told of a page: the route that answers it, its address, its title, and
// the state its view starts from, as JSON. One line each, the title a JSON string, so nothing in it
// ends a line; an address a request came with has none.
export function arrival(route: str, url: str, title: str, state: str): String {
  `${route}\n${url}\n${stringify(title)}\n${state}`
}

// Whether the request is a page's program asking for what a page shows, not a browser for the page.
export function wantsData(req: readonly Request): bool {
  match (req.header("X-Fly-Data")) { #Some(_) => true, #None => false }
}

// A page as a browser gets it: the view rendered, what the page's program starts from, and the
// program, which takes the page over (web/dom.fly).
export function document<M>(shell: readonly Shell, route: str, url: str, title: str, state: str, view: () => void uses Ui<M>): String {
  let out = "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>".toString();
  escape(title, mut out);
  out.push("</title>");
  out.push(shell.head.asStr());
  out.push("<link rel=\"modulepreload\" href=\"/_fly/flynext.js\"></head><body><div id=\"app\">");
  html(mut out, view);
  // What the program starts from is text a script holds: `</` in it would end the script, and is
  // `<\/` in JSON, which reads it as the same.
  // The form a button posts its message with, without the page's program (web/ui.fly's `posting`).
  out.push("</div><form id=\"_fly\" method=\"post\" hidden></form><script type=\"text/plain\" id=\"fly-page\">");
  out.push(arrival(route, url, title, state).asStr().replaceAll("</", "<\\/").asStr());
  out.push("</script><script type=\"module\">import { start } from \"/_fly/flynext.js\"; start(\"/_fly/app.wasm\");</script>");
  if (shell.build.len() > 0) {
    // In development a page reloads once the server answers for another build.
    out.push("<script>(async () => { const was = ");
    out.push(stringify(shell.build.asStr()).asStr());
    out.push("; for (;;) { await new Promise((r) => setTimeout(r, 400)); try { const now = await (await fetch(\"/_fly/build\")).text(); if (now !== was) { location.reload(); return; } } catch (_) {} } })();</script>");
  }
  out.push("</body></html>\n");
  out
}

// Answers for a page: its data, to a page's program, or the page, to a browser; with the cookies
// its `load` set.
export function respond<M>(conn: mut Conn, req: readonly Request, shell: readonly Shell, status: u16, route: str, url: str, title: str, state: str, cookies: readonly Vec<String>, view: () => void uses Ui<M>): void uses Io, Fail<IoErr> {
  let r = if (wantsData(req)) {
    Response.new(status, "text/plain; charset=utf-8", arrival(route, url, title, state))
  } else {
    Response.new(status, "text/html; charset=utf-8", document(shell, route, url, title, state, view))
  };
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.write(r);
}

// How a page's model was made: made, or nothing found for the address, or the page failed.
export enum Loaded<M> { #Page(M), #Missing, #Broken }

// A page that is the same for every request, rendered once: as a browser gets it, and as its data.
export type Fixed = { doc: String; data: String };

export function fixed<M>(shell: readonly Shell, route: str, url: str, title: str, state: str, view: () => void uses Ui<M>): Fixed {
  { doc: document(shell, route, url, title, state, view), data: arrival(route, url, title, state) }
}

// Answers for a page rendered once.
export function answerFixed(conn: mut Conn, req: readonly Request, f: readonly Fixed): void uses Io, Fail<IoErr> {
  let r = if (wantsData(req)) {
    Response.new(200, "text/plain; charset=utf-8", f.data.clone())
  } else {
    Response.new(200, "text/html; charset=utf-8", f.doc.clone())
  };
  r.header("Cache-Control", "no-store");
  conn.write(r);
}

// ---- the request ----

// The value of the request's cookie `name`, if it sent one.
export function cookieOf(req: readonly Request, name: str): Option<String> {
  const all = match (req.header("Cookie")) { #Some(c) => c, #None => return #None };
  for (const part of all.split(";")) {
    const p = part.asStr().trim();
    if (const #Some(eq) = p.indexOf("=") && p.slice(0, eq) == name) {
      return #Some(p.slice(eq + 1, p.len()).toString());
    }
  }
  #None
}

// A `Set-Cookie` header's value.
function cookie(name: str, value: str, maxAge: u32): String {
  let c = `${name}=${value}; Path=/; HttpOnly; SameSite=Lax`;
  if (maxAge > 0) { c.push(`; Max-Age=${maxAge}`.asStr()); }
  c
}

export function setCookies(r: mut Response, cookies: readonly Vec<String>): void {
  for (const c of cookies) { r.header("Set-Cookie", c.asStr()); }
}

// Runs `body` with `Http` answered from `req`: what it gives, or, if it sent the browser
// elsewhere, where; the cookies it sets added to `set`.
export function withHttp<T, row E>(req: readonly Request, set: mut Vec<String>, body: once () => T uses Http, ...E): Result<T, String> uses ...E {
  handle { #Ok(body()) } with Http {
    header(name) resumes k => k(match (req.header(name)) { #Some(v) => #Some(v.toString()), #None => #None }),
    cookie(name) resumes k => k(cookieOf(req, name)),
    setCookie(name, value, maxAge) resumes k => {
      set.push(cookie(name, value, maxAge));
      k()
    }
    redirect(url) => #Err(url),
  }
}

// Sends the browser to `url`, with the cookies set on the way: a page's program following a link
// follows this too, to the data of the page at `url`.
export function redirect(conn: mut Conn, url: str, cookies: readonly Vec<String>): void uses Io, Fail<IoErr> {
  let r = Response.text(303, "");
  r.header("Location", url);
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.write(r);
}

export function contentType(path: str): str {
  if (path.endsWith(".wasm")) { "application/wasm" }
  else if (path.endsWith(".js")) { "text/javascript" }
  else if (path.endsWith(".css")) { "text/css" }
  else if (path.endsWith(".html")) { "text/html; charset=utf-8" }
  else if (path.endsWith(".svg")) { "image/svg+xml" }
  else if (path.endsWith(".png")) { "image/png" }
  else if (path.endsWith(".jpg") || path.endsWith(".jpeg")) { "image/jpeg" }
  else if (path.endsWith(".ico")) { "image/x-icon" }
  else if (path.endsWith(".json")) { "application/json" }
  else if (path.endsWith(".txt")) { "text/plain; charset=utf-8" }
  else { "application/octet-stream" }
}

// Answers with the site's file at the request's path, under `dir`, if there is one. The program a
// build makes is named for it, so a browser may keep it as long as it likes; other files it checks.
export function file(conn: mut Conn, req: readonly Request, dir: str): bool uses Io, Fail<IoErr> {
  const path = req.path.asStr();
  if (path.includes("..") || path.endsWith("/")) { return false; }
  const found = try {
    let f = File.open(`${dir}${path}`.asStr());
    #Some(f.readBytes())
  } catch (_) { #None };
  match (found) {
    #Some(bytes) => {
      const cache = if (path.startsWith("/_fly/")) { "no-cache" } else { "public, max-age=300" };
      conn.writeFile(contentType(path), cache, bytes);
      true
    }
    #None => false,
  }
}

// ---- forms, without the page's program ----

// A form's fields, as it posts them: `name=value&…`, each decoded.
export function fields(body: str): Vec<[String, String]> {
  let out: Vec<[String, String]> = Vec.new();
  for (const part of body.split("&")) {
    if (part.len() == 0) { continue; }
    match (part.asStr().indexOf("=")) {
      #Some(eq) => out.push([decode(part.asStr().slice(0, eq), true), decode(part.asStr().slice(eq + 1, part.len()), true)]),
      #None => out.push([decode(part.asStr(), true), String.new()]),
    }
  }
  out
}

// What posted the form: the number of the message it gives, from its address's `?_fly=`.
export function postedMessage(req: readonly Request): Option<usize> {
  for (const part of req.query.split("&")) {
    if (part.asStr().startsWith("_fly=")) {
      return match (parseInt(part.asStr().slice(5, part.len()))) { #Some(n) => #Some(n as usize), #None => #None };
    }
  }
  #None
}

// A form posted from a page the page's program has not taken over: `update` given, as the page's
// program would have given it, each input's message with the text the form posted for it, then
// the message `k` the form's submission, or the button's click, gives — the messages as the page
// rendered from `m` numbers them. What the update performs is the server's to handle, as it is
// around a page's `load`. Where the page goes then: where the update sends it, or back to `url`,
// so that loading it again does not post the form again.
export function submitted<Model, M extends Send & Clone, row E>(m: Model, k: usize, posted: readonly Vec<[String, String]>, url: str, view: (m: readonly Model) => void uses Ui<M>, update: (m: mut Model, msg: M, ev: readonly Event) => void uses Page<Model>, ...E): String uses ...E {
  let model = m;
  const msgs = messages(() => view(model));
  let to = url.toString();
  handle {
    for (const [name, value] of posted) {
      if (!name.startsWith("_fly_")) { continue; }
      if (const #Some(j) = parseInt(name.asStr().slice(5, name.len())) && (j as usize) < msgs.len()) {
        update(mut model, msgs[j as usize].clone(), { text: value.clone(), key: String.new(), checked: true });
      }
    }
    if (k < msgs.len()) { update(mut model, msgs[k].clone(), { text: String.new(), key: String.new(), checked: false }); }
  } with Page<Model> {
    show(_) resumes k => k(),
    go(u) resumes k => {
      to = u.toString();
      k()
    }
  };
  to
}
