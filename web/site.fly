// What a site's server does for any site, which the server `flynext` makes from an app calls: a
// page answered — whole, for a browser, or as its data, for the page's program following a link —
// the site's files, and the address of a build, which a page in development watches to reload.

import { File } from "std/io";
import { Mutex } from "std/sync";
import { HashMap } from "std/collections";
import { stringify, ToJson } from "std/json";
import { Request, Response, Conn, Header, forward } from "./http";
import { Ui, Event, html, escape, messages } from "./ui";
import { Page } from "./dom";
import { decode } from "./router";
import { Http } from "./request";

// What every page of the site has around what it shows: what goes in its `<head>`; in development,
// the build it was made by; the file of each route's own module (web/flynext.js), by route; and
// whether the site answers only some addresses, an app it is replacing the rest, so that its
// program follows only links to its own routes.
export type Shell = { head: String; build: String; modules: HashMap<String, String>; strangling: bool };

// The routes' modules, as a build lists them in `_fly/routes/modules.txt`: a route and its file a line.
export function modulesIn(dir: str): HashMap<String, String> uses Io {
  let out: HashMap<String, String> = HashMap.new();
  const text = try {
    let f = File.open(`${dir}/_fly/routes/modules.txt`.asStr());
    f.readText()
  } catch (_) { String.new() };
  for (const line of text.split("\n")) {
    if (const #Some(at) = line.lastIndexOf(" ")) { out.insert(line.slice(0, at).toString(), line.slice(at + 1, line.len()).toString()); }
  }
  out
}

// What a page's program is told of a page: the route that answers it, its address, its title and
// description, and the state its view starts from, as JSON. One line each, the title and the
// description JSON strings, so nothing in them ends a line; an address a request came with has none.
export function arrival(route: str, url: str, title: str, description: str, state: str): String {
  `${route}\n${url}\n${stringify(title)}\n${stringify(description)}\n${state}`
}

// Whether the request is a page's program asking for what a page shows, not a browser for the page.
export function wantsData(req: readonly Request): bool {
  match (req.header("X-Fly-Data")) { #Some(_) => true, #None => false }
}

// A page as a browser gets it: the view rendered, what the page's program starts from, and the
// program, which takes the page over (web/dom.fly).
export function document<M>(shell: readonly Shell, route: str, url: str, title: str, description: str, state: str, view: () => void uses Ui<M>): String {
  let out = opening(shell, route, title, description, view);
  out.push("</div>");
  closing(mut out, shell, route, url, title, description, state);
  out
}

// A page's document up to the end of what its view shows, which is left open.
function opening<M>(shell: readonly Shell, route: str, title: str, description: str, view: () => void uses Ui<M>): String {
  let out = "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>".toString();
  escape(title, mut out);
  out.push("</title>");
  // What a search engine or a link preview shows of the page.
  if (description.len() > 0) {
    out.push("<meta name=\"description\" content=\"");
    escape(description, mut out);
    out.push("\"><meta property=\"og:description\" content=\"");
    escape(description, mut out);
    out.push("\">");
  }
  if (title.len() > 0) {
    out.push("<meta property=\"og:title\" content=\"");
    escape(title, mut out);
    out.push("\">");
  }
  out.push(shell.head.asStr());
  // The page's program and its own module, fetched as the page is read.
  out.push("<link rel=\"modulepreload\" href=\"/_fly/flynext.js\"><link rel=\"preload\" href=\"/_fly/app.wasm\" as=\"fetch\" crossorigin>");
  if (const #Some(file) = shell.modules.get(route)) {
    out.push("<link rel=\"preload\" href=\"/_fly/routes/");
    out.push(file.asStr());
    out.push("\" as=\"fetch\" crossorigin>");
  }
  out.push("</head><body><div id=\"app\">");
  html(mut out, view);
  out
}

// The rest of a page's document, after what its view shows: what the program starts from, and the
// program.
function closing(out: mut String, shell: readonly Shell, route: str, url: str, title: str, description: str, state: str): void {
  // What the program starts from is text a script holds: `</` in it would end the script, and is
  // `<\/` in JSON, which reads it as the same.
  // The form a button posts its message with, without the page's program (web/ui.fly's `posting`).
  out.push("<form id=\"_fly\" method=\"post\" hidden></form><script type=\"text/plain\" id=\"fly-page\">");
  out.push(arrival(route, url, title, description, state).asStr().replaceAll("</", "<\\/").asStr());
  const how = if (shell.strangling) { ", undefined, { strangling: true }" } else { "" };
  out.push(`</script><script type="module">import { start } from "/_fly/flynext.js"; start("/_fly/app.wasm"${how});</script>`.asStr());
  if (shell.build.len() > 0) {
    // In development a page reloads once the server answers for another build.
    out.push("<script>(async () => { const was = ");
    out.push(stringify(shell.build.asStr()).asStr());
    out.push("; for (;;) { await new Promise((r) => setTimeout(r, 400)); try { const now = await (await fetch(\"/_fly/build\")).text(); if (now !== was) { location.reload(); return; } } catch (_) {} } })();</script>");
  }
  out.push("</body></html>\n");
}

// A page whose model is made in two steps, streamed: what `first` shows — the model as `load`
// left it, its view showing what is still to come as it likes — at once, to a browser; then, once
// `rest` has made the rest of the model, what `view` shows of it, which takes the first's place
// before the program takes the page over, as if the page had been rendered whole. To a page's
// program, the page's data once the model is whole. If `rest` sends the browser elsewhere, it goes.
export function stream<Model extends ToJson, M>(conn: mut Conn, req: readonly Request, shell: readonly Shell, route: str, url: str, title: str, description: str, cookies: readonly Vec<String>, m: Model, view: (m: readonly Model) => void uses Ui<M>, rest: once (m: Model) => Result<Model, String> uses Io, Fail<IoErr>): void uses Io, Fail<IoErr> {
  if (wantsData(req)) {
    return match (rest(m)) {
      #Ok(model) => respond(mut conn, req, shell, 200, route, url, title, description, stringify(model).asStr(), cookies, () => view(model)),
      #Err(to) => redirect(mut conn, to.asStr(), cookies),
    };
  }
  let r = Response.new(200, "text/html; charset=utf-8", String.new());
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.start(r);
  let first = opening(shell, route, title, description, () => view(m));
  first.push("</div>");
  conn.send(first.asStr());
  const model = match (rest(m)) {
    #Ok(model) => model,
    #Err(to) => {
      conn.send(`<script>location.replace(${stringify(to.asStr()).replaceAll("</", "<\\/")})</script>`.asStr());
      return conn.end();
    }
  };
  let out = "<template id=\"fly-later\">".toString();
  html(mut out, () => view(model));
  out.push("</template><script>document.getElementById(\"app\").replaceChildren(document.getElementById(\"fly-later\").content);document.getElementById(\"fly-later\").remove();</script>");
  closing(mut out, shell, route, url, title, description, stringify(model).asStr());
  conn.send(out.asStr());
  conn.end();
}

// Answers for a page: its data, to a page's program, or the page, to a browser; with the cookies
// its `load` set.
export function respond<M>(conn: mut Conn, req: readonly Request, shell: readonly Shell, status: u16, route: str, url: str, title: str, description: str, state: str, cookies: readonly Vec<String>, view: () => void uses Ui<M>): void uses Io, Fail<IoErr> {
  let r = if (wantsData(req)) {
    Response.new(status, "text/plain; charset=utf-8", arrival(route, url, title, description, state))
  } else {
    Response.new(status, "text/html; charset=utf-8", document(shell, route, url, title, description, state, view))
  };
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.write(r);
}

// How a page's model was made: made, or nothing found for the address, or the page failed.
export enum Loaded<M> { #Page(M), #Missing, #Broken }

// A page that is the same for every request, rendered once: as a browser gets it, and as its data.
export type Fixed = { doc: String; data: String };

export function fixed<M>(shell: readonly Shell, route: str, url: str, title: str, description: str, state: str, view: () => void uses Ui<M>): Fixed {
  { doc: document(shell, route, url, title, description, state, view), data: arrival(route, url, title, description, state) }
}

// Answers for a page rendered once.
export function answerFixed(conn: mut Conn, req: readonly Request, f: readonly Fixed, cookies: readonly Vec<String>): void uses Io, Fail<IoErr> {
  let r = if (wantsData(req)) {
    Response.new(200, "text/plain; charset=utf-8", f.data.clone())
  } else {
    Response.new(200, "text/html; charset=utf-8", f.doc.clone())
  };
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.write(r);
}

// ---- pages kept for a while ----

// A page that exports `revalidate` is the same for every request for that many seconds after it is
// rendered, unless its `load` read the request — its headers or cookies — or set a cookie: then it
// is the request's own. What is kept is kept by address, its query too.
export type Kept = { page: Fixed; at: Instant; path: String };
export type Cache = Mutex<HashMap<String, Kept>>;

export function newCache(): Cache { Mutex.new(HashMap.new()) }

// The page kept for `url`, if it was rendered less than `secs` seconds before `now`.
export function kept(cache: readonly Cache, url: str, secs: u64, now: Instant): Option<Fixed> uses Io {
  const key = url.toString();
  cache.lock((c) => match (c.get(key)) {
    #Some(k) => if (now.since(k.at) < Duration.secs(secs)) { #Some(k.page.clone()) } else { #None },
    #None => #None,
  })
}

export function keep(cache: readonly Cache, url: str, path: str, page: Fixed, now: Instant): void uses Io {
  const key = url.toString();
  const k: Kept = { page, at: now, path: path.toString() };
  cache.lock((c) => { c.insert(key, k); });
}

// Answers with a page kept, or rendered to be: `X-Fly-Cache` says which, as a shared cache may keep
// it for `secs` seconds, unless the answer sets a cookie.
export function answerKept(conn: mut Conn, req: readonly Request, f: readonly Fixed, cookies: readonly Vec<String>, secs: u64, hit: bool): void uses Io, Fail<IoErr> {
  let r = if (wantsData(req)) {
    Response.new(200, "text/plain; charset=utf-8", f.data.clone())
  } else {
    Response.new(200, "text/html; charset=utf-8", f.doc.clone())
  };
  if (cookies.len() > 0) { r.header("Cache-Control", "no-store"); } else { r.header("Cache-Control", `public, max-age=0, s-maxage=${secs}`.asStr()); }
  r.header("X-Fly-Cache", if (hit) { "HIT" } else { "MISS" });
  setCookies(mut r, cookies);
  conn.write(r);
}

// Drops every page kept for `path`, at any query.
export function drop(cache: readonly Cache, path: str): void uses Io {
  const p = path.toString();
  cache.lock((c) => {
    let gone: Vec<String> = Vec.new();
    for (const [url, k] of c.entries()) { if (k.path == p) { gone.push(url.clone()); } }
    for (const url of gone) { c.remove(url); }
  });
}

// ---- the request ----

// The value of the request's cookie `name`, if it sent one.
export function cookieOf(req: readonly Request, name: str): Option<String> {
  const all = match (req.header("Cookie")) { #Some(c) => c, #None => return #None };
  for (const part of all.split(";")) {
    const p = part.asStr().trim();
    if (const #Some(eq) = p.indexOf("=") && p.slice(0, eq) == name) {
      return #Some(decode(p.slice(eq + 1, p.len()), false));
    }
  }
  #None
}

// A `Set-Cookie` header's value.
function cookie(name: str, value: str, maxAge: u32): String {
  let c = `${name}=${cookieValue(value)}; Path=/; HttpOnly; SameSite=Lax`;
  if (maxAge > 0) { c.push(`; Max-Age=${maxAge}`.asStr()); }
  c
}

// A cookie's value as a header may carry it: a byte no cookie value may hold, `%` among them, as
// `%XX`, so a value from a request cannot end the value and add attributes of its own.
function cookieValue(value: str): String {
  const digits = "0123456789ABCDEF".asBytes();
  let out: Vec<u8> = Vec.new();
  for (const b of value.asBytes()) {
    if (b > 0x20 && b < 0x7f && b != b'"' && b != b',' && b != b';' && b != b'\\' && b != b'%') { out.push(b); continue; }
    out.push(b'%');
    out.push(digits[(b >> 4) as usize]);
    out.push(digits[(b & 15) as usize]);
  }
  match (String.fromUtf8(out)) { #Some(t) => t, #None => value.toString() }
}

export function setCookies(r: mut Response, cookies: readonly Vec<String>): void {
  for (const c of cookies) { r.header("Set-Cookie", c.asStr()); }
}

// Runs `body` with `Http` answered from `req`: what it gives, or, if it sent the browser
// elsewhere, where; the cookies it sets added to `set`, and whether it read the request — a header
// or a cookie — in `read`. The pages it revalidates are dropped from `cache`.
export function withHttp<T, row E>(req: readonly Request, set: mut Vec<String>, read: mut bool, cache: readonly Cache, body: once () => T uses Http, ...E): Result<T, String> uses Io, ...E {
  handle { #Ok(body()) } with Http {
    header(name) resumes k => {
      read = true;
      k(match (req.header(name)) { #Some(v) => #Some(v.toString()), #None => #None })
    }
    cookie(name) resumes k => {
      read = true;
      k(cookieOf(req, name))
    }
    setCookie(name, value, maxAge) resumes k => {
      set.push(cookie(name, value, maxAge));
      k()
    }
    redirect(url) => #Err(url),
    revalidate(path) resumes k => {
      drop(cache, path);
      k()
    }
  }
}

// Sends the browser to `url`, with the cookies set on the way: a page's program following a link
// follows this too, to the data of the page at `url`.
export function redirect(conn: mut Conn, url: str, cookies: readonly Vec<String>): void uses Io, Fail<IoErr> {
  let r = Response.text(303, "");
  r.header("Location", url);
  r.header("Cache-Control", "no-store");
  setCookies(mut r, cookies);
  conn.write(r);
}

export function contentType(path: str): str {
  if (path.endsWith(".wasm")) { "application/wasm" }
  else if (path.endsWith(".js")) { "text/javascript" }
  else if (path.endsWith(".css")) { "text/css" }
  else if (path.endsWith(".html")) { "text/html; charset=utf-8" }
  else if (path.endsWith(".svg")) { "image/svg+xml" }
  else if (path.endsWith(".png")) { "image/png" }
  else if (path.endsWith(".jpg") || path.endsWith(".jpeg")) { "image/jpeg" }
  else if (path.endsWith(".ico")) { "image/x-icon" }
  else if (path.endsWith(".json")) { "application/json" }
  else if (path.endsWith(".txt")) { "text/plain; charset=utf-8" }
  else { "application/octet-stream" }
}

// Answers with the site's file at the request's path, under `dir`, if there is one. The program a
// build makes is named for it, so a browser may keep it as long as it likes; other files it checks.
export function file(conn: mut Conn, req: readonly Request, dir: str, cookies: readonly Vec<String>): bool uses Io, Fail<IoErr> {
  const path = req.path.asStr();
  if (path.includes("..") || path.endsWith("/")) { return false; }
  const found = try {
    let f = File.open(`${dir}${path}`.asStr());
    #Some(f.readBytes())
  } catch (_) { #None };
  match (found) {
    #Some(bytes) => {
      const cache = if (path.startsWith("/_fly/")) { "no-cache" } else { "public, max-age=300" };
      // A file answered with cookies is no one's to keep.
      const keep = if (cookies.len() > 0) { "no-store" } else { cache };
      conn.writeFile(contentType(path), keep, cookies, bytes);
      true
    }
    #None => false,
  }
}

// ---- strangling ----

// A page of the site's asked for by Next.js's client router, following a link from a page of the app
// the site is replacing (`RSC: 1`): answered with nothing, which that router takes to mean the page
// is not its own, and loads as a browser does. Its prefetches cost no page's `load` either.
export function forNextsRouter(req: readonly Request): bool { req.header("rsc").isSome() }

export function notNexts(conn: mut Conn): void uses Io, Fail<IoErr> {
  let r = Response.new(204, "text/plain", String.new());
  r.header("Cache-Control", "no-store");
  conn.write(r);
}

// The app a site is replacing a route at a time, which answers what no route of the site does: its
// server's host and port, as `--upstream=http://host:port` names it.
export type Upstream = { host: String; port: u16 };

// The upstream the server's arguments name, if they name one.
export function upstreamIn(args: readonly String[]): Option<Upstream> {
  for (const a of args) {
    if (!a.asStr().startsWith("--upstream=")) { continue; }
    let rest = a.asStr().slice(11, a.len());
    if (rest.startsWith("http://")) { rest = rest.slice(7, rest.len()); }
    if (const #Some(slash) = rest.indexOf("/")) { rest = rest.slice(0, slash); }
    return match (rest.lastIndexOf(":")) {
      #Some(c) => match (parseInt(rest.slice(c + 1, rest.len()))) {
        #Some(p) => #Some({ host: rest.slice(0, c).toString(), port: p as u16 }),
        #None => #None,
      },
      #None => #Some({ host: rest.toString(), port: 80 }),
    };
  }
  #None
}

// A request no route of the site answers, answered by the app the site is replacing: forwarded as
// it came, saying where it came to, and its answer relayed, with the cookies the site set.
export function upstream(conn: mut Conn, req: readonly Request, up: readonly Upstream, cookies: readonly Vec<String>): void uses Io, Fail<IoErr> {
  let extra: Vec<Header> = Vec.new();
  if (const #Some(h) = req.header("host") && req.header("x-forwarded-host").isNone()) { extra.push({ name: "X-Forwarded-Host".toString(), value: h.toString() }); }
  if (req.header("x-forwarded-proto").isNone()) { extra.push({ name: "X-Forwarded-Proto".toString(), value: "http".toString() }); }
  forward(mut conn, req, up.host.asStr(), up.port, extra, cookies);
}

// ---- forms, without the page's program ----

// A form's fields, as it posts them: `name=value&…`, each decoded.
export function fields(body: str): Vec<[String, String]> {
  let out: Vec<[String, String]> = Vec.new();
  for (const part of body.split("&")) {
    if (part.len() == 0) { continue; }
    match (part.asStr().indexOf("=")) {
      #Some(eq) => out.push([decode(part.asStr().slice(0, eq), true), decode(part.asStr().slice(eq + 1, part.len()), true)]),
      #None => out.push([decode(part.asStr(), true), String.new()]),
    }
  }
  out
}

// What posted the form: the number of the message it gives, from its address's `?_fly=`.
export function postedMessage(req: readonly Request): Option<usize> {
  for (const part of req.query.split("&")) {
    if (part.asStr().startsWith("_fly=")) {
      return match (parseInt(part.asStr().slice(5, part.len()))) { #Some(n) => #Some(n as usize), #None => #None };
    }
  }
  #None
}

// A form posted from a page the page's program has not taken over: `update` given, as the page's
// program would have given it, each input's message with the text the form posted for it, then
// the message `k` the form's submission, or the button's click, gives — the messages as the page
// rendered from `m` numbers them. What the update performs is the server's to handle, as it is
// around a page's `load`. Where the page goes then: where the update sends it, or back to `url`,
// so that loading it again does not post the form again.
export function submitted<Model, M extends Send & Clone, row E>(m: Model, k: usize, posted: readonly Vec<[String, String]>, url: str, view: (m: readonly Model) => void uses Ui<M>, update: (m: mut Model, msg: M, ev: readonly Event) => void uses Page<Model>, ...E): String uses ...E {
  let model = m;
  const msgs = messages(() => view(model));
  let to = url.toString();
  handle {
    for (const [name, value] of posted) {
      if (!name.startsWith("_fly_")) { continue; }
      if (const #Some(j) = parseInt(name.asStr().slice(5, name.len())) && (j as usize) < msgs.len()) {
        update(mut model, msgs[j as usize].clone(), { text: value.clone(), key: String.new(), checked: true });
      }
    }
    if (k < msgs.len()) { update(mut model, msgs[k].clone(), { text: String.new(), key: String.new(), checked: false }); }
  } with Page<Model> {
    show(_) resumes k => k(),
    go(u) resumes k => {
      to = u.toString();
      k()
    }
  };
  to
}
