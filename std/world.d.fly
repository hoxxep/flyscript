// Services only a simulated world provides (§6.4): a database of profiles and quotas, which the
// world describes, for examples and tests.
export struct Db;

export type Profile = { displayName: String };
export type Quota = { allowed: bool };

impl Db {
  export function connect(): Db uses Io, Fail<IoErr>;
  // `#NotFound` for a user the world does not know.
  export function fetchProfile(self: readonly Self, user: str): Profile uses Io, Fail<IoErr>;
  export function checkQuota(self: readonly Self, token: str): Quota uses Io, Fail<IoErr>;
}
