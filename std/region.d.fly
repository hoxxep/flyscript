// Mutable slots in an append-only region (§4.6). `Cell` and `RegionList` are handles into their
// region, `Copy` like a `Ref`; their writes are `Region<R>` operations: mutation by effect, not
// by ownership.

export struct Cell<region R, T extends Copy>;
export struct RegionList<region R, T>;

impl<region R, T extends Copy> Cell<R, T> {
  export function new(v: T): Cell<R, T> uses Region<R>;
  export function get(self: Self): T uses Region<R>;
  export function set(self: Self, v: T): void uses Region<R>;
}

impl<region R, T> RegionList<R, T> {
  export function new(): RegionList<R, T> uses Region<R>;
  export function push(self: Self, v: T): void uses Region<R>;
  export function len(self: Self): usize;
}

impl<region R, T> Iterable<readonly T> for RegionList<R, T> {
  function each(self: readonly Self): void uses Yield<readonly T>;
}

// Handles are `Copy`, so cloning one copies it: a `Vec<Ref<T>>` clones like any other.
impl<region R, T extends Copy> Clone for Cell<R, T> { function clone(self: readonly Self): Self; }
impl<region R, T> Clone for RegionList<R, T> { function clone(self: readonly Self): Self; }
