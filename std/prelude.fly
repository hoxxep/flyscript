// The prelude: in scope in every module without an import.

// ---- Marker interfaces (§4.4) ----
// Copy, Send and LentBy are satisfied structurally by the compiler.
export interface Copy {}
export interface Send {}
// `Q extends LentBy<K>` holds when K is Q or K lends Q (String lends str, Vec<T> lends T[]).
export interface LentBy<K> {}
export interface Drop { function drop(self: mut Self): void; }

// ---- Derived interfaces (§3.5) ----
// Each is derived below, in Flyscript, for every type that belongs to no module and for structs
// and enums that ask (`impl Eq for Point;`). `==` and `!=` call `Eq.eq` on anything but a
// primitive, and `${e}` writes anything but a primitive or string with `Show`.
export interface Eq { function eq(self: readonly Self, other: readonly Self): bool; }
export interface Hash { function hash(self: readonly Self, h: mut Hasher): void; }
// Writes the value as Flyscript would write it: strings quoted, `Point { x: 1, y: 2 }`, `#Some(3)`.
export interface Show { function show(self: readonly Self, out: mut String): void; }
export interface Clone { function clone(self: readonly Self): Self; }
// A total order: `<`, `<=`, `>` and `>=` call `cmp` on anything but a primitive. Derived, it
// orders by fields in declaration order, then by tags in declaration order.
export interface Ord extends Eq { function cmp(self: readonly Self, other: readonly Self): Ordering; }
export type Ordering = #Less | #Equal | #Greater;

// The rest of a handled computation, given to a resumptive arm (§5.3): called once, `k(a)`, to
// resume it, which may perform `E`, what its `handle` performs. It is bound to its task, so it is
// not `Send`, and it may hold borrows, so it is a view.
export view struct Cont<A, B, row E = []>;

export struct Hasher;
impl Hasher {
  export function new(): Hasher;
  export function writeInt(self: mut Self, v: i64): void;
  export function writeFloat(self: mut Self, v: f64): void;
  export function writeBool(self: mut Self, v: bool): void;
  export function writeStr(self: mut Self, s: str): void;
  export function finish(self: readonly Self): u64;
}

impl<comptime T: Type> Eq for T {
  function eq(self: readonly Self, other: readonly Self): bool {
    comptime match (Type.info(T)) {
      #Int(_) | #Bool | #Str | #Void => self == other,
      // A total equality: `NaN` equals itself, and `-0.0` equals `0.0`, as `Hash` agrees.
      #Float(_) => self == other || self != self && other != other,
      #Record(fields) | #Struct { fields } => {
        comptime for (const f of fields) {
          if (!self.[f.name].eq(other.[f.name])) { return false; }
        }
        true
      }
      #Tuple(items) => {
        comptime for (const [i, _] of items.enumerate()) {
          if (!self[i].eq(other[i])) { return false; }
        }
        true
      }
      #Array(_) | #Slice(_) => {
        if (self.len() != other.len()) { return false; }
        let i: usize = 0;
        while (i < self.len()) {
          if (!self[i].eq(other[i])) { return false; }
          i += 1;
        }
        true
      }
      #Union(tags) | #Enum { tags } => match ([self, other]) {
        comptime for (const t of tags) {
          comptime match (t.payload) {
            #Some(_) => { [#[t.name](a), #[t.name](b)] => a.eq(b), }
            #None => { [#[t.name], #[t.name]] => true, }
          }
        }
        _ => false,
      },
      _ => comptime panic(`${Type.name(T)} cannot be compared`),
    }
  }
}

impl<comptime T: Type> Hash for T {
  function hash(self: readonly Self, h: mut Hasher): void {
    comptime match (Type.info(T)) {
      #Int(_) => h.writeInt(self as i64),
      #Float(_) => h.writeFloat(self as f64),
      #Bool => h.writeBool(self),
      #Str => h.writeStr(self),
      #Void => {}
      #Record(fields) | #Struct { fields } => {
        comptime for (const f of fields) { self.[f.name].hash(mut h); }
      }
      #Tuple(items) => {
        comptime for (const [i, _] of items.enumerate()) { self[i].hash(mut h); }
      }
      #Array(_) | #Slice(_) => {
        h.writeInt(self.len() as i64);
        let i: usize = 0;
        while (i < self.len()) {
          self[i].hash(mut h);
          i += 1;
        }
      }
      #Union(tags) | #Enum { tags } => match (self) {
        comptime for (const [i, t] of tags.enumerate()) {
          comptime match (t.payload) {
            #Some(_) => { #[t.name](x) => { h.writeInt(comptime i); x.hash(mut h); }, }
            #None => { #[t.name] => h.writeInt(comptime i), }
          }
        }
      },
      _ => comptime panic(`${Type.name(T)} cannot be hashed`),
    }
  }
}

impl<comptime T: Type> Ord for T {
  function cmp(self: readonly Self, other: readonly Self): Ordering {
    comptime match (Type.info(T)) {
      #Int(_) | #Bool | #Str => if (self < other) { #Less } else if (self == other) { #Equal } else { #Greater },
      // A total order: `NaN` after every number, and equal to itself.
      #Float(_) => {
        if (self != self) { if (other != other) { #Equal } else { #Greater } }
        else if (other != other) { #Less }
        else if (self < other) { #Less } else if (self == other) { #Equal } else { #Greater }
      }
      #Void => #Equal,
      #Record(fields) | #Struct { fields } => {
        comptime for (const f of fields) {
          const c = self.[f.name].cmp(other.[f.name]);
          if (c != #Equal) { return c; }
        }
        #Equal
      }
      #Tuple(items) => {
        comptime for (const [i, _] of items.enumerate()) {
          const c = self[i].cmp(other[i]);
          if (c != #Equal) { return c; }
        }
        #Equal
      }
      #Array(_) | #Slice(_) => {
        let i: usize = 0;
        while (i < self.len() && i < other.len()) {
          const c = self[i].cmp(other[i]);
          if (c != #Equal) { return c; }
          i += 1;
        }
        self.len().cmp(other.len())
      }
      #Union(tags) | #Enum { tags } => match ([self, other]) {
        comptime for (const t of tags) {
          comptime match (t.payload) {
            #Some(_) => { [#[t.name](a), #[t.name](b)] => a.cmp(b), }
            #None => { [#[t.name], #[t.name]] => #Equal, }
          }
        }
        _ => if (tagIndex(self) < tagIndex(other)) { #Less } else { #Greater },
      },
      _ => comptime panic(`${Type.name(T)} cannot be ordered`),
    }
  }
}

// The position of a value's tag among its type's tags, in declaration order.
function tagIndex<comptime T: Type>(v: readonly T): usize {
  comptime match (Type.info(T)) {
    #Union(tags) | #Enum { tags } => match (v) {
      comptime for (const [i, t] of tags.enumerate()) {
        comptime match (t.payload) {
          #Some(_) => { #[t.name](_) => comptime i, }
          #None => { #[t.name] => comptime i, }
        }
      }
    },
    _ => 0,
  }
}

export function min<T extends Ord>(a: T, b: T): T { if (b < a) { b } else { a } }
export function max<T extends Ord>(a: T, b: T): T { if (b > a) { b } else { a } }

impl Ord for String {
  function cmp(self: readonly Self, other: readonly Self): Ordering { self.asStr().cmp(other.asStr()) }
}

// Writes a string as a quoted literal.
export function writeQuoted(s: str, out: mut String): void {
  const bytes = s.asBytes();
  out.push("\"");
  let start: usize = 0;
  let i: usize = 0;
  while (i < bytes.len()) {
    const b = bytes[i];
    const esc = match (b) { b'"' => "\\\"", b'\\' => "\\\\", b'\n' => "\\n", b'\t' => "\\t", b'\r' => "\\r", _ => "" };
    if (esc.len() > 0) {
      out.push(s.slice(start, i));
      out.push(esc);
      start = i + 1;
    }
    i += 1;
  }
  out.push(s.slice(start, bytes.len()));
  out.push("\"");
}

impl<comptime T: Type> Show for T {
  function show(self: readonly Self, out: mut String): void {
    comptime match (Type.info(T)) {
      #Int(_) | #Float(_) | #Bool => out.push(`${self}`),
      #Str => writeQuoted(self, mut out),
      #Void => out.push("void"),
      #Record(fields) | #Struct { fields } => {
        comptime match (Type.info(T)) {
          #Struct { name } => { out.push(comptime name); out.push(" "); }
          _ => {}
        }
        out.push("{");
        comptime for (const [i, f] of fields.enumerate()) {
          out.push(comptime if (i == 0) { " " } else { ", " });
          out.push(comptime f.name);
          out.push(": ");
          self.[f.name].show(mut out);
        }
        out.push(" }");
      }
      #Tuple(items) => {
        out.push("[");
        comptime for (const [i, _] of items.enumerate()) {
          comptime if (i > 0) { out.push(", "); }
          self[i].show(mut out);
        }
        out.push("]");
      }
      #Array(_) | #Slice(_) => {
        out.push("[");
        let i: usize = 0;
        while (i < self.len()) {
          if (i > 0) { out.push(", "); }
          self[i].show(mut out);
          i += 1;
        }
        out.push("]");
      }
      #Union(tags) | #Enum { tags } => match (self) {
        comptime for (const t of tags) {
          comptime match (t.payload) {
            #Some(_) => {
              #[t.name](x) => {
                out.push(comptime `#${t.name}(`);
                x.show(mut out);
                out.push(")");
              },
            }
            #None => { #[t.name] => out.push(comptime `#${t.name}`), }
          }
        }
      },
      #Fn => out.push("<function>"),
      _ => out.push(comptime `<${Type.name(T)}>`),
    }
  }
}

impl<comptime T: Type> Clone for T {
  function clone(self: readonly Self): T {
    comptime match (Type.info(T)) {
      #Int(_) | #Float(_) | #Bool | #Str | #Void => self,
      // A `readonly` borrow is copied; a `mut` one is never duplicated.
      #Borrow { mutable: false } => self,
      #Borrow { mutable: true } => comptime panic("a `mut` borrow cannot be cloned"),
      #Record(fields) | #Struct { fields } => {
        { comptime for (const f of fields) { [f.name]: self.[f.name].clone(), } }
      }
      #Tuple(items) => {
        const v: T = [comptime for (const [i, _] of items.enumerate()) { self[i].clone() }];
        v
      }
      #Union(tags) | #Enum { tags } => match (self) {
        comptime for (const t of tags) {
          comptime match (t.payload) {
            #Some(_) => { #[t.name](x) => #[t.name](x.clone()), }
            #None => { #[t.name] => #[t.name], }
          }
        }
      },
      _ => comptime panic(`${Type.name(T)} cannot be cloned`),
    }
  }
}

// ---- Tag-union aliases (§3.2) ----
export type Option<T> = #Some(T) | #None;
export type Result<T, E> = #Ok(T) | #Err(E);

impl<T> Option<T> {
  export function isSome(self: readonly Self): bool;
  export function isNone(self: readonly Self): bool { !self.isSome() }
  export function take(self: mut Self): Option<T>;
  export function unwrapOr(self: Self, fallback: T): T;
  // The value transformed, if there is one: TypeScript's `x === undefined ? undefined : f(x)`.
  export function map<U, row E>(self: Self, f: once (v: T) => U uses ...E): Option<U> uses ...E {
    match (self) { #Some(v) => #Some(f(v)), #None => #None }
  }
  // The value, which must be there: `#None` is a bug, and panics (§5.7).
  export function unwrap(self: Self): T {
    match (self) { #Some(v) => v, #None => panic("unwrap of #None") }
  }
}
impl<T extends Clone> Option<readonly T> {
  export function cloned(self: Self): Option<T>;
}
impl<T, E> Result<T, E> {
  // The value, or the `#Err` payload thrown (§5.4).
  export function unwrap(self: Self): T uses Fail<E>;
  export function isOk(self: readonly Self): bool { match (self) { #Ok(_) => true, #Err(_) => false } }
  export function isErr(self: readonly Self): bool { !self.isOk() }
}

// A bug: unwinds the task, running cleanup, and fails its scope; nothing handles it (§5.7).
export function panic(message: str): never;

// ---- The standard effects (§5.1) ----
export effect Fail<E> { raise(err: E): never; }
export effect Yield<T> { yield(item: T): void; }
export effect Region<region R> {}
export effect Io {
  // A descriptor's bytes: as many as are there, at most `buf.len()`, waiting for one, `0` at the
  // end; and some of `buf` written, how many.
  read(fd: Fd, buf: mut u8[]): Result<usize, IoErr>;
  write(fd: Fd, buf: readonly u8[]): Result<usize, IoErr>;
  // A file opened (std/io): `mode` 0 to read, 1 to write it anew, made if need be, 2 to write at
  // its end, made if need be; and a descriptor closed.
  open(path: str, mode: u8): Result<Fd, IoErr>;
  close(fd: Fd): void;
  now(): Instant;
  sleep(d: Duration): void;
  // The primitive under locks, channels and `join`.
  park(on: WaitKey): void;
  // The file system (std/fs): what is at a path, a directory's entries, in order, and changing them.
  stat(path: str): Result<Stat, IoErr>;
  list(path: str): Result<Vec<String>, IoErr>;
  mkdir(path: str): Result<void, IoErr>;
  remove(path: str): Result<void, IoErr>;
  rename(from: str, to: str): Result<void, IoErr>;
  // The process (std/process): a variable of its environment, its working directory, and running
  // another program to its end, given what it reads and giving what it wrote.
  env(name: str): Option<String>;
  cwd(): String;
  run(program: str, args: readonly String[], input: str): Result<Output, IoErr>;
  // The time of day: nanoseconds since 1970 began, in UTC.
  wall(): i64;
  // `buf` filled from the system's cryptographically secure generator: keys, nonces, tokens.
  random(buf: mut u8[]): void;
}

// What is at a path: its size in bytes, whether it is a directory, and when it last changed, in
// nanoseconds since 1970 began.
export type Stat = { size: u64; dir: bool; modified: i64 };
// What a program that was run did: the status it ended with, and what it wrote to its standard
// output and its standard error.
export type Output = { status: i32; out: String; err: String };

// ---- Floats: the arithmetic of the C library's <math.h>, and fixed-point text ----
impl f64 {
  export function sqrt(self: Self): Self;
  export function abs(self: Self): Self;
  export function floor(self: Self): Self;
  export function ceil(self: Self): Self;
  // To the nearest whole number, halves away from zero.
  export function round(self: Self): Self;
  export function trunc(self: Self): Self;
  export function sin(self: Self): Self;
  export function cos(self: Self): Self;
  export function tan(self: Self): Self;
  // The angle of the point (x, self), from -π to π.
  export function atan2(self: Self, x: Self): Self;
  export function exp(self: Self): Self;
  // The natural logarithm.
  export function ln(self: Self): Self;
  export function pow(self: Self, e: Self): Self;
  export function min(self: Self, other: Self): Self;
  export function max(self: Self, other: Self): Self;
  // The number written with `digits` digits after the point, rounded: `(2.0 / 3.0).toFixed(3)` is "0.667".
  export function toFixed(self: Self, digits: u32): String;
}
impl f32 {
  export function sqrt(self: Self): Self;
  export function abs(self: Self): Self;
  export function floor(self: Self): Self;
  export function ceil(self: Self): Self;
  // To the nearest whole number, halves away from zero.
  export function round(self: Self): Self;
  export function trunc(self: Self): Self;
  export function sin(self: Self): Self;
  export function cos(self: Self): Self;
  export function tan(self: Self): Self;
  // The angle of the point (x, self), from -π to π.
  export function atan2(self: Self, x: Self): Self;
  export function exp(self: Self): Self;
  // The natural logarithm.
  export function ln(self: Self): Self;
  export function pow(self: Self, e: Self): Self;
  export function min(self: Self, other: Self): Self;
  export function max(self: Self, other: Self): Self;
  // The number written with `digits` digits after the point, rounded: `(2.0 / 3.0).toFixed(3)` is "0.667".
  export function toFixed(self: Self, digits: u32): String;
}

// ---- Integers: arithmetic that wraps instead of panicking on overflow (§5.7) ----
impl i8 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl i16 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl i32 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl i128 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl i64 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl isize { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl u8 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl u16 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl u32 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl u64 { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }
impl usize { export function wrappingAdd(self: Self, b: Self): Self; export function wrappingSub(self: Self, b: Self): Self; export function wrappingMul(self: Self, b: Self): Self; }

// A span of time: `Io.sleep(Duration.ms(250))`.
export struct Duration { private nanos: u64 }
impl Duration {
  export function nanos(n: u64): Duration { Duration { nanos: n } }
  export function ms(n: u64): Duration { Duration { nanos: n * 1000000 } }
  export function secs(n: u64): Duration { Duration { nanos: n * 1000000000 } }
  export function toMs(self: readonly Self): u64 { self.nanos / 1000000 }
  export function toNanos(self: readonly Self): u64 { self.nanos }
}
impl Eq for Duration;
impl Ord for Duration;
impl Show for Duration;
// A point in time, as `Io.now()` reads it: only differences between two mean anything.
export struct Instant { private nanos: u64 }
impl Instant {
  export function since(self: readonly Self, earlier: readonly Instant): Duration { Duration.nanos(self.nanos - earlier.nanos) }
}
impl Eq for Instant;
impl Ord for Instant;
// A file descriptor, and what a parked task waits on: handles the runtime gives out.
export struct Fd { private n: u32 }
impl Copy for Fd;

impl Fd {
  export function stdin(): Fd { Fd { n: 0 } }
  export function stdout(): Fd { Fd { n: 1 } }
  export function stderr(): Fd { Fd { n: 2 } }
  // Lets go of a descriptor without saying whether closing it went well, as a destructor may:
  // what a dropped file does.
  export function release(self: Self): void;
}
export struct WaitKey { private n: u64 }
// What can go wrong with I/O. `#Exists`: a path that is already there; `#NotEmpty`: a directory
// removed with entries in it; `#Unsupported`: what the host cannot do, as a page cannot run programs.
export type IoErr = #Reset | #TimedOut | #BrokenPipe | #NotFound | #PermissionDenied | #AddrInUse | #Refused | #Exists | #NotEmpty | #Unsupported | #Untrusted;

impl<E> Fail<E> {
  export function capture<T, row R>(body: once () => T uses Fail<E>, ...R): Result<T, E> uses ...R;
  // Wraps one call's failures (§5.4): `Fail.map(() => fetch(u), (e) => #Http(e))`.
  export function map<T, F, row R>(body: once () => T uses Fail<E>, ...R, wrap: once (e: E) => F): T uses Fail<F>, ...R;
}

// ---- Reflection (§7.2): what `Type.info` tells `comptime` code about a type ----
export type Field = { name: str; type: Type };
// A tag's payload: the one type of `#A(T)`, the tuple or record of a larger payload, or none.
export type TagInfo = { name: str; payload: Option<Type> };
export type TypeInfo =
  | #Int { signed: bool; bits: u8 } | #Float(u8) | #Bool | #Str | #Void | #Fn
  | #Record(Field[]) | #Tuple(Type[]) | #Union(TagInfo[])
  | #Struct { name: str; fields: Field[] } | #Enum { name: str; tags: TagInfo[] }
  | #Array { item: Type; len: usize } | #Slice(Type) | #Borrow { mutable: bool; type: Type }
  | #Opaque { name: str; args: Type[] };

// ---- Iteration (§5.5): generators, pull iteration and iteration chains ----
export view struct Gen<T, row E>;

export function generate<T, row E>(producer: once () => void uses Yield<T>, ...E): Gen<T, E>;

impl<T, row E> Gen<T, E> {
  export function next(self: mut Self): Option<T> uses ...E;
  export function map<U>(self: Self, f: mut (x: T) => U uses ...E): Gen<U, E>;
  export function filter(self: Self, keep: mut (x: readonly T) => bool uses ...E): Gen<T, E>;
  export function take(self: Self, n: usize): Gen<T, E>;
  export function zip<U>(self: Self, other: Gen<U, E>): Gen<[T, U], E>;
  export function enumerate(self: Self): Gen<[usize, T], E>;
  export function collect(self: Self): Vec<T> uses ...E;
  // The first item `test` accepts, if any; the rest are not produced.
  // What it finds is one of the generator's items: it borrows what they do, not the test.
  export function find(self: Self, test: mut (x: readonly T) => bool uses ...E): Option<T> from self uses ...E {
    for (const x of self) { if (test(x)) { return #Some(x); } }
    #None
  }
  // The position of the first item `test` accepts: TypeScript's `findIndex`, without the `-1`.
  export function findIndex(self: Self, test: mut (x: readonly T) => bool uses ...E): Option<usize> uses ...E {
    let i: usize = 0;
    for (const x of self) {
      if (test(x)) { return #Some(i); }
      i += 1;
    }
    #None
  }
  export function some(self: Self, test: mut (x: readonly T) => bool uses ...E): bool uses ...E {
    for (const x of self) { if (test(x)) { return true; } }
    false
  }
  export function every(self: Self, test: mut (x: readonly T) => bool uses ...E): bool uses ...E {
    for (const x of self) { if (!test(x)) { return false; } }
    true
  }
  // Folds the items into one value, as TypeScript's `reduce` with an initial value.
  export function reduce<A>(self: Self, f: mut (acc: A, x: T) => A uses ...E, init: A): A uses ...E {
    let acc = init;
    for (const x of self) { acc = f(acc, x); }
    acc
  }
}
impl<T extends Show, row E> Gen<T, E> {
  // Each item shown, with `sep` between them, strings as they are: `ps.iter().map(show).join(", ")`.
  export function join(self: Self, sep: str): String uses ...E {
    let out = String.new();
    let first = true;
    for (const x of self) {
      if (!first) { out.push(sep); }
      out.push(`${x}`);
      first = false;
    }
    out
  }
}
impl<T extends Clone, row E> Gen<readonly T, E> {
  // Owned copies of borrowed items: `map.keys().cloned().collect()` is a `Vec<String>`.
  export function cloned(self: Self): Gen<T, E> { self.map((x) => x.clone()) }
}

// Dropping a generator before it finishes unwinds it, running its cleanup (§5.5).
impl<T, row E> Drop for Gen<T, E> {
  function drop(self: mut Self): void;
}
impl<T, row E> Iterable<T, E> for Gen<T, E> {
  function each(self: readonly Self): void uses Yield<T>, ...E;
}

export interface Iterable<T, row E = []> {
  function each(self: readonly Self): void uses Yield<T>, ...E;
}

// ---- Structured concurrency (§6.1): library code over the scheduler and Io.park ----
// A task runs on a new fiber, where only `Io` and its scope's capture of failures are handled.
export struct Scope<X>;
export struct Fiber<T>;
impl Io {
  // The body, like its tasks, performs only `Io` and failures: an outer region is frozen while tasks run (§6.1).
  export function scope<T, X>(body: once (s: mut Scope<X>) => T uses Io, Fail<X>): T uses Io, Fail<X>;
}
impl<X> Scope<X> {
  // Starting a task is a scheduling point (§6.4).
  export function spawn(self: mut Self, task: once () => void uses Io): void uses Io;
  export function fork<T extends Send>(self: mut Self, task: once () => T uses Io, Fail<X>): Fiber<T> uses Io;
}
impl<T> Fiber<T> {
  export function join(self: Self): T uses Io;
}

// ---- Owned containers and strings (§3.1) ----
export struct String;
export struct Vec<T>;
export struct Box<T>;
export struct Arc<T extends Send>;

impl String {
  export function new(): String;
  export function len(self: readonly Self): usize;
  export function push(self: mut Self, s: str): void;
  // Room for `n` more bytes, so pushing them allocates nothing; or `#OutOfMemory`.
  export function tryReserve(self: mut Self, n: usize): void uses Fail<#OutOfMemory>;
  export function asStr(self: readonly Self): str from self;
  // The string these bytes spell, if they are UTF-8.
  export function fromUtf8(bytes: Vec<u8>): Option<String>;
  // The bytes as text, each maximal part of them that begins no UTF-8 sequence U+FFFD.
  export function fromUtf8Lossy(bytes: Vec<u8>): String;
}
impl str {
  // Bytes `lo` to `hi`, which must fall on character boundaries.
  export function slice(self: Self, lo: usize, hi: usize): str from self;
  export function len(self: Self): usize;
  export function toString(self: Self): String;
  export function bytes(self: Self): void uses Yield<u8>;
  export function asBytes(self: Self): readonly u8[] from self;
  export function splitWhitespace(self: Self): void uses Yield<str>;
  // Each line, without its line ending.
  export function lines(self: Self): void uses Yield<str>;
  // TypeScript's string methods. `split` gives owned pieces, which a `Vec` can hold; iterate
  // `splitWhitespace` to borrow them instead.
  export function split(self: Self, sep: str): Vec<String>;
  export function trim(self: Self): str from self;
  export function includes(self: Self, needle: str): bool;
  export function startsWith(self: Self, prefix: str): bool;
  export function endsWith(self: Self, suffix: str): bool;
  export function indexOf(self: Self, needle: str): Option<usize>;
  // ASCII letters changed, every other character as it is.
  export function toUpperCase(self: Self): String;
  export function toLowerCase(self: Self): String;
  export function replaceAll(self: Self, from: str, to: str): String;
  // `padStart` and `padEnd` pad with spaces to `width` characters (not bytes).
  export function padStart(self: Self, width: usize): String {
    let out = String.new();
    let n = charsIn(self);
    while (n < width) { out.push(" "); n += 1; }
    out.push(self);
    out
  }
  export function padEnd(self: Self, width: usize): String {
    let out = self.toString();
    let n = charsIn(self);
    while (n < width) { out.push(" "); n += 1; }
    out
  }
  export function repeat(self: Self, n: usize): String {
    let out = String.new();
    for (const _ of 0..n) { out.push(self); }
    out
  }
  export function trimStart(self: Self): str from self {
    const b = self.asBytes();
    let i: usize = 0;
    while (i < b.len() && isSpace(b[i])) { i += 1; }
    self.slice(i, b.len())
  }
  export function trimEnd(self: Self): str from self {
    const b = self.asBytes();
    let n = b.len();
    while (n > 0 && isSpace(b[n - 1])) { n -= 1; }
    self.slice(0, n)
  }
  // Where `needle` last starts, if anywhere.
  export function lastIndexOf(self: Self, needle: str): Option<usize> {
    const n = needle.len();
    if (n > self.len()) { return #None; }
    let i = self.len() - n + 1;
    while (i > 0) {
      i -= 1;
      if (self.asBytes()[i..i + n] == needle.asBytes()) { return #Some(i); }
    }
    #None
  }
}

// The characters of a string: its bytes that start one, in UTF-8.
function charsIn(s: str): usize {
  let n: usize = 0;
  for (const b of s.bytes()) { if ((b & 0xc0) != 0x80) { n += 1; } }
  n
}

function isSpace(b: u8): bool { b == b' ' || b == b'\t' || b == b'\n' || b == b'\r' }
impl<T> T[] {
  export function len(self: readonly Self): usize;
  export function iter<row E>(self: readonly Self): Gen<readonly T, E>;
  // Each element, lent `mut`: `for (const x of xs.iterMut()) { x += 1; }` updates `xs`.
  export function iterMut<row E>(self: mut Self): Gen<mut T, E> from self;
  // Two disjoint slices, before and after element `at`.
  export function splitAt(self: mut Self, at: usize): [mut T[], mut T[]] from self;
  // Sorts in place by `cmp`, stably: elements `cmp` calls equal keep their order.
  export function sortBy(self: mut Self, cmp: mut (a: readonly T, b: readonly T) => Ordering): void;
  export function reverse(self: mut Self): void;
  // Exchanges elements `i` and `j`: the two places are proved apart by splitting the list
  // between them, as `[a[i], a[j]] = [a[j], a[i]]` does in TypeScript.
  export function swap(self: mut Self, i: usize, j: usize): void {
    if (i == j) { return; }
    const [lo, hi] = if (i < j) { [i, j] } else { [j, i] };
    const [a, b] = self.splitAt(hi);
    swap(mut a[lo], mut b[0]);
  }
  // The element at `i`, if there is one.
  export function get(self: readonly Self, i: usize): Option<readonly T> from self {
    if (i < self.len()) { #Some(self[i]) } else { #None }
  }
  export function first(self: readonly Self): Option<readonly T> from self {
    if (self.len() == 0) { #None } else { #Some(self[0]) }
  }
  export function last(self: readonly Self): Option<readonly T> from self {
    if (self.len() == 0) { #None } else { #Some(self[self.len() - 1]) }
  }
}
impl<T extends Ord> T[] {
  export function sort(self: mut Self): void { self.sortBy((a, b) => a.cmp(b)) }
}
impl<T extends Eq> T[] {
  export function includes(self: readonly Self, x: readonly T): bool {
    for (const y of self) { if (y == x) { return true; } }
    false
  }
  export function indexOf(self: readonly Self, x: readonly T): Option<usize> {
    let i: usize = 0;
    for (const y of self) {
      if (y == x) { return #Some(i); }
      i += 1;
    }
    #None
  }
}
impl<T extends Copy> T[] {
  // `src`'s elements in place of these, which panics unless there are as many.
  export function copyFrom(self: mut Self, src: readonly T[]): void;
}
impl<T extends Show> T[] {
  // Each element shown, with `sep` between them: `["a", "b"].join(", ")` is `"a, b"`.
  export function join(self: readonly Self, sep: str): String {
    let out = String.new();
    let first = true;
    for (const x of self) {
      if (!first) { out.push(sep); }
      out.push(`${x}`);
      first = false;
    }
    out
  }
}
impl<T extends Copy> Vec<T> {
  // A copy of each of `items`, pushed in order: amortized O(items.len()).
  export function extend(self: mut Self, items: readonly T[]): void;
}
impl<T> Iterable<readonly T> for T[] {
  function each(self: readonly Self): void uses Yield<readonly T>;
}
impl<T> Vec<T> {
  export function new(): Vec<T>;
  export function push(self: mut Self, v: T): void;
  // Room for `n` more elements, so pushing them allocates nothing; or `#OutOfMemory`.
  export function tryReserve(self: mut Self, n: usize): void uses Fail<#OutOfMemory>;
  export function pop(self: mut Self): Option<T>;
  // The element at `i`, taken out; those after it move down. Out of bounds panics.
  export function remove(self: mut Self, i: usize): T;
  export function insert(self: mut Self, i: usize, v: T): void;
  // Keeps the elements `keep` accepts, in order: TypeScript's `xs = xs.filter(keep)`, in place.
  export function retain(self: mut Self, keep: mut (x: readonly T) => bool): void;
  // Keeps the first `n` elements, dropping the rest; a vector no longer than `n` is unchanged.
  export function truncate(self: mut Self, n: usize): void;
  // Takes every element out, in order, leaving the vector empty: `for (const f of fibers.drain())`.
  export function drain<row E>(self: mut Self): Gen<T, E>;
  export function len(self: readonly Self): usize;
  // A generator that performs nothing may be given any row, so its consumers' closures may
  // perform what they need: `xs.iter().some((x) => check(x))` where `check` uses `Region<R>`.
  export function iter<row E>(self: readonly Self): Gen<readonly T, E>;
  export function iterMut<row E>(self: mut Self): Gen<mut T, E> from self;
}
impl Eq for String {
  function eq(self: readonly Self, other: readonly Self): bool { self.asStr() == other.asStr() }
}
impl Hash for String {
  function hash(self: readonly Self, h: mut Hasher): void { h.writeStr(self); }
}
impl Show for String {
  function show(self: readonly Self, out: mut String): void { writeQuoted(self, mut out); }
}
impl Clone for String {
  function clone(self: readonly Self): String;
}
impl<T extends Eq> Eq for Vec<T> {
  function eq(self: readonly Self, other: readonly Self): bool {
    if (self.len() != other.len()) { return false; }
    let i: usize = 0;
    while (i < self.len()) {
      if (!self[i].eq(other[i])) { return false; }
      i += 1;
    }
    true
  }
}
impl<T extends Hash> Hash for Vec<T> {
  function hash(self: readonly Self, h: mut Hasher): void {
    h.writeInt(self.len() as i64);
    for (const x of self) { x.hash(mut h); }
  }
}
impl<T extends Show> Show for Vec<T> {
  function show(self: readonly Self, out: mut String): void {
    out.push("[");
    let first = true;
    for (const x of self) {
      if (!first) { out.push(", "); }
      first = false;
      x.show(mut out);
    }
    out.push("]");
  }
}
impl<T extends Clone> Clone for Vec<T> {
  function clone(self: readonly Self): Vec<T> {
    let v = Vec.new();
    for (const x of self) { v.push(x.clone()); }
    v
  }
}
impl<T, comptime N: usize> Iterable<readonly T> for T[N] {
  function each(self: readonly Self): void uses Yield<readonly T>;
}
impl<T> Iterable<readonly T> for Vec<T> {
  function each(self: readonly Self): void uses Yield<readonly T>;
}
impl<T> Box<T> {
  export function new(v: T): Box<T>;
  // A box, or `#OutOfMemory`, which drops `v`.
  export function tryNew(v: T): Box<T> uses Fail<#OutOfMemory>;
  export function get(self: readonly Self): readonly T from self;
  // What the box held, the box consumed: how a value is taken out of a box.
  export function into(self: Self): T;
}
// A box is its contents, for every derived interface.
impl<T extends Eq> Eq for Box<T> {
  function eq(self: readonly Self, other: readonly Self): bool { self.get().eq(other.get()) }
}
impl<T extends Ord> Ord for Box<T> {
  function cmp(self: readonly Self, other: readonly Self): Ordering { self.get().cmp(other.get()) }
}
impl<T extends Hash> Hash for Box<T> {
  function hash(self: readonly Self, h: mut Hasher): void { self.get().hash(mut h); }
}
impl<T extends Show> Show for Box<T> {
  function show(self: readonly Self, out: mut String): void { self.get().show(mut out); }
}
impl<T extends Clone> Clone for Box<T> {
  function clone(self: readonly Self): Box<T> { Box.new(self.get().clone()) }
}
impl<T extends Send> Arc<T> {
  export function new(v: T): Arc<T>;
  export function get(self: readonly Self): readonly T from self;
}
// An `Arc` compares, hashes and shows as what it shares; cloning it shares it again.
impl<T extends Send & Eq> Eq for Arc<T> {
  function eq(self: readonly Self, other: readonly Self): bool { self.get().eq(other.get()) }
}
impl<T extends Send & Hash> Hash for Arc<T> {
  function hash(self: readonly Self, h: mut Hasher): void { self.get().hash(mut h); }
}
impl<T extends Send & Show> Show for Arc<T> {
  function show(self: readonly Self, out: mut String): void { self.get().show(mut out); }
}
impl<T extends Send> Clone for Arc<T> {
  function clone(self: readonly Self): Arc<T>;
}

// ---- Regions (§4.6) ----
// `Ref<R, T>` is used as a `readonly T`; the compiler provides the projection.
export struct Ref<region R, T>;

// A `Ref` is `Copy`, so cloning one copies it; otherwise it is what it points at, so region
// strings key maps: `HashMap<Ref<R, str>, V>`, looked up by a `str`.
impl<region R, T> Clone for Ref<R, T> { function clone(self: readonly Self): Self; }
impl<region R, T> Ref<R, T> {
  export function get(self: readonly Self): readonly T from self;
}
impl<region R, T extends Eq> Eq for Ref<R, T> {
  function eq(self: readonly Self, other: readonly Self): bool { self.get().eq(other.get()) }
}
impl<region R, T extends Ord> Ord for Ref<R, T> {
  function cmp(self: readonly Self, other: readonly Self): Ordering { self.get().cmp(other.get()) }
}
impl<region R, T extends Hash> Hash for Ref<R, T> {
  function hash(self: readonly Self, h: mut Hasher): void { self.get().hash(mut h); }
}
impl<region R, T extends Show> Show for Ref<R, T> {
  function show(self: readonly Self, out: mut String): void { self.get().show(mut out); }
}
export function alloc<region R, T>(v: T): Ref<R, T> uses Region<R>;
// TypeScript's `parseInt` and `parseFloat`, without the `NaN`: decimal text, or `#None`.
export function parseInt(s: str): Option<i64>;
export function parseFloat(s: str): Option<f64>;
export function copyUtf8<region R>(bytes: readonly u8[]): Ref<R, str> uses Region<R>, Fail<#MalformedUtf8>;
export function fmt<region R>(s: str): Ref<R, str> uses Region<R>;
// A fixed list placed in the region: what a parser builds in a `Vec` and then never changes —
// a call's arguments, a function's parameters — indexed and sliced through the `Ref` (§4.6).
export function allocAll<region R, T extends Copy>(items: readonly T[]): Ref<R, T[]> uses Region<R>;

// ---- Moving out of a place that must stay filled ----
// The value at `place`, which gets `v` instead: how a pass takes a field out of `mut self`.
export function replace<T>(place: mut T, v: T): T;
export function swap<T>(a: mut T, b: mut T): void;

// ---- Arrays ----
export function repeat<T extends Copy, comptime N: usize>(v: T): T[N];

// ---- Foreign code (§8.2) ----

// What reaching through a raw pointer, or calling C, performs. `unsafe { … }` handles it: its code
// vouches for what the compiler cannot check.
export effect Unsafe {}

// A raw pointer, `T*`: an address, `Copy` and not `Send`, which no borrow rule follows. Taking one
// is safe; reaching through one is `Unsafe`. Address `0` is null.
export struct Ptr<T>;
impl<T> Ptr<T> {
  export function fromMut(r: mut T): Ptr<T>;
  export function fromRef(r: readonly T): Ptr<T>;
  export function at(address: usize): Ptr<T>;
  export function address(self: Self): usize;
  // The pointer `n` elements on.
  export function add(self: Self, n: usize): Ptr<T>;
  export function cast<U>(self: Self): Ptr<U>;
  // A copy of the bits there; writing does not drop what was there.
  export function read(self: Self): T uses Unsafe;
  export function write(self: Self, v: T): void uses Unsafe;
  // Reads and writes the compiler keeps, in order: a device's registers.
  export function readVolatile(self: Self): T uses Unsafe;
  export function writeVolatile(self: Self, v: T): void uses Unsafe;
  // Atomic operations, on an integer or a pointer.
  export function loadAcquire(self: Self): T uses Unsafe;
  export function storeRelease(self: Self, v: T): void uses Unsafe;
  export function compareExchange(self: Self, expected: T, desired: T): [T, bool] uses Unsafe;
  export function fetchAdd(self: Self, v: T): T uses Unsafe;
  // What is there, lent `mut` to `body` for as long as it runs: what it changes changes there.
  export function with<R, row E>(self: Self, body: once (v: mut T) => R uses ...E): R uses Unsafe, ...E;
}

// The bytes a value of `T` takes, and the alignment it needs, as C lays it out.
export function sizeOf<T>(): usize;
export function alignOf<T>(): usize;
// A value of all zero bits, which C structures are often filled in from.
export function zeroed<T>(): T uses Unsafe;
// Memory fences: every access before one is seen before every access after it.
export function fence(): void;
export function fenceAcquire(): void;
export function fenceRelease(): void;
