// Channels between tasks (§6.2). Sending and receiving are `Io`: each is a scheduling point the
// deterministic simulator controls.

export struct Receiver<T>;
export struct Sender<T>;
export struct Reply<T>;
export struct Pending<T>;

// What is sent goes to another task, so it must be `Send`.
export function channel<T extends Send>(): [Sender<T>, Receiver<T>];

// A channel ends when its last sender is dropped or closed (`close` is an explicit drop): its
// receivers drain what was sent, then see the end (`recv` gives `#None`, and `for…of` stops).
impl<T> Sender<T> {
  // Whether `v` went to the channel: once the receiver is dropped, `v` is dropped instead, and a
  // producer may stop.
  export function send(self: readonly Self, v: T): bool uses Io;
  export function close(self: Self): void uses Io;
}
impl<T extends Send> Drop for Sender<T> {
  function drop(self: mut Self): void;
}
// Another sender on the same channel: it ends when the last of them is dropped or closed.
impl<T extends Send> Clone for Sender<T> {
  function clone(self: readonly Self): Self;
}

// State shared between tasks, reached only inside `lock`. The body performs no effects, so no
// lock is held across a scheduling point, and gives back a `Send` value, so nothing it returns
// borrows the guarded state.
export struct Mutex<T>;
impl<T extends Send> Mutex<T> {
  export function new(v: T): Mutex<T>;
  export function lock<R extends Send>(self: readonly Self, body: once (v: mut T) => R): R uses Io;
}
impl<T> Receiver<T> {
  export function recv(self: readonly Self): Option<T> uses Io;
}
// A receiver dropped: what is sent from then on is dropped, and the channel is freed once its
// senders are gone too.
impl<T> Drop for Receiver<T> {
  function drop(self: mut Self): void;
}
impl<T> Iterable<T, [Io]> for Receiver<T> {
  function each(self: readonly Self): void uses Yield<T>, Io;
}

// A one-shot reply: the requester keeps the `Pending` half and waits on it.
impl<T> Reply<T> {
  export function new(): [Reply<T>, Pending<T>];
  export function send(self: Self, v: T): void uses Io;
}
impl<T> Pending<T> {
  export function wait(self: Self): T uses Io;
}
// A reply dropped unsent ends the wait for it: `wait` panics. A `Pending` dropped unwaited for is
// done with.
impl<T> Drop for Reply<T> {
  function drop(self: mut Self): void;
}
impl<T> Drop for Pending<T> {
  function drop(self: mut Self): void;
}
