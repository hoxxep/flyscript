// Portable SIMD (std.md): `Simd<T, N>`, `N` lanes of a scalar `T`, and `Mask<N>`, `N` lanes of
// truth, for the horizontal work vectorizing compilers do not find — scanning sixteen bytes at a
// time for a quote or a newline, checking UTF-8, reductions and lookups. Natively and in
// WebAssembly each is lowered to the target's vector registers; the reference evaluator and
// JavaScript run them a lane at a time, with the same results.
//
// Integer arithmetic wraps, as vector instructions do; `saturatingAdd` and `saturatingSub` clamp.
// A mask's `firstTrue` and `bitmask` are what a scanner is written with: on x86 a `movemask`, on
// ARM a narrowing shift, so finding the first match costs about the same on both.

// A scalar a lane holds: an integer or a float.
export interface Lane extends Copy {
  function laneAdd(self: Self, o: Self): Self;
  function laneSub(self: Self, o: Self): Self;
  function laneMul(self: Self, o: Self): Self;
  function laneMin(self: Self, o: Self): Self;
  function laneMax(self: Self, o: Self): Self;
  function laneEq(self: Self, o: Self): bool;
  function laneLt(self: Self, o: Self): bool;
  function laneZero(): Self;
}

// A lane that is an integer: what has bits to combine, shift and saturate.
export interface IntLane extends Lane {
  function laneAnd(self: Self, o: Self): Self;
  function laneOr(self: Self, o: Self): Self;
  function laneXor(self: Self, o: Self): Self;
  function laneNot(self: Self): Self;
  function laneShl(self: Self, k: u32): Self;
  function laneShr(self: Self, k: u32): Self;
  function laneSatAdd(self: Self, o: Self): Self;
  function laneSatSub(self: Self, o: Self): Self;
}

impl<comptime T: Type> Lane for T {
  function laneAdd(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self.wrappingAdd(o),
      #Float(_) => self + o,
      _ => comptime panic(`${Type.name(T)} is not a lane: a lane is an integer or a float`),
    }
  }
  function laneSub(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self.wrappingSub(o),
      #Float(_) => self - o,
      _ => comptime panic(`${Type.name(T)} is not a lane: a lane is an integer or a float`),
    }
  }
  function laneMul(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self.wrappingMul(o),
      #Float(_) => self * o,
      _ => comptime panic(`${Type.name(T)} is not a lane: a lane is an integer or a float`),
    }
  }
  function laneMin(self: Self, o: Self): Self { if (o < self) { o } else { self } }
  function laneMax(self: Self, o: Self): Self { if (o > self) { o } else { self } }
  function laneEq(self: Self, o: Self): bool { self == o }
  function laneLt(self: Self, o: Self): bool { self < o }
  function laneZero(): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => 0,
      #Float(_) => 0.0,
      _ => comptime panic(`${Type.name(T)} is not a lane: a lane is an integer or a float`),
    }
  }
}

impl<comptime T: Type> IntLane for T {
  function laneAnd(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self & o,
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to combine`),
    }
  }
  function laneOr(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self | o,
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to combine`),
    }
  }
  function laneXor(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => self ^ o,
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to combine`),
    }
  }
  function laneNot(self: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed: _, bits: _ } => ~self,
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to combine`),
    }
  }
  // Shifting by the lane's width or more gives zero, or, rightward in a signed lane, its sign.
  function laneShl(self: Self, k: u32): Self {
    comptime match (Type.info(T)) {
      // Bits shifted out are dropped: a multiplication that wraps, by two to the `k - 1` and then
      // by two, each of which fits a signed lane.
      #Int { signed: _, bits } => if (k >= comptime bits as u32) { 0 } else if (k == 0) { self } else { self.wrappingMul((1 as T) << ((k - 1) as T)).wrappingMul(2) },
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to shift`),
    }
  }
  function laneShr(self: Self, k: u32): Self {
    comptime match (Type.info(T)) {
      #Int { signed, bits } => {
        const w: u32 = comptime bits as u32;
        comptime if (signed) { if (k >= w) { self >> ((w - 1) as T) } else { self >> (k as T) } } else { if (k >= w) { 0 } else { self >> (k as T) } }
      }
      _ => comptime panic(`a lane of ${Type.name(T)} has no bits to shift`),
    }
  }
  function laneSatAdd(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed, bits } => {
        comptime if (bits > 64) { comptime panic("a saturating lane is at most 64 bits") }
        const w = (self as i128) + (o as i128);
        comptime if (signed) {
          if (w < comptime -(1 << (bits - 1))) { comptime -(1 << (bits - 1)) } else if (w > comptime (1 << (bits - 1)) - 1) { comptime (1 << (bits - 1)) - 1 } else { w as T }
        } else {
          if (w > comptime (1 << bits) - 1) { comptime (1 << bits) - 1 } else { w as T }
        }
      }
      _ => comptime panic(`a lane of ${Type.name(T)} does not saturate`),
    }
  }
  function laneSatSub(self: Self, o: Self): Self {
    comptime match (Type.info(T)) {
      #Int { signed, bits } => {
        comptime if (bits > 64) { comptime panic("a saturating lane is at most 64 bits") }
        const w = (self as i128) - (o as i128);
        comptime if (signed) {
          if (w < comptime -(1 << (bits - 1))) { comptime -(1 << (bits - 1)) } else if (w > comptime (1 << (bits - 1)) - 1) { comptime (1 << (bits - 1)) - 1 } else { w as T }
        } else {
          if (w < 0) { 0 } else { w as T }
        }
      }
      _ => comptime panic(`a lane of ${Type.name(T)} does not saturate`),
    }
  }
}

// `N` lanes of `T`.
export struct Simd<T extends Lane, comptime N: usize> { lanes: T[N] }

// `N` lanes of truth: what comparing two `Simd`s gives.
export struct Mask<comptime N: usize> { lanes: bool[N] }

impl<T extends Lane, comptime N: usize> Simd<T, N> {
  // Every lane `v`.
  export function splat(v: T): Simd<T, N> { Simd { lanes: repeat(v) } }

  export function fromArray(a: T[N]): Simd<T, N> { Simd { lanes: a } }

  // The `N` values of `s` from `at`, bounds-checked once for all of them.
  export function load(s: readonly T[], at: usize): Simd<T, N> {
    let r: Simd<T, N> = Simd.splat(T.laneZero());
    const n = r.lanes.len();
    if (at > s.len() || s.len() - at < n) { panic(`${n} lanes from ${at} are out of bounds (length ${s.len()})`); }
    for (const i of 0..n) { r.lanes[i] = s[at + i]; }
    r
  }

  // Writes the lanes to `s` from `at`, bounds-checked once.
  export function store(self: Self, s: mut T[], at: usize): void {
    const n = self.lanes.len();
    if (at > s.len() || s.len() - at < n) { panic(`${n} lanes from ${at} are out of bounds (length ${s.len()})`); }
    for (const i of 0..n) { s[at + i] = self.lanes[i]; }
  }

  export function toArray(self: Self): T[N] { self.lanes }
  export function at(self: Self, i: usize): T { self.lanes[i] }
  export function len(self: Self): usize { self.lanes.len() }

  export function add(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneAdd(o.lanes[i]); } r }
  export function sub(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneSub(o.lanes[i]); } r }
  export function mul(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneMul(o.lanes[i]); } r }
  export function min(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneMin(o.lanes[i]); } r }
  export function max(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneMax(o.lanes[i]); } r }

  export function eq(self: Self, o: Self): Mask<N> { let m: Mask<N> = Mask.splat(false); for (const i of 0..m.lanes.len()) { m.lanes[i] = self.lanes[i].laneEq(o.lanes[i]); } m }
  export function ne(self: Self, o: Self): Mask<N> { let m: Mask<N> = Mask.splat(false); for (const i of 0..m.lanes.len()) { m.lanes[i] = !self.lanes[i].laneEq(o.lanes[i]); } m }
  export function lt(self: Self, o: Self): Mask<N> { let m: Mask<N> = Mask.splat(false); for (const i of 0..m.lanes.len()) { m.lanes[i] = self.lanes[i].laneLt(o.lanes[i]); } m }
  export function le(self: Self, o: Self): Mask<N> { let m: Mask<N> = Mask.splat(false); for (const i of 0..m.lanes.len()) { m.lanes[i] = !o.lanes[i].laneLt(self.lanes[i]); } m }
  export function gt(self: Self, o: Self): Mask<N> { o.lt(self) }
  export function ge(self: Self, o: Self): Mask<N> { o.le(self) }

  // The lanes added together, wrapping for integers; for floats, in lane order.
  export function sum(self: Self): T { let s = T.laneZero(); for (const i of 0..self.lanes.len()) { s = s.laneAdd(self.lanes[i]); } s }
  export function reduceMin(self: Self): T { let s = self.lanes[0]; for (const i of 1..self.lanes.len()) { s = s.laneMin(self.lanes[i]); } s }
  export function reduceMax(self: Self): T { let s = self.lanes[0]; for (const i of 1..self.lanes.len()) { s = s.laneMax(self.lanes[i]); } s }

  // The lanes rearranged: lane `i` of the result is lane `idx[i]` of `self`; an index out of range
  // panics. Indices known at compile time are one shuffle instruction.
  export function shuffle(self: Self, idx: readonly usize[N]): Simd<T, N> {
    let r = self;
    for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[idx[i]]; }
    r
  }
}

impl<T extends IntLane, comptime N: usize> Simd<T, N> {
  export function and(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneAnd(o.lanes[i]); } r }
  export function or(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneOr(o.lanes[i]); } r }
  export function xor(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneXor(o.lanes[i]); } r }
  export function not(self: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneNot(); } r }
  export function shl(self: Self, k: u32): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneShl(k); } r }
  export function shr(self: Self, k: u32): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneShr(k); } r }
  export function saturatingAdd(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneSatAdd(o.lanes[i]); } r }
  export function saturatingSub(self: Self, o: Self): Simd<T, N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i].laneSatSub(o.lanes[i]); } r }
}

impl<comptime N: usize> Simd<u8, N> {
  // Lane `i` is `table`'s lane `self[i]`, or zero where that is 16 or more: a byte lookup, one
  // instruction (`tbl`, `pshufb`, `i8x16.swizzle`), as classifying bytes needs.
  export function lookupIn(self: Self, table: Simd<u8, 16>): Simd<u8, N> {
    let r = self;
    for (const i of 0..r.lanes.len()) { r.lanes[i] = if (self.lanes[i] < 16) { table.lanes[self.lanes[i] as usize] } else { 0 }; }
    r
  }
}

impl<comptime N: usize> Mask<N> {
  export function splat(v: bool): Mask<N> { Mask { lanes: repeat(v) } }
  export function fromArray(a: bool[N]): Mask<N> { Mask { lanes: a } }
  export function at(self: Self, i: usize): bool { self.lanes[i] }

  // Lane `i` of `a` where lane `i` is true, of `b` where it is not.
  export function select<T extends Lane>(self: Self, a: Simd<T, N>, b: Simd<T, N>): Simd<T, N> {
    let r = b;
    for (const i of 0..r.lanes.len()) { if (self.lanes[i]) { r.lanes[i] = a.lanes[i]; } }
    r
  }

  export function and(self: Self, o: Self): Mask<N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i] && o.lanes[i]; } r }
  export function or(self: Self, o: Self): Mask<N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = self.lanes[i] || o.lanes[i]; } r }
  export function not(self: Self): Mask<N> { let r = self; for (const i of 0..r.lanes.len()) { r.lanes[i] = !self.lanes[i]; } r }

  export function any(self: Self): bool { let r = false; for (const i of 0..self.lanes.len()) { r = r || self.lanes[i]; } r }
  export function all(self: Self): bool { let r = true; for (const i of 0..self.lanes.len()) { r = r && self.lanes[i]; } r }
  export function countTrue(self: Self): u32 { let n: u32 = 0; for (const i of 0..self.lanes.len()) { if (self.lanes[i]) { n += 1; } } n }

  // Bit `i` set where lane `i` is true: of at most 64 lanes.
  export function bitmask(self: Self): u64 {
    if (self.lanes.len() > 64) { panic("a bitmask is of at most 64 lanes"); }
    let m: u64 = 0;
    for (const i of 0..self.lanes.len()) { if (self.lanes[i]) { m = m | ((1 as u64) << (i as u64)); } }
    m
  }

  // The first lane that is true.
  export function firstTrue(self: Self): Option<usize> {
    for (const i of 0..self.lanes.len()) { if (self.lanes[i]) { return #Some(i); } }
    #None
  }
}
