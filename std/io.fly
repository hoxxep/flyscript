// Files and the standard streams (std.md), over `Io`'s descriptors: what is read is read ahead
// into a buffer, what is written goes to the descriptor as it is written, unless through a
// `Writer`, which gathers it until it is flushed.

import { Simd } from "std/simd";

// A file open for reading or for writing.
export struct File {
  private fd: Fd;
  private open: bool;
  // What has been read ahead and not yet given out: `buf[at..end]`.
  private buf: Vec<u8>;
  private at: usize;
  private end: usize;
  // Whether a read found the end.
  private done: bool;
}

const AHEAD: usize = 65536;

// A file dropped open is let go of; closing it, which may fail, is `close`.
impl Drop for File {
  function drop(self: mut Self): void { if (self.open) { self.fd.release(); } }
}

function made(fd: Fd): File { File { fd, open: true, buf: Vec.new(), at: 0, end: 0, done: false } }

function opened(path: str, mode: u8): File uses Io, Fail<IoErr> {
  match (Io.open(path, mode)) { #Ok(fd) => made(fd), #Err(e) => throw e }
}

impl File {
  // The file at `path`, to read: `#NotFound` if there is none.
  export function open(path: str): File uses Io, Fail<IoErr> { opened(path, 0) }
  // The file at `path`, made empty, or made, to write.
  export function create(path: str): File uses Io, Fail<IoErr> { opened(path, 1) }
  // The file at `path`, made if it is not there, to write at its end.
  export function append(path: str): File uses Io, Fail<IoErr> { opened(path, 2) }
  // The program's standard input.
  export function stdin(): File { made(Fd.stdin()) }

  // Whether more can be read: fills the buffer if it is empty, false at the end.
  function fill(self: mut Self): bool uses Io, Fail<IoErr> {
    if (self.at < self.end) { return true; }
    if (self.done || !self.open) { return false; }
    if (self.buf.len() < AHEAD) {
      const zeros: u8[4096] = repeat(0 as u8);
      while (self.buf.len() < AHEAD) { self.buf.extend(zeros); }
    }
    const n = match (Io.read(self.fd, mut self.buf)) { #Ok(n) => n, #Err(e) => throw e };
    self.at = 0;
    self.end = n;
    if (n == 0) { self.done = true; }
    n > 0
  }

  // Reads what is there, at most `into.len()` bytes, waiting for at least one: how many, `0` at the end.
  export function read(self: mut Self, into: mut u8[]): usize uses Io, Fail<IoErr> {
    if (into.len() == 0 || !self.fill()) { return 0; }
    const n = if (self.end - self.at < into.len()) { self.end - self.at } else { into.len() };
    into[0..n].copyFrom(self.buf[self.at..self.at + n]);
    self.at += n;
    n
  }

  // The next line, without its `\n` or `\r\n`; `#None` at the end. A last line with nothing after
  // its `\n` is not one.
  export function readLine(self: mut Self): Option<String> uses Io, Fail<IoErr> {
    let line: Vec<u8> = Vec.new();
    let any = false;
    // Whether the scan found the line well-formed UTF-8, which need not be checked again.
    let known = true;
    // What is read ahead is looked at before anything more is read.
    while (self.at < self.end || self.fill()) {
      any = true;
      // Scanned as a slice of its own, so the scan reads nothing else.
      let k: usize = 0;
      {
        const ahead = self.buf[self.at..self.end];
        const [end, plain] = lineEnd(ahead);
        k = end;
        known = known && plain;
        line.extend(ahead[0..k]);
      }
      k += self.at;
      if (k < self.end) {
        self.at = k + 1;
        if (line.len() > 0 && line[line.len() - 1] == 13) { line.pop(); }
        return #Some(lineText(line, known));
      }
      self.at = k;
    }
    if (any && line.len() > 0) { #Some(lineText(line, known)) } else { #None }
  }

  // Each line in turn, as `readLine` reads them.
  export function lines(self: mut Self): void uses Io, Fail<IoErr>, Yield<String> {
    while (const #Some(l) = self.readLine()) { yield l; }
  }

  // The rest of the file, as bytes.
  export function readBytes(self: mut Self): Vec<u8> uses Io, Fail<IoErr> {
    let out: Vec<u8> = Vec.new();
    while (self.fill()) {
      out.extend(self.buf[self.at..self.end]);
      self.at = self.end;
    }
    out
  }

  // The rest of the file, as text: each byte that begins no UTF-8 sequence as U+FFFD.
  export function readText(self: mut Self): String uses Io, Fail<IoErr> { text(self.readBytes()) }

  // Writes all of `bytes`.
  export function write(self: mut Self, bytes: readonly u8[]): void uses Io, Fail<IoErr> {
    let done: usize = 0;
    while (done < bytes.len()) {
      match (Io.write(self.fd, bytes[done..bytes.len()])) {
        #Ok(n) => { done += n; }
        #Err(e) => throw e,
      }
    }
  }

  export function writeText(self: mut Self, s: str): void uses Io, Fail<IoErr> { self.write(s.asBytes()); }

  // Closes the file; closing it again does nothing.
  export function close(self: mut Self): void uses Io {
    if (self.open) {
      self.open = false;
      Io.close(self.fd);
    }
  }
}

// Writes that gather in a buffer and go to their file a buffer at a time. Flush it, or close it,
// to be sure what was written is there: what it holds when it is dropped is lost, as a destructor
// performs nothing.
export struct Writer {
  private file: File;
  private buf: Vec<u8>;
}

impl Writer {
  // A writer to `file`, which it owns.
  export function new(file: File): Writer { Writer { file, buf: Vec.new() } }
  // A writer to the program's standard output.
  export function stdout(): Writer { Writer { file: made(Fd.stdout()), buf: Vec.new() } }

  export function write(self: mut Self, bytes: readonly u8[]): void uses Io, Fail<IoErr> {
    self.buf.extend(bytes);
    if (self.buf.len() >= AHEAD) { self.flush(); }
  }

  export function writeText(self: mut Self, s: str): void uses Io, Fail<IoErr> { self.write(s.asBytes()); }

  // `s` and a line break.
  export function writeLine(self: mut Self, s: str): void uses Io, Fail<IoErr> {
    self.write(s.asBytes());
    self.buf.push(10);
    if (self.buf.len() >= AHEAD) { self.flush(); }
  }

  // Writes what it holds to its file.
  export function flush(self: mut Self): void uses Io, Fail<IoErr> {
    if (self.buf.len() == 0) { return; }
    self.file.write(self.buf);
    self.buf.truncate(0);
  }

  // Flushes it, then closes its file.
  export function close(self: mut Self): void uses Io, Fail<IoErr> {
    self.flush();
    self.file.close();
  }
}

// The whole file at `path`, as text.
export function readFile(path: str): String uses Io, Fail<IoErr> {
  let f = File.open(path);
  const t = f.readText();
  f.close();
  t
}

// Writes `content` to the file at `path`, replacing what was there.
export function writeFile(path: str, content: str): void uses Io, Fail<IoErr> {
  let f = File.create(path);
  f.writeText(content);
  f.close();
}

function text(b: Vec<u8>): String { String.fromUtf8Lossy(b) }

// A line's bytes as text: checked, unless the scan found them well formed.
function lineText(b: Vec<u8>, known: bool): String {
  if (known) { unsafe { String.fromUtf8Unchecked(b) } } else { text(b) }
}

// Where the first `\n` in `bytes` is, or how many there are if none is, and whether the bytes
// before it are known to be well-formed UTF-8 — or, false, they may not be, which only means the
// line is checked. The first 64 bytes sixteen at a time as two words, each word's bytes that are
// `\n` found as those its exclusive or with eight of them leaves zero, the first of which is the
// lowest marked (the marks above it may be wrong); a block with bytes past ASCII is checked as it
// is scanned (`utf8Errors`), up to the `\n`, and so is the block after one whose last three bytes
// may begin a sequence that ends there, so that a short line is checked in the one pass that finds
// its end. Past that, sixteen at a time as vectors, which is faster on long lines, while the words
// answer sooner on short ones, the branch out of the loop resolved without a move out of a vector
// register; a long line is known only if it is ASCII. The rest a byte at a time.
function lineEnd(bytes: readonly u8[]): [usize, bool] {
  const n = bytes.len();
  let k: usize = 0;
  let high: u64 = 0;
  let bad = false;
  let after = false;
  while (k + 16 <= n && k < 64) {
    const w = bytes.readU64Le(k);
    const w2 = bytes.readU64Le(k + 8);
    const x = w ^ 0x0a0a0a0a0a0a0a0a;
    const x2 = w2 ^ 0x0a0a0a0a0a0a0a0a;
    const zero = x.wrappingSub(0x0101010101010101) & ~x & 0x8080808080808080;
    const zero2 = x2.wrappingSub(0x0101010101010101) & ~x2 & 0x8080808080808080;
    const hi = (w | w2) & 0x8080808080808080;
    high = high | hi;
    if (hi != 0 || after) { bad = bad || utf8Bad(bytes, k, newlineAt(zero, zero2)); }
    if ((zero | zero2) != 0) { return [k + newlineAt(zero, zero2), !bad]; }
    // A sequence its last three bytes begin may end in the next block.
    after = (w2 & 0x8080800000000000) != 0;
    k += 16;
  }
  const newline: Simd<u8, 16> = Simd.splat(10);
  let seen: Simd<u8, 16> = Simd.splat(0);
  while (k + 16 <= n) {
    const v: Simd<u8, 16> = Simd.load(bytes, k);
    seen = seen.or(v);
    if (const #Some(i) = v.eq(newline).firstTrue()) { return [k + i, high == 0 && seen.reduceMax() < 0x80]; }
    k += 16;
  }
  if (seen.reduceMax() >= 0x80) { high = high | 0x80; }
  while (k < n && bytes[k] != 10) {
    high = high | ((bytes[k] & 0x80) as u64);
    k += 1;
  }
  [k, high == 0]
}

// Which of sixteen bytes is the first `\n`, from the marks of two words, or 16 if neither has one.
function newlineAt(zero: u64, zero2: u64): usize {
  if (zero != 0) { (zero.trailingZeros() / 8) as usize } else if (zero2 != 0) { 8 + (zero2.trailingZeros() / 8) as usize } else { 16 }
}

// Whether the sixteen bytes at `at` hold a byte where well-formed UTF-8 would not, among the
// first `upto` and the one after (a `\n`, which a sequence left unfinished before it is wrong at),
// each byte checked with the three before it, the slice beginning a line.
function utf8Bad(bytes: readonly u8[], at: usize, upto: usize): bool {
  const v: Simd<u8, 16> = Simd.load(bytes, at);
  const prev: Simd<u8, 16> = if (at >= 16) { Simd.load(bytes, at - 16) } else { Simd.splat(0) };
  const e = utf8Errors(v, prev);
  if (e.reduceMax() == 0) { return false; }
  const lanes: u64 = if (upto >= 15) { 0xffff } else { ((2 as u64) << (upto as u64)) - 1 };
  (e.ne(Simd.splat(0)).bitmask() & lanes) != 0
}

// Where the bytes of `v`, with those of `prev` before them, are not well-formed UTF-8: nonzero
// lanes, each byte judged with the three before it (Keiser and Lemire, "Validating UTF-8 in less
// than one instruction per byte", 2021, as the runtime's own check is). Each pair of a byte and
// the one before is looked up by the high nibble of each and the low nibble of the first, in three
// tables whose entries are the errors that nibble allows, and is wrong where the three agree on
// one; that the third and fourth bytes of a long sequence are continuations is checked apart. The
// errors, as bits: too short 1, too long 2, an overlong three 4, too large 8, a surrogate 16, an
// overlong two 32, too large past U+10FFFF or an overlong four 64, two continuations 128.
function utf8Errors(v: Simd<u8, 16>, prev: Simd<u8, 16>): Simd<u8, 16> {
  const b1hi: Simd<u8, 16> = Simd.fromArray([2, 2, 2, 2, 2, 2, 2, 2, 128, 128, 128, 128, 33, 1, 21, 73]);
  const b1lo: Simd<u8, 16> = Simd.fromArray([231, 163, 131, 131, 139, 203, 203, 203, 203, 203, 203, 203, 203, 219, 203, 203]);
  const b2hi: Simd<u8, 16> = Simd.fromArray([1, 1, 1, 1, 1, 1, 1, 1, 230, 174, 186, 186, 1, 1, 1, 1]);
  const prev1 = v.shiftIn(prev, 1);
  const prev2 = v.shiftIn(prev, 2);
  const prev3 = v.shiftIn(prev, 3);
  const low: Simd<u8, 16> = Simd.splat(15);
  const special = prev1.shr(4).lookupIn(b1hi).and(prev1.and(low).lookupIn(b1lo)).and(v.shr(4).lookupIn(b2hi));
  const third = prev2.saturatingSub(Simd.splat(0xe0 - 0x80));
  const fourth = prev3.saturatingSub(Simd.splat(0xf0 - 0x80));
  third.or(fourth).and(Simd.splat(0x80)).xor(special)
}

// A line to standard output; on threads, each line is written whole.
export function println(s: str): void uses Io;
// A line to standard error, which is not buffered.
export function eprintln(s: str): void uses Io;
// Ends the program at once, with `code` its exit status: no cleanup runs, as for a panic.
export function exit(code: i32): never uses Io;
