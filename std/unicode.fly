// Unicode (std.md): text as its code points, and as the characters people see — grapheme clusters,
// as UAX #29 finds them — in its normal forms NFC and NFD, and in its cases. Text is UTF-8. The
// tables at the end are the Unicode Character Database's, of the version `version()` says, written
// by tools/unicode.py, under the Unicode License v3 (LICENSE-UNICODE).

// The version of Unicode the tables are of.
export function version(): str { VERSION }

// The code point that starts at byte `i`, and how many bytes it takes: U+FFFD, one byte, for a byte
// that starts none, which a `str` never has.
function decodeAt(b: readonly u8[], i: usize): [u32, usize] {
  const c = b[i] as u32;
  if (c < 0x80) { return [c, 1]; }
  const n: usize = if (c >= 0xF0) { 4 } else if (c >= 0xE0) { 3 } else if (c >= 0xC0) { 2 } else { return [0xFFFD, 1] };
  if (i + n > b.len()) { return [0xFFFD, 1]; }
  let cp = c & (if (n == 2) { 0x1F } else if (n == 3) { 0x0F } else { 0x07 });
  for (const k of 1..n) { cp = (cp << 6) | ((b[i + k] as u32) & 0x3F); }
  [cp, n]
}

// The code points of `s`, in order.
export function codePoints(s: str): void uses Yield<u32> {
  const b = s.asBytes();
  let i: usize = 0;
  while (i < b.len()) {
    const [cp, n] = decodeAt(b, i);
    yield cp;
    i += n;
  }
}

function push(out: mut Vec<u8>, cp: u32): void {
  if (cp < 0x80) {
    out.push(cp as u8);
  } else if (cp < 0x800) {
    out.push((0xC0 | (cp >> 6)) as u8);
    out.push((0x80 | (cp & 0x3F)) as u8);
  } else if (cp < 0x10000) {
    out.push((0xE0 | (cp >> 12)) as u8);
    out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
    out.push((0x80 | (cp & 0x3F)) as u8);
  } else {
    out.push((0xF0 | (cp >> 18)) as u8);
    out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
    out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
    out.push((0x80 | (cp & 0x3F)) as u8);
  }
}

// Text of code points, each written as UTF-8; one that is no character, a surrogate or past U+10FFFF,
// as U+FFFD.
export function fromCodePoints(cps: readonly u32[]): String {
  let b: Vec<u8> = Vec.new();
  for (const cp of cps) { push(mut b, if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) { 0xFFFD } else { cp }); }
  match (String.fromUtf8(b)) { #Some(s) => s, #None => String.new() }
}

// The value of a property given by runs, at a code point.
function inRuns(at: readonly u32[], is: readonly u8[], cp: u32): u8 {
  let lo: usize = 0;
  let hi = at.len();
  while (hi - lo > 1) {
    const mid = (lo + hi) / 2;
    if (at[mid] <= cp) { lo = mid; } else { hi = mid; }
  }
  is[lo]
}

// The sequence a mapping gives a code point, if it has one: where it is in the flat list.
function mapped(cps: readonly u32[], at: readonly u32[], cp: u32): Option<[usize, usize]> {
  let lo: usize = 0;
  let hi = cps.len();
  while (lo < hi) {
    const mid = (lo + hi) / 2;
    if (cps[mid] < cp) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo < cps.len() && cps[lo] == cp) { #Some([at[lo] as usize, at[lo + 1] as usize]) } else { #None }
}

// ---- grapheme clusters ----

const CR: u8 = 1;
const LF: u8 = 2;
const CONTROL: u8 = 3;
const EXTEND: u8 = 4;
const ZWJ: u8 = 5;
const RI: u8 = 6;
const PREPEND: u8 = 7;
const SPACING_MARK: u8 = 8;
const L: u8 = 9;
const V: u8 = 10;
const T: u8 = 11;
const LV: u8 = 12;
const LVT: u8 = 13;

// What a cluster's rules know of the code points before a break they decide.
struct Before {
  kind: u8;
  // Regional indicators just before, in a row.
  ri: usize;
  // An Extended_Pictographic, Extend*, then ZWJ just before (GB11).
  zwj: bool;
  // An Extended_Pictographic, then Extend* so far.
  pictographic: bool;
  // An Indic_Conjunct_Break Linker, then Extend* so far (GB9c).
  linker: bool;
}

function breaks(b: readonly Before, kind: u8): bool {
  const p = b.kind & 15;
  const c = kind & 15;
  if (p == CR && c == LF) { return false; }
  if (p == CONTROL || p == CR || p == LF) { return true; }
  if (c == CONTROL || c == CR || c == LF) { return true; }
  if (p == L && (c == L || c == V || c == LV || c == LVT)) { return false; }
  if ((p == LV || p == V) && (c == V || c == T)) { return false; }
  if ((p == LVT || p == T) && c == T) { return false; }
  if (c == EXTEND || c == ZWJ || c == SPACING_MARK || p == PREPEND) { return false; }
  if (b.linker && (kind & 64) != 0) { return false; }
  if (b.zwj && (kind & 16) != 0) { return false; }
  if (p == RI && c == RI && b.ri % 2 == 1) { return false; }
  true
}

function after(b: readonly Before, kind: u8): Before {
  const c = kind & 15;
  const pictographic = (kind & 16) != 0 || (b.pictographic && c == EXTEND);
  const linker = (kind & 32) != 0 || (b.linker && (kind & 128) != 0);
  { kind, ri: if (c == RI) { b.ri + 1 } else { 0 }, zwj: b.pictographic && c == ZWJ, pictographic, linker }
}

function graphemeKind(cp: u32): u8 { inRuns(GRAPHEME_AT, GRAPHEME_IS, cp) }

// The grapheme clusters of `s`, each a slice of it: the characters people see, a letter and the
// marks on it, an emoji of several code points, a flag.
export function graphemes(s: str): void uses Yield<str> {
  const b = s.asBytes();
  if (b.len() == 0) { return; }
  let start: usize = 0;
  const [first, n0] = decodeAt(b, 0);
  let before = after({ kind: 0, ri: 0, zwj: false, pictographic: false, linker: false }, graphemeKind(first));
  let i = n0;
  while (i < b.len()) {
    const [cp, n] = decodeAt(b, i);
    const kind = graphemeKind(cp);
    if (breaks(before, kind)) {
      yield s.slice(start, i);
      start = i;
    }
    before = after(before, kind);
    i += n;
  }
  yield s.slice(start, b.len());
}

// How many grapheme clusters `s` is.
export function graphemeCount(s: str): usize {
  let n: usize = 0;
  for (const _ of graphemes(s)) { n += 1; }
  n
}

// ---- normal forms ----

const S_BASE: u32 = 0xAC00;
const L_BASE: u32 = 0x1100;
const V_BASE: u32 = 0x1161;
const T_BASE: u32 = 0x11A7;
const T_COUNT: u32 = 28;
const N_COUNT: u32 = 588;
const S_COUNT: u32 = 11172;

function ccc(cp: u32): u8 { if (cp < 0x300) { 0 } else { inRuns(CCC_AT, CCC_IS, cp) } }

function decompose(cp: u32, out: mut Vec<u32>): void {
  if (cp >= S_BASE && cp < S_BASE + S_COUNT) {
    const s = cp - S_BASE;
    out.push(L_BASE + s / N_COUNT);
    out.push(V_BASE + s % N_COUNT / T_COUNT);
    if (s % T_COUNT != 0) { out.push(T_BASE + s % T_COUNT); }
    return;
  }
  match (mapped(DECOMP_CP, DECOMP_AT, cp)) {
    #Some([from, to]) => { for (const k of from..to) { out.push(DECOMP_TO[k]); } }
    #None => out.push(cp),
  }
}

// The code points of `s` decomposed and in canonical order.
function decomposed(s: str): Vec<u32> {
  let out: Vec<u32> = Vec.new();
  for (const cp of codePoints(s)) { decompose(cp, mut out); }
  // Marks after a starter in order of their classes, those of one class as they were.
  let i: usize = 1;
  while (i < out.len()) {
    const c = ccc(out[i]);
    if (c != 0) {
      let j = i;
      while (j > 0 && ccc(out[j - 1]) > c) {
        out.swap(j - 1, j);
        j -= 1;
      }
    }
    i += 1;
  }
  out
}

function composite(a: u32, b: u32): Option<u32> {
  if (a >= L_BASE && a < L_BASE + 19 && b >= V_BASE && b < V_BASE + 21) {
    return #Some(S_BASE + ((a - L_BASE) * 21 + (b - V_BASE)) * T_COUNT);
  }
  if (a >= S_BASE && a < S_BASE + S_COUNT && (a - S_BASE) % T_COUNT == 0 && b > T_BASE && b < T_BASE + T_COUNT) {
    return #Some(a + (b - T_BASE));
  }
  const key = ((a as u64) << 21) | (b as u64);
  let lo: usize = 0;
  let hi = COMPOSE_KEY.len();
  while (lo < hi) {
    const mid = (lo + hi) / 2;
    if (COMPOSE_KEY[mid] < key) { lo = mid + 1; } else { hi = mid; }
  }
  if (lo < COMPOSE_KEY.len() && COMPOSE_KEY[lo] == key) { #Some(COMPOSE_TO[lo]) } else { #None }
}

// `s` in Normalization Form D: every character decomposed, canonically.
export function nfd(s: str): String { fromCodePoints(decomposed(s)) }

// `s` in Normalization Form C: decomposed, then composed again, canonically.
export function nfc(s: str): String {
  const d = decomposed(s);
  let out: Vec<u32> = Vec.new();
  let starter: Option<usize> = #None;
  // The class of what was last put after the starter: a mark of a class as high stops another.
  let last: u8 = 0;
  for (const cp of d) {
    const c = ccc(cp);
    if (const #Some(si) = starter) {
      // Between the starter and it, in canonical order, the last class is the highest.
      const blocked = out.len() - 1 > si && last >= c;
      if (!blocked) {
        if (const #Some(x) = composite(out[si], cp)) {
          out[si] = x;
          continue;
        }
      }
    }
    if (c == 0) {
      starter = #Some(out.len());
      last = 0;
    } else {
      last = c;
    }
    out.push(cp);
  }
  fromCodePoints(out)
}

export function isNfc(s: str): bool { nfc(s) == s }
export function isNfd(s: str): bool { nfd(s) == s }

// ---- cases ----

function caseFlags(cp: u32): u8 { inRuns(CASE_AT, CASE_IS, cp) }

// Σ at the end of a word: a cased letter before it, ignorable ones between, and none after it.
function finalSigma(cps: readonly Vec<u32>, i: usize): bool {
  let j = i;
  let cased = false;
  while (j > 0) {
    j -= 1;
    const f = caseFlags(cps[j]);
    if ((f & 2) != 0) { continue; }
    cased = (f & 1) != 0;
    break;
  }
  if (!cased) { return false; }
  let k = i + 1;
  while (k < cps.len()) {
    const f = caseFlags(cps[k]);
    if ((f & 2) != 0) { k += 1; continue; }
    return (f & 1) == 0;
  }
  true
}

// `s` in lower case, by Unicode's full case mappings, Σ final where it ends a word.
export function lower(s: str): String {
  let cps: Vec<u32> = Vec.new();
  for (const cp of codePoints(s)) { cps.push(cp); }
  let out: Vec<u32> = Vec.new();
  for (const [i, cp] of cps.iter().enumerate()) {
    if (cp == 0x03A3 && finalSigma(cps, i)) { out.push(0x03C2); continue; }
    match (mapped(LOWER_CP, LOWER_AT, cp)) {
      #Some([from, to]) => { for (const k of from..to) { out.push(LOWER_TO[k]); } }
      #None => out.push(cp),
    }
  }
  fromCodePoints(out)
}

// `s` in upper case, by Unicode's full case mappings: `ß` is `SS`.
export function upper(s: str): String {
  let out: Vec<u32> = Vec.new();
  for (const cp of codePoints(s)) {
    match (mapped(UPPER_CP, UPPER_AT, cp)) {
      #Some([from, to]) => { for (const k of from..to) { out.push(UPPER_TO[k]); } }
      #None => out.push(cp),
    }
  }
  fromCodePoints(out)
}

