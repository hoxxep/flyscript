// JSON as library code (§7.3). Encoding and decoding are interfaces; records, tuples and tag
// unions get them by derivation over `Type.info`, and a struct asks for them with
// `impl ToJson for User;`. Nothing here is known to the compiler.

export type JsonError = #Syntax(usize) | #Missing(String) | #Unknown(String) | #Range(usize);

export interface ToJson {
  function toJson(self: readonly Self, out: mut String): void;
}

// What is decoded is owned: `Send` makes `T extends FromJson` range over values that borrow
// nothing, so `parse` can return one from its own parser.
export interface FromJson extends Send {
  function fromJson(p: mut JsonParser): Self uses Fail<JsonError>;
}

// Encodes a value as JSON text: `stringify(user)`.
export function stringify<T extends ToJson>(v: readonly T): String {
  let out = String.new();
  v.toJson(mut out);
  out
}

// Decodes JSON text: `const u: User = parse(text);`. Unknown object keys are skipped, and a
// missing key is an error unless its field is an `Option`.
export function parse<T extends FromJson>(text: str): T uses Fail<JsonError> {
  let p = JsonParser.new(text);
  const v = T.fromJson(mut p);
  p.finish();
  v
}

// ---- Encoding ----

const HEX: str = "0123456789abcdef";

// Writes `s` as a JSON string, escaping quotes, backslashes and control characters.
export function writeString(s: str, out: mut String): void {
  const bytes = s.asBytes();
  out.push("\"");
  let start: usize = 0;
  let i: usize = 0;
  while (i < bytes.len()) {
    const b = bytes[i];
    if (b == b'"' || b == b'\\' || b < 32) {
      out.push(s.slice(start, i));
      escape(b, mut out);
      start = i + 1;
    }
    i += 1;
  }
  out.push(s.slice(start, bytes.len()));
  out.push("\"");
}

function escape(b: u8, out: mut String): void {
  match (b) {
    b'"' => out.push("\\\""),
    b'\\' => out.push("\\\\"),
    b'\n' => out.push("\\n"),
    b'\r' => out.push("\\r"),
    b'\t' => out.push("\\t"),
    _ => {
      const hi = (b >> 4) as usize;
      const lo = (b & 15) as usize;
      out.push("\\u00");
      out.push(HEX.slice(hi, hi + 1));
      out.push(HEX.slice(lo, lo + 1));
    },
  }
}

impl ToJson for String {
  function toJson(self: readonly Self, out: mut String): void { writeString(self, mut out); }
}
impl<T extends ToJson> ToJson for Vec<T> {
  function toJson(self: readonly Self, out: mut String): void {
    out.push("[");
    let first = true;
    for (const x of self) {
      if (!first) { out.push(","); }
      first = false;
      x.toJson(mut out);
    }
    out.push("]");
  }
}
// An `Option` is its value, or `null`: serde's convention, and what TypeScript's optional
// properties look like on the wire.
impl<T extends ToJson> ToJson for Option<T> {
  function toJson(self: readonly Self, out: mut String): void {
    match (self) {
      #Some(x) => x.toJson(mut out),
      #None => out.push("null"),
    }
  }
}

// Numbers and booleans are themselves, strings are quoted; records and structs are objects,
// tuples arrays; a tag without a payload is its name, and a tag with one is `{ "Name": payload }`.
impl<comptime T: Type> ToJson for T {
  function toJson(self: readonly Self, out: mut String): void {
    comptime match (Type.info(T)) {
      #Int(_) | #Float(_) | #Bool => out.push(`${self}`),
      #Str => writeString(self, mut out),
      #Record(fields) | #Struct { fields } => {
        out.push("{");
        comptime for (const [i, f] of fields.enumerate()) {
          comptime if (i > 0) { out.push(","); }
          writeString(f.name, mut out);
          out.push(":");
          self.[f.name].toJson(mut out);
        }
        out.push("}");
      }
      #Tuple(items) => {
        out.push("[");
        comptime for (const [i, _] of items.enumerate()) {
          comptime if (i > 0) { out.push(","); }
          self[i].toJson(mut out);
        }
        out.push("]");
      }
      #Union(tags) | #Enum { tags } => match (self) {
        comptime for (const t of tags) {
          comptime if (t.payload == #None) {
            #[t.name] => writeString(t.name, mut out),
          } else {
            #[t.name](x) => {
              out.push("{");
              writeString(t.name, mut out);
              out.push(":");
              x.toJson(mut out);
              out.push("}");
            },
          }
        }
      },
      _ => comptime panic(`${Type.name(T)} cannot be encoded as JSON`),
    }
  }
}

// ---- Decoding ----

// A cursor over JSON text. It borrows the text, so strings that need no unescaping could be
// lent rather than copied.
export view struct JsonParser { private text: str; private bytes: readonly u8[]; private pos: usize; }

function isSpace(b: u8): bool { b == b' ' || b == b'\n' || b == b'\t' || b == b'\r' }

function isNumberByte(b: u8): bool {
  b >= b'0' && b <= b'9' || b == b'-' || b == b'+' || b == b'.' || b == b'e' || b == b'E'
}

function hexValue(b: u8): u32 {
  if (b >= b'0' && b <= b'9') { (b - b'0') as u32 }
  else if (b >= b'a' && b <= b'f') { (b - b'a') as u32 + 10 }
  else if (b >= b'A' && b <= b'F') { (b - b'A') as u32 + 10 }
  else { 16 }
}

function pushUtf8(out: mut Vec<u8>, c: u32): void {
  if (c < 128) {
    out.push(c as u8);
  } else if (c < 2048) {
    out.push((192 | (c >> 6)) as u8);
    out.push((128 | (c & 63)) as u8);
  } else if (c < 65536) {
    out.push((224 | (c >> 12)) as u8);
    out.push((128 | ((c >> 6) & 63)) as u8);
    out.push((128 | (c & 63)) as u8);
  } else {
    out.push((240 | (c >> 18)) as u8);
    out.push((128 | ((c >> 12) & 63)) as u8);
    out.push((128 | ((c >> 6) & 63)) as u8);
    out.push((128 | (c & 63)) as u8);
  }
}

impl JsonParser {
  export function new(text: str): JsonParser from text {
    JsonParser { text, bytes: text.asBytes(), pos: 0 }
  }

  // The next byte that is not whitespace, or 0 at the end.
  export function peek(self: mut Self): u8 {
    while (self.pos < self.bytes.len() && isSpace(self.bytes[self.pos])) { self.pos += 1; }
    if (self.pos < self.bytes.len()) { self.bytes[self.pos] } else { 0 }
  }

  export function at(self: readonly Self): usize { self.pos }

  function expect(self: mut Self, b: u8): void uses Fail<JsonError> {
    if (self.peek() != b) { throw #Syntax(self.pos); }
    self.pos += 1;
  }

  function word(self: mut Self, w: str): bool {
    const wb = w.asBytes();
    if (self.pos + wb.len() > self.bytes.len()) { return false; }
    let i: usize = 0;
    while (i < wb.len()) {
      if (self.bytes[self.pos + i] != wb[i]) { return false; }
      i += 1;
    }
    self.pos += wb.len();
    true
  }

  // Consumes `null` if it comes next.
  export function eatNull(self: mut Self): bool { self.peek() == b'n' && self.word("null") }

  export function bool(self: mut Self): bool uses Fail<JsonError> {
    const b = self.peek();
    if (b == b't' && self.word("true")) { true }
    else if (b == b'f' && self.word("false")) { false }
    else { throw #Syntax(self.pos) }
  }

  // The text of the number that comes next.
  export function number(self: mut Self): str from self uses Fail<JsonError> {
    self.peek();
    const start = self.pos;
    while (self.pos < self.bytes.len() && isNumberByte(self.bytes[self.pos])) { self.pos += 1; }
    if (self.pos == start) { throw #Syntax(start); }
    self.text.slice(start, self.pos)
  }

  // A non-negative integer, over the whole range of `u64`.
  export function uint(self: mut Self): u64 uses Fail<JsonError> {
    self.peek();
    const start = self.pos;
    let n: u64 = 0;
    while (self.pos < self.bytes.len() && self.bytes[self.pos] >= b'0' && self.bytes[self.pos] <= b'9') {
      const d = (self.bytes[self.pos] - b'0') as u64;
      if (n > (18446744073709551615 - d) / 10) { throw #Range(start); }
      n = n * 10 + d;
      self.pos += 1;
    }
    if (self.pos == start || self.pos < self.bytes.len() && isNumberByte(self.bytes[self.pos])) { throw #Syntax(start); }
    n
  }

  export function int(self: mut Self): i64 uses Fail<JsonError> {
    self.peek();
    const start = self.pos;
    match (parseInt(self.number())) {
      #Some(n) => n,
      #None => throw #Syntax(start),
    }
  }

  export function float(self: mut Self): f64 uses Fail<JsonError> {
    self.peek();
    const start = self.pos;
    match (parseFloat(self.number())) {
      #Some(x) => x,
      #None => throw #Syntax(start),
    }
  }

  export function string(self: mut Self): String uses Fail<JsonError> {
    self.expect(b'"');
    let out: Vec<u8> = Vec.new();
    while (true) {
      if (self.pos >= self.bytes.len()) { throw #Syntax(self.pos); }
      const b = self.bytes[self.pos];
      self.pos += 1;
      if (b == b'"') { break; }
      if (b != b'\\') {
        out.push(b);
        continue;
      }
      if (self.pos >= self.bytes.len()) { throw #Syntax(self.pos); }
      const e = self.bytes[self.pos];
      self.pos += 1;
      match (e) {
        b'n' => out.push(b'\n'),
        b't' => out.push(b'\t'),
        b'r' => out.push(b'\r'),
        b'b' => out.push(8),
        b'f' => out.push(12),
        b'u' => self.unicode(mut out),
        b'"' | b'\\' | b'/' => out.push(e),
        _ => throw #Syntax(self.pos - 1),
      }
    }
    match (String.fromUtf8(out)) {
      #Some(s) => s,
      #None => throw #Syntax(self.pos),
    }
  }

  function hex4(self: mut Self): u32 uses Fail<JsonError> {
    let n: u32 = 0;
    let i = 0;
    while (i < 4) {
      if (self.pos >= self.bytes.len()) { throw #Syntax(self.pos); }
      const d = hexValue(self.bytes[self.pos]);
      if (d > 15) { throw #Syntax(self.pos); }
      n = n * 16 + d;
      self.pos += 1;
      i += 1;
    }
    n
  }

  // `\uXXXX`, with a surrogate pair for a code point beyond the basic plane.
  function unicode(self: mut Self, out: mut Vec<u8>): void uses Fail<JsonError> {
    let c = self.hex4();
    if (c >= 55296 && c < 56320) {
      if (!self.word("\\u")) { throw #Syntax(self.pos); }
      const lo = self.hex4();
      if (lo < 56320 || lo >= 57344) { throw #Syntax(self.pos); }
      c = 65536 + ((c - 55296) << 10) + (lo - 56320);
    }
    pushUtf8(mut out, c);
  }

  // Whether the byte before the cursor, ignoring whitespace, opened an array or object.
  function afterOpen(self: readonly Self): bool {
    let i = self.pos;
    while (i > 0 && isSpace(self.bytes[i - 1])) { i -= 1; }
    i > 0 && (self.bytes[i - 1] == b'[' || self.bytes[i - 1] == b'{')
  }

  // Whether another element follows before `close`, consuming the separating comma or `close`.
  function more(self: mut Self, close: u8): bool uses Fail<JsonError> {
    if (self.peek() == close) {
      self.pos += 1;
      return false;
    }
    if (!self.afterOpen()) { self.expect(b','); }
    true
  }

  export function beginArray(self: mut Self): void uses Fail<JsonError> { self.expect(b'['); }
  export function nextItem(self: mut Self): bool uses Fail<JsonError> { self.more(b']') }
  export function beginObject(self: mut Self): void uses Fail<JsonError> { self.expect(b'{'); }
  export function nextKey(self: mut Self): bool uses Fail<JsonError> { self.more(b'}') }

  // An object's key, and the `:` after it.
  export function key(self: mut Self): String uses Fail<JsonError> {
    const k = self.string();
    self.expect(b':');
    k
  }

  export function atString(self: mut Self): bool { self.peek() == b'"' }

  // Skips one value of any kind.
  export function skip(self: mut Self): void uses Fail<JsonError> {
    match (self.peek()) {
      b'{' => {
        self.pos += 1;
        while (self.more(b'}')) { self.key(); self.skip(); }
      },
      b'[' => {
        self.pos += 1;
        while (self.more(b']')) { self.skip(); }
      },
      b'"' => { self.string(); },
      b't' | b'f' => { self.bool(); },
      b'n' => { if (!self.eatNull()) { throw #Syntax(self.pos); } },
      _ => { self.number(); },
    }
  }

  // Only whitespace may follow the value.
  export function finish(self: mut Self): void uses Fail<JsonError> {
    if (self.peek() != 0) { throw #Syntax(self.pos); }
  }
}

impl FromJson for String {
  function fromJson(p: mut JsonParser): String uses Fail<JsonError> { p.string() }
}
impl<T extends FromJson> FromJson for Vec<T> {
  function fromJson(p: mut JsonParser): Vec<T> uses Fail<JsonError> {
    let v = Vec.new();
    p.beginArray();
    while (p.nextItem()) { v.push(T.fromJson(mut p)); }
    v
  }
}
impl<T extends FromJson> FromJson for Option<T> {
  function fromJson(p: mut JsonParser): Option<T> uses Fail<JsonError> {
    if (p.eatNull()) { #None } else { #Some(T.fromJson(mut p)) }
  }
}

// Whether a field's type is an `Option`, so its key may be left out.
comptime function isOption(T: Type): bool {
  match (Type.info(T)) {
    #Union(tags) =>
      tags.len() == 2
        && tags.any((t) => t.name == "None" && t.payload == #None)
        && tags.any((t) => t.name == "Some" && t.payload != #None),
    _ => false,
  }
}

impl<comptime T: Type> FromJson for T {
  function fromJson(p: mut JsonParser): T uses Fail<JsonError> {
    comptime match (Type.info(T)) {
      #Bool => p.bool(),
      #Float(_) => p.float() as T,
      // Any integer, checked against its range: the bounds are computed at compile time.
      #Int { signed, bits } => {
        const at = p.at();
        comptime if (signed) {
          const n = p.int();
          if (n < comptime -(1 << (bits - 1)) || n > comptime (1 << (bits - 1)) - 1) { throw #Range(at); }
          n as T
        } else {
          const n = p.uint();
          if (n > comptime (1 << bits) - 1) { throw #Range(at); }
          n as T
        }
      }
      #Record(fields) | #Struct { fields } => {
        let slots: { comptime for (const f of fields) { [f.name]: Option<f.type>; } } =
          { comptime for (const f of fields) { [f.name]: #None, } };
        p.beginObject();
        while (p.nextKey()) {
          const key = p.key();
          match (key.asStr()) {
            comptime for (const f of fields) {
              comptime f.name => { slots.[f.name] = #Some(f.type.fromJson(mut p)); },
            }
            _ => p.skip(),
          }
        }
        {
          comptime for (const f of fields) {
            [f.name]: match (slots.[f.name]) {
              #Some(v) => v,
              #None => comptime if (isOption(f.type)) { #None } else { throw #Missing(String.fromStr(f.name)) },
            },
          }
        }
      }
      #Tuple(items) => {
        p.beginArray();
        const v: T = [
          comptime for (const t of items) {
            if (!p.nextItem()) { throw #Syntax(p.at()); }
            t.fromJson(mut p)
          }
        ];
        if (p.nextItem()) { throw #Syntax(p.at()); }
        v
      }
      #Union(tags) | #Enum { tags } => {
        if (p.atString()) {
          const name = p.string();
          match (name.asStr()) {
            comptime for (const t of tags) {
              comptime if (t.payload == #None) { comptime t.name => #[t.name], }
            }
            _ => throw #Unknown(name),
          }
        } else {
          p.beginObject();
          if (!p.nextKey()) { throw #Syntax(p.at()); }
          const name = p.key();
          const v: T = match (name.asStr()) {
            comptime for (const t of tags) {
              comptime match (t.payload) {
                #Some(P) => { comptime t.name => #[t.name](P.fromJson(mut p)), }
                #None => {}
              }
            }
            _ => throw #Unknown(name),
          };
          if (p.nextKey()) { throw #Syntax(p.at()); }
          v
        }
      }
      _ => comptime panic(`${Type.name(T)} cannot be decoded from JSON`),
    }
  }
}
