// Data parallelism as library code (§6.5).

// A container whose elements can be worked on in parallel. `slice` lends a view of all of them,
// `split` divides a view into two disjoint ones, and `viewAt` lends one element of a view; the
// borrow rules prove the views disjoint, so `par` may hand them to different workers.
export interface ParSplit {
  type Slice;       // a splittable mutable view of a run of elements
  type View;        // a mutable view of one element
  type ReadView;    // a read-only view of one element
  function len(self: readonly Self): usize;
  function slice(self: mut Self): Self.Slice from self;
  function split(s: Self.Slice, at: usize): [Self.Slice, Self.Slice] from s;
  function viewAt(s: Self.Slice, i: usize): Self.View from s;
  function readAt(self: readonly Self, i: usize): Self.ReadView from self;
}

// Runs `a` and `b` and gives both results: at once, on two cores, when another is free. Both are
// pure, so whether they overlap cannot be seen; what each captures must be `Send`, as either may
// run on another core.
export function join<A extends Send, B extends Send>(a: once () => A, b: once () => B): [A, B];

// Fewer elements than this are worked on in order, by the worker that has them.
const GRAIN: usize = 16;

// Runs `f` on every element. The halves of each split are independent, so `join` may run them at
// once.
export function par<C extends ParSplit>(c: mut C, f: (v: C.View, i: usize) => void): void {
  const n = c.len();
  each<C>(c.slice(), 0, n, f);
}

// `f` is lent, so both halves call it.
function each<C extends ParSplit>(s: C.Slice, lo: usize, n: usize, f: readonly (v: C.View, i: usize) => void): void {
  if (n > GRAIN) {
    const half = n / 2;
    const [a, b] = C.split(s, half);
    join(() => each<C>(a, lo, half, f), () => each<C>(b, lo + half, n - half, f));
  } else if (n == 1) {
    f(C.viewAt(s, 0), lo);
  } else if (n > 1) {
    const half = n / 2;
    const [a, b] = C.split(s, half);
    each<C>(a, lo, half, f);
    each<C>(b, lo + half, n - half, f);
  }
}

// Folds every element with `one` and combines with `both`, which must be associative, starting
// from `zero`. Workers share the container `readonly`, and fold halves of it at once.
export function parReduce<C extends ParSplit, A extends Send>(
  c: readonly C,
  zero: A,
  one: (v: C.ReadView, i: usize) => A,
  both: (a: A, b: A) => A,
): A {
  const n = c.len();
  if (n == 0) { return zero; }
  both(zero, fold<C, A>(c, 0, n, one, both))
}

// The fold of elements `lo` up to `hi`, of which there is at least one.
function fold<C extends ParSplit, A extends Send>(c: readonly C, lo: usize, hi: usize, one: readonly (v: C.ReadView, i: usize) => A, both: readonly (a: A, b: A) => A): A {
  if (hi - lo > GRAIN) {
    const mid = lo + (hi - lo) / 2;
    const [a, b] = join(() => fold<C, A>(c, lo, mid, one, both), () => fold<C, A>(c, mid, hi, one, both));
    return both(a, b);
  }
  let acc = one(c.readAt(lo), lo);
  let i = lo + 1;
  while (i < hi) {
    acc = both(acc, one(c.readAt(i), i));
    i += 1;
  }
  acc
}

// The elements go to different workers, so they must be `Send`.
impl<T extends Send> ParSplit for T[] {
  type Slice = mut T[];
  type View = mut T;
  type ReadView = readonly T;
  function len(self: readonly Self): usize;
  function slice(self: mut Self): mut T[] from self;
  function split(s: mut T[], at: usize): [mut T[], mut T[]] from s;
  function viewAt(s: mut T[], i: usize): mut T from s;
  function readAt(self: readonly Self, i: usize): readonly T from self;
}

impl<T extends Send, comptime N: usize> ParSplit for T[N] {
  type Slice = mut T[];
  type View = mut T;
  type ReadView = readonly T;
  function len(self: readonly Self): usize;
  function slice(self: mut Self): mut T[] from self;
  function split(s: mut T[], at: usize): [mut T[], mut T[]] from s;
  function viewAt(s: mut T[], i: usize): mut T from s;
  function readAt(self: readonly Self, i: usize): readonly T from self;
}

impl<T extends Send> ParSplit for Vec<T> {
  type Slice = mut T[];
  type View = mut T;
  type ReadView = readonly T;
  function len(self: readonly Self): usize;
  function slice(self: mut Self): mut T[] from self;
  function split(s: mut T[], at: usize): [mut T[], mut T[]] from s;
  function viewAt(s: mut T[], i: usize): mut T from s;
  function readAt(self: readonly Self, i: usize): readonly T from self;
}
