import { parse, ParseError } from "./parse";
import { LexError } from "./lex";
import { File, println } from "std/io";

export function main(path: str): void uses Io {
  try {
    let f = File.open(path);
    const src = f.readText();
    try {
      const m = parse(src.asStr());
      println(`${path}: ${m.items.len()} items`);
    } catch (e) {
      match (e) {
        #ParseError { at, message } => println(`${path}:${at}: parse error: ${message}`),
        #LexError { at, message } => println(`${path}:${at}: lex error: ${message}`),
      }
    }
  } catch (e) {
    println(`io error`);
  }
}
