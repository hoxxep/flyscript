// The parser: Flyscript's grammar (§2.3), by recursive descent, with TypeScript's rules where it
// is ambiguous: braces that begin records, `<` that begins type arguments, block-like statements.

import { Span, Diagnostic } from "./diag";
import { Tok, Token, TemplatePart, lex, lexRange } from "./lex";
import {
  Ident, Module, Item, ItemKind, StructDecl, Field, Generate, EnumDecl, TagDecl, TagPayload, InterfaceDecl,
  InterfaceMember, ImplDecl, Method, TypeAlias, EffectDecl, FnSig, FnDecl, Param, Return, TypeParam, RowItem, Type,
  FnMode, TypeKind, Block, Stmt, Expr, FieldInit, TagArgs, TemplatePiece, ExprKind, MatchArm, HandlerArm, Pattern,
  PatternKind, TagPatArgs,
} from "./ast";

// Binary operators by precedence, lowest first. `as` binds tighter than all of them.
const BINARY: str[][] = [["||"], ["&&"], ["==", "!=", "<", ">", "<=", ">="], ["|"], ["^"], ["&"], ["<<", ">>"], ["+", "-"], ["*", "/", "%"]];

const ASSIGN: str[] = ["=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^="];

export function parseModule(src: str): Module uses Fail<Diagnostic> { parse(src, false) }

// A declaration file (`.d.fly`): functions may end in `;` and structs may be opaque.
export function parseDeclarations(src: str): Module uses Fail<Diagnostic> { parse(src, true) }

function parse(src: str, declarations: bool): Module uses Fail<Diagnostic> {
  let p = Parser { src, toks: lex(src), pos: 0, declarations, nextId: 0, guardArrow: #None };
  let items: Vec<Item> = Vec.new();
  while (!p.atEof()) { items.push(p.item()); }
  { items: items }
}

function mkIdent(name: str, span: Span): Ident { { name: name.toString(), span } }

function isUpper(s: str): bool {
  const b = s.asBytes();
  b.len() > 0 && b[0] >= b'A' && b[0] <= b'Z'
}

// `guardArrow`: while a `match` guard is parsed, the token index of its arm's `=>`: a
// parenthesized expression closing just before it ends the guard, rather than being a lambda's
// parameters.
view struct Parser { src: str; toks: Vec<Token>; pos: usize; declarations: bool; nextId: usize; guardArrow: Option<usize> }

impl Parser {
  // ---- nodes ----

  function expr_(self: mut Self, kind: ExprKind, span: Span): Expr {
    self.nextId += 1;
    { kind, span, id: self.nextId }
  }
  function pat_(self: mut Self, kind: PatternKind, span: Span): Pattern {
    self.nextId += 1;
    { kind, span, id: self.nextId }
  }

  // ---- tokens ----

  function tok(self: readonly Self): readonly Tok { self.toks[self.pos].tok }
  function tokAt(self: readonly Self, n: usize): readonly Tok { self.toks[min(self.pos + n, self.toks.len() - 1)].tok }
  function tokIndex(self: readonly Self, i: usize): readonly Tok { self.toks[min(i, self.toks.len() - 1)].tok }
  function span(self: readonly Self): Span { self.toks[self.pos].span }
  function prevEnd(self: readonly Self): usize { if (self.pos == 0) { 0 } else { self.toks[self.pos - 1].span.end } }
  function since(self: readonly Self, start: Span): Span { { start: start.start, end: max(self.prevEnd(), start.start) } }

  function bump(self: mut Self): Span {
    const s = self.span();
    if (self.pos < self.toks.len() - 1) { self.pos += 1; }
    s
  }

  function atEof(self: readonly Self): bool { self.tok() == #Eof }
  function isPunct(t: readonly Tok, p: str): bool { match (t) { #Punct(q) => q == p, _ => false } }
  function isKw(t: readonly Tok, k: str): bool { match (t) { #Kw(q) => q == k, _ => false } }
  function isWord(t: readonly Tok, w: str): bool { match (t) { #Ident(q) => q == w, _ => false } }
  function isIdent(t: readonly Tok): bool { match (t) { #Ident(_) => true, _ => false } }
  function at(self: readonly Self, p: str): bool { Parser.isPunct(self.tok(), p) }
  function atN(self: readonly Self, n: usize, p: str): bool { Parser.isPunct(self.tokAt(n), p) }
  function atKw(self: readonly Self, k: str): bool { Parser.isKw(self.tok(), k) }
  function atWord(self: readonly Self, w: str): bool { Parser.isWord(self.tok(), w) }
  function wordAt(self: readonly Self, n: usize, w: str): bool { Parser.isWord(self.tokAt(n), w) }

  // `match (e) {` at token `at`: the word begins a `match` only in that shape.
  function matchAt(self: readonly Self, at: usize): bool {
    Parser.isWord(self.tokIndex(at), "match") && Parser.isPunct(self.tokIndex(at + 1), "(")
      && match (self.closeFrom(at + 1)) { #Some(c) => Parser.isPunct(self.tokIndex(c + 1), "{"), #None => false }
  }

  // `handle {` or `region (R) {`: the other contextual expression words.
  function atHandle(self: readonly Self): bool { self.atWord("handle") && self.atN(1, "{") }
  function atRegion(self: readonly Self): bool {
    self.atWord("region") && self.atN(1, "(") && Parser.isIdent(self.tokAt(2)) && self.atN(3, ")") && self.atN(4, "{")
  }

  function eat(self: mut Self, p: str): bool { if (self.at(p)) { self.bump(); true } else { false } }
  function eatKw(self: mut Self, k: str): bool { if (self.atKw(k)) { self.bump(); true } else { false } }
  function eatWord(self: mut Self, w: str): bool { if (self.atWord(w)) { self.bump(); true } else { false } }

  function describe(self: readonly Self): String {
    match (self.tok()) {
      #Ident(s) | #Kw(s) | #Int(s) | #Float(s) => `\`${s}\``,
      #Byte(_) => "a byte literal".toString(),
      #Str(_) => "a string".toString(),
      #Template(_) => "a template literal".toString(),
      #Tag(s) => `\`#${s}\``,
      #Punct(p) => `\`${p}\``,
      #Eof => "end of file".toString(),
    }
  }

  function error(self: readonly Self, expected: str): never uses Fail<Diagnostic> {
    throw #Diagnostic { span: self.span(), message: `expected ${expected}, found ${self.describe()}` }
  }

  function expect(self: mut Self, p: str): Span uses Fail<Diagnostic> {
    if (self.at(p)) { self.bump() } else { self.error(`\`${p}\``) }
  }
  function expectKw(self: mut Self, k: str): Span uses Fail<Diagnostic> {
    if (self.atKw(k)) { self.bump() } else { self.error(`\`${k}\``) }
  }
  function expectWord(self: mut Self, w: str): void uses Fail<Diagnostic> {
    if (!self.eatWord(w)) { self.error(`\`${w}\``); }
  }
  function expectEof(self: readonly Self): void uses Fail<Diagnostic> {
    if (!self.atEof()) { self.error("end of input"); }
  }

  function ident(self: mut Self): Ident uses Fail<Diagnostic> {
    const name: String = match (self.tok()) { #Ident(n) => n.clone(), _ => self.error("an identifier") };
    const span = self.bump();
    { name, span }
  }

  // A member name: as in TypeScript, reserved words are allowed after `.`, as effect operation
  // names and as record fields, so `Yield.yield` and `{ default: 1 }` work.
  function memberName(self: mut Self): Ident uses Fail<Diagnostic> {
    if (const #Kw(k) = self.tok()) {
      const name = k.clone();
      const span = self.bump();
      return { name, span };
    }
    self.ident()
  }

  // Two adjacent single-character tokens, e.g. `>` `>` read as a shift operator.
  function adjacent(self: readonly Self, a: str, b: str): bool {
    self.at(a) && self.atN(1, b) && self.toks[self.pos].span.end == self.toks[self.pos + 1].span.start
  }

  // The bracket that closes the one at token `from`.
  function closeFrom(self: readonly Self, from: usize): Option<usize> {
    let depth: usize = 0;
    let i = from;
    while (i < self.toks.len()) {
      match (self.toks[i].tok) {
        #Punct(p) => {
          if (p == "(" || p == "[" || p == "{") { depth += 1; }
          else if (p == ")" || p == "]" || p == "}") {
            depth -= 1;
            if (depth == 0) { return #Some(i); }
          }
        }
        #Eof => return #None,
        _ => {}
      }
      i += 1;
    }
    #None
  }

  // ---- items ----

  function item(self: mut Self): Item uses Fail<Diagnostic> {
    const start = self.span();
    const exported = self.eatKw("export");
    const kind: ItemKind = if (self.atKw("import") && !exported) {
      self.importItem()
    } else if (self.at("@")) {
      const layout = self.layout();
      const view = self.eatWord("view");
      #Struct(self.structDecl(#Some(layout), view))
    } else if (self.atWord("view") && (Parser.isKw(self.tokAt(1), "struct") || Parser.isKw(self.tokAt(1), "enum"))) {
      self.bump();
      if (self.atKw("struct")) {
        #Struct(self.structDecl(#None, true))
      } else {
        let e = self.enumDecl();
        e.view = true;
        #Enum(e)
      }
    } else if (self.atKw("struct")) {
      #Struct(self.structDecl(#None, false))
    } else if (self.atKw("enum")) {
      #Enum(self.enumDecl())
    } else if (self.atKw("const")) {
      self.bump();
      const name = self.ident();
      const ty: Option<Type> = if (self.eat(":")) { #Some(self.ty()) } else { #None };
      self.expect("=");
      const value = self.expr();
      self.expect(";");
      #Const { name, ty, value }
    } else if (self.atKw("interface")) {
      #Interface(self.interfaceDecl())
    } else if (self.atKw("impl")) {
      #Impl(self.implDecl())
    } else if (self.atKw("type")) {
      #TypeAlias(self.typeAlias())
    } else if (self.atWord("effect") && Parser.isIdent(self.tokAt(1))) {
      #Effect(self.effectDecl())
    } else if (self.atKw("function") || self.atKw("comptime")) {
      #Function(self.fnDecl())
    } else if (self.atKw("extern")) {
      self.bump();
      match (self.tok()) {
        #Str(abi) if abi == "C" => { self.bump(); }
        _ => self.error("`\"C\"`"),
      }
      const sig = self.sig(true);
      self.expect(";");
      #Extern(sig)
    } else {
      self.error("a declaration")
    };
    { exported, kind, span: self.since(start) }
  }

  function importItem(self: mut Self): ItemKind uses Fail<Diagnostic> {
    self.expectKw("import");
    self.expect("{");
    let names: Vec<[Ident, Ident]> = Vec.new();
    while (!self.at("}")) {
      const name = self.ident();
      const local = if (self.eatKw("as")) { self.ident() } else { name.clone() };
      names.push([name, local]);
      if (!self.eat(",")) { break; }
    }
    self.expect("}");
    self.expectWord("from");
    const from: String = match (self.tok()) { #Str(s) => s.clone(), _ => self.error("a module path string") };
    self.bump();
    self.expect(";");
    #Import { names, from }
  }

  function layout(self: mut Self): Ident uses Fail<Diagnostic> {
    self.expect("@");
    self.expectWord("layout");
    self.expect("(");
    const kind = self.ident();
    self.expect(")");
    kind
  }

  function structDecl(self: mut Self, layout: Option<Ident>, view: bool): StructDecl uses Fail<Diagnostic> {
    self.expectKw("struct");
    const name = self.ident();
    const params = self.typeParams();
    const fields: Option<Vec<Field>> = if (self.declarations && self.eat(";")) { #None } else { #Some(self.fieldList()) };
    { layout, view, name, params, fields }
  }

  // `{ name: Type; … }` with `;` or `,` separators.
  function fieldList(self: mut Self): Vec<Field> uses Fail<Diagnostic> {
    self.expect("{");
    const fields = self.fieldItems();
    self.expect("}");
    fields
  }

  // Fields up to a closing `}`: `name: T`, `private name: T`, `[e]: T`, or generated ones.
  function fieldItems(self: mut Self): Vec<Field> uses Fail<Diagnostic> {
    let fields: Vec<Field> = Vec.new();
    while (!self.at("}") && !self.at("...")) {
      const generated = Parser.isKw(self.tokAt(1), "for") || Parser.isKw(self.tokAt(1), "if") || self.wordAt(1, "match");
      if (self.atKw("comptime") && !generated) {
        const start = self.span();
        self.bump();
        const e = self.expr();
        self.expect(";");
        fields.push(Field { name: mkIdent("", self.since(start)), ty: { kind: #EmptyRow, span: start }, private: false, computed: #None, generate: #Some(Box.new(#Do(e))) });
        continue;
      }
      if (self.atKw("comptime")) {
        const start = self.span();
        const g = self.generate((p) => p.fieldItems());
        fields.push(Field { name: mkIdent("", self.since(start)), ty: { kind: #EmptyRow, span: start }, private: false, computed: #None, generate: #Some(Box.new(g)) });
        if (!self.eat(";")) { self.eat(","); }
        continue;
      }
      const private = self.atWord("private") && Parser.isIdent(self.tokAt(1));
      if (private) { self.bump(); }
      const [name, computed] = self.entryName();
      self.expect(":");
      const ty = self.ty();
      fields.push(Field { name, ty, private, computed, generate: #None });
      if (!self.eat(";") && !self.eat(",")) { break; }
    }
    fields
  }

  // A field's name, or `[e]` for one computed by `comptime` code.
  function entryName(self: mut Self): [Ident, Option<Box<Expr>>] uses Fail<Diagnostic> {
    if (self.at("[")) {
      const start = self.span();
      self.bump();
      const e = self.expr();
      self.expect("]");
      return [mkIdent("", self.since(start)), #Some(Box.new(e))];
    }
    [self.memberName(), #None]
  }

  // `comptime for (const p of e) { … }`, `comptime if (c) { … } else { … }` or `comptime match`
  // in a sequence, the items between the braces parsed by `items`.
  function generate<T extends Send>(self: mut Self, items: mut (p: mut Parser) => Vec<T> uses Fail<Diagnostic>): Generate<T> uses Fail<Diagnostic> {
    self.expectKw("comptime");
    if (self.eatKw("for")) {
      self.expect("(");
      if (!self.eatKw("const") && !self.eatKw("let")) { self.error("`const`"); }
      const pat = self.patternOne();
      self.expectWord("of");
      const iter = self.expr();
      self.expect(")");
      self.expect("{");
      const body = items(mut self);
      self.expect("}");
      return #For { pat, iter, body };
    }
    if (self.eatKw("if")) {
      const cond = self.parenExpr();
      self.expect("{");
      const then = items(mut self);
      self.expect("}");
      let otherwise: Vec<T> = Vec.new();
      if (self.eatKw("else")) {
        self.expect("{");
        otherwise = items(mut self);
        self.expect("}");
      }
      return #If { cond, then, otherwise };
    }
    if (self.eatWord("match")) {
      const scrutinee = self.parenExpr();
      self.expect("{");
      let arms: Vec<[Pattern, Vec<T>]> = Vec.new();
      while (!self.at("}")) {
        const pat = self.pattern();
        self.expect("=>");
        self.expect("{");
        const group = items(mut self);
        self.expect("}");
        arms.push([pat, group]);
        self.eat(",");
      }
      self.expect("}");
      return #Match { scrutinee, arms };
    }
    self.error("`for`, `if` or `match` after `comptime`")
  }

  function enumDecl(self: mut Self): EnumDecl uses Fail<Diagnostic> {
    self.expectKw("enum");
    const name = self.ident();
    const params = self.typeParams();
    self.expect("{");
    let tags: Vec<TagDecl> = Vec.new();
    while (!self.at("}")) {
      tags.push(self.tagDecl());
      if (!self.eat(",")) { break; }
    }
    self.expect("}");
    { view: false, name, params, tags }
  }

  function tagDecl(self: mut Self): TagDecl uses Fail<Diagnostic> {
    const n: String = match (self.tok()) { #Tag(t) => t.clone(), _ => self.error("a tag such as `#Some`") };
    const name = mkIdent(n.asStr(), self.bump());
    const payload: TagPayload = if (self.at("(")) {
      self.bump();
      let tys: Vec<Type> = Vec.new();
      while (!self.at(")")) {
        tys.push(self.ty());
        if (!self.eat(",")) { break; }
      }
      self.expect(")");
      #Tuple(tys)
    } else if (self.at("{")) {
      #Record(self.fieldList())
    } else {
      #None
    };
    { name, payload }
  }

  function interfaceDecl(self: mut Self): InterfaceDecl uses Fail<Diagnostic> {
    self.expectKw("interface");
    const name = self.ident();
    const params = self.typeParams();
    const ext: Vec<Type> = if (self.eatKw("extends")) { self.bounds() } else { Vec.new() };
    self.expect("{");
    let members: Vec<InterfaceMember> = Vec.new();
    while (!self.at("}")) {
      if (self.eatKw("type")) {
        const aname = self.ident();
        const bounds: Vec<Type> = if (self.eatKw("extends")) { self.bounds() } else { Vec.new() };
        members.push(#AssocType { name: aname, bounds });
      } else {
        members.push(#Method(self.memberSig()));
      }
      self.expect(";");
    }
    self.expect("}");
    { name, params, extends: ext, members }
  }

  function implDecl(self: mut Self): ImplDecl uses Fail<Diagnostic> {
    self.expectKw("impl");
    const params = self.typeParams();
    const first = self.ty();
    let iface: Option<Type> = #None;
    let target = first;
    if (self.eatKw("for")) {
      iface = #Some(replace(mut target, self.ty()));
    }
    let methods: Vec<Method> = Vec.new();
    let assoc: Vec<[Ident, Type]> = Vec.new();
    if (iface.isSome() && self.eat(";")) {
      return { params, iface, target, methods, assoc, derived: true };
    }
    self.expect("{");
    while (!self.at("}")) {
      if (self.eatKw("type")) {
        const aname = self.ident();
        self.expect("=");
        assoc.push([aname, self.ty()]);
        self.expect(";");
        continue;
      }
      const exported = self.eatKw("export");
      const sig = self.memberSig();
      const body: Option<Block> = if (self.declarations && self.eat(";")) { #None } else { #Some(self.block()) };
      methods.push({ exported, decl: { sig, body } });
    }
    self.expect("}");
    { params, iface, target, methods, assoc, derived: false }
  }

  function typeAlias(self: mut Self): TypeAlias uses Fail<Diagnostic> {
    self.expectKw("type");
    const name = self.ident();
    const params = self.typeParams();
    self.expect("=");
    const ty = self.ty();
    self.expect(";");
    { name, params, ty }
  }

  function effectDecl(self: mut Self): EffectDecl uses Fail<Diagnostic> {
    self.expectWord("effect");
    const name = self.ident();
    const params = self.typeParams();
    self.expect("{");
    let ops: Vec<FnSig> = Vec.new();
    while (!self.at("}")) {
      // Operations are written without `function`; tolerate it for symmetry with interfaces.
      const withKw = self.atKw("function");
      ops.push(self.sig(withKw));
      self.expect(";");
    }
    self.expect("}");
    { name, params, ops }
  }

  function fnDecl(self: mut Self): FnDecl uses Fail<Diagnostic> {
    const sig = self.sig(true);
    const body: Option<Block> = if (self.declarations && self.eat(";")) { #None } else { #Some(self.block()) };
    { sig, body }
  }

  // A method's signature: its name may be any word, reserved ones included (§2.3).
  function memberSig(self: mut Self): FnSig uses Fail<Diagnostic> { self.sigNamed(true, true) }

  function sig(self: mut Self, functionKw: bool): FnSig uses Fail<Diagnostic> { self.sigNamed(functionKw, !functionKw) }

  function sigNamed(self: mut Self, functionKw: bool, member: bool): FnSig uses Fail<Diagnostic> {
    const start = self.span();
    const isComptime = self.eatKw("comptime");
    if (functionKw) { self.expectKw("function"); }
    const name = if (member) { self.memberName() } else { self.ident() };
    const typeParams = self.typeParams();
    const params = self.params(true);
    self.expect(":");
    const ret = self.ret();
    const row = self.uses();
    { isComptime, name, typeParams, params, ret, uses: row, span: self.since(start) }
  }

  function params(self: mut Self, typed: bool): Vec<Param> uses Fail<Diagnostic> {
    self.expect("(");
    let out: Vec<Param> = Vec.new();
    while (!self.at(")")) {
      const isComptime = self.eatKw("comptime");
      const name = self.ident();
      const ty: Option<Type> = if (self.eat(":")) {
        #Some(self.ty())
      } else if (typed) {
        self.error("`:` and a parameter type")
      } else {
        #None
      };
      out.push({ isComptime, name, ty });
      if (!self.eat(",")) { break; }
    }
    self.expect(")");
    out
  }

  // A lambda's parameters, which, as in TypeScript, may take their argument apart: `([k, v]) => …`
  // and `({ name }) => …` take a parameter and bind its parts with `const`.
  function lambdaParams(self: mut Self): [Vec<Param>, Vec<Stmt>] uses Fail<Diagnostic> {
    self.expect("(");
    let out: Vec<Param> = Vec.new();
    let unpack: Vec<Stmt> = Vec.new();
    while (!self.at(")")) {
      if (self.at("[") || self.at("{")) {
        const pat = self.pattern();
        const ty: Option<Type> = if (self.eat(":")) { #Some(self.ty()) } else { #None };
        const at: Span = { start: pat.span.end, end: pat.span.end };
        const name = mkIdent(`$${out.len()}`.asStr(), pat.span);
        const init = self.expr_(#Ident(name.name.clone()), at);
        const span = pat.span;
        unpack.push(#Let { mutable: false, pat, ty: #None, init, span });
        out.push({ isComptime: false, name, ty });
      } else {
        const isComptime = self.eatKw("comptime");
        const name = self.ident();
        const ty: Option<Type> = if (self.eat(":")) { #Some(self.ty()) } else { #None };
        out.push({ isComptime, name, ty });
      }
      if (!self.eat(",")) { break; }
    }
    self.expect(")");
    [out, unpack]
  }

  function ret(self: mut Self): Return uses Fail<Diagnostic> {
    const ty = self.ty();
    let from: Vec<Ident> = Vec.new();
    if (self.eatWord("from")) {
      from.push(self.ident());
      // More sources, unless the comma starts the next parameter (`, name:`).
      while (self.at(",") && Parser.isIdent(self.tokAt(1)) && !Parser.isPunct(self.tokAt(2), ":")) {
        self.bump();
        from.push(self.ident());
      }
    }
    { ty, from }
  }

  function uses(self: mut Self): Option<Vec<RowItem>> uses Fail<Diagnostic> {
    if (!self.eatKw("uses")) { return #None; }
    let row: Vec<RowItem> = Vec.new();
    row.push(self.rowItem());
    // A comma continues the row unless it starts the next parameter (`, name:`).
    while (self.at(",") && self.rowContinues()) {
      self.bump();
      row.push(self.rowItem());
    }
    #Some(row)
  }

  function rowContinues(self: readonly Self): bool {
    match (self.tokAt(1)) {
      #Punct(p) => p == "...",
      #Ident(_) => !self.atN(2, ":"),
      _ => false,
    }
  }

  function rowItem(self: mut Self): RowItem uses Fail<Diagnostic> {
    if (self.eat("...")) { return #Spread(self.ident()); }
    const start = self.span();
    const segments = self.path();
    const args = self.typeArgs();
    #Effect({ kind: #Path { segments, args }, span: self.since(start) })
  }

  function typeParams(self: mut Self): Vec<TypeParam> uses Fail<Diagnostic> {
    let out: Vec<TypeParam> = Vec.new();
    if (!self.eat("<")) { return out; }
    while (!self.at(">")) {
      const param: TypeParam = if (self.atWord("region") && Parser.isIdent(self.tokAt(1))) {
        self.bump();
        const name = self.ident();
        const default: Option<Type> = if (self.eat("=")) { #Some(self.ty()) } else { #None };
        #Region { name, default }
      } else if (self.atWord("row") && Parser.isIdent(self.tokAt(1))) {
        self.bump();
        const name = self.ident();
        const bounds: Vec<Type> = if (self.eatKw("extends")) { self.bounds() } else { Vec.new() };
        const default: Option<Type> = if (self.eat("=")) { #Some(self.ty()) } else { #None };
        #Row { name, bounds, default }
      } else if (self.eatKw("comptime")) {
        const name = self.ident();
        self.expect(":");
        #Comptime { name, ty: self.ty() }
      } else {
        const name = self.ident();
        const bounds: Vec<Type> = if (self.eatKw("extends")) { self.bounds() } else { Vec.new() };
        const default: Option<Type> = if (self.eat("=")) { #Some(self.ty()) } else { #None };
        #Type { name, bounds, default }
      };
      out.push(param);
      if (!self.eat(",")) { break; }
    }
    self.expect(">");
    out
  }

  function bounds(self: mut Self): Vec<Type> uses Fail<Diagnostic> {
    let out: Vec<Type> = Vec.new();
    out.push(self.tyPostfix());
    while (self.eat("&")) { out.push(self.tyPostfix()); }
    out
  }

  function path(self: mut Self): Vec<Ident> uses Fail<Diagnostic> {
    let segments: Vec<Ident> = Vec.new();
    segments.push(self.ident());
    while (self.at(".") && match (self.tokAt(1)) { #Ident(_) | #Kw(_) => true, _ => false }) {
      self.bump();
      segments.push(self.memberName());
    }
    segments
  }

  function typeArgs(self: mut Self): Vec<Type> uses Fail<Diagnostic> {
    let args: Vec<Type> = Vec.new();
    if (!self.eat("<")) { return args; }
    while (!self.at(">")) {
      args.push(self.ty());
      if (!self.eat(",")) { break; }
    }
    self.expect(">");
    args
  }

  // ---- types ----

  function ty(self: mut Self): Type uses Fail<Diagnostic> {
    const start = self.span();
    if (self.at("|") || match (self.tok()) { #Tag(_) => true, _ => false }) { return self.unionTy(); }
    // A named union followed by `|` starts a union that includes it: `JsonError | #Port(u16)`.
    if (Parser.isIdent(self.tok())) {
      const save = self.pos;
      const first = self.tyPostfix();
      if (!self.at("|")) { return first; }
      self.pos = save;
      return self.unionTy();
    }
    if (self.atKw("mut") && self.atN(1, "(")) {
      self.bump();
      return self.fnTy(#Mut, start);
    }
    if (self.eatKw("once")) { return self.fnTy(#Once, start); }
    if (self.eatKw("mut")) {
      const inner = self.ty();
      return { kind: #Mut(Box.new(inner)), span: self.since(start) };
    }
    if (self.eatKw("readonly")) {
      const inner = self.ty();
      return { kind: #Readonly(Box.new(inner)), span: self.since(start) };
    }
    if (self.at("(")) { return self.fnTy(#Shared, start); }
    self.tyPostfix()
  }

  function fnTy(self: mut Self, mode: FnMode, start: Span): Type uses Fail<Diagnostic> {
    const params = self.params(false);
    self.expect("=>");
    const ret = Box.new(self.ret());
    const row = self.uses();
    { kind: #Fn { mode, params, ret, uses: row }, span: self.since(start) }
  }

  function unionTy(self: mut Self): Type uses Fail<Diagnostic> {
    const start = self.span();
    self.eat("|");
    let tags: Vec<TagDecl> = Vec.new();
    let includes: Vec<Type> = Vec.new();
    let rest: Option<Ident> = #None;
    while (true) {
      if (self.eat("...")) {
        rest = #Some(self.ident());
        break;
      }
      if (Parser.isIdent(self.tok())) { includes.push(self.tyPostfix()); } else { tags.push(self.tagDecl()); }
      if (!self.eat("|")) { break; }
    }
    { kind: #Union { tags, includes, rest }, span: self.since(start) }
  }

  function tyPostfix(self: mut Self): Type uses Fail<Diagnostic> {
    const start = self.span();
    let ty = self.tyAtom();
    while (true) {
      if (self.at("[")) {
        self.bump();
        const len: Option<Box<Expr>> = if (self.at("]")) { #None } else { #Some(Box.new(self.expr())) };
        self.expect("]");
        ty = { kind: #Array { elem: Box.new(ty), len }, span: self.since(start) };
      } else if (self.at("*")) {
        self.bump();
        ty = { kind: #Ptr(Box.new(ty)), span: self.since(start) };
      } else {
        return ty;
      }
    }
    ty
  }

  function tyAtom(self: mut Self): Type uses Fail<Diagnostic> {
    const start = self.span();
    const kind: TypeKind = if (self.at("[")) {
      self.bump();
      if (self.eat("]")) {
        #EmptyRow
      } else {
        let tys: Vec<Type> = Vec.new();
        tys.push(self.ty());
        while (self.eat(",")) {
          if (self.at("]")) { break; }
          tys.push(self.ty());
        }
        self.expect("]");
        #Tuple(tys)
      }
    } else if (self.at("{")) {
      self.bump();
      let fields: Vec<Field> = Vec.new();
      let rest: Option<Ident> = #None;
      while (!self.at("}")) {
        if (self.eat("...")) {
          rest = #Some(self.ident());
          self.eat(";");
          break;
        }
        let items = self.fieldItems();
        if (items.len() == 0) { break; }
        for (const f of items.drain()) { fields.push(f); }
      }
      self.expect("}");
      #Record { fields, rest }
    } else if (self.eatKw("dyn")) {
      #Dyn(self.path())
    } else if (Parser.isIdent(self.tok())) {
      const segments = self.path();
      #Path { segments, args: self.typeArgs() }
    } else if (match (self.tok()) { #Int(_) => true, _ => false }) {
      #Expr(Box.new(self.primary()))
    } else {
      self.error("a type")
    };
    { kind, span: self.since(start) }
  }

  // ---- blocks and statements ----

  function block(self: mut Self): Block uses Fail<Diagnostic> {
    const start = self.expect("{");
    let stmts: Vec<Stmt> = Vec.new();
    let tail: Option<Box<Expr>> = #None;
    while (!self.at("}")) {
      if (self.atKw("const") || self.atKw("let")) {
        const s = self.span();
        const mutable = self.atKw("let");
        self.bump();
        const pat = self.patternOne();
        const ty: Option<Type> = if (self.eat(":")) { #Some(self.ty()) } else { #None };
        self.expect("=");
        const init = self.expr();
        self.expect(";");
        stmts.push(#Let { mutable, pat, ty, init, span: self.since(s) });
        continue;
      }
      if (self.eatKw("defer")) {
        // `defer { … }` defers a block, `defer e` an expression.
        const e = if (self.at("{")) { self.blockLike() } else { self.expr() };
        stmts.push(#Defer(e));
        self.expect(";");
        continue;
      }
      const blockLike = self.atBlockLike();
      const e = if (blockLike) { self.blockLike() } else { self.expr() };
      if (self.eat(";")) {
        stmts.push(#Expr(e));
      } else if (self.at("}")) {
        tail = #Some(Box.new(e));
      } else if (blockLike) {
        stmts.push(#Expr(e));
      } else {
        self.error("`;` or `}`");
      }
    }
    self.expect("}");
    { stmts, tail, span: self.since(start) }
  }

  // Whether the `{` at token `at` begins a record literal: it is followed by an entry (`name:`,
  // `[e]:`), or by a `comptime for` or `comptime if` whose items are entries. Flyscript has no
  // labeled statements, so such a brace never begins a block.
  function recordAt(self: readonly Self, at: usize): bool {
    const next = self.tokIndex(at + 1);
    match (next) {
      #Ident(_) | #Kw(_) if Parser.isPunct(self.tokIndex(at + 2), ":") => !Parser.isKw(next, "comptime"),
      // A shorthand entry followed by a comma: there is no comma operator, so no block starts
      // `{ name,` (`{ defs, main }`).
      #Ident(_) if Parser.isPunct(self.tokIndex(at + 2), ",") => true,
      #Punct(p) if p == "[" => match (self.closeFrom(at + 1)) { #Some(c) => Parser.isPunct(self.tokIndex(c + 1), ":"), #None => false },
      #Kw(k) if k == "comptime" && (Parser.isKw(self.tokIndex(at + 2), "for") || Parser.isKw(self.tokIndex(at + 2), "if")) && Parser.isPunct(self.tokIndex(at + 3), "(") => {
        match (self.closeFrom(at + 3)) { #Some(c) => Parser.isPunct(self.tokIndex(c + 1), "{") && self.recordAt(c + 1), #None => false }
      }
      _ => false,
    }
  }

  function atBlockLike(self: readonly Self): bool {
    if (self.at("{") && self.recordAt(self.pos)) { return false; }
    self.atKw("if") || self.atKw("while") || self.atKw("for") || self.atKw("try") || self.atKw("unsafe") || self.at("{")
      || self.matchAt(self.pos) || self.atHandle() || self.atRegion()
      || (self.atKw("comptime") && (Parser.isKw(self.tokAt(1), "if") || Parser.isKw(self.tokAt(1), "for") || self.matchAt(self.pos + 1)))
  }

  // A block-like expression in statement position: it is not continued by operators.
  function blockLike(self: mut Self): Expr uses Fail<Diagnostic> {
    if (self.at("{")) {
      const b = self.block();
      const span = b.span;
      return self.expr_(#Block(b), span);
    }
    if (self.atKw("comptime")) {
      const start = self.span();
      self.bump();
      const e = self.primary();
      return self.expr_(#Comptime(Box.new(e)), self.since(start));
    }
    self.primary()
  }

  // ---- expressions ----

  function expr(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    const lhs = self.range();
    match (ASSIGN.iter().find((op) => self.at(op))) {
      #Some(op) => {
        self.bump();
        const value = self.expr();
        self.expr_(#Assign { op: op.toString(), target: Box.new(lhs), value: Box.new(value) }, self.since(start))
      }
      #None => lhs,
    }
  }

  function range(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    let lo: Option<Box<Expr>> = #None;
    if (!self.at("..")) {
      const l = self.binary(0);
      if (!self.at("..")) { return l; }
      lo = #Some(Box.new(l));
    }
    self.bump();
    const closes = self.at("]") || self.at(")") || self.at(",") || self.at(";") || self.at("}");
    const hi: Option<Box<Expr>> = if (closes) { #None } else { #Some(Box.new(self.binary(0))) };
    self.expr_(#Range { lo, hi }, self.since(start))
  }

  function binaryOp(self: readonly Self, level: usize): Option<[String, usize]> {
    for (const op of BINARY[level]) {
      if (op == "<<") { if (self.adjacent("<", "<")) { return #Some(["<<".toString(), 2]); } continue; }
      if (op == ">>") { if (self.adjacent(">", ">")) { return #Some([">>".toString(), 2]); } continue; }
      if ((op == "<" || op == ">") && self.adjacent(op, op)) { continue; }
      if (self.at(op)) { return #Some([op.toString(), 1]); }
    }
    #None
  }

  function binary(self: mut Self, level: usize): Expr uses Fail<Diagnostic> {
    if (level == BINARY.len()) { return self.cast(); }
    const start = self.span();
    let lhs = self.binary(level + 1);
    while (const #Some([op, width]) = self.binaryOp(level)) {
      for (const _ of 0..width) { self.bump(); }
      const rhs = self.binary(level + 1);
      lhs = self.expr_(#Binary { op, lhs: Box.new(lhs), rhs: Box.new(rhs) }, self.since(start));
    }
    lhs
  }

  function cast(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    let e = self.unary();
    while (self.eatKw("as")) {
      const ty = self.tyPostfix();
      e = self.expr_(#Cast { expr: Box.new(e), ty }, self.since(start));
    }
    e
  }

  function unary(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    if (self.at("!") || self.at("-") || self.at("~")) {
      const op: String = match (self.tok()) { #Punct(p) => p.clone(), _ => String.new() };
      self.bump();
      const operand = self.unary();
      return self.expr_(#Unary { op, operand: Box.new(operand) }, self.since(start));
    }
    if (self.eatKw("mut")) {
      const inner = self.unary();
      return self.expr_(#BorrowMut(Box.new(inner)), self.since(start));
    }
    if (self.eatKw("throw")) {
      const inner = self.expr();
      return self.expr_(#Throw(Box.new(inner)), self.since(start));
    }
    if (self.eatKw("yield")) {
      const inner = self.expr();
      return self.expr_(#Yield(Box.new(inner)), self.since(start));
    }
    // A prefix operator, like TypeScript's `await`: `n < comptime -(1 << b)`.
    if (self.eatKw("comptime")) {
      const inner = self.unary();
      return self.expr_(#Comptime(Box.new(inner)), self.since(start));
    }
    if (self.eatKw("return")) {
      const bare = self.at(";") || self.at("}") || self.at(",") || self.at(")");
      const value: Option<Box<Expr>> = if (bare) { #None } else { #Some(Box.new(self.expr())) };
      return self.expr_(#Return(value), self.since(start));
    }
    self.postfix()
  }

  function postfix(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    let e = self.primary();
    while (true) {
      if (self.at(".") && self.atN(1, "[")) {
        self.bump();
        self.bump();
        const name = self.expr();
        self.expect("]");
        e = self.expr_(#FieldAt { target: Box.new(e), name: Box.new(name) }, self.since(start));
      } else if (self.at(".")) {
        self.bump();
        const name = self.memberName();
        e = self.expr_(#Field { target: Box.new(e), name }, self.since(start));
      } else if (self.at("(")) {
        const args = self.args();
        e = self.expr_(#Call { callee: Box.new(e), typeArgs: Vec.new(), args }, self.since(start));
      } else if (self.at("[")) {
        self.bump();
        const index = self.expr();
        self.expect("]");
        e = self.expr_(#Index { target: Box.new(e), index: Box.new(index) }, self.since(start));
      } else if (self.at("<") && match (e.kind) { #Ident(_) | #Field { target: _ } => true, _ => false }) {
        // TypeScript's rule: `f<…>(` is a generic call when the `<…>` parses as type arguments
        // and is followed directly by `(`; otherwise `<` is less-than.
        const saved = self.pos;
        const typeArgs: Option<Vec<Type>> = try {
          const ta = self.typeArgs();
          if (self.at("(")) { #Some(ta) } else { #None }
        } catch (_) { #None };
        match (typeArgs) {
          #Some(ta) => {
            const args = self.args();
            e = self.expr_(#Call { callee: Box.new(e), typeArgs: ta, args }, self.since(start));
          }
          #None => {
            self.pos = saved;
            return e;
          }
        }
      } else {
        return e;
      }
    }
    e
  }

  function tagArgs(self: mut Self): TagArgs uses Fail<Diagnostic> {
    if (self.at("(")) { #Tuple(self.args()) } else if (self.at("{")) { #Record(self.fieldInits()) } else { #None }
  }

  function args(self: mut Self): Vec<Expr> uses Fail<Diagnostic> {
    self.expect("(");
    let out: Vec<Expr> = Vec.new();
    while (!self.at(")")) {
      out.push(self.expr());
      if (!self.eat(",")) { break; }
    }
    self.expect(")");
    out
  }

  function isLambda(self: readonly Self): bool {
    match (self.closeFrom(self.pos)) {
      #Some(c) => Parser.isPunct(self.tokIndex(c + 1), "=>") && self.guardArrow != #Some(c + 1),
      #None => false,
    }
  }

  // The `=>` that ends a guard starting at the current token: the first at bracket depth 0.
  function arrowAhead(self: readonly Self): Option<usize> {
    let depth: usize = 0;
    let i = self.pos;
    while (i < self.toks.len()) {
      match (self.toks[i].tok) {
        #Punct(p) => {
          if (p == "(" || p == "[" || p == "{") { depth += 1; }
          else if (p == ")" || p == "]" || p == "}") {
            if (depth == 0) { return #None; }
            depth -= 1;
          } else if (p == "=>" && depth == 0) { return #Some(i); }
        }
        #Eof => return #None,
        _ => {}
      }
      i += 1;
    }
    #None
  }

  function primary(self: mut Self): Expr uses Fail<Diagnostic> {
    const start = self.span();
    const t = self.tok().clone();
    const kind: ExprKind = match (t) {
      #Int(s) => { self.bump(); #Int(s) }
      #Float(s) => { self.bump(); #Float(s) }
      #Byte(b) => { self.bump(); #Byte(b) }
      #Str(s) => { self.bump(); #Str(s) }
      #Template(parts) => { self.bump(); #Template(self.template(parts)) }
      #Kw(k) if k == "true" => { self.bump(); #Bool(true) }
      #Kw(k) if k == "false" => { self.bump(); #Bool(false) }
      #Kw(k) if k == "break" => { self.bump(); #Break }
      #Kw(k) if k == "continue" => { self.bump(); #Continue }
      #Tag(name) => {
        self.bump();
        #Tag { name, args: self.tagArgs() }
      }
      #Punct(p) if p == "#[" => {
        self.bump();
        const name = self.expr();
        self.expect("]");
        #TagAt { name: Box.new(name), args: self.tagArgs() }
      }
      #Ident(name) if !self.matchAt(self.pos) && !self.atRegion() && !self.atHandle() => {
        // `Name { … }` is a struct literal; blocks never follow an expression directly.
        if (isUpper(name.asStr()) && self.atN(1, "{")) {
          let path: Vec<Ident> = Vec.new();
          path.push(self.ident());
          #Record { name: #Some(path), fields: self.fieldInits() }
        } else {
          self.bump();
          #Ident(name)
        }
      }
      #Punct(p) if p == "(" && self.isLambda() => {
        const [params, unpack] = self.lambdaParams();
        self.expect("=>");
        const body: Expr = if (self.at("{")) {
          let b = self.block();
          let stmts = unpack;
          for (const s of b.stmts.drain()) { stmts.push(s); }
          b.stmts = stmts;
          const span = b.span;
          self.expr_(#Block(b), span)
        } else {
          const e = self.expr();
          if (unpack.len() == 0) {
            e
          } else {
            const span = e.span;
            self.expr_(#Block({ stmts: unpack, tail: #Some(Box.new(e)), span }), span)
          }
        };
        #Lambda { params, body: Box.new(body) }
      }
      #Punct(p) if p == "(" => {
        self.bump();
        const e = self.expr();
        self.expect(")");
        return e;
      }
      #Punct(p) if p == "[" => {
        self.bump();
        let items: Vec<Expr> = Vec.new();
        while (!self.at("]")) {
          items.push(self.expr());
          if (!self.eat(",")) { break; }
        }
        self.expect("]");
        #List(items)
      }
      #Punct(p) if p == "{" => #Record { name: #None, fields: self.fieldInits() },
      #Kw(k) if k == "if" => self.ifExpr(),
      #Kw(k) if k == "while" => self.whileExpr(),
      #Kw(k) if k == "for" => {
        self.bump();
        self.expect("(");
        const mutable = if (self.atKw("const")) { false } else if (self.atKw("let")) { true } else { self.error("`const` or `let`") };
        self.bump();
        const pat = self.patternOne();
        self.expectWord("of");
        const iter = self.expr();
        self.expect(")");
        #For { mutable, pat, iter: Box.new(iter), body: self.block() }
      }
      #Ident(w) if w == "match" && self.matchAt(self.pos) => {
        self.bump();
        const scrutinee = self.parenExpr();
        self.expect("{");
        const arms = self.armItems();
        self.expect("}");
        #Match { scrutinee: Box.new(scrutinee), arms }
      }
      #Kw(k) if k == "try" => {
        self.bump();
        const body = self.block();
        self.expectKw("catch");
        self.expect("(");
        const pat = self.pattern();
        self.expect(")");
        #Try { body, pat, handler: self.block() }
      }
      #Ident(_) if self.atRegion() => {
        self.bump();
        self.expect("(");
        const name = self.ident();
        self.expect(")");
        #Region { name, body: self.block() }
      }
      #Ident(_) if self.atHandle() => self.handleExpr(start),
      #Kw(k) if k == "unsafe" => {
        self.bump();
        #Unsafe(self.block())
      }
      _ => self.error("an expression"),
    };
    self.expr_(kind, self.since(start))
  }

  // `handle { … } with A { … } with B { … }` handles `A` innermost, then `B`.
  function handleExpr(self: mut Self, start: Span): ExprKind uses Fail<Diagnostic> {
    self.bump();
    let body = self.block();
    let handled: Option<ExprKind> = #None;
    while (self.eatWord("with")) {
      if (const #Some(kind) = handled.take()) {
        const span = self.since(start);
        const inner = self.expr_(kind, span);
        body = { stmts: Vec.new(), tail: #Some(Box.new(inner)), span };
      }
      const effect = self.tyPostfix();
      self.expect("{");
      let arms: Vec<HandlerArm> = Vec.new();
      while (!self.at("}")) {
        const op = self.memberName();
        self.expect("(");
        let params: Vec<Ident> = Vec.new();
        while (!self.at(")")) {
          params.push(self.ident());
          if (!self.eat(",")) { break; }
        }
        self.expect(")");
        const resumes: Option<Ident> = if (self.eatWord("resumes")) { #Some(self.ident()) } else { #None };
        self.expect("=>");
        // An arm's body is a block or an expression, as in `match`.
        const armBody: Block = if (self.at("{")) {
          const b = self.block();
          self.eat(",");
          b
        } else {
          const e = self.expr();
          const span = e.span;
          self.eat(",");
          { stmts: Vec.new(), tail: #Some(Box.new(e)), span }
        };
        arms.push({ op, params, resumes, body: armBody });
      }
      self.expect("}");
      handled = #Some(#Handle { body: replace(mut body, { stmts: Vec.new(), tail: #None, span: start }), effect, arms });
    }
    match (handled) {
      #Some(kind) => kind,
      #None => self.error("`with`"),
    }
  }

  // Match arms up to a closing `}`.
  function armItems(self: mut Self): Vec<MatchArm> uses Fail<Diagnostic> {
    let arms: Vec<MatchArm> = Vec.new();
    while (!self.at("}")) {
      if (self.atKw("comptime") && (Parser.isKw(self.tokAt(1), "for") || Parser.isKw(self.tokAt(1), "if") || self.wordAt(1, "match"))) {
        const start = self.span();
        const g = self.generate((p) => p.armItems());
        const span = self.since(start);
        const pat = self.pat_(#Wild, span);
        const body = self.expr_(#Break, span);
        arms.push(MatchArm { pat, guard: #None, body, generate: #Some(Box.new(g)) });
        self.eat(",");
        continue;
      }
      const pat = self.pattern();
      const guard: Option<Expr> = if (self.eatKw("if")) {
        const saved = replace(mut self.guardArrow, self.arrowAhead());
        const g = try { self.expr() } catch (d) { self.guardArrow = saved; throw d };
        self.guardArrow = saved;
        #Some(g)
      } else { #None };
      self.expect("=>");
      if (self.at("{")) {
        const b = self.block();
        const span = b.span;
        const body = self.expr_(#Block(b), span);
        arms.push(MatchArm { pat, guard, body, generate: #None });
        self.eat(",");
      } else {
        const body = self.expr();
        arms.push(MatchArm { pat, guard, body, generate: #None });
        if (!self.eat(",")) { break; }
      }
    }
    arms
  }

  function parenExpr(self: mut Self): Expr uses Fail<Diagnostic> {
    self.expect("(");
    const e = self.expr();
    self.expect(")");
    e
  }

  // The head and block of `if (const|let Pat = e) { … }` or its `while`, if that is next.
  // The conditions and block of `if (…) { … }` or its `while`, if a condition binds with `const`
  // or `let`: a chain of bindings and tests joined by `&&`, each binding's names in scope in what
  // follows it (§2.3).
  function chainHead(self: mut Self): Option<[Vec<Cond>, Block]> uses Fail<Diagnostic> {
    if (!(self.at("(") && self.chainAhead())) { return #None; }
    self.bump();
    let conds: Vec<Cond> = Vec.new();
    let names: Vec<[String, Span]> = Vec.new();
    while (true) {
      if (self.atKw("const") || self.atKw("let")) {
        const mutable = self.eatKw("let");
        if (!mutable) { self.bump(); }
        const pat = self.pattern();
        self.expect("=");
        // A binding's value stops at `&&`, which joins it to what follows.
        const init = self.binary(2);
        if (mutable) { boundNames(pat, mut names); }
        conds.push(#Bind(pat, init));
      } else {
        conds.push(#Test(self.binary(2)));
      }
      if (!self.at("&&")) { break; }
      self.bump();
    }
    self.expect(")");
    let body = self.block();
    // `let` makes the names it binds mutable in the block.
    if (names.len() > 0) {
      let stmts: Vec<Stmt> = Vec.new();
      for (const [name, span] of names) {
        const bind = self.pat_(#Bind(name.clone()), span);
        const init = self.expr_(#Ident(name.clone()), span);
        stmts.push(#Let { mutable: true, pat: bind, ty: #None, init, span });
      }
      for (const s of body.stmts.drain()) { stmts.push(s); }
      body.stmts = stmts;
    }
    #Some([conds, body])
  }

  // Whether the parenthesized condition ahead binds: has `const` or `let` outside any nesting.
  function chainAhead(self: readonly Self): bool {
    let depth: usize = 0;
    let i: usize = 1;
    while (true) {
      const t = self.tokAt(i);
      if (Parser.isPunct(t, "(") || Parser.isPunct(t, "[") || Parser.isPunct(t, "{")) {
        depth += 1;
      } else if (Parser.isPunct(t, ")") || Parser.isPunct(t, "]") || Parser.isPunct(t, "}")) {
        if (depth == 0) { return false; }
        depth -= 1;
      } else if (depth == 0 && (Parser.isKw(t, "const") || Parser.isKw(t, "let"))) {
        return true;
      } else if (match (t) { #Eof => true, _ => false }) {
        return false;
      }
      i += 1;
    }
    false
  }

  // A chain of conditions as `match`es and `if`s: `then` if every one holds, else `otherwise`,
  // which every condition that fails reaches. A binding followed only by tests is one arm with a
  // guard.
  function chain(self: mut Self, conds: readonly Vec<Cond>, from: usize, then: readonly Block, otherwise: readonly Expr, span: Span): Expr {
    if (from == conds.len()) { return self.expr_(#Block(then.clone()), then.span); }
    let tests: Vec<Expr> = Vec.new();
    for (const c of conds[from + 1..conds.len()]) { if (const #Test(x) = c) { tests.push(x.clone()); } }
    const onlyTests = tests.len() + from + 1 == conds.len();
    match (conds[from]) {
      #Bind(pat, init) => {
        let guard: Option<Expr> = #None;
        const body = if (onlyTests && tests.len() > 0) {
          let g = tests[0].clone();
          for (const t of tests[1..tests.len()]) {
            const gs: Span = { start: g.span.start, end: t.span.end };
            g = self.expr_(#Binary { op: "&&".toString(), lhs: Box.new(g), rhs: Box.new(t.clone()) }, gs);
          }
          guard = #Some(g);
          self.expr_(#Block(then.clone()), then.span)
        } else {
          self.chain(conds, from + 1, then, otherwise, span)
        };
        const rest = self.pat_(#Wild, otherwise.span);
        let arms: Vec<MatchArm> = Vec.new();
        arms.push(MatchArm { pat: pat.clone(), guard, body, generate: #None });
        arms.push(MatchArm { pat: rest, guard: #None, body: otherwise.clone(), generate: #None });
        self.expr_(#Match { scrutinee: Box.new(init.clone()), arms }, span)
      }
      #Test(c) => {
        const inner = self.chain(conds, from + 1, then, otherwise, span);
        const ispan = inner.span;
        const block: Block = { stmts: Vec.new(), tail: #Some(Box.new(inner)), span: ispan };
        self.expr_(#If { cond: Box.new(c.clone()), then: block, otherwise: #Some(Box.new(otherwise.clone())) }, span)
      }
    }
  }

  function ifExpr(self: mut Self): ExprKind uses Fail<Diagnostic> {
    self.expectKw("if");
    // `if (const #Some(x) = e && …) { … } else { … }` is `match`es and `if`s (§2.3).
    const head = self.span();
    if (const #Some([conds, then]) = self.chainHead()) {
      const start = self.span();
      const otherwise: Expr = if (self.eatKw("else")) {
        if (self.atKw("if")) {
          const kind = self.ifExpr();
          self.expr_(kind, self.since(start))
        } else {
          const b = self.block();
          const span = b.span;
          self.expr_(#Block(b), span)
        }
      } else {
        self.expr_(#Block({ stmts: Vec.new(), tail: #None, span: start }), start)
      };
      const span: Span = { start: head.start, end: self.prevEnd() };
      const e = self.chain(conds, 0, then, otherwise, span);
      return e.kind;
    }
    const cond = self.parenExpr();
    const then = self.block();
    const otherwise: Option<Box<Expr>> = if (self.eatKw("else")) {
      const start = self.span();
      const e: Expr = if (self.atKw("if")) {
        const kind = self.ifExpr();
        self.expr_(kind, self.since(start))
      } else {
        const b = self.block();
        const span = b.span;
        self.expr_(#Block(b), span)
      };
      #Some(Box.new(e))
    } else { #None };
    #If { cond: Box.new(cond), then, otherwise }
  }

  function whileExpr(self: mut Self): ExprKind uses Fail<Diagnostic> {
    const kw = self.span();
    self.bump();
    // `while (const #Some(x) = e && …) { … }` loops while its conditions hold.
    if (const #Some([conds, body]) = self.chainHead()) {
      // Each piece has a span of its own, as the Rust prototype keys what it records by span.
      const all: Span = { start: kw.start, end: body.span.end };
      const end: Span = { start: body.span.end, end: body.span.end };
      const first = match (conds[0]) { #Bind(_, e) | #Test(e) => e.span.start };
      const head: Span = { start: first, end: body.span.end };
      const brk = self.expr_(#Break, end);
      const m = self.chain(conds, 0, body, brk, head);
      const yes = self.expr_(#Bool(true), kw);
      let stmts: Vec<Stmt> = Vec.new();
      stmts.push(#Expr(m));
      return #While { cond: Box.new(yes), body: { stmts, tail: #None, span: all } };
    }
    const cond = self.parenExpr();
    #While { cond: Box.new(cond), body: self.block() }
  }

  function fieldInits(self: mut Self): Vec<FieldInit> uses Fail<Diagnostic> {
    self.expect("{");
    const fields = self.initItems();
    self.expect("}");
    fields
  }

  // Record-literal entries up to a closing `}`.
  function initItems(self: mut Self): Vec<FieldInit> uses Fail<Diagnostic> {
    let fields: Vec<FieldInit> = Vec.new();
    while (!self.at("}")) {
      if (self.atKw("comptime") && (Parser.isKw(self.tokAt(1), "for") || Parser.isKw(self.tokAt(1), "if") || self.wordAt(1, "match"))) {
        const start = self.span();
        const g = self.generate((p) => p.initItems());
        fields.push(FieldInit { name: mkIdent("", self.since(start)), value: #None, computed: #None, generate: #Some(Box.new(g)) });
        self.eat(",");
        continue;
      }
      const [name, computed] = self.entryName();
      const value: Option<Expr> = if (computed.isSome() || self.at(":")) {
        self.expect(":");
        #Some(self.expr())
      } else { #None };
      fields.push(FieldInit { name, value, computed, generate: #None });
      if (!self.eat(",")) { break; }
    }
    fields
  }

  function template(self: mut Self, parts: Vec<TemplatePart>): Vec<TemplatePiece> uses Fail<Diagnostic> {
    let out: Vec<TemplatePiece> = Vec.new();
    for (const part of parts) {
      match (part) {
        #Lit(s) => out.push(#Lit(s.clone())),
        #Expr(span) => {
          let sub = Parser { src: self.src, toks: lexRange(self.src, span.start, span.end), pos: 0, declarations: false, nextId: self.nextId, guardArrow: #None };
          const e = sub.expr();
          sub.expectEof();
          self.nextId = sub.nextId;
          out.push(#Expr(e));
        }
      }
    }
    out
  }

  // ---- patterns ----

  function pattern(self: mut Self): Pattern uses Fail<Diagnostic> {
    const start = self.span();
    const first = self.patternOne();
    if (!self.at("|")) { return first; }
    let alts: Vec<Pattern> = Vec.new();
    alts.push(first);
    while (self.eat("|")) { alts.push(self.patternOne()); }
    self.pat_(#Or(alts), self.since(start))
  }

  function patternOne(self: mut Self): Pattern uses Fail<Diagnostic> {
    const start = self.span();
    const t = self.tok().clone();
    const kind: PatternKind = match (t) {
      #Ident(name) if name == "_" => { self.bump(); #Wild }
      #Ident(name) if isUpper(name.asStr()) && self.atN(1, "{") => {
        let path: Vec<Ident> = Vec.new();
        path.push(self.ident());
        #Record { name: #Some(path), fields: self.fieldPats() }
      }
      #Ident(name) => { self.bump(); #Bind(name) }
      #Tag(name) => {
        self.bump();
        #Tag { name, args: self.tagPatArgs() }
      }
      #Punct(p) if p == "#[" => {
        self.bump();
        const name = self.expr();
        self.expect("]");
        #TagAt { name: Box.new(name), args: self.tagPatArgs() }
      }
      // A value computed by `comptime` code: `comptime f.name => …`.
      #Kw(k) if k == "comptime" => {
        const cstart = self.span();
        self.bump();
        const e = self.postfix();
        #Lit(Box.new(self.expr_(#Comptime(Box.new(e)), self.since(cstart))))
      }
      #Punct(p) if p == "[" => {
        self.bump();
        let pats: Vec<Pattern> = Vec.new();
        while (!self.at("]")) {
          pats.push(self.pattern());
          if (!self.eat(",")) { break; }
        }
        self.expect("]");
        #Tuple(pats)
      }
      #Punct(p) if p == "{" => #Record { name: #None, fields: self.fieldPats() },
      #Int(_) | #Float(_) | #Byte(_) | #Str(_) => #Lit(Box.new(self.primary())),
      #Kw(k) if k == "true" || k == "false" => #Lit(Box.new(self.primary())),
      #Punct(p) if p == "-" => #Lit(Box.new(self.unary())),
      _ => self.error("a pattern"),
    };
    self.pat_(kind, self.since(start))
  }

  function tagPatArgs(self: mut Self): TagPatArgs uses Fail<Diagnostic> {
    if (self.at("(")) {
      self.bump();
      let pats: Vec<Pattern> = Vec.new();
      while (!self.at(")")) {
        pats.push(self.pattern());
        if (!self.eat(",")) { break; }
      }
      self.expect(")");
      #Tuple(pats)
    } else if (self.at("{")) {
      #Record(self.fieldPats())
    } else {
      #None
    }
  }

  function fieldPats(self: mut Self): Vec<[Ident, Option<Pattern>]> uses Fail<Diagnostic> {
    self.expect("{");
    let fields: Vec<[Ident, Option<Pattern>]> = Vec.new();
    while (!self.at("}")) {
      // A field's name may be a reserved word, as in a declaration or a literal; such a field is
      // bound to a name of its own (`{ uses: row }`).
      const reserved = match (self.tok()) { #Kw(_) => true, _ => false };
      const name = self.memberName();
      const pat: Option<Pattern> = if (self.eat(":")) {
        #Some(self.pattern())
      } else if (reserved) {
        throw #Diagnostic { span: name.span, message: `\`${name.name}\` is a reserved word: bind the field to a name, \`${name.name}: x\`` }
      } else {
        // `{ x }` binds `x`: a pattern of its own, as later passes record what bindings are.
        #Some(self.pat_(#Bind(name.name.clone()), name.span))
      };
      fields.push([name, pat]);
      if (!self.eat(",")) { break; }
    }
    self.expect("}");
    fields
  }
}

// The names a pattern binds, with where.
// One condition of a chain: a binding, `const Pat = e`, or a test.
enum Cond { #Bind(Pattern, Expr), #Test(Expr) }

export function boundNames(p: readonly Pattern, out: mut Vec<[String, Span]>): void {
  match (p.kind) {
    #Bind(n) => out.push([n.clone(), p.span]),
    #Tuple(ps) | #Or(ps) => { for (const q of ps) { boundNames(q, mut out); } }
    #Record { fields } => { boundFields(fields, mut out); }
    #Tag { args } | #TagAt { args } => match (args) {
      #None => {}
      #Tuple(ps) => { for (const q of ps) { boundNames(q, mut out); } }
      #Record(fs) => { boundFields(fs, mut out); }
    },
    _ => {}
  }
}

function boundFields(fields: readonly Vec<[Ident, Option<Pattern>]>, out: mut Vec<[String, Span]>): void {
  for (const [n, q] of fields) {
    match (q) {
      #Some(q) => boundNames(q, mut out),
      #None => out.push([n.name.clone(), n.span]),
    }
  }
}
