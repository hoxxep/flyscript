// The compiler's driver: `main(entry, out, root)` checks the program whose entry module is `entry`
// and compiles it to one JavaScript file `out`, which starts with the runtime and ends by calling
// the entry's `main` with the command line. `root` is the directory that holds `std/` and
// `selfhost/runtime.js`.

import { Diagnostic, render } from "./diag";
import { Module, Item, ItemKind } from "./ast";
import { Program } from "./env";
import { checkFn } from "./check";
import { survey, module } from "./gen";
import { File, println, writeFile } from "std/io";
import { HashMap } from "std/collections";

// What stops a compilation: diagnostics, or a file that cannot be read or written.
type Stop = #Failed | #Unreadable { path: String };

function isUpper(s: str): bool {
  const b = s.asBytes();
  b.len() > 0 && b[0] >= b'A' && b[0] <= b'Z'
}

// What module `k` can see by name: its own functions and constants, and what it imports.
function namesOf(p: readonly Program, k: usize): HashMap<String, String> {
  let names: HashMap<String, String> = HashMap.new();
  for (const item of p.modules[k].ast.items) {
    match (item.kind) {
      #Function(f) => { names.insert(f.sig.name.name.clone(), `m${k}$${f.sig.name.name}`); }
      #Const { name, ty: _, value: _ } => { names.insert(name.name.clone(), `m${k}$${name.name}`); }
      #Import { names: imported, from } => {
        if (from.startsWith("std/")) {
          // The standard library is the runtime's; its types are known by name.
          for (const [name, local] of imported) {
            if (!isUpper(name.name.asStr())) { names.insert(local.name.clone(), `$rt.${name.name}`); }
          }
        } else {
          const j = match (p.importedModule(k, from.asStr())) { #Some(j) => j, #None => continue };
          for (const [name, local] of imported) {
            for (const other of p.modules[j].ast.items) {
              const declares = match (other.kind) {
                #Function(f) => f.sig.name.name == name.name,
                #Const { name: c, ty: _, value: _ } => c.name == name.name,
                _ => false,
              };
              if (declares) { names.insert(local.name.clone(), `m${j}$${name.name}`); }
            }
          }
        }
      }
      _ => {}
    }
  }
  names
}

// The program's diagnostics, each with the source line it is about.
function report(p: readonly Program): void uses Io {
  for (const [m, d] of p.diags) {
    if (m < p.modules.len()) {
      println(render(d, p.modules[m].file.asStr(), p.modules[m].source.asStr()).asStr());
    } else {
      const #Diagnostic { span: _, message } = d;
      println(`error: ${message}`);
    }
  }
}

function compile(entry: str, out: str, root: str): void uses Io, Fail<Stop> {
  let p = Program.load([entry.toString()], `${root}/std`.asStr());
  if (p.diags.len() == 0) {
    let fid: usize = 0;
    while (fid < p.fns.len()) {
      checkFn(mut p, fid);
      fid += 1;
    }
  }
  if (p.diags.len() > 0) {
    report(p);
    throw #Failed;
  }
  let user: Vec<usize> = Vec.new();
  for (const [k, m] of p.modules.iter().enumerate()) { if (!m.isStd) { user.push(k); } }
  let asts: Vec<Module> = Vec.new();
  for (const k of user) { asts.push(p.modules[k].ast.clone()); }
  const world = survey(asts);
  const runtime = `${root}/selfhost/runtime.js`;
  const rt: String = try {
    let f = File.open(runtime.asStr());
    f.readText()
  } catch (_) { throw #Unreadable { path: runtime } };
  let js = rt;
  let main: usize = 0;
  for (const k of user) {
    js.push(`\n// ${p.modules[k].file}\n`);
    const code = try {
      module(p.modules[k].ast, `m${k}$`.asStr(), namesOf(p, k), world.clone())
    } catch (d) {
      p.diags.push([k, d]);
      report(p);
      throw #Failed
    };
    js.push(code.asStr());
    if (p.modules[k].file.asStr() == p.entryFile(entry).asStr()) { main = k; }
  }
  js.push(`\n$rt.start(m${main}$main);\n`);
  try { writeFile(out, js.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
}

export function main(entry: str, out: str, root: str): void uses Io {
  try {
    compile(entry, out, root);
  } catch (e) {
    match (e) {
      #Failed => {}
      #Unreadable { path } => println(`error: cannot read or write ${path}`),
    }
  }
}
