// The compiler's driver: `main(entry, out, root)` checks the program whose entry module is `entry`
// — types and effects, then ownership — and compiles it to one file `out`: C if its name ends in
// `.c`, JavaScript otherwise, starting with the runtime and ending by calling the entry's `main`
// with the command line. A name ending in `.ll` is an LLVM module, with the C it links with — the
// runtime, and what the module calls of it — beside it, its name ending in `.c` instead. `root` is
// the directory that holds `std/` and `selfhost/`.

import { Diagnostic, render } from "./diag";
import { Program } from "./env";
import { checkFn } from "./check";
import { checkOwnership } from "./own";
import { cProgram } from "./c";
import { jsProgram } from "./js";
import { llvmProgram } from "./llvm";
import { File, println, writeFile } from "std/io";

// What stops a compilation: diagnostics, or a file that cannot be read or written.
type Stop = #Failed | #Unreadable { path: String };

// The program's diagnostics, each with the source line it is about.
function report(p: readonly Program): void uses Io {
  for (const [m, d] of p.diags) {
    if (m < p.modules.len()) {
      println(render(d, p.modules[m].file.asStr(), p.modules[m].source.asStr()).asStr());
    } else {
      const #Diagnostic { span: _, message } = d;
      println(`error: ${message}`);
    }
  }
}

function readText(path: String): String uses Io, Fail<Stop> {
  try {
    let f = File.open(path.asStr());
    f.readText()
  } catch (_) { throw #Unreadable { path } }
}

function compile(entry: str, out: str, root: str, freestanding: bool): void uses Io, Fail<Stop> {
  let p = Program.load([entry.toString()], `${root}/std`.asStr());
  if (p.diags.len() == 0) {
    let fid: usize = 0;
    while (fid < p.fns.len()) {
      checkFn(mut p, fid);
      fid += 1;
    }
  }
  // Ownership needs well-typed bodies.
  if (p.diags.len() == 0) {
    for (const f of 0..p.fns.len()) { checkOwnership(mut p, f); }
  }
  if (p.diags.len() > 0) {
    report(p);
    throw #Failed;
  }
  const file = p.entryFile(entry);
  const main = match (p.modules.iter().findIndex((m) => m.file == file)) { #Some(k) => k, #None => throw #Unreadable { path: file } };
  const toLlvm = out.endsWith(".ll");
  const toC = out.endsWith(".c") || toLlvm;
  // The C runtime is its header and its code, made one file.
  const rt: String = if (toC) {
    const h = readText(`${root}/selfhost/runtime.h`);
    const c = readText(`${root}/selfhost/runtime.c`);
    // A freestanding program's runtime does without the C library.
    const mode = if (freestanding) { "#define FLY_FREESTANDING 1\n" } else { "" };
    `${mode}${h}\n${c.asStr().replaceAll("#include \"runtime.h\"", "")}`
  } else { readText(`${root}/selfhost/runtime.js`) };
  if (toLlvm) {
    const [ll, c] = try { llvmProgram(p, main, rt.asStr(), freestanding) } catch (#Failed(message)) {
      println(message.asStr());
      throw #Failed
    };
    const companion = `${out.slice(0, out.len() - 3)}.c`;
    try { writeFile(out, ll.asStr()); writeFile(companion.asStr(), c.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
    return;
  }
  const code = try {
    if (toC) { cProgram(p, main, rt.asStr(), freestanding) } else if (freestanding) { throw #Failed("error: a freestanding program compiles only to C".toString()) } else { jsProgram(p, main, rt.asStr()) }
  } catch (#Failed(message)) {
    println(message.asStr());
    throw #Failed
  };
  try { writeFile(out, code.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
}

// `--freestanding`: a program without the C library, whose roots are the functions C calls.
export function main(entry: str, out: str, root: str, flags: readonly String[]): void uses Io {
  try {
    compile(entry, out, root, flags.iter().some((f) => f == "--freestanding"));
  } catch (e) {
    match (e) {
      #Failed => {}
      #Unreadable { path } => println(`error: cannot read or write ${path}`),
    }
  }
}
