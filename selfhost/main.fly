// The compiler's driver: `main(entry, out, root)` checks the program whose entry module is `entry`
// — types and effects, then ownership — and compiles it to one file `out`: C if its name ends in
// `.c`, JavaScript otherwise, starting with the runtime and ending by calling the entry's `main`
// with the command line. A name ending in `.ll` is an LLVM module, with the C it links with — the
// runtime, and what the module calls of it — beside it, its name ending in `.c` instead. `root` is
// the directory that holds `std/` and `selfhost/`.

import { Diagnostic, diag, renderIn } from "./diag";
import { Program, RUNTIME, FREESTANDING, rendered } from "./env";
import { checkFn } from "./check";
import { checkOwnership } from "./own";
import { cProgram } from "./c";
import { jsProgram } from "./js";
import { llvmProgram } from "./llvm";
import { watch } from "./watch";
import { coreProgram } from "./core";
import { lex, Tok } from "./lex";
import { writeEffs } from "./types";
import { File, println, eprintln, writeFile, exit } from "std/io";
import { isDir, listDir, join } from "std/fs";

// What stops a compilation: diagnostics, or a file that cannot be read or written.
type Stop = #Failed | #Unreadable { path: String };

// The program's diagnostics, each with the source line it is about.
function report(p: readonly Program): void uses Io {
  for (const [m, d] of p.diags) {
    if (m < p.modules.len()) {
      println(rendered(p.modules[m], d).asStr());
    } else {
      const #Diagnostic { span: _, message } = d;
      println(`error: ${message}`);
    }
  }
}

function readText(path: String): String uses Io, Fail<Stop> {
  try {
    let f = File.open(path.asStr());
    f.readText()
  } catch (_) { throw #Unreadable { path } }
}

// With `--time`, how long each phase took, on standard error.
struct Clock { on: bool; at: Instant }

impl Clock {
  function lap(self: mut Self, phase: str): void uses Io {
    const now = Io.now();
    if (self.on) { eprintln(`${phase}: ${now.since(self.at).toMs()} ms`); }
    self.at = now;
  }
}

// `--interface`: what each module but the standard library's offers, for `fly`'s lockfile to hold
// a package to (docs/fly.md): `module` and its file, `unsafe` if it vouches for raw pointers or
// foreign code — an `unsafe` block, an `extern` function — then `fn` and each exported function,
// a method by its type, with the effects it declares, in order.
function interfaceOf(p: readonly Program): String {
  const names = p.defNames();
  let out = String.new();
  for (const [m, info] of p.modules.iter().enumerate()) {
    if (info.isStd) { continue; }
    out.push(`module ${info.file}\n`);
    const vouches = try {
      lex(info.source.asStr()).iter().some((t) => t.tok == #Kw("unsafe".toString()) || t.tok == #Kw("extern".toString()))
    } catch (_) { true };
    if (vouches) { out.push("unsafe\n"); }
    let fns: Vec<String> = Vec.new();
    for (const f of p.fns.iter()) {
      if (f.module != m || !f.exported) { continue; }
      let line = match (f.implId) { #Some(i) => `fn ${p.show(p.impls[i].target)}.${f.name}:`, #None => `fn ${f.name}:` };
      if (const #Some(r) = f.scheme.effects) {
        if (r.effs.len() > 0 || r.tail != #Closed) {
          line.push(" ");
          writeEffs(r, names, mut line);
        }
      }
      fns.push(line);
    }
    fns.sort();
    for (const l of fns) { out.push(l); out.push("\n"); }
  }
  out
}

// The modules of a package's directory, for `--interface`: every `.fly` file under it but those of
// its tests and what it builds.
function packageFiles(dir: str, out: mut Vec<String>): void uses Io {
  const names = try { listDir(dir) } catch (_) { return };
  for (const n of names) {
    const path = join(dir, n.asStr());
    if (isDir(path.asStr())) {
      if (n != "tests" && n != "target" && !n.asStr().startsWith(".")) { packageFiles(path.asStr(), mut out); }
    } else if (n.asStr().endsWith(".fly") && !n.asStr().endsWith(".d.fly")) {
      out.push(path);
    }
  }
}

// The C runtime, its header and its code made one file. A freestanding program's does without the C
// library; a program's whole C unwinds a panic by C's cleanups (runtime.c's FLY_C_UNWIND), and the
// C beside a module made through LLVM by the module's landing pads, as its build says.
function cRuntime(root: str, freestanding: bool, toLlvm: bool): String uses Io, Fail<Stop> {
  const h = readText(`${root}/selfhost/runtime.h`);
  const c = readText(`${root}/selfhost/runtime.c`);
  const mode = if (freestanding) { "#define FLY_FREESTANDING 1\n" } else if (!toLlvm) { "#define FLY_C_UNWIND 1\n" } else { "" };
  `${mode}${h}\n${c.asStr().replaceAll("#include \"runtime.h\"", "")}`
}

function compile(entry: str, out: str, root: str, freestanding: bool, ptr: usize, time: bool, core: Option<String>, interfaces: bool): void uses Io, Fail<Stop> {
  let clock = Clock { on: time, at: Io.now() };
  // With `--interface`, an entry that is a directory is a package with no program: all of it.
  let entries: Vec<String> = Vec.new();
  if (interfaces && isDir(entry)) { packageFiles(entry, mut entries); } else { entries.push(entry.toString()); }
  // A native or WebAssembly program has the runtime's Flyscript, which the runtime's C calls.
  if (!interfaces && core.isNone() && (out.endsWith(".c") || out.endsWith(".ll"))) {
    for (const [i, m] of RUNTIME.iter().enumerate()) {
      if (!freestanding || i < FREESTANDING) { entries.push(`${root}/selfhost/rt/${m}`); }
    }
  }
  let p = Program.load(entries, `${root}/std`.asStr());
  clock.lap("load");
  if (p.diags.len() == 0) {
    let fid: usize = 0;
    while (fid < p.fns.len()) {
      checkFn(mut p, fid);
      fid += 1;
    }
  }
  clock.lap("check");
  // Ownership needs well-typed bodies.
  if (p.diags.len() == 0) {
    for (const f of 0..p.fns.len()) { checkOwnership(mut p, f); }
  }
  clock.lap("ownership");
  if (p.diags.len() > 0) {
    report(p);
    throw #Failed;
  }
  if (interfaces) {
    try { writeFile(out, interfaceOf(p).asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
    return;
  }
  // `--core=root`: the program `root` reaches, elaborated into λ-fly, for the proof to certify.
  if (const #Some(root) = core) {
    const file = p.entryFile(entry);
    const m = match (p.modules.iter().findIndex((x) => x.file == file)) { #Some(k) => k, #None => throw #Unreadable { path: file } };
    const name = p.modules[m].file.clone();
    const source = p.modules[m].source.clone();
    const origin = p.modules[m].origin.clone();
    const text = try { coreProgram(p, m, root.asStr()) } catch (#Outside(span, why)) {
      println(renderIn(diag(span, why.asStr()), name.asStr(), source.asStr(), origin).asStr());
      throw #Failed
    };
    try { writeFile(out, text.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
    return;
  }
  const file = p.entryFile(entry);
  const main = match (p.modules.iter().findIndex((m) => m.file == file)) { #Some(k) => k, #None => throw #Unreadable { path: file } };
  const toLlvm = out.endsWith(".ll");
  const toC = out.endsWith(".c") || toLlvm;
  // The C runtime is its header and its code, made one file.
  const rt: String = if (toC) { cRuntime(root, freestanding, toLlvm) } else { readText(`${root}/selfhost/runtime.js`) };
  if (toLlvm) {
    const [ll, c] = try { llvmProgram(p, main, rt.asStr(), freestanding, ptr) } catch (#Failed(message)) {
      println(message.asStr());
      throw #Failed
    };
    clock.lap("code");
    const companion = `${out.slice(0, out.len() - 3)}.c`;
    try { writeFile(out, ll.asStr()); writeFile(companion.asStr(), c.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
    clock.lap("write");
    return;
  }
  const code = try {
    if (toC) { cProgram(p, main, rt.asStr(), freestanding) } else if (freestanding) { throw #Failed("error: a freestanding program compiles only to C".toString()) } else { jsProgram(p, main, rt.asStr()) }
  } catch (#Failed(message)) {
    println(message.asStr());
    throw #Failed
  };
  clock.lap("code");
  try { writeFile(out, code.asStr()); } catch (_) { throw #Unreadable { path: out.toString() } };
  clock.lap("write");
}

// `--freestanding`: a program without the C library, whose roots are the functions C calls.
// `--wasm32`: through LLVM, for a target of 32-bit pointers, WebAssembly's.
// `--time`: how long each phase took, on standard error.
// `--watch`: compiled to C again whenever a module changes, until stopped (watch.fly).
// `--core=root`: the program `root` reaches, as λ-fly in Lean, for the proof to certify (core.fly).
// `--interface`: what each module but the standard library's offers, for `fly` (`interfaceOf`).
export function main(entry: str, out: str, root: str, flags: readonly String[]): void uses Io {
  try {
    const ptr: usize = if (flags.iter().some((f) => f == "--wasm32")) { 4 } else { 8 };
    if (flags.iter().some((f) => f == "--watch")) {
      if (!out.endsWith(".c")) {
        println("error: `--watch` compiles to C: name a file ending in `.c`");
        exit(2);
      }
      watch(entry, out, root, cRuntime(root, false, false).asStr());
    }
    const core: Option<String> = match (flags.iter().find((f) => f.startsWith("--core="))) { #Some(f) => #Some(f.slice(7, f.len()).toString()), #None => #None };
    compile(entry, out, root, flags.iter().some((f) => f == "--freestanding"), ptr, flags.iter().some((f) => f == "--time"), core, flags.iter().some((f) => f == "--interface"));
  } catch (e) {
    match (e) {
      #Failed => {}
      #Unreadable { path } => println(`error: cannot read or write ${path}`),
    }
    // A program that did not compile is no success.
    exit(1);
  }
}
