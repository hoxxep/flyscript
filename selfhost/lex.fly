// Tokens. `from`, `of`, `with`, `resumes`, `row`, `view`, `private`, and the words that begin
// `match`, `handle`, `region` and `effect`, are contextual and lex as identifiers: names like
// `handle` and `match` are too common to reserve.

import { Span, Diagnostic } from "./diag";

export enum TemplatePart {
  #Lit(String),
  // The byte range of an interpolated expression's source.
  #Expr(Span),
}
impl Clone for TemplatePart;
impl Eq for TemplatePart;

export enum Tok {
  #Ident(String),
  #Kw(String),
  #Int(String),
  #Float(String),
  #Byte(u8),
  #Str(String),
  #Template(Vec<TemplatePart>),
  // `#Name`
  #Tag(String),
  #Punct(String),
  #Eof,
}
impl Clone for Tok;
impl Eq for Tok;

export type Token = { tok: Tok; span: Span };

export const KEYWORDS: str[] = ["as", "break", "catch", "comptime", "const", "continue", "defer", "dyn", "else",
  "enum", "export", "extends", "extern", "false", "for", "function", "if", "impl", "import", "interface", "let",
  "mut", "once", "readonly", "return", "struct", "throw", "true", "try", "type", "unsafe", "uses", "while", "yield"];

// Longest first. `>>` and `<<` are deliberately absent: the parser joins adjacent `<`/`>` so
// that `Option<Ref<Scope>>` closes two type-argument lists.
const PUNCT: str[] = ["...", "..", "=>", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=", "%=", "&=", "|=",
  "^=", "{", "}", "(", ")", "[", "]", "<", ">", ",", ";", ":", ".", "=", "+", "-", "*", "/", "%",
  "&", "|", "^", "!", "?", "@", "~"];

export function lex(src: str): Vec<Token> uses Fail<Diagnostic> { lexRange(src, 0, src.len()) }

// Lexes `src[start..end]`, producing spans relative to the whole source.
export function lexRange(src: str, start: usize, end: usize): Vec<Token> uses Fail<Diagnostic> {
  let lx = Lexer { src, bytes: src.asBytes(), pos: start, end, out: Vec.new() };
  lx.run();
  replace(mut lx.out, Vec.new())
}

function isDigit(c: u8): bool { c >= b'0' && c <= b'9' }
function isHex(c: u8): bool { isDigit(c) || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F') }
// Bytes of non-ASCII characters count as letters.
function isAlpha(c: u8): bool { (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c >= 0x80 }
function isSpace(c: u8): bool { c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' }

// Appends the UTF-8 encoding of a character.
function pushChar(s: mut String, c: u32): void {
  let bytes: Vec<u8> = Vec.new();
  if (c < 0x80) {
    bytes.push(c as u8);
  } else if (c < 0x800) {
    bytes.push((0xc0 | (c >> 6)) as u8);
    bytes.push((0x80 | (c & 0x3f)) as u8);
  } else if (c < 0x10000) {
    bytes.push((0xe0 | (c >> 12)) as u8);
    bytes.push((0x80 | ((c >> 6) & 0x3f)) as u8);
    bytes.push((0x80 | (c & 0x3f)) as u8);
  } else {
    bytes.push((0xf0 | (c >> 18)) as u8);
    bytes.push((0x80 | ((c >> 12) & 0x3f)) as u8);
    bytes.push((0x80 | ((c >> 6) & 0x3f)) as u8);
    bytes.push((0x80 | (c & 0x3f)) as u8);
  }
  match (String.fromUtf8(bytes)) {
    #Some(t) => s.push(t.asStr()),
    #None => {}
  }
}

view struct Lexer { src: str; bytes: readonly u8[]; pos: usize; end: usize; out: Vec<Token> }

impl Lexer {
  // The byte at the position, `0` at the end.
  function peek(self: readonly Self): u8 { self.peekAt(0) }
  function peekAt(self: readonly Self, n: usize): u8 {
    if (self.pos + n < self.end) { self.bytes[self.pos + n] } else { 0 }
  }
  function startsWith(self: readonly Self, p: str): bool {
    const pb = p.asBytes();
    if (self.pos + pb.len() > self.end) { return false; }
    for (const i of 0..pb.len()) { if (self.bytes[self.pos + i] != pb[i]) { return false; } }
    true
  }

  function err(self: readonly Self, start: usize, message: str): Diagnostic {
    #Diagnostic { span: { start, end: max(self.pos, start + 1) }, message: message.toString() }
  }

  function push(self: mut Self, tok: Tok, start: usize): void {
    self.out.push({ tok, span: { start, end: self.pos } });
  }

  function run(self: mut Self): void uses Fail<Diagnostic> {
    while (true) {
      self.skipTrivia();
      const start = self.pos;
      if (self.pos >= self.end) {
        self.push(#Eof, start);
        return;
      }
      const c = self.peek();
      if (c == b'b' && self.peekAt(1) == b'\'') {
        self.pos += 2;
        const b = self.byteChar(start);
        if (self.peek() != b'\'') { throw self.err(start, "unterminated byte literal"); }
        self.pos += 1;
        self.push(#Byte(b), start);
      } else if (isAlpha(c) || c == b'_') {
        const word = self.word();
        const tok: Tok = if (KEYWORDS.includes(word.asStr())) { #Kw(word) } else { #Ident(word) };
        self.push(tok, start);
      } else if (c == b'#' && self.peekAt(1) == b'[') {
        self.pos += 2;
        self.push(#Punct("#[".toString()), start);
      } else if (c == b'#') {
        self.pos += 1;
        if (!(isAlpha(self.peek()) || self.peek() == b'_')) { throw self.err(start, "expected a tag name after `#`"); }
        const name = self.word();
        self.push(#Tag(name), start);
      } else if (isDigit(c)) {
        const tok = self.number();
        self.push(tok, start);
      } else if (c == b'"') {
        self.pos += 1;
        const s = self.string(start, b'"');
        self.push(#Str(s), start);
      } else if (c == b'`') {
        self.pos += 1;
        const parts = self.template(start);
        self.push(#Template(parts), start);
      } else {
        match (PUNCT.iter().find((p) => self.startsWith(p))) {
          #Some(p) => {
            self.pos += p.len();
            self.push(#Punct(p.toString()), start);
          }
          #None => {
            self.pos += 1;
            throw self.err(start, `unexpected character \`${self.src.slice(start, start + 1)}\``);
          }
        }
      }
    }
  }

  function skipTrivia(self: mut Self): void uses Fail<Diagnostic> {
    while (true) {
      const c = self.peek();
      if (self.pos < self.end && isSpace(c)) {
        self.pos += 1;
      } else if (c == b'/' && self.peekAt(1) == b'/') {
        while (self.pos < self.end && self.peek() != b'\n') { self.pos += 1; }
      } else if (c == b'/' && self.peekAt(1) == b'*') {
        const start = self.pos;
        self.pos += 2;
        while (!(self.peek() == b'*' && self.peekAt(1) == b'/')) {
          if (self.pos >= self.end) { throw self.err(start, "unterminated block comment"); }
          self.pos += 1;
        }
        self.pos += 2;
      } else {
        return;
      }
    }
  }

  function word(self: mut Self): String {
    const start = self.pos;
    while (self.pos < self.end && (isAlpha(self.peek()) || isDigit(self.peek()) || self.peek() == b'_')) { self.pos += 1; }
    self.src.slice(start, self.pos).toString()
  }

  function number(self: mut Self): Tok {
    const start = self.pos;
    if (self.peek() == b'0' && (self.peekAt(1) == b'x' || self.peekAt(1) == b'b' || self.peekAt(1) == b'o')) {
      self.pos += 2;
      while (self.pos < self.end && (isHex(self.peek()) || self.peek() == b'_')) { self.pos += 1; }
      return #Int(self.src.slice(start, self.pos).replaceAll("_", ""));
    }
    self.digits();
    let float = false;
    // `0..8` is a range, not the float `0.` followed by `.8`.
    if (self.peek() == b'.' && isDigit(self.peekAt(1))) {
      float = true;
      self.pos += 1;
      self.digits();
    }
    const e = self.peek();
    const sign = self.peekAt(1) == b'+' || self.peekAt(1) == b'-';
    if ((e == b'e' || e == b'E') && (isDigit(self.peekAt(1)) || (sign && isDigit(self.peekAt(2))))) {
      float = true;
      self.pos += 1;
      if (self.peek() == b'+' || self.peek() == b'-') { self.pos += 1; }
      self.digits();
    }
    const text = self.src.slice(start, self.pos).replaceAll("_", "");
    if (float) { #Float(text) } else { #Int(text) }
  }

  function digits(self: mut Self): void {
    while (self.pos < self.end && (isDigit(self.peek()) || self.peek() == b'_')) { self.pos += 1; }
  }

  // The character an escape stands for, after its backslash.
  function escape(self: mut Self, start: usize): u32 uses Fail<Diagnostic> {
    const c = self.peek();
    self.pos += 1;
    if (c == b'n') { return 10; }
    if (c == b't') { return 9; }
    if (c == b'r') { return 13; }
    if (c == b'0') { return 0; }
    if (c == b'\\' || c == b'\'' || c == b'"' || c == b'`' || c == b'$') { return c as u32; }
    if (c == b'u' && self.peek() == b'{') {
      self.pos += 1;
      let v: u32 = 0;
      let n: usize = 0;
      while (self.pos < self.end && self.peek() != b'}') {
        const h = self.peek();
        if (!isHex(h) || n == 6) { throw self.err(start, "invalid unicode escape"); }
        const d = if (isDigit(h)) { h - b'0' } else if (h >= b'a') { h - b'a' + 10 } else { h - b'A' + 10 };
        v = v * 16 + (d as u32);
        n += 1;
        self.pos += 1;
      }
      self.pos += 1;
      if (n == 0 || v > 0x10ffff || (v >= 0xd800 && v < 0xe000)) { throw self.err(start, "invalid unicode escape"); }
      return v;
    }
    throw self.err(start, "invalid escape sequence")
  }

  function byteChar(self: mut Self, start: usize): u8 uses Fail<Diagnostic> {
    if (self.pos >= self.end) { throw self.err(start, "unterminated byte literal"); }
    const c = self.peek();
    self.pos += 1;
    const v: u32 = if (c == b'\\') { self.escape(start) } else { c as u32 };
    if (v > 0x7f) { throw self.err(start, "byte literal must be ASCII"); }
    v as u8
  }

  function string(self: mut Self, start: usize, close: u8): String uses Fail<Diagnostic> {
    let s = String.new();
    let run = self.pos;
    while (true) {
      if (self.pos >= self.end) { throw self.err(start, "unterminated string"); }
      const c = self.peek();
      if (c == close) {
        s.push(self.src.slice(run, self.pos));
        self.pos += 1;
        return s;
      }
      if (c == b'\\') {
        s.push(self.src.slice(run, self.pos));
        self.pos += 1;
        pushChar(mut s, self.escape(start));
        run = self.pos;
      } else {
        self.pos += 1;
      }
    }
    s
  }

  function template(self: mut Self, start: usize): Vec<TemplatePart> uses Fail<Diagnostic> {
    let parts: Vec<TemplatePart> = Vec.new();
    let lit = String.new();
    let run = self.pos;
    while (true) {
      if (self.pos >= self.end) { throw self.err(start, "unterminated template literal"); }
      const c = self.peek();
      if (c == b'`') {
        lit.push(self.src.slice(run, self.pos));
        self.pos += 1;
        break;
      }
      if (c == b'\\') {
        lit.push(self.src.slice(run, self.pos));
        self.pos += 1;
        pushChar(mut lit, self.escape(start));
        run = self.pos;
      } else if (c == b'$' && self.peekAt(1) == b'{') {
        lit.push(self.src.slice(run, self.pos));
        self.pos += 2;
        parts.push(#Lit(replace(mut lit, String.new())));
        const from = self.pos;
        self.skipBalanced(start);
        parts.push(#Expr({ start: from, end: self.pos - 1 }));
        run = self.pos;
      } else {
        self.pos += 1;
      }
    }
    parts.push(#Lit(lit));
    parts
  }

  // Skips to just past the `}` closing an interpolation, honouring nested braces and strings.
  function skipBalanced(self: mut Self, start: usize): void uses Fail<Diagnostic> {
    let depth: usize = 1;
    while (depth > 0) {
      if (self.pos >= self.end) { throw self.err(start, "unterminated template interpolation"); }
      const c = self.peek();
      self.pos += 1;
      if (c == b'{') { depth += 1; }
      else if (c == b'}') { depth -= 1; }
      else if (c == b'"' || c == b'\'') { self.string(start, c); }
      else if (c == b'`') { self.template(start); }
    }
  }
}
