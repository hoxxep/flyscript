// Flyscript's tokens. Keywords are identifiers the parser looks for, since most of Flyscript's
// words are keywords only where the grammar expects them (§2.3).

export type Span = { start: usize; end: usize };

// A template literal's pieces: text, and the source of each `${…}`, with where it starts.
export enum Piece { #Text(String), #Code(String, usize) }
impl Clone for Piece;
impl Eq for Piece;

export enum Tok {
  #Ident(String),
  #Int(String),
  #Float(String),
  #Str(String),
  #Byte(i64),
  #Template(Vec<Piece>),
  #Tag(String),
  #Punct(String),
  #Eof,
}
impl Clone for Tok;
impl Eq for Tok;

export type Token = { tok: Tok; span: Span };

export type LexError = #LexError { at: usize; message: String };

// Punctuation, longest first so that `...` is not read as `..` and `.`.
const PUNCT: str[] = ["...", "#[", "=>", "==", "!=", "<=", ">=", "&&", "||", "+=", "-=", "*=", "/=", "%=", "..",
  "{", "}", "(", ")", "[", "]", "<", ">", ",", ";", ":", ".", "=", "+", "-", "*", "/", "%", "!", "&", "|", "?", "@", "^", "~"];

function isDigit(b: u8): bool { b >= b'0' && b <= b'9' }
function isIdentStart(b: u8): bool { (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'_' || b == b'$' }
function isIdentPart(b: u8): bool { isIdentStart(b) || isDigit(b) }

// The character an escape stands for, after its backslash.
function unescape(b: u8): str {
  match (b) {
    b'n' => "\n",
    b't' => "\t",
    b'r' => "\r",
    b'0' => "\0",
    b'\\' => "\\",
    b'"' => "\"",
    b'\'' => "'",
    b'`' => "`",
    b'$' => "$",
    _ => "?",
  }
}

export function lex(src: str): Vec<Token> uses Fail<LexError> {
  const bytes = src.asBytes();
  const n = bytes.len();
  let out: Vec<Token> = Vec.new();
  let i: usize = 0;
  while (i < n) {
    const b = bytes[i];
    const start = i;
    if (b == b' ' || b == b'\n' || b == b'\t' || b == b'\r') { i += 1; continue; }
    // Comments.
    if (b == b'/' && i + 1 < n && bytes[i + 1] == b'/') {
      while (i < n && bytes[i] != b'\n') { i += 1; }
      continue;
    }
    if (b == b'/' && i + 1 < n && bytes[i + 1] == b'*') {
      i += 2;
      while (i + 1 < n && !(bytes[i] == b'*' && bytes[i + 1] == b'/')) { i += 1; }
      i += 2;
      continue;
    }
    // A byte literal: `b'x'`.
    if (b == b'b' && i + 1 < n && bytes[i + 1] == b'\'') {
      i += 2;
      let value: i64 = 0;
      if (bytes[i] == b'\\') {
        value = unescape(bytes[i + 1]).asBytes()[0] as i64;
        i += 2;
      } else {
        value = bytes[i] as i64;
        i += 1;
      }
      if (i >= n || bytes[i] != b'\'') { throw #LexError { at: start, message: `an unclosed byte literal` }; }
      i += 1;
      out.push({ tok: #Byte(value), span: { start, end: i } });
      continue;
    }
    if (isIdentStart(b)) {
      while (i < n && isIdentPart(bytes[i])) { i += 1; }
      out.push({ tok: #Ident(src.slice(start, i).toString()), span: { start, end: i } });
      continue;
    }
    if (isDigit(b)) {
      let float = false;
      if (b == b'0' && i + 1 < n && (bytes[i + 1] == b'x' || bytes[i + 1] == b'b')) {
        i += 2;
        while (i < n && (isIdentPart(bytes[i]))) { i += 1; }
      } else {
        while (i < n && (isDigit(bytes[i]) || bytes[i] == b'_')) { i += 1; }
        // A fraction, but not a range: `1..n` is an integer and `..`.
        if (i + 1 < n && bytes[i] == b'.' && isDigit(bytes[i + 1])) {
          float = true;
          i += 1;
          while (i < n && isDigit(bytes[i])) { i += 1; }
        }
        if (i < n && (bytes[i] == b'e' || bytes[i] == b'E')) {
          float = true;
          i += 1;
          if (i < n && (bytes[i] == b'+' || bytes[i] == b'-')) { i += 1; }
          while (i < n && isDigit(bytes[i])) { i += 1; }
        }
      }
      const text = src.slice(start, i).replaceAll("_", "");
      out.push({ tok: if (float) { #Float(text) } else { #Int(text) }, span: { start, end: i } });
      continue;
    }
    if (b == b'"') {
      i += 1;
      let text = String.new();
      let run = i;
      while (i < n && bytes[i] != b'"') {
        if (bytes[i] == b'\\') {
          text.push(src.slice(run, i));
          text.push(unescape(bytes[i + 1]));
          i += 2;
          run = i;
        } else {
          i += 1;
        }
      }
      if (i >= n) { throw #LexError { at: start, message: `an unclosed string` }; }
      text.push(src.slice(run, i));
      i += 1;
      out.push({ tok: #Str(text), span: { start, end: i } });
      continue;
    }
    if (b == b'`') {
      i += 1;
      let pieces: Vec<Piece> = Vec.new();
      let text = String.new();
      let run = i;
      while (i < n && bytes[i] != b'`') {
        if (bytes[i] == b'\\') {
          text.push(src.slice(run, i));
          text.push(unescape(bytes[i + 1]));
          i += 2;
          run = i;
        } else if (bytes[i] == b'$' && i + 1 < n && bytes[i + 1] == b'{') {
          text.push(src.slice(run, i));
          pieces.push(#Text(replace(mut text, String.new())));
          i += 2;
          const codeStart = i;
          i = matchingBrace(src, i);
          pieces.push(#Code(src.slice(codeStart, i).toString(), codeStart));
          i += 1;
          run = i;
        } else {
          i += 1;
        }
      }
      if (i >= n) { throw #LexError { at: start, message: `an unclosed template` }; }
      text.push(src.slice(run, i));
      pieces.push(#Text(text));
      i += 1;
      out.push({ tok: #Template(pieces), span: { start, end: i } });
      continue;
    }
    if (b == b'#' && i + 1 < n && isIdentStart(bytes[i + 1])) {
      i += 1;
      while (i < n && isIdentPart(bytes[i])) { i += 1; }
      out.push({ tok: #Tag(src.slice(start + 1, i).toString()), span: { start, end: i } });
      continue;
    }
    match (PUNCT.iter().find((p) => src.slice(i, n).startsWith(p))) {
      #Some(p) => {
        i += p.len();
        out.push({ tok: #Punct(p.toString()), span: { start, end: i } });
      }
      #None => throw #LexError { at: i, message: `an unexpected character` },
    }
  }
  out.push({ tok: #Eof, span: { start: n, end: n } });
  out
}

// The position of the `}` that closes a `${`, skipping strings and nested braces inside it.
function matchingBrace(src: str, from: usize): usize {
  const bytes = src.asBytes();
  let depth: usize = 0;
  let i = from;
  while (i < bytes.len()) {
    const b = bytes[i];
    if (b == b'"' || b == b'`') {
      // A string or nested template inside the expression.
      i += 1;
      while (i < bytes.len() && bytes[i] != b) {
        if (bytes[i] == b'\\') { i += 1; }
        i += 1;
      }
    } else if (b == b'{') {
      depth += 1;
    } else if (b == b'}') {
      if (depth == 0) { return i; }
      depth -= 1;
    }
    i += 1;
  }
  i
}
