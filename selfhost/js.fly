// JavaScript from the core IR, running on `runtime.js`.
//
// Values: integers of up to 32 bits, and `usize` and `isize`, are numbers — 53-bit integers on
// this target — and wider ones BigInts; floats are numbers, strings JavaScript strings of one byte
// per character, `void` is `undefined`. Structs and records are objects; tuples, arrays and `Vec`s
// are arrays; a tag is `{ $tag, $ }`, its payload in `$`: the value of a payload of one, an array of
// several, an object of a record. `Box`, `Arc` and region references are what they hold. A
// `readonly` borrow is the value it lends; a `mut` borrow is a reference, an object whose `v` reads
// and writes the place lent. A local lent `mut` lives in a cell `{ v }`, which is its reference.
//
// Effects: `Fail` is a JavaScript exception. A function that may yield, perform an effect of the
// program's own, or perform `Io` in a program with tasks, is a generator, which performs an
// operation by yielding it to whoever drives it; calls to it are `yield*`. A block's cleanups run in
// a `finally`, however it is left. Only what a destructor can observe is dropped: values of types
// with a `Drop` of their own, and what holds them.

import { Span, Diagnostic, render } from "./diag";
import { Prim, Row, Ty, FnTy, GArg, Len, EffRow, isInt, isFloat, primName, keyTy } from "./types";
import { Program as Prog, substParams } from "./env";
import {
  Lower, Entry, newLower, stripBorrow, viewLike, typeArg, entryTy, optionTy, ckey, unitTy, isVoidTy,
} from "./lower";
import {
  Local, LocalKind, Place, Root, Proj, ProjKind, Operand, Constant, Rvalue, Capture, Call, Callee, Stmt, Handle, Arm, Block,
  Cleanup, Func, ConstValue, MainArg,
} from "./ir";
import { HashMap, HashSet } from "std/collections";

const RESERVED: str[] = ["arguments", "await", "case", "catch", "class", "debugger", "default", "delete", "do",
  "else", "enum", "eval", "export", "extends", "finally", "function", "implements", "import", "in",
  "instanceof", "interface", "let", "new", "null", "package", "private", "protected", "public", "static",
  "super", "switch", "this", "typeof", "undefined", "var", "void", "with", "yield", "NaN", "Infinity"];

const HEX: str = "0123456789abcdef";

// A string as a JavaScript literal: printable ASCII as it is, every other byte escaped.
export function quote(s: str): String {
  const bytes = s.asBytes();
  let out = "\"".toString();
  let run: usize = 0;
  let i: usize = 0;
  while (i < bytes.len()) {
    const b = bytes[i];
    const plain = b >= 0x20 && b < 0x7f && b != b'"' && b != b'\\';
    if (!plain) {
      if (run < i) { out.push(s.slice(run, i)); }
      if (b == b'"') { out.push("\\\""); }
      else if (b == b'\\') { out.push("\\\\"); }
      else if (b == b'\n') { out.push("\\n"); }
      else {
        const h = (b >> 4) as usize;
        const l = (b & 15) as usize;
        out.push("\\x");
        out.push(HEX.slice(h, h + 1));
        out.push(HEX.slice(l, l + 1));
      }
      run = i + 1;
    }
    i += 1;
  }
  out.push(s.slice(run, bytes.len()));
  out.push("\"");
  out
}

function mangle(n: str): String {
  if (RESERVED.iter().some((r) => r == n)) { `${n}$` } else { n.toString() }
}

// A field's JavaScript name: one JavaScript gives a meaning of its own is renamed.
function mangleField(n: str): String {
  if (n == "__proto__" || n == "constructor") { `${n}$` } else { n.toString() }
}

function isMutBorrow(t: readonly Ty): bool { match (t) { #Borrow(true, _) => true, _ => false } }

function intPrim(t: readonly Ty): Option<Prim> {
  match (t) {
    #Prim(p) => if (isInt(p)) { #Some(p) } else { #None },
    #Borrow(_, inner) => intPrim(inner),
    _ => #None,
  }
}

// The check of a result of integer type `p`: the program's own function for a number, which V8
// inlines, the runtime's for a BigInt.
function check(p: Prim): String {
  match (p) {
    #I64 | #U64 | #I128 => `$rt.${primName(p)}`,
    _ => `$${primName(p)}`,
  }
}

// Whether every value of integer type `q` is a value of `p`, both numbers in JavaScript.
function fitsIn(q: Prim, p: Prim): bool {
  const [qs, qb] = intShape(q);
  const [ps, pb] = intShape(p);
  if (qs) { ps && qb <= pb } else if (ps) { qb < pb } else { qb <= pb }
}

// Whether an integer type is signed, and its bits: `usize` and `isize` have the 53 a number holds.
function intShape(p: Prim): [bool, u32] {
  match (p) {
    #I8 => [true, 8], #I16 => [true, 16], #I32 => [true, 32], #Isize => [true, 53],
    #U8 => [false, 8], #U16 => [false, 16], #U32 => [false, 32], #Usize => [false, 53],
    _ => [true, 128],
  }
}

// Whether integers of the type are JavaScript numbers rather than BigInts.
function numeric(t: readonly Ty): bool {
  match (intPrim(t)) {
    #Some(p) => match (p) { #I64 | #U64 | #I128 => false, _ => true },
    #None => false,
  }
}

function floatTy(t: readonly Ty): bool {
  match (t) { #Prim(p) => isFloat(p), #Borrow(_, inner) => floatTy(inner), _ => false }
}

// An integer literal of the type.
function intLit(t: readonly Ty, n: str): String {
  if (floatTy(t) || numeric(t) || intPrim(t).isNone()) { n.toString() } else { `${n}n` }
}

// A JavaScript function being made: the state of the code inside it.
type Ctx = {
  locals: Vec<Local>;
  // The locals a JavaScript function of its own holds: those of its code, not of code made apart
  // inside it.
  own: HashSet<usize>;
  // Locals that live in cells, being lent `mut`.
  cells: HashSet<usize>;
  // How each capture of a closure is reached.
  captures: Vec<String>;
  capTys: Vec<Ty>;
  // Whether the function is a generator, and whether it is a `handle`'s body or arm, whose `return`
  // leaves the function around it.
  gen: bool;
  inHandle: bool;
  out: String;
  indent: usize;
  // Locals declared at the function's top: its value's, read once its blocks have ended.
  hoisted: HashSet<usize>;
  // Statements the next block made starts with, after its declarations.
  prologue: String;
};

function newCtx(locals: Vec<Local>, gen: bool): Ctx {
  {
    locals, own: HashSet.new(), cells: HashSet.new(), captures: Vec.new(), capTys: Vec.new(), gen, inHandle: false,
    out: String.new(), indent: 1, hoisted: HashSet.new(), prologue: String.new(),
  }
}

export struct JsGen {
  lw: Lower;
  // Whether the program starts tasks: its `Io` then suspends.
  tasks: bool;
  // Module constants made so far, by index, with their names.
  consts: HashMap<usize, String>;
  // Destructors (§5.6): whether each type, by key, needs dropping; the drop function of each
  // that does, and their code.
  dropNeeds: HashMap<String, bool>;
  dropFns: HashMap<String, String>;
  head: String;
  code: String;
  tmp: usize;
  cx: Ctx;
  module: usize;
}

impl JsGen {
  function fail(self: readonly Self, span: Span, message: str): never uses Fail<Diagnostic> {
    throw #Diagnostic { span: self.lw.p.sourceSpan(span), message: message.toString() }
  }

  function line(self: mut Self, s: str): void {
    for (const _ of 0..self.cx.indent) { self.cx.out.push("  "); }
    self.cx.out.push(s);
    self.cx.out.push("\n");
  }

  function fresh(self: mut Self): String {
    self.tmp += 1;
    `$${self.tmp}`
  }

  // ---- what suspends ----

  // Whether code performing `row` suspends here: it yields, performs an effect of the program's
  // own, or performs `Io` in a program with tasks, which the scheduler switches between.
  function rowSuspends(self: readonly Self, row: readonly EffRow): bool {
    row.effs.iter().some((e) => {
      const name = self.lw.p.defs[e.def].name.asStr();
      match (self.lw.p.defs[e.def].kind) {
        #Effect { ops: _ } => name != "Fail" && name != "Region" && (name != "Io" || self.tasks || self.lw.handlesIo),
        _ => false,
      }
    })
  }

  function rowYields(self: readonly Self, row: readonly EffRow): bool {
    row.effs.iter().some((e) => self.lw.p.defs[e.def].name == "Yield")
  }

  // Whether a call suspends here.
  function callSuspends(self: readonly Self, c: readonly Call): bool {
    self.rowSuspends(c.row)
  }

  // ---- types ----

  // Whether a value of the type is a JavaScript object a copy must duplicate: a `Copy` struct,
  // record, tuple or array.
  function copiedObject(self: readonly Self, t: readonly Ty): bool {
    const object = match (t) {
      #Record(_) | #Tuple(_) | #Array(_, _) => true,
      #Named(d, _) => match (self.lw.p.defs[d].kind) { #Struct { fields: #Some(_) } => true, _ => false },
      _ => false,
    };
    object && self.lw.p.isCopy(t)
  }

  // Whether dropping a value of the type is something a program can observe.
  function needsDrop(self: mut Self, t: readonly Ty): bool {
    const key = keyTy(t);
    if (const #Some(b) = self.dropNeeds.get(key.asStr())) { return b; }
    // A type met again inside itself adds nothing.
    self.dropNeeds.insert(key.clone(), false);
    const b = self.computeNeeds(t);
    self.dropNeeds.insert(key, b);
    b
  }

  function computeNeeds(self: mut Self, t: readonly Ty): bool {
    match (t) {
      #Named(d, args) => {
        if (self.lw.p.hasDrop(d)) { return true; }
        // What an `Arc` holds is shared, and dropped by no one clone.
        if (self.lw.p.isKnown(d, "Arc")) { return false; }
        for (const a of args) { if (const #Ty(x) = a) { if (self.needsDrop(x)) { return true; } } }
        for (const x of self.partsOf(d, args)) { if (self.needsDrop(x)) { return true; } }
        false
      }
      #Tuple(ts) => {
        for (const x of ts) { if (self.needsDrop(x)) { return true; } }
        false
      }
      #Record(r) | #Union(r) => {
        for (const [_, x] of r.labels) { if (self.needsDrop(x)) { return true; } }
        false
      }
      #Array(e, _) => self.needsDrop(e),
      _ => false,
    }
  }

  function partsOf(self: readonly Self, d: usize, args: readonly Vec<GArg>): Vec<Ty> {
    let out: Vec<Ty> = Vec.new();
    match (self.lw.p.defs[d].kind) {
      #Struct { fields: _ } => { if (const #Some(fs) = self.lw.p.structFields(d, args)) { for (const [_, x] of fs) { out.push(x.clone()); } } }
      #Enum { tags } => { for (const [_, x] of tags) { out.push(substParams(x, self.lw.p.defs[d].params, args)); } }
      _ => {}
    }
    out
  }

  // Whether a value of the type held where it is is dropped there: owned, and observably dropped.
  function drops(self: mut Self, t: readonly Ty): bool {
    match (t) { #Borrow(_, _) | #Slice(_) | #Prim(_) | #Error => false, _ => self.needsDrop(t) }
  }

  // The function that drops a value of type `t`, made once. A dead value — one moved out of its
  // place — is `undefined`, and dropping it does nothing.
  function dropFn(self: mut Self, t: Ty, span: Span): String uses Fail<Diagnostic> {
    const key = keyTy(t);
    if (const #Some(n) = self.dropFns.get(key.asStr())) { return n.clone(); }
    const name = `$drop${self.dropFns.len()}`;
    self.dropFns.insert(key, name.clone());
    let body = "  if (v === undefined) return;\n".toString();
    match (t) {
      #Named(d, args) => {
        if (self.lw.p.hasDrop(d)) {
          const call = self.dropCall(t.clone(), span);
          body.push(`  ${call};\n`);
        }
        if (self.lw.p.isKnown(d, "Box")) {
          if (const #Some(#Ty(inner)) = args.first() && self.needsDrop(inner)) {
            const f = self.dropFn(inner.clone(), span);
            body.push(`  ${f}(v);\n`);
          }
        } else {
          match (self.lw.p.defs[d].kind) {
            #Struct { fields: #Some(_) } => {
              const fs: Vec<[String, Ty]> = match (self.lw.p.structFields(d, args)) { #Some(x) => x, #None => Vec.new() };
              for (const [f, ft] of fs) { self.dropPart(mut body, `v.${mangleField(f.asStr())}`.asStr(), ft.clone(), span); }
            }
            #Enum { tags: _ } => {
              let payloads: Vec<[String, Ty]> = Vec.new();
              if (const #Enum { tags } = self.lw.p.defs[d].kind) {
                for (const [tag, pt0] of tags) { payloads.push([tag.clone(), substParams(pt0, self.lw.p.defs[d].params, args)]); }
              }
              for (const [tag, pt] of payloads) { self.dropPayload(mut body, tag.asStr(), pt.clone(), span); }
            }
            _ => {
              // A collection drops its elements; a map its keys and values.
              const name0 = self.lw.p.defs[d].name.clone();
              let elems: Vec<Ty> = Vec.new();
              for (const a of args) { if (const #Ty(x) = a) { elems.push(x.clone()); } }
              if ((name0 == "Vec" || name0 == "RegionList") && elems.len() > 0 && self.needsDrop(elems[0])) {
                const f = self.dropFn(elems[0].clone(), span);
                body.push(`  for (const x of v) ${f}(x);\n`);
              } else if (name0 == "HashMap" && elems.len() == 2) {
                const dk = self.needsDrop(elems[0]);
                const dv = self.needsDrop(elems[1]);
                if (dk || dv) {
                  body.push("  for (const e of v.m.values()) {\n");
                  if (dk) { const f = self.dropFn(elems[0].clone(), span); body.push(`    ${f}(e[0]);\n`); }
                  if (dv) { const f = self.dropFn(elems[1].clone(), span); body.push(`    ${f}(e[1]);\n`); }
                  body.push("  }\n");
                }
              }
            }
          }
        }
      }
      #Record(r) => { for (const [f, ft] of r.labels) { self.dropPart(mut body, `v.${mangleField(f.asStr())}`.asStr(), ft.clone(), span); } }
      #Union(r) => { for (const [tag, pt] of r.labels) { self.dropPayload(mut body, tag.asStr(), pt.clone(), span); } }
      #Tuple(ts) => { for (const [i, x] of ts.iter().enumerate()) { self.dropPart(mut body, `v[${i}]`.asStr(), x.clone(), span); } }
      #Array(e, _) => {
        if (self.needsDrop(e)) {
          const f = self.dropFn(e.get().clone(), span);
          body.push(`  for (const x of v) ${f}(x);\n`);
        }
      }
      _ => {}
    }
    self.head.push(`function ${name}(v) {\n${body}}\n`);
    name
  }

  function dropPart(self: mut Self, body: mut String, at: str, ft: Ty, span: Span): void uses Fail<Diagnostic> {
    if (!self.needsDrop(ft)) { return; }
    const f = self.dropFn(ft, span);
    body.push(`  ${f}(${at});\n`);
  }

  // Drops a tag's payload: one value in `$`, several in an array, or a record.
  function dropPayload(self: mut Self, body: mut String, tag: str, pt: Ty, span: Span): void uses Fail<Diagnostic> {
    if (!self.needsDrop(pt)) { return; }
    match (pt) {
      #Tuple(ts) => {
        if (ts.len() == 1) {
          const f = self.dropFn(ts[0].clone(), span);
          body.push(`  if (v.$tag === ${quote(tag)}) ${f}(v.$);\n`);
        } else {
          for (const [i, x] of ts.iter().enumerate()) {
            if (self.needsDrop(x)) {
              const f = self.dropFn(x.clone(), span);
              body.push(`  if (v.$tag === ${quote(tag)}) ${f}(v.$[${i}]);\n`);
            }
          }
        }
      }
      other => {
        const f = self.dropFn(other, span);
        body.push(`  if (v.$tag === ${quote(tag)}) ${f}(v.$);\n`);
      }
    }
  }

  // A call of the type's `Drop.drop` on `v`, run to its end: a destructor does not suspend.
  function dropCall(self: mut Self, t: Ty, span: Span): String uses Fail<Diagnostic> {
    const [c, _] = self.lw.ifaceMethod("Drop", "drop", t, span);
    match (c) {
      #Inst(i) => {
        const name = self.instName(i);
        if (self.instSuspends(i)) { `$rt.drive(${name}({ v: v }))` } else { `${name}({ v: v })` }
      }
      #Builtin(k) => `$b.${k}({ v: v })`,
      _ => self.fail(span, "a `Drop` of no function"),
    }
  }

  // An instance's JavaScript name.
  function instName(self: readonly Self, i: usize): String { `${self.lw.insts[i].name}` }

  // Whether an instance's code is a generator.
  function instSuspends(self: readonly Self, i: usize): bool {
    const row = self.lw.instEffects(i);
    self.rowSuspends(row)
  }

  // The function that copies a `Copy` object of type `t`, made once: its parts that are `Copy`
  // objects are copied too, and nothing a borrow in it refers to is.
  function copyFn(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const key = `copy:${keyTy(t)}`;
    if (const #Some(n) = self.dropFns.get(key.asStr())) { return n.clone(); }
    const name = `$copy${self.dropFns.len()}`;
    self.dropFns.insert(key, name.clone());
    const body: String = match (t) {
      #Tuple(ts) => {
        let xs: Vec<String> = Vec.new();
        for (const [i, x] of ts.iter().enumerate()) { xs.push(self.copyPart(`v[${i}]`.asStr(), x, span)); }
        `[${xs.join(", ")}]`
      }
      #Array(e, _) => if (self.copiedObject(e)) { `v.map((x) => ${self.copyPart("x", e, span)})` } else { "v.slice()".toString() },
      _ => {
        let es: Vec<String> = Vec.new();
        for (const [f, ft] of self.lw.fieldsOf(t)) {
          const k = mangleField(f.asStr());
          es.push(`${k}: ${self.copyPart(`v.${k}`.asStr(), ft, span)}`);
        }
        `({ ${es.join(", ")} })`
      }
    };
    self.head.push(`function ${name}(v) { return ${body}; }\n`);
    name
  }

  // A part of a `Copy` object, copied if it is one itself.
  function copyPart(self: mut Self, x: str, pt: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    if (!self.copiedObject(pt)) { return x.toString(); }
    const f = self.copyFn(pt, span);
    `${f}(${x})`
  }

  // ---- places and values ----

  function rootTy(self: readonly Self, r: readonly Root): Ty {
    match (r) {
      #Local(l) => self.cx.locals[l].ty.clone(),
      #Capture(k) => match (self.cx.capTys.get(k)) { #Some(t) => t.clone(), #None => #Error },
    }
  }

  function placeTy(self: readonly Self, p: readonly Place): Ty {
    match (p.path.last()) { #Some(x) => x.ty.clone(), #None => self.rootTy(p.root) }
  }

  // A local's name; one in a cell is the cell.
  function localName(self: readonly Self, l: usize): String { `v${l}_${mangle(self.cx.locals[l].name.asStr())}` }

  // The JavaScript of what a local holds.
  function local(self: readonly Self, l: usize): String {
    if (self.cx.cells.has(l)) { `${self.localName(l)}.v` } else { self.localName(l) }
  }

  // A place as JavaScript: to read it, or to write it.
  function lvalue(self: mut Self, p: readonly Place, span: Span): String uses Fail<Diagnostic> {
    const [s, _] = self.lvalueParts(p, false, span);
    s
  }

  // A place: its JavaScript, to read or to `write`, and, if its last step is a field or an
  // element, the object and key a reference to it is made of.
  function lvalueParts(self: mut Self, p: readonly Place, write: bool, span: Span): [String, Option<[String, String]>] uses Fail<Diagnostic> {
    let s = match (p.root) {
      #Local(l) => self.local(l),
      #Capture(k) => match (self.cx.captures.get(k)) { #Some(c) => c.clone(), #None => self.fail(span, "a capture out of reach") },
    };
    let t = self.rootTy(p.root);
    let parts: Option<[String, String]> = #None;
    const n = p.path.len();
    for (const [k, proj] of p.path.iter().enumerate()) {
      match (proj.kind) {
        #Field(f) => {
          match (t) {
            #Tuple(_) => {
              parts = #Some([s.clone(), f.clone()]);
              s = `${s}[${f}]`;
            }
            _ => {
              parts = #Some([s.clone(), quote(mangleField(f.asStr()).asStr())]);
              s = `${s}.${mangleField(f.asStr())}`;
            }
          }
        }
        #Payload(_) => {
          parts = #Some([s.clone(), "\"$\"".toString()]);
          s = `${s}.$`;
        }
        #Deref => {
          parts = #None;
          if (isMutBorrow(t)) { s = `${s}.v`; }
        }
        #Index(i) => {
          const iv = self.operand(i, span);
          const o = s.clone();
          // A list that is a JavaScript array, at an index that is a number, is read and written
          // as one; a string's bytes, or an index that may be a BigInt, by the runtime.
          if (self.isArray(t) && numeric(self.operandTy(i))) {
            parts = #Some([o.clone(), `$at(${o}, ${iv})`]);
            s = if (write && k + 1 == n) { `${o}[$at(${o}, ${iv})]` } else { `$ix(${o}, ${iv})` };
          } else {
            parts = #Some([o.clone(), `$rt.at(${o}, ${iv})`]);
            s = if (write && k + 1 == n) { `${o}[$rt.at(${o}, ${iv})]` } else { `$rt.idx(${o}, ${iv})` };
          }
        }
      }
      t = proj.ty.clone();
    }
    [s, parts]
  }

  function operandTy(self: readonly Self, op: readonly Operand): Ty {
    match (op) {
      #Copy(p) | #Move(p) => self.placeTy(p),
      #Const(c) => match (c) {
        #Int(_, t) | #Float(_, t) | #Named(_, t) | #Zero(t) => t.clone(),
        #Str(_) => #Prim(#Str),
        #Byte(_) => #Prim(#U8),
        #Bool(_) => #Prim(#Bool),
        #Unit => #Prim(#Void),
      },
    }
  }

  function operand(self: mut Self, op: readonly Operand, span: Span): String uses Fail<Diagnostic> {
    match (op) {
      #Copy(p) => {
        const lv = self.lvalue(p, span);
        // A `Copy` object read out of a place is a copy, unless it is a temporary's, which nothing
        // else reaches.
        const t = self.placeTy(p);
        const temp = p.path.len() == 0 && match (p.root) { #Local(l) => match (self.cx.locals[l].kind) { #Temp => true, _ => false }, _ => false };
        if (!temp && self.copiedObject(t)) {
          const f = self.copyFn(t, span);
          `${f}(${lv})`
        } else { lv }
      }
      #Move(p) => {
        const [lv, _] = self.lvalueParts(p, true, span);
        // A value moved out of its place leaves it dead, if dropping it could be seen.
        if (self.drops(self.placeTy(p))) { `$rt.take(${lv}, ${lv} = undefined)` } else { lv }
      }
      #Const(c) => self.constant(c, span),
    }
  }

  function constant(self: mut Self, c: readonly Constant, span: Span): String uses Fail<Diagnostic> {
    match (c) {
      #Int(n, t) => intLit(t, n.asStr()),
      #Float(n, _) => n.clone(),
      #Str(s) => quote(s.asStr()),
      #Byte(b) => `${b}`,
      #Bool(b) => if (b) { "true".toString() } else { "false".toString() },
      #Unit => "undefined".toString(),
      #Named(k, _) => self.named(k, span),
      #Zero(_) => "undefined".toString(),
    }
  }

  // A module-level constant, made once.
  function named(self: mut Self, c: usize, span: Span): String uses Fail<Diagnostic> {
    if (const #Some(n) = self.consts.get(c)) { return n.clone(); }
    const name = `$const${c}`;
    self.consts.insert(c, name.clone());
    const value = self.lw.constValue(c);
    const v = self.constValue(value, span);
    self.head.push(`const ${name} = ${v};\n`);
    name
  }

  function constValue(self: mut Self, v: readonly ConstValue, span: Span): String uses Fail<Diagnostic> {
    match (v) {
      #Lit(c) => self.constant(c, span),
      #Unary(op, x, t) => {
        const a = self.constValue(x, span);
        self.arith(op.asStr(), "", a.asStr(), t)
      }
      #Binary(op, x, y, t) => {
        const a = self.constValue(x, span);
        const b = self.constValue(y, span);
        self.binary(op.asStr(), a, b, t, t)
      }
      #List(items, _) => {
        let vs: Vec<String> = Vec.new();
        for (const it of items) { vs.push(self.constValue(it, span)); }
        `[${vs.join(", ")}]`
      }
    }
  }

  // Whether a list of the type is a JavaScript array: an array, a `Vec`, or a slice whose elements
  // are not bytes, which may be a string's.
  function isArray(self: readonly Self, t: readonly Ty): bool {
    match (t) {
      #Borrow(_, inner) => self.isArray(inner),
      #Array(_, _) => true,
      #Slice(e) => match (e.get()) { #Prim(#U8) => false, _ => true },
      _ => self.lw.namedIs(t, "Vec"),
    }
  }

  // A unary operator on a primitive of type `t`, checked for overflow.
  function arith(self: readonly Self, op: str, x: str, y: str, t: readonly Ty): String {
    match (intPrim(t)) {
      #Some(p) if op == "-" => `${check(p)}(-${y})`,
      _ => `(${op}${y})`,
    }
  }
}

// ---- values ----

// The locals lent `mut` as wholes in a function's blocks: those that live in cells.
function cellsIn(b: readonly Block, out: mut HashSet<usize>): void {
  for (const c of b.cleanups) { if (const #Defer(_, d) = c) { cellsIn(d, mut out); } }
  for (const s of b.stmts) {
    match (s) {
      #Let(_, rv) | #Store(_, rv) => cellsRvalue(rv, mut out),
      #If(_, x, y) | #Loop(_, x, y) | #Try(x, _, y) => { cellsIn(x, mut out); cellsIn(y, mut out); }
      #Labeled(_, x) | #Block(x) | #Region(_, _, x) | #ForGen(_, _, _, x) => cellsIn(x, mut out),
      #Handle(h) => { cellsIn(h.body, mut out); for (const a of h.arms) { cellsIn(a.body, mut out); } }
      _ => {}
    }
  }
}

function cellsRvalue(rv: readonly Rvalue, out: mut HashSet<usize>): void {
  if (const #Borrow(true, p) = rv && p.path.len() == 0 && const #Local(l) = p.root) { out.insert(l); }
}

impl JsGen {
  // A JavaScript expression of an rvalue other than a call, of type `ty`.
  function rvalue(self: mut Self, rv: readonly Rvalue, ty: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    match (rv) {
      #Use(op) => self.operand(op, span),
      #Borrow(m, p) => {
        const [lv, parts] = self.lvalueParts(p, true, span);
        if (!m) { return self.lvalue(p, span); }
        // What a reference reads and writes: a cell, the reference a place holds, or a field.
        if (lv.endsWith(".v")) { return lv.slice(0, lv.len() - 2).toString(); }
        match (parts) {
          #Some([o, k]) => `new $rt.FieldRef(${o}, ${k})`,
          #None => `{ v: ${lv} }`,
        }
      }
      #View(p) => self.lvalue(p, span),
      #Unary(op, v) => {
        const x = self.operand(v, span);
        if (op == "-") { self.arith("-", "", x.asStr(), ty) } else if (op == "~") {
          match (intPrim(ty)) { #Some(p) => `$rt.wrap_${primName(p)}(~${x})`, #None => `(~${x})` }
        } else { `(${op}${x})` }
      }
      #Binary(op, a, b) => {
        const x = self.operand(a, span);
        const y = self.operand(b, span);
        const at = self.operandTy(a);
        self.binary(op.asStr(), x, y, ty, at)
      }
      #Cast(v, to) => {
        const from = self.operandTy(v);
        const x = self.operand(v, span);
        self.cast(x, from, to)
      }
      #IsTag(p, tag) => {
        const lv = self.lvalue(p, span);
        `(${lv}.$tag === ${quote(tag.asStr())})`
      }
      #Tag(name, vs) => match (vs.first()) {
        #None => `{ $tag: ${quote(name.asStr())} }`,
        #Some(v) => {
          const x = self.operand(v, span);
          `{ $tag: ${quote(name.asStr())}, $: ${x} }`
        }
      },
      #Fields(fs) => {
        match (ty) {
          #Tuple(_) => {
            let xs: Vec<String> = Vec.new();
            for (const [_, v] of fs) { xs.push(self.operand(v, span)); }
            `[${xs.join(", ")}]`
          }
          _ => {
            let es: Vec<String> = Vec.new();
            for (const [k, v] of fs) {
              const x = self.operand(v, span);
              es.push(`${mangleField(k.asStr())}: ${x}`);
            }
            `{ ${es.join(", ")} }`
          }
        }
      }
      #List(vs) => {
        let xs: Vec<String> = Vec.new();
        for (const v of vs) { xs.push(self.operand(v, span)); }
        `[${xs.join(", ")}]`
      }
      #Convert(v) => self.operand(v, span),
      #Closure(k, caps, _) => self.closure(k, caps, span),
      #FnRef(i) => self.instName(i),
      #AddressOf(_) => self.fail(span, "an address exists only in a native program"),
      #Call(_) => self.fail(span, "a call where a value was expected"),
    }
  }

  // `x op y` for primitives of type `operand`, giving a value of type `t`.
  function binary(self: readonly Self, op: str, x: String, y: String, t: readonly Ty, operand: readonly Ty): String {
    if (op == "==") { return `(${x} === ${y})`; }
    if (op == "!=") { return `(${x} !== ${y})`; }
    match (intPrim(t)) {
      #Some(p) => {
        const name = primName(p);
        if (numeric(t)) {
          const c = check(p);
          return match (op) {
            "/" => `${c}($div(${x}, ${y}))`,
            "%" => `$rem(${x}, ${y})`,
            // Bitwise operators work on 32 bits: wider numbers go through BigInts.
            "&" | "|" | "^" => match (p) {
              #U32 => `((${x} ${op} ${y}) >>> 0)`,
              #Usize | #Isize => `$rt.bits(${x}, ${y}, ${quote(op)})`,
              _ => `(${x} ${op} ${y})`,
            },
            "<<" => `${c}(${x} * 2 ** ${y})`,
            ">>" => `Math.floor(${x} / 2 ** ${y})`,
            _ => `${c}(${x} ${op} ${y})`,
          };
        }
        match (op) {
          "/" => `$rt.div(${x}, ${y}, $rt.${name})`,
          "%" => `$rt.rem(${x}, ${y})`,
          "&" | "|" | "^" => `(${x} ${op} ${y})`,
          ">>" => `(${x} >> ${y})`,
          _ => `$rt.${name}(${x} ${op} ${y})`,
        }
      }
      #None => {
        if (floatTy(operand) && op == "%") { return `$rt.fmod(${x}, ${y})`; }
        `(${x} ${op} ${y})`
      }
    }
  }

  function cast(self: readonly Self, v: String, from: readonly Ty, to: readonly Ty): String {
    const fromInt = intPrim(from).isSome();
    // Between integers that are numbers: nothing, if every value of the one is a value of the
    // other, or the low bits by a bit operation.
    if (const #Some(p) = intPrim(to) && const #Some(q) = intPrim(from) && numeric(to) && numeric(from)) {
      if (fitsIn(q, p)) { return v; }
      return match (p) {
        #I8 => `((${v} << 24) >> 24)`,
        #I16 => `((${v} << 16) >> 16)`,
        #I32 => `(${v} | 0)`,
        #U8 => `(${v} & 255)`,
        #U16 => `(${v} & 65535)`,
        #U32 => `(${v} >>> 0)`,
        _ => `$rt.wrap_${primName(p)}(${v})`,
      };
    }
    match (intPrim(to)) {
      #Some(p) => {
        // To the target's representation first, then to its width.
        const conv = if (floatTy(from)) {
          if (numeric(to)) { "$rt.truncNum" } else { "$rt.truncFloat" }
        } else if (numeric(to)) { "$rt.toNum" } else { "$rt.toInt" };
        `$rt.wrap_${primName(p)}(${conv}(${v}))`
      }
      #None => if (floatTy(to) && fromInt && !numeric(from)) { `Number(${v})` } else { v },
    }
  }
}

// ---- statements ----

impl JsGen {
  function declarations(self: mut Self, b: readonly Block): void {
    let names: Vec<String> = Vec.new();
    for (const l of b.locals) {
      if (!self.cx.own.has(l) || self.cx.hoisted.has(l)) { continue; }
      if (self.cx.cells.has(l)) { self.line(`const ${self.localName(l)} = { v: undefined };`); } else { names.push(self.localName(l)); }
    }
    if (names.len() > 0) { self.line(`let ${names.join(", ")};`); }
  }

  // Whether running a block's cleanups does anything here.
  function cleansUp(self: mut Self, b: readonly Block): bool {
    for (const c of b.cleanups) {
      match (c) {
        #Drop(l) => {
          const t = self.cx.locals[l].ty.clone();
          if (self.drops(t)) { return true; }
        }
        #Defer(_, _) => return true,
        #Arena(_) => {}
      }
    }
    false
  }

  function block(self: mut Self, b: readonly Block, span: Span): void uses Fail<Diagnostic> {
    self.line("{");
    self.cx.indent += 1;
    self.declarations(b);
    const pro = replace(mut self.cx.prologue, String.new());
    if (pro.len() > 0) { self.line(pro.asStr()); }
    if (!self.cleansUp(b)) {
      for (const s of b.stmts) { self.stmt(s, span); }
    } else {
      // A block's cleanups run however it is left.
      self.line("try {");
      self.cx.indent += 1;
      for (const s of b.stmts) { self.stmt(s, span); }
      self.cx.indent -= 1;
      // A panic stops the task where it is: its cleanup does not run (§5.7).
      self.line("} finally { if ($rt.unwinds()) {");
      self.cx.indent += 1;
      let k = b.cleanups.len();
      while (k > 0) {
        k -= 1;
        match (b.cleanups[k]) {
          #Drop(l) => {
            const t = self.cx.locals[l].ty.clone();
            if (self.drops(t)) {
              const f = self.dropFn(t, span);
              self.line(`${f}(${self.local(l)});`);
            }
          }
          #Defer(flag, body) => {
            const fl = self.local(flag);
            // A `defer` runs to its end: a cancellation meanwhile waits for it (§5.6).
            self.line(`if (${fl}) {`);
            self.cx.indent += 1;
            self.line(`${fl} = false;`);
            self.line("$rt.cleaning(1);");
            self.line("try {");
            self.block(body, span);
            self.line("} finally { $rt.cleaning(-1); }");
            self.cx.indent -= 1;
            self.line("}");
          }
          #Arena(_) => {}
        }
      }
      self.cx.indent -= 1;
      self.line("} }");
    }
    self.cx.indent -= 1;
    self.line("}");
  }

  function stmt(self: mut Self, s: readonly Stmt, span: Span): void uses Fail<Diagnostic> {
    match (s) {
      #Let(l, rv) => {
        const t = self.cx.locals[l].ty.clone();
        const dest: Option<String> = if (unitTy(t)) { #None } else { #Some(self.local(l)) };
        self.assignTo(dest, rv, t, span);
      }
      #Store(p, rv) => {
        const t = self.placeTy(p);
        const [lv, _] = self.lvalueParts(p, true, span);
        self.assignTo(#Some(lv), rv, t, span);
      }
      #Drop(p) => {
        const t = self.placeTy(p);
        if (self.drops(t)) {
          const f = self.dropFn(t, span);
          const lv = self.lvalue(p, span);
          // Emptied, as C's drops leave a place: dropping it again does nothing.
          self.line(`${f}(${lv}); ${lv} = undefined;`);
        }
      }
      #If(c, a, b) => {
        const x = self.operand(c, span);
        self.line(`if (${x})`);
        self.block(a, span);
        if (b.stmts.len() > 0) {
          self.line("else");
          self.block(b, span);
        }
      }
      #Loop(l, body, step) => {
        self.line(`L${l}: for (;;) {`);
        self.cx.indent += 1;
        self.line(`C${l}:`);
        self.block(body, span);
        self.block(step, span);
        self.cx.indent -= 1;
        self.line("}");
      }
      #Labeled(l, b) => {
        self.line(`L${l}:`);
        self.block(b, span);
      }
      #Break(l) => self.line(`break L${l};`),
      // A `continue` leaves the body, to the loop's step.
      #Continue(l) => self.line(`break C${l};`),
      #Return(op) => {
        const v = self.operand(op, span);
        // A `return` in a `handle`'s body or arm leaves the function around it.
        if (self.cx.inHandle) { self.line(`throw new $rt.Return(${v});`); } else { self.line(`return ${v};`); }
      }
      #Throw(op, _) => {
        const v = self.operand(op, span);
        self.line(`throw new $rt.Fail(${v});`);
      }
      #Panic(m) => self.line(`$rt.panic(${quote(m.asStr())});`),
      #Block(b) => self.block(b, span),
      #Try(b, err, h) => {
        self.line("try");
        self.block(b, span);
        const e = self.fresh();
        self.line(`catch (${e}) {`);
        self.cx.indent += 1;
        self.line(`if (!(${e} instanceof $rt.Fail)) throw ${e};`);
        self.cx.prologue = `${self.local(err)} = ${e}.value;`;
        self.block(h, span);
        self.cx.indent -= 1;
        self.line("}");
      }
      #Arm(flag) => self.line(`${self.local(flag)} = true;`),
      #Yield(op, _) => {
        const v = self.operand(op, span);
        self.line(`yield $rt.yielded(${v});`);
      }
      #ForGen(l, c, item, body) => self.forGen(l, c, item, body, span),
      #Region(_, _, b) => self.block(b, span),
      #Perform(d, op, args, r) => {
        let vs: Vec<String> = Vec.new();
        for (const a of args) { vs.push(self.operand(a, span)); }
        const name = match (self.lw.p.defs[d].kind) {
          #Effect { ops } => match (ops.get(op)) { #Some([n, _]) => n.clone(), #None => String.new() },
          _ => String.new(),
        };
        const call = `(yield $rt.perform(${d}, ${quote(name.asStr())}, [${vs.join(", ")}]))`;
        if (unitTy(self.cx.locals[r].ty)) { self.line(`${call};`); } else { self.line(`${self.local(r)} = ${call};`); }
      }
      #Handle(h) => self.handle(h),
      #Resume(k, arg, r) => {
        const kv = self.operand(k, span);
        const a = match (arg) { #Some(x) => self.operand(x, span), #None => String.new() };
        const call = if (self.cx.gen) { `(yield* ${kv}(${a}))` } else { `$rt.run(${kv}(${a}))` };
        if (unitTy(self.cx.locals[r].ty)) { self.line(`${call};`); } else { self.line(`${self.local(r)} = ${call};`); }
      }
      #At(_) => {}
    }
  }

  // Statements putting the value of `rv`, a `t`, in `dest`, or evaluating it if there is none.
  function assignTo(self: mut Self, dest: Option<String>, rv: readonly Rvalue, t: readonly Ty, span: Span): void uses Fail<Diagnostic> {
    const v = match (rv) {
      #Call(c) => self.call(c),
      _ => self.rvalue(rv, t, span),
    };
    match (dest) {
      #Some(d) => self.line(`${d} = ${v};`),
      #None => { if (v != "undefined") { self.line(`${v};`); } }
    }
  }
}

// ---- calls ----

impl JsGen {
  // A call, as an expression.
  function call(self: mut Self, c: readonly Call): String uses Fail<Diagnostic> {
    const span = c.span;
    let vs: Vec<String> = Vec.new();
    for (const a of c.args) { vs.push(self.operand(a, span)); }
    match (c.callee) {
      #Inst(i) => {
        const f = self.instName(i);
        if (self.instSuspends(i)) { `(yield* ${f}(${vs.join(", ")}))` } else { `${f}(${vs.join(", ")})` }
      }
      #Value(f, _) => {
        const fv = self.operand(f, span);
        // A function value may do less than its type allows — a closure that performs nothing,
        // passed where one may suspend — and then is no generator: it is called either way.
        if (self.rowSuspends(c.row)) { `(yield* $rt.lift(${fv}(${vs.join(", ")})))` } else { `${fv}(${vs.join(", ")})` }
      }
      #Builtin(k) => self.builtin(k.asStr(), c, vs),
    }
  }

  // A call of the runtime's.
  function builtin(self: mut Self, key: str, c: readonly Call, vs0: Vec<String>): String uses Fail<Diagnostic> {
    const span = c.span;
    // A list lent `mut` is a reference to its range.
    let vs: Vec<String> = Vec.new();
    for (const [i, v] of vs0.iter().enumerate()) {
      const lent = match (c.params.get(i)) { #Some(#Borrow(true, x)) => match (x.get()) { #Slice(_) | #Array(_, _) => true, _ => false }, _ => false };
      vs.push(if (lent) { `$rt.sliceRef(${v})` } else { v.clone() });
    }
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "undefined".toString() };
    // Raw memory and C exist only in a native program (§8.2).
    if (key.startsWith("extern:") || key.startsWith("Ptr_") || key == "sizeOf" || key == "alignOf" || key == "zeroed" || key.startsWith("fence")) {
      return self.fail(span, `\`${key}\` runs only in a native program`);
    }
    if (key.startsWith("perform:Io:")) {
      const op = key.slice(11, key.len());
      return if (self.tasks) { `(yield* $b.Io_${op}$g(${vs.join(", ")}))` } else { `$b.Io_${op}(${vs.join(", ")})` };
    }
    match (key) {
      "str_eq" => return `(${arg(0)} === ${arg(1)})`,
      "str_cmp" => return `$rt.strCmp(${arg(0)}, ${arg(1)})`,
      "slice_range" => return `$rt.slice(${arg(0)}, ${arg(1)}, ${arg(2)})`,
      "String_pushShown" => {
        const f = match (c.argTys.get(1)) { #Some(t) => floatTy(t), #None => false };
        const shown = if (f) { `$rt.showFloat(${arg(1)})` } else { `String(${arg(1)})` };
        return `(${arg(0)}.v += ${shown}, undefined)`;
      }
      "str_nextLine" | "str_nextWord" => {
        // The rest of the text, advanced in its place.
        const [lv, _] = match (c.args.first()) { #Some(#Copy(p)) | #Some(#Move(p)) => self.lvalueParts(p, true, span), _ => return self.fail(span, "a routine changes what is not a place") };
        const t = self.fresh();
        const f = if (key == "str_nextWord") { "nextWord" } else { "nextLine" };
        self.line(`const ${t} = $rt.${f}(${lv});`);
        self.line(`${lv} = ${t}[1];`);
        return `(${t}[0] === undefined ? { $tag: "None" } : { $tag: "Some", $: ${t}[0] })`;
      }
      "channel" | "Reply_new" => {
        // What drops a message left in the channel, or sent to it once no one receives.
        const msg = match (c.ret) { #Tuple(ts) if ts.len() > 0 => typeArg(ts[0], 0), _ => #Error };
        const drop = if (self.drops(msg)) { self.dropFn(msg, span) } else { "undefined".toString() };
        return `$b.${key}(${drop})`;
      }
      "HashMap_insert" => {
        // The entry an equal key replaces is dropped.
        const m = match (c.argTys.first()) { #Some(t) => stripBorrow(t), #None => #Error };
        const e = entryTy(m);
        if (self.drops(e)) { return `$b.HashMap_insert(${arg(0)}, ${arg(1)}, ${arg(2)}, ${self.dropFn(e, span)})`; }
      }
      "Io_handled" => return "$rt.ioHandled()".toString(),
      "File_text" => return `${arg(0)}.text`,
      "RegionList_at" => return `${arg(0)}[${arg(1)}]`,
      "Listener_next" => return "$rt.nextConnection()".toString(),
      "Receiver_recv" => return `(yield* $b.Receiver_recv$g(${arg(0)}))`,
      "Gen_next" => {
        return if (self.cx.gen) { `(yield* $b.Gen_next$g(${arg(0)}))` } else { `$b.Gen_next(${arg(0)})` };
      }
      _ => {}
    }
    let all = vs.clone();
    // `repeat` makes an array of the length its type has.
    if (key == "repeat") {
      match (c.ret) {
        #Array(_, #Known(n)) => all.push(`${n}`),
        _ => self.fail(span, "`repeat` needs an array type of a known length"),
      }
    }
    // A builtin that may suspend other than by yielding items has a generator of its own.
    const suspends = self.rowSuspends(c.row) && self.cx.gen;
    if (suspends && !self.rowYields(c.row)) { `(yield* $b.${key}$g(${all.join(", ")}))` } else { `$b.${key}(${all.join(", ")})` }
  }

  // `for` over a generator: it is stepped here, each item it yields running the body, and anything
  // else it performs passed on to whoever drives this code, and the answer back to it.
  function forGen(self: mut Self, l: usize, c: readonly Call, item: usize, body: readonly Block, span: Span): void uses Fail<Diagnostic> {
    let vs: Vec<String> = Vec.new();
    for (const a of c.args) { vs.push(self.operand(a, span)); }
    const f = match (c.callee) { #Inst(i) => self.instName(i), _ => return self.fail(span, "a loop over no generator") };
    const g = self.fresh();
    const r = self.fresh();
    const answer = self.fresh();
    self.line(`const ${g} = ${f}(${vs.join(", ")});`);
    self.line(`let ${answer};`);
    self.line("try {");
    self.cx.indent += 1;
    self.line(`L${l}: for (let ${r} = ${g}.next(); !${r}.done; ${r} = ${g}.next(${answer})) {`);
    self.cx.indent += 1;
    self.line(`${answer} = undefined;`);
    if (self.cx.gen) { self.line(`if (!$rt.isYield(${r}.value)) { ${answer} = yield ${r}.value; continue; }`); }
    self.line(`C${l}:`);
    self.cx.prologue = `${self.local(item)} = ${r}.value.item;`;
    self.block(body, span);
    self.cx.indent -= 1;
    self.line("}");
    self.cx.indent -= 1;
    // A generator left early runs its cleanup.
    self.line(`} finally { if (${g}.return && $rt.unwinds()) ${g}.return(); }`);
  }

  // Whether a block has a `return` outside the closures in it.
  function returnsIn(b: readonly Block): bool {
    for (const c of b.cleanups) { if (const #Defer(_, d) = c && JsGen.returnsIn(d)) { return true; } }
    for (const s of b.stmts) {
      const r = match (s) {
        #Return(_) => true,
        #If(_, x, y) | #Loop(_, x, y) | #Try(x, _, y) => JsGen.returnsIn(x) || JsGen.returnsIn(y),
        #Labeled(_, x) | #Block(x) | #Region(_, _, x) | #ForGen(_, _, _, x) => JsGen.returnsIn(x),
        #Handle(h) => JsGen.returnsIn(h.body) || h.arms.iter().some((a) => JsGen.returnsIn(a.body)),
        _ => false,
      };
      if (r) { return true; }
    }
    false
  }

  // `handle { body } with E { arms }`: the body and each arm become generators, which the runtime
  // drives (§5.2, §5.3).
  function handle(self: mut Self, h: readonly Handle): void uses Fail<Diagnostic> {
    const span = h.span;
    const d = h.effect;
    const id = if (self.lw.p.defs[d].name == "Yield") { "$rt.YIELD".toString() } else { `${d}` };
    const ops = match (self.lw.p.defs[d].kind) { #Effect { ops } => ops.clone(), _ => Vec.new() };
    const b = self.cx.locals[h.result].ty.clone();
    const body = self.part(Vec.new(), #None, h.body, h.value, b.clone(), span);
    let parts: Vec<String> = Vec.new();
    for (const a of h.arms) {
      const name = match (ops.get(a.op)) { #Some([n, _]) => n.clone(), #None => String.new() };
      const f = self.part(a.params, a.cont, a.body, a.value, b.clone(), span);
      parts.push(`${mangleField(name.asStr())}: ${f}`);
    }
    // A handler of `Io` says, while its body runs, that `Io`'s operations are the program's.
    const io = if (self.lw.p.defs[d].name == "Io" && self.lw.p.modules[self.lw.p.defs[d].module].isStd) { ", true" } else { "" };
    const run = `$rt.handle(${id}, ${body}, { ${parts.join(", ")} }${io})`;
    const call = if (self.cx.gen) { `(yield* ${run})` } else { `$rt.run(${run})` };
    const store = if (unitTy(b)) { "".toString() } else { `${self.local(h.result)} = ` };
    const leaves = JsGen.returnsIn(h.body) || h.arms.iter().some((a) => JsGen.returnsIn(a.body));
    if (!leaves || self.cx.inHandle) {
      self.line(`${store}${call};`);
      return;
    }
    // A `return` inside it leaves the function.
    const x = self.fresh();
    self.line(`try { ${store}${call}; } catch (${x}) { if (${x} instanceof $rt.Return) return ${x}.v; throw ${x}; }`);
  }

  // A `handle`'s body or arm, as a generator function of the arm's parameters and continuation,
  // whose value is in local `value`.
  function part(self: mut Self, params: readonly Vec<usize>, cont: Option<usize>, body: readonly Block, value: usize, b: Ty, span: Span): String uses Fail<Diagnostic> {
    let own: HashSet<usize> = HashSet.new();
    ownedIn(body, mut own);
    const saved = self.enter(own, true);
    self.cx.inHandle = true;
    let names: Vec<String> = Vec.new();
    let pro = String.new();
    let all = params.clone();
    if (const #Some(k) = cont) { all.push(k); }
    for (const p of all) {
      const raw = self.fresh();
      names.push(raw.clone());
      pro.push(`${self.local(p)} = ${raw}; `);
    }
    if (!unitTy(b)) {
      self.cx.hoisted.insert(value);
      self.line(`let ${self.localName(value)};`);
    }
    self.cx.prologue = pro;
    self.block(body, span);
    if (!unitTy(b)) { self.line(`return ${self.local(value)};`); }
    const inner = self.leave(saved);
    let close = String.new();
    for (const _ of 0..self.cx.indent) { close.push("  "); }
    `(function* (${names.join(", ")}) {\n${inner}${close}})`
  }

  // Starts a JavaScript function of its own inside the one being made, holding the locals `own`.
  function enter(self: mut Self, own: HashSet<usize>, gen: bool): Ctx {
    let cx = newCtx(self.cx.locals.clone(), gen);
    cx.own = own;
    cx.cells = self.cx.cells.clone();
    cx.captures = self.cx.captures.clone();
    cx.capTys = self.cx.capTys.clone();
    cx.indent = self.cx.indent + 1;
    replace(mut self.cx, cx)
  }

  // Ends it: its code.
  function leave(self: mut Self, saved: Ctx): String {
    const out = replace(mut self.cx.out, String.new());
    self.cx = saved;
    out
  }

  // A closure: its function, made where the closure is, which reaches what it borrows where it
  // is, and holds what it holds.
  function closure(self: mut Self, k: usize, caps: readonly Vec<Capture>, span: Span): String uses Fail<Diagnostic> {
    const f = self.lw.closures[k].clone();
    let held: Vec<String> = Vec.new();
    let heldValues: Vec<String> = Vec.new();
    let captures: Vec<String> = Vec.new();
    for (const c of caps) {
      match (c) {
        #Value(op) => {
          const n = self.fresh();
          heldValues.push(self.operand(op, span));
          held.push(n.clone());
          captures.push(n);
        }
        #Ref(_, p) => {
          const [lv, _] = self.lvalueParts(p, true, span);
          captures.push(lv);
        }
      }
    }
    const gen = self.rowSuspends(f.row);
    let own: HashSet<usize> = HashSet.new();
    for (const [i, _] of f.locals.iter().enumerate()) { own.insert(i); }
    let cx = newCtx(f.locals.clone(), gen);
    cx.own = own;
    let cells: HashSet<usize> = HashSet.new();
    cellsIn(f.body, mut cells);
    cx.cells = cells;
    cx.captures = captures;
    for (const [_, t, _] of f.captures) { cx.capTys.push(t.clone()); }
    cx.indent = self.cx.indent + 1;
    const saved = replace(mut self.cx, cx);
    let names: Vec<String> = Vec.new();
    let pro = String.new();
    for (const p of f.params) {
      const raw = self.fresh();
      names.push(raw.clone());
      pro.push(`${self.local(p)} = ${raw}; `);
    }
    if (!unitTy(f.ret)) {
      self.cx.hoisted.insert(f.value);
      self.line(`let ${self.localName(f.value)};`);
    }
    // A closure called `once` drops what it holds as its call ends.
    let drops = String.new();
    if (f.once) {
      for (const [i, [_, t, byValue]] of f.captures.iter().enumerate()) {
        if (byValue && self.drops(t)) {
          const d = self.dropFn(t.clone(), span);
          drops.push(`${d}(${self.cx.captures[i]}); `);
        }
      }
    }
    self.cx.prologue = pro;
    if (drops.len() > 0) {
      self.line("try {");
      self.block(f.body, span);
      self.line(`} finally { if ($rt.unwinds()) { ${drops}} }`);
    } else {
      self.block(f.body, span);
    }
    if (!unitTy(f.ret)) { self.line(`return ${self.local(f.value)};`); }
    const inner = self.leave(saved);
    let close = String.new();
    for (const _ of 0..self.cx.indent) { close.push("  "); }
    const fn = if (gen) { `function* (${names.join(", ")}) {\n${inner}${close}}` } else { `(${names.join(", ")}) => {\n${inner}${close}}` };
    if (held.len() == 0) { return `(${fn})`; }
    `((${held.join(", ")}) => ${fn})(${heldValues.join(", ")})`
  }
}

// The locals declared in a block and the blocks in it, but not in code made a function of its own.
function ownedIn(b: readonly Block, out: mut HashSet<usize>): void {
  for (const l of b.locals) { out.insert(l); }
  for (const c of b.cleanups) { if (const #Defer(_, d) = c) { ownedIn(d, mut out); } }
  for (const s of b.stmts) {
    match (s) {
      #If(_, x, y) | #Loop(_, x, y) | #Try(x, _, y) => { ownedIn(x, mut out); ownedIn(y, mut out); }
      #Labeled(_, x) | #Block(x) | #Region(_, _, x) | #ForGen(_, _, _, x) => ownedIn(x, mut out),
      _ => {}
    }
  }
}

// ---- functions and the program ----

impl JsGen {
  // Function instance `i`, lowered as `f`.
  function emit(self: mut Self, i: usize, f: Func): void uses Fail<Diagnostic> {
    const gen = self.instSuspends(i);
    let own: HashSet<usize> = HashSet.new();
    ownedIn(f.body, mut own);
    self.cx = newCtx(f.locals.clone(), gen);
    self.cx.own = own;
    let cells: HashSet<usize> = HashSet.new();
    cellsIn(f.body, mut cells);
    self.cx.cells = cells;
    let names: Vec<String> = Vec.new();
    let pro = String.new();
    for (const p of f.params) {
      const raw = self.fresh();
      names.push(raw.clone());
      pro.push(`${self.local(p)} = ${raw}; `);
    }
    if (!unitTy(f.ret)) {
      self.cx.hoisted.insert(f.value);
      self.line(`let ${self.localName(f.value)};`);
    }
    self.cx.prologue = pro;
    self.block(f.body, f.span);
    if (!unitTy(f.ret)) { self.line(`return ${self.local(f.value)};`); }
    const body = replace(mut self.cx.out, String.new());
    const star = if (gen) { "*" } else { "" };
    self.code.push(`function${star} ${self.instName(i)}(${names.join(", ")}) {\n${body}}\n`);
  }

  function failed(self: readonly Self, d: Diagnostic, module: usize): #Failed(String) {
    #Failed(render(d, self.lw.p.modules[module].file.asStr(), self.lw.p.modules[module].source.asStr()))
  }

  export function program(self: mut Self, entry: usize, runtime: str): String uses Fail<#Failed(String)> {
    const ent = self.lw.entry(entry, false);
    if (ent.exports.len() > 0) { throw #Failed("error: functions C calls exist only in a native program".toString()); }
    const mainInst = match (ent.main) { #Some(m) => m, #None => throw #Failed("error: the program has no `main` function".toString()) };
    self.tasks = ent.tasks;
    let next: usize = 0;
    while (next < self.lw.insts.len()) {
      const i = next;
      next += 1;
      const r = try {
        match (self.lw.func(i)) {
          #Some(f) => {
            self.module = f.module;
            self.emit(i, f);
          }
          #None => {}
        }
        #Ok
      } catch (d) { #Err(d) };
      if (const #Err(d) = r) { throw self.failed(d, self.lw.module) }
    }
    // `main` is given the command line, as its parameters' types read it.
    let args: Vec<String> = Vec.new();
    for (const [k, a] of ent.args.iter().enumerate()) {
      args.push(match (a) {
        #Int(t) => if (numeric(t)) { `$rt.argNum(${k})` } else { `$rt.argInt(${k})` },
        #Float(_) => `$rt.argNum(${k})`,
        #Str => `$rt.argStr(${k})`,
        #Strings | #Strs => `$rt.argList(${k})`,
      });
    }
    const main = self.instName(mainInst);
    const suspends = if (self.instSuspends(mainInst)) { "true" } else { "false" };
    const tasks = if (self.tasks) { "true" } else { "false" };
    let out = runtime.toString();
    out.push("\n");
    out.push(self.head.asStr());
    out.push(self.code.asStr());
    out.push(`$rt.start(() => ${main}(${args.join(", ")}), ${suspends}, ${tasks});\n`);
    out
  }
}

// The JavaScript for a checked program: the runtime, then the code its `main` reaches, then a call
// of `main` with the command line.
export function jsProgram(p: Prog, entry: usize, runtime: str): String uses Fail<#Failed(String)> {
  let g = JsGen {
    lw: newLower(p), tasks: false, consts: HashMap.new(), dropNeeds: HashMap.new(), dropFns: HashMap.new(), head: String.new(),
    code: String.new(), tmp: 0, cx: newCtx(Vec.new(), false), module: 0,
  };
  g.program(entry, runtime)
}
