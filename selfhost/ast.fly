// The surface syntax tree. It mirrors the grammar in docs/spec.md §2.3; desugaring happens in
// later passes. Every expression and pattern has an `id`, unique in its module, which the passes
// after parsing index their tables by.

import { Span } from "./diag";

export type Ident = { name: String; span: Span };

export type Module = { items: Vec<Item> };

export type Item = { exported: bool; kind: ItemKind; span: Span };

export enum ItemKind {
  // `import { a, b as c } from "m";`: each name, and the local name it is bound to.
  #Import { names: Vec<[Ident, Ident]>; from: String },
  // A module-level constant, evaluated at compile time.
  #Const { name: Ident; ty: Option<Type>; value: Expr },
  #Struct(StructDecl),
  #Enum(EnumDecl),
  #Interface(InterfaceDecl),
  #Impl(ImplDecl),
  #TypeAlias(TypeAlias),
  #Effect(EffectDecl),
  #Function(FnDecl),
}

export type StructDecl = {
  layout: Option<Ident>;
  // `@layout(c, align = N)`: the alignment asked for.
  align: Option<u64>;
  // Declared `view`: it may hold borrows (§3.3).
  view: bool;
  name: Ident;
  params: Vec<TypeParam>;
  // `#None` for an opaque declaration (`struct Socket;`), allowed only in `.d.fly` files.
  fields: Option<Vec<Field>>;
};

export struct Field {
  name: Ident;
  ty: Type;
  // `private`: visible only in the declaring module.
  private: bool;
  // `[e]: T`: the name is the value of the `comptime` expression `e` (§7.2).
  computed: Option<Box<Expr>>;
  // Fields generated by `comptime for` or `comptime if`; the other parts are unused.
  generate: Option<Box<Generate<Field>>>;
}

// Items generated in a sequence — record fields, record-literal entries, match arms — by
// `comptime for (pat of iter) { … }`, `comptime if (cond) { … } else { … }` or `comptime match` (§7.2).
export enum Generate<T> {
  #For { pat: Pattern; iter: Expr; body: Vec<T> },
  #If { cond: Expr; then: Vec<T>; otherwise: Vec<T> },
  #Match { scrutinee: Expr; arms: Vec<[Pattern, Vec<T>]> },
  // `comptime e;` among a struct's fields: run for its checks, generating nothing.
  #Do(Expr),
}

export type EnumDecl = { view: bool; name: Ident; params: Vec<TypeParam>; tags: Vec<TagDecl> };

export type TagDecl = { name: Ident; payload: TagPayload };

export enum TagPayload { #None, #Tuple(Vec<Type>), #Record(Vec<Field>) }

export type InterfaceDecl = { name: Ident; params: Vec<TypeParam>; extends: Vec<Type>; members: Vec<InterfaceMember> };

export enum InterfaceMember {
  #Method(FnSig),
  #AssocType { name: Ident; bounds: Vec<Type> },
}

export type ImplDecl = {
  params: Vec<TypeParam>;
  // `impl I for T` has `iface: #Some(I)` and `target: T`; `impl T` has `iface: #None`.
  iface: Option<Type>;
  target: Type;
  methods: Vec<Method>;
  // `type View = …;`: the interface's associated types, for this type (§3.4).
  assoc: Vec<[Ident, Type]>;
  // `impl I for T;`: the type asks for the interface's derivation (§7.3).
  derived: bool;
};

export type Method = { exported: bool; decl: FnDecl };

export type TypeAlias = { name: Ident; params: Vec<TypeParam>; ty: Type };

export type EffectDecl = { name: Ident; params: Vec<TypeParam>; ops: Vec<FnSig> };

export type FnSig = {
  isComptime: bool;
  // `extern "C"`: a function of C's, declared without a body, or one C calls, with a body (§8.2).
  foreign: bool;
  name: Ident;
  typeParams: Vec<TypeParam>;
  params: Vec<Param>;
  ret: Return;
  // `#None` when there is no `uses` clause.
  uses: Option<Vec<RowItem>>;
  span: Span;
};

// `body` is `#None` for a signature ending in `;`, allowed only in `.d.fly` files.
export type FnDecl = { sig: FnSig; body: Option<Block> };

// `ty` is `#None` only for untyped lambda parameters.
export type Param = { isComptime: bool; name: Ident; ty: Option<Type> };

// `from` is the parameters a returned borrow may come from (`from a, b`); empty if not written.
export type Return = { ty: Type; from: Vec<Ident> };

export enum TypeParam {
  #Region { name: Ident; default: Option<Type> },
  #Row { name: Ident; bounds: Vec<Type>; default: Option<Type> },
  #Comptime { name: Ident; ty: Type },
  #Type { name: Ident; bounds: Vec<Type>; default: Option<Type> },
}

export enum RowItem { #Effect(Type), #Spread(Ident) }

export type Type = { kind: TypeKind; span: Span };

export enum FnMode { #Shared, #Mut, #Once }

export enum TypeKind {
  // A primitive, a named type, a type parameter or an associated type (`C.View`).
  #Path { segments: Vec<Ident>; args: Vec<Type> },
  #Record { fields: Vec<Field>; rest: Option<Ident> },
  // Tags, named unions whose tags it includes (`JsonError | #Port(u16)`), and a row tail.
  #Union { tags: Vec<TagDecl>; includes: Vec<Type>; rest: Option<Ident> },
  #Tuple(Vec<Type>),
  // `[]`: the empty row, used as a row default.
  #EmptyRow,
  #Fn { mode: FnMode; params: Vec<Param>; ret: Box<Return>; uses: Option<Vec<RowItem>> },
  // `T[N]` when `len` is present, the slice `T[]` otherwise.
  #Array { elem: Box<Type>; len: Option<Box<Expr>> },
  #Mut(Box<Type>),
  #Readonly(Box<Type>),
  #Ptr(Box<Type>),
  #Dyn(Vec<Ident>),
  // A `comptime` expression in type position, e.g. an array length.
  #Expr(Box<Expr>),
  // A type computed by `comptime` code, by its index in the program's table (never parsed).
  #Spliced(usize),
}

export type Block = { stmts: Vec<Stmt>; tail: Option<Box<Expr>>; span: Span };

export enum Stmt {
  #Let { mutable: bool; pat: Pattern; ty: Option<Type>; init: Expr; span: Span },
  #Defer(Expr),
  #Expr(Expr),
}

export type Expr = { kind: ExprKind; span: Span; id: usize };

// `value` is `#None` for a punned field: `{ x }` means `{ x: x }`.
export struct FieldInit {
  name: Ident;
  value: Option<Expr>;
  // `[e]: v`: the name is the value of the `comptime` expression `e`.
  computed: Option<Box<Expr>>;
  // Entries generated by `comptime for` or `comptime if`; the other parts are unused.
  generate: Option<Box<Generate<FieldInit>>>;
}

export enum TagArgs { #None, #Tuple(Vec<Expr>), #Record(Vec<FieldInit>) }

export enum TemplatePiece { #Lit(String), #Expr(Expr) }

export enum ExprKind {
  #Int(String),
  #Float(String),
  #Byte(u8),
  #Str(String),
  #Template(Vec<TemplatePiece>),
  #Bool(bool),
  #Ident(String),
  #Tag { name: String; args: TagArgs },
  // `#[e](…)`: the tag named by the `comptime` string `e`.
  #TagAt { name: Box<Expr>; args: TagArgs },
  // A type computed by `comptime` code, used as a value's type: `T.decode(p)` (never parsed).
  #TypeRef(usize),
  // `{ … }` or `Name { … }`.
  #Record { name: Option<Vec<Ident>>; fields: Vec<FieldInit> },
  // `[a, b]`: a tuple or array literal, resolved by type.
  #List(Vec<Expr>),
  #Field { target: Box<Expr>; name: Ident },
  // `v.[e]`: the field named by the `comptime` string `e` (§7.2).
  #FieldAt { target: Box<Expr>; name: Box<Expr> },
  #Index { target: Box<Expr>; index: Box<Expr> },
  #Call { callee: Box<Expr>; typeArgs: Vec<Type>; args: Vec<Expr> },
  #Unary { op: String; operand: Box<Expr> },
  // `mut e` at a call site.
  #BorrowMut(Box<Expr>),
  #Binary { op: String; lhs: Box<Expr>; rhs: Box<Expr> },
  #Assign { op: String; target: Box<Expr>; value: Box<Expr> },
  #Cast { expr: Box<Expr>; ty: Type },
  #Range { lo: Option<Box<Expr>>; hi: Option<Box<Expr>> },
  #Lambda { params: Vec<Param>; body: Box<Expr> },
  #Block(Block),
  #If { cond: Box<Expr>; then: Block; otherwise: Option<Box<Expr>> },
  #While { cond: Box<Expr>; body: Block },
  #For { mutable: bool; pat: Pattern; iter: Box<Expr>; body: Block },
  #Match { scrutinee: Box<Expr>; arms: Vec<MatchArm> },
  #Try { body: Block; pat: Pattern; handler: Block },
  #Throw(Box<Expr>),
  #Yield(Box<Expr>),
  #Return(Option<Box<Expr>>),
  #Break,
  #Continue,
  #Region { name: Ident; body: Block },
  #Handle { body: Block; effect: Type; arms: Vec<HandlerArm> },
  #Unsafe(Block),
  #Comptime(Box<Expr>),
}

export struct MatchArm {
  pat: Pattern;
  guard: Option<Expr>;
  body: Expr;
  // Arms generated by `comptime for` or `comptime if`; the other parts are unused.
  generate: Option<Box<Generate<MatchArm>>>;
}

export type HandlerArm = { op: Ident; params: Vec<Ident>; resumes: Option<Ident>; body: Block };

export type Pattern = { kind: PatternKind; span: Span; id: usize };

export enum PatternKind {
  #Wild,
  #Bind(String),
  #Lit(Box<Expr>),
  #Tag { name: String; args: TagPatArgs },
  // `#[e](…)`: the tag named by the `comptime` string `e`.
  #TagAt { name: Box<Expr>; args: TagPatArgs },
  #Tuple(Vec<Pattern>),
  #Record { name: Option<Vec<Ident>>; fields: Vec<[Ident, Option<Pattern>]> },
  #Or(Vec<Pattern>),
}

export enum TagPatArgs { #None, #Tuple(Vec<Pattern>), #Record(Vec<[Ident, Option<Pattern>]>) }

impl Clone for ItemKind;
impl Clone for Field;
impl<T extends Clone> Clone for Generate<T>;
impl Clone for TagPayload;
impl Clone for InterfaceMember;
impl Clone for TypeParam;
impl Clone for RowItem;
impl Clone for FnMode;
impl Clone for TypeKind;
impl Clone for Stmt;
impl Clone for FieldInit;
impl Clone for TagArgs;
impl Clone for TemplatePiece;
impl Clone for ExprKind;
impl Clone for MatchArm;
impl Clone for PatternKind;
impl Clone for TagPatArgs;
