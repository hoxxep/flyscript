// Numbers as text, for the native runtime (runtime.c), which calls these by their C names: every
// native program and every WebAssembly one has them. Exactly, and with no help from the C library:
// a float is m·2^e, and its decimal digits are found with integers as large as they need to be.
// Shown, a float is the fewest digits that read back as it, the nearest of them to it, written out
// in full without an exponent; `toFixed` rounds to the nearest, a value exactly halfway to the
// even; text is read as the nearest float, halfway to the even. The JavaScript runtime has its own.

// An unsigned integer of up to 5,120 bits, its 32-bit digits least significant first.
struct Big { n: usize; d: u32[160] }
impl Copy for Big;

function big(v: u64): Big {
  let a = Big { n: 0, d: repeat(0 as u32) };
  let x = v;
  while (x != 0) { a.d[a.n] = x as u32; a.n += 1; x = x >> 32; }
  a
}

impl Big {
  function mul(self: mut Self, m: u32): void {
    let c: u64 = 0;
    for (const i of 0..self.n) {
      const t = (self.d[i] as u64) * (m as u64) + c;
      self.d[i] = t as u32;
      c = t >> 32;
    }
    if (c != 0) { self.d[self.n] = c as u32; self.n += 1; }
  }

  function addSmall(self: mut Self, m: u32): void {
    let c = m as u64;
    let i: usize = 0;
    while (i < self.n && c != 0) {
      const t = (self.d[i] as u64) + c;
      self.d[i] = t as u32;
      c = t >> 32;
      i += 1;
    }
    if (c != 0) { self.d[self.n] = c as u32; self.n += 1; }
  }

  function pow10(self: mut Self, k: i32): void {
    const p: u32[9] = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000];
    let left = k;
    while (left >= 9) { self.mul(1000000000); left -= 9; }
    if (left > 0) { self.mul(p[left as usize]); }
  }

  function shl(self: mut Self, bits: i32): void {
    if (self.n == 0 || bits <= 0) { return; }
    const w = (bits / 32) as usize;
    const b = (bits % 32) as u32;
    if (b != 0) {
      let c: u32 = 0;
      for (const i of 0..self.n) {
        const t = self.d[i];
        // Shifted as 64 bits and cut to 32: the bits shifted out are the carry.
        self.d[i] = (((t as u64) << (b as u64)) as u32) | c;
        c = t >> (32 - b);
      }
      if (c != 0) { self.d[self.n] = c; self.n += 1; }
    }
    if (w != 0) {
      let i = self.n;
      while (i > 0) { i -= 1; self.d[i + w] = self.d[i]; }
      for (const j of 0..w) { self.d[j] = 0; }
      self.n += w;
    }
  }

  function compare(self: readonly Self, b: readonly Big): i32 {
    if (self.n != b.n) { return if (self.n < b.n) { -1 } else { 1 }; }
    let i = self.n;
    while (i > 0) {
      i -= 1;
      if (self.d[i] != b.d[i]) { return if (self.d[i] < b.d[i]) { -1 } else { 1 }; }
    }
    0
  }

  // self + b compared with c.
  function cmpSum(self: readonly Self, b: readonly Big, c: readonly Big): i32 {
    let s: Big = self;
    let carry: u64 = 0;
    const n = if (self.n > b.n) { self.n } else { b.n };
    for (const i of 0..n) {
      const x: u64 = if (i < self.n) { self.d[i] as u64 } else { 0 };
      const y: u64 = if (i < b.n) { b.d[i] as u64 } else { 0 };
      const t = x + y + carry;
      s.d[i] = t as u32;
      carry = t >> 32;
    }
    s.n = n;
    if (carry != 0) { s.d[s.n] = carry as u32; s.n += 1; }
    s.compare(c)
  }

  // self -= b, where self >= b.
  function sub(self: mut Self, b: readonly Big): void {
    let borrow: i64 = 0;
    for (const i of 0..self.n) {
      const y: i64 = if (i < b.n) { b.d[i] as i64 } else { 0 };
      let t = (self.d[i] as i64) - y - borrow;
      borrow = if (t < 0) { 1 } else { 0 };
      t += borrow << 32;
      self.d[i] = t as u32;
    }
    self.trim();
  }

  function trim(self: mut Self): void { while (self.n > 0 && self.d[self.n - 1] == 0) { self.n -= 1; } }

  function bit(self: readonly Self, i: i32): bool {
    i >= 0 && ((i / 32) as usize) < self.n && ((self.d[(i / 32) as usize] >> ((i % 32) as u32)) & 1) != 0
  }

  // Whether any bit below bit `i` is set.
  function anyBelow(self: readonly Self, i: i32): bool {
    const words = (i / 32) as usize;
    for (const w of 0..words) { if (w < self.n && self.d[w] != 0) { return true; } }
    const b = (i % 32) as u32;
    b != 0 && words < self.n && (self.d[words] & ((1 << b) - 1)) != 0
  }

  function shr(self: mut Self, bits: i32): void {
    const w = (bits / 32) as usize;
    const b = (bits % 32) as u32;
    if (w >= self.n) { self.n = 0; return; }
    for (const i of 0..self.n - w) { self.d[i] = self.d[i + w]; }
    self.n -= w;
    if (b != 0) {
      for (const i of 0..self.n) {
        const next: u32 = if (i + 1 < self.n) { (((self.d[i + 1] as u64) << ((32 - b) as u64)) as u32) } else { 0 };
        self.d[i] = (self.d[i] >> b) | next;
      }
    }
    self.trim();
  }

  function bits(self: readonly Self): i32 {
    if (self.n == 0) { return 0; }
    ((self.n - 1) * 32) as i32 + 32 - leadingZeros32(self.d[self.n - 1])
  }

  // self /= m, giving the remainder.
  function div(self: mut Self, m: u32): u32 {
    let r: u64 = 0;
    let i = self.n;
    while (i > 0) {
      i -= 1;
      const t = (r << 32) | (self.d[i] as u64);
      self.d[i] = (t / (m as u64)) as u32;
      r = t % (m as u64);
    }
    self.trim();
    r as u32
  }

  // The quotient self / den, which is below 2^64; self becomes the remainder.
  function quot(self: mut Self, den: readonly Big): u64 {
    let q: u64 = 0;
    let s = self.bits() - den.bits();
    while (s >= 0) {
      let t: Big = den;
      t.shl(s);
      if (t.compare(self) <= 0) {
        self.sub(t);
        q = q | ((1 as u64) << (s as u64));
      }
      s -= 1;
    }
    q
  }
}

function leadingZeros32(x: u32): i32 {
  if (x == 0) { return 32; }
  let n: i32 = 0;
  let v = x;
  while ((v & 0x80000000) == 0) { v = v << 1; n += 1; }
  n
}

function leadingZeros64(x: u64): i32 {
  if ((x >> 32) != 0) { leadingZeros32((x >> 32) as u32) } else { 32 + leadingZeros32(x as u32) }
}

function bitsOf(v: f64): u64 { unsafe { Ptr.fromRef(v).cast<u64>().read() } }

function floatOf(bits: u64): f64 { unsafe { Ptr.fromRef(bits).cast<f64>().read() } }

// The mantissa and exponent of a finite float that is not negative: v = m·2^e.
function parts(v: f64): [u64, i32] {
  const b = bitsOf(v);
  const be = ((b >> 52) & 0x7ff) as i32;
  const frac = b & ((1 << 52) - 1);
  if (be == 0) { [frac, -1074] } else { [frac | (1 << 52), be - 1075] }
}

// The fewest decimal digits that read back as `v`, finite and positive, the nearest of them to it:
// v ≈ 0.d₁d₂…dₙ × 10^k. Steele and White's method: r/s is what is left to write, and m⁻/s and m⁺/s
// how far below and above it a float still reads as `v`. How many digits, and `k`.
function shortest(v: f64, digits: mut u8[20]): [usize, i32] {
  const [f, e] = parts(v);
  const even = (f & 1) == 0;
  // At a power of two the floats below are closer together than those above.
  const tight = f == (1 << 52) && e > -1074;
  let r = big(f);
  let s = big(1);
  let mp = big(1);
  let mm = big(1);
  if (e >= 0) {
    r.shl(e + if (tight) { 2 } else { 1 });
    s = big(if (tight) { 4 } else { 2 });
    mp.shl(e + if (tight) { 1 } else { 0 });
    mm.shl(e);
  } else {
    r.shl(if (tight) { 2 } else { 1 });
    s.shl((if (tight) { 2 } else { 1 }) - e);
    if (tight) { mp = big(2); }
  }
  // k from the number of bits, then exactly.
  let k = ((((e + 63 - leadingZeros64(f)) as i64) * 78913) >> 18) as i32;
  if (k >= 0) { s.pow10(k); } else { r.pow10(-k); mp.pow10(-k); mm.pow10(-k); }
  while (true) {
    const c = r.cmpSum(mp, s);
    if (if (even) { c >= 0 } else { c > 0 }) { s.mul(10); k += 1; continue; }
    let t: Big = r;
    t.mul(10);
    let u: Big = mp;
    u.mul(10);
    const c2 = t.cmpSum(u, s);
    if (if (even) { c2 < 0 } else { c2 <= 0 }) { r = t; mp = u; mm.mul(10); k -= 1; continue; }
    break;
  }
  let n: usize = 0;
  while (true) {
    r.mul(10);
    mp.mul(10);
    mm.mul(10);
    let d: u8 = 0;
    while (r.compare(s) >= 0) { r.sub(s); d += 1; }
    const lo = r.compare(mm);
    const low = if (even) { lo <= 0 } else { lo < 0 };
    const hi = r.cmpSum(mp, s);
    const high = if (even) { hi >= 0 } else { hi > 0 };
    if (!low && !high) { digits[n] = b'0' + d; n += 1; continue; }
    if (low && high) {
      let twice: Big = r;
      twice.mul(2);
      const c = twice.compare(s);
      if (c > 0 || (c == 0 && (d & 1) == 1)) { d += 1; }
    } else if (high) {
      d += 1;
    }
    digits[n] = b'0' + d;
    n += 1;
    break;
  }
  // A last digit rounded up to ten carries into those before it.
  let i = n - 1;
  while (i > 0 && digits[i] > b'9') { digits[i] = b'0'; digits[i - 1] += 1; i -= 1; }
  if (digits[0] > b'9') {
    digits[0] = b'1';
    for (const j of 1..n) { digits[j] = b'0'; }
    k += 1;
  }
  while (n > 1 && digits[n - 1] == b'0') { n -= 1; }
  [n, k]
}

// Writes bytes at `out`, which the caller made room for.
struct Out { at: u8*; n: usize }

impl Out {
  function byte(self: mut Self, b: u8): void {
    unsafe { self.at.add(self.n).write(b); }
    self.n += 1;
  }
  function text(self: mut Self, t: str): void { for (const b of t.bytes()) { self.byte(b); } }
  function digits(self: mut Self, d: readonly u8[], from: usize, to: usize): void { for (const i of from..to) { self.byte(d[i]); } }
  function decimal(self: mut Self, v: u64): void {
    let tmp: u8[20] = repeat(0 as u8);
    let n: usize = 0;
    let x = v;
    while (true) {
      tmp[n] = b'0' + ((x % 10) as u8);
      n += 1;
      x = x / 10;
      if (x == 0) { break; }
    }
    while (n > 0) { n -= 1; self.byte(tmp[n]); }
  }
}

// A float shown, at `out`, which has room for 400 bytes: how many it wrote.
export extern "C" function fly_rt_show_f64(value: f64, out: u8*): usize {
  let o = Out { at: out, n: 0 };
  let v = value;
  if (v != v) { o.text("NaN"); return o.n; }
  if ((bitsOf(v) >> 63) != 0) { o.byte(b'-'); v = -v; }
  if (v > 1.7976931348623157e308) { o.text("inf"); return o.n; }
  const [f, e] = parts(v);
  // An integral value below 10^15 shows one decimal place.
  if (v < 1e15 && (e >= 0 || (e > -64 && (f & ((1 << ((-e) as u64)) - 1)) == 0))) {
    o.decimal(if (e >= 0) { f << (e as u64) } else { f >> ((-e) as u64) });
    o.text(".0");
    return o.n;
  }
  if (v == 0.0) { o.text("0.0"); return o.n; }
  let d: u8[20] = repeat(0 as u8);
  const [n, k] = shortest(v, mut d);
  if (k <= 0) {
    o.text("0.");
    for (const _ of 0..(-k) as usize) { o.byte(b'0'); }
    o.digits(d, 0, n);
  } else if ((k as usize) >= n) {
    o.digits(d, 0, n);
    for (const _ of n..k as usize) { o.byte(b'0'); }
  } else {
    o.digits(d, 0, k as usize);
    o.byte(b'.');
    o.digits(d, k as usize, n);
  }
  o.n
}

// A float to `digits` places, at most 100, at `out`, which has room for 512 bytes.
export extern "C" function fly_rt_float_fixed(value: f64, places: u32, out: u8*): usize {
  let o = Out { at: out, n: 0 };
  let v = value;
  if (v != v) { o.text("NaN"); return o.n; }
  if ((bitsOf(v) >> 63) != 0) { o.byte(b'-'); v = -v; }
  if (v > 1.7976931348623157e308) { o.text("inf"); return o.n; }
  const digits: usize = if (places > 100) { 100 } else { places as usize };
  const [f, e] = parts(v);
  // v·10^digits, rounded to the nearest integer, halfway to the even.
  let q = big(f);
  q.pow10(digits as i32);
  if (e >= 0) {
    q.shl(e);
  } else {
    // q >>= -e, the bits shifted out deciding the rounding: the first of them is a half.
    const drop = -e;
    const half = q.bit(drop - 1);
    const rest = q.anyBelow(drop - 1);
    q.shr(drop);
    if (half && (rest || (q.n > 0 && (q.d[0] & 1) == 1))) { q.addSmall(1); }
  }
  // Its digits, most significant first.
  let num: u8[1600] = repeat(0 as u8);
  let len: usize = 0;
  while (true) {
    let chunk = q.div(1000000000);
    for (const _ of 0..9) { num[len] = b'0' + ((chunk % 10) as u8); chunk = chunk / 10; len += 1; }
    if (q.n == 0) { break; }
  }
  while (len > 1 && num[len - 1] == b'0') { len -= 1; }
  num[0..len].reverse();
  // At least one digit before the point.
  if (len <= digits) {
    o.byte(b'0');
    if (digits > 0) {
      o.byte(b'.');
      for (const _ of len..digits) { o.byte(b'0'); }
      o.digits(num, 0, len);
    }
  } else {
    o.digits(num, 0, len - digits);
    if (digits > 0) {
      o.byte(b'.');
      o.digits(num, len - digits, len);
    }
  }
  o.n
}

// Decimal text as the nearest float, halfway to the even: an optional sign, digits with a point
// among or before or after them, and an exponent, nothing else. False for anything else.
export extern "C" function fly_rt_parse_float(text: u8*, len: usize, out: f64*): bool {
  const at = (i: usize) => unsafe { text.add(i).read() };
  let i: usize = 0;
  let neg = false;
  if (i < len && (at(i) == b'+' || at(i) == b'-')) { neg = at(i) == b'-'; i += 1; }
  // The significant digits, up to 800, and whether any beyond them is not zero.
  let sig: u8[801] = repeat(0 as u8);
  let n: usize = 0;
  let exp10: i32 = 0;
  let any = false;
  let more = false;
  let point = false;
  while (i < len) {
    const c = at(i);
    if (c == b'.' && !point) { point = true; i += 1; continue; }
    if (c < b'0' || c > b'9') { break; }
    any = true;
    if (n == 0 && c == b'0') { if (point) { exp10 -= 1; } i += 1; continue; }
    if (n < 800) {
      sig[n] = c;
      n += 1;
      if (point) { exp10 -= 1; }
    } else {
      if (c != b'0') { more = true; }
      if (!point) { exp10 += 1; }
    }
    i += 1;
  }
  if (!any) { return false; }
  if (i < len && (at(i) == b'e' || at(i) == b'E')) {
    i += 1;
    let eneg = false;
    if (i < len && (at(i) == b'+' || at(i) == b'-')) { eneg = at(i) == b'-'; i += 1; }
    if (i == len || at(i) < b'0' || at(i) > b'9') { return false; }
    let x: i32 = 0;
    while (i < len && at(i) >= b'0' && at(i) <= b'9') {
      if (x < 100000) { x = x * 10 + ((at(i) - b'0') as i32); }
      i += 1;
    }
    exp10 += if (eneg) { -x } else { x };
  }
  if (i != len) { return false; }
  let v: f64 = 0.0;
  if (n == 0) {
    v = 0.0;
  } else if ((n as i32) + exp10 > 310) {
    v = floatOf(0x7ff0000000000000);
  } else if ((n as i32) + exp10 < -326) {
    v = 0.0;
  } else {
    // A digit 1 past the 800th stands for the rest, which only breaks a tie.
    if (more) { sig[n] = b'1'; n += 1; exp10 -= 1; }
    let num = big(0);
    for (const k of 0..n) {
      num.mul(10);
      num.addSmall((sig[k] - b'0') as u32);
    }
    let den = big(1);
    if (exp10 >= 0) { num.pow10(exp10); } else { den.pow10(-exp10); }
    // num / den = q·2^b, with 2^52 <= q < 2^53, or b = -1074 for a subnormal.
    let b = num.bits() - den.bits() - 53;
    let q: u64 = 0;
    let rem = big(0);
    let d = big(0);
    while (true) {
      if (b < -1074) { b = -1074; }
      rem = num;
      d = den;
      if (b >= 0) { d.shl(b); } else { rem.shl(-b); }
      q = rem.quot(d);
      if (q >= (1 << 53)) { b += 1; continue; }
      if (q < (1 << 52) && b > -1074) { b -= 1; continue; }
      break;
    }
    let twice: Big = rem;
    twice.mul(2);
    const c = twice.compare(d);
    if (c > 0 || (c == 0 && (q & 1) == 1)) { q += 1; }
    if (q == (1 << 53)) { q = q >> 1; b += 1; }
    if (b > 971) {
      v = floatOf(0x7ff0000000000000);
    } else {
      v = floatOf(if (q < (1 << 52)) { q } else { (((b + 1075) as u64) << 52) | (q & ((1 << 52) - 1)) });
    }
  }
  unsafe { out.write(if (neg) { -v } else { v }); }
  true
}

// An integer of up to 128 bits, given as its high and low halves of its magnitude, shown at `out`,
// which has room for 41 bytes.
export extern "C" function fly_rt_show_int(negative: bool, high: u64, low: u64, out: u8*): usize {
  let o = Out { at: out, n: 0 };
  if (negative) { o.byte(b'-'); }
  if (high == 0) { o.decimal(low); return o.n; }
  // Long division by 10^9, which leaves nine low digits at a time, over 32-bit pieces: the
  // remainder is below 10^9 < 2^30, so it and a piece fit in 64 bits.
  let w: u32[4] = [(high >> 32) as u32, high as u32, (low >> 32) as u32, low as u32];
  let chunks: u64[5] = repeat(0 as u64);
  let k: usize = 0;
  while (w[0] != 0 || w[1] != 0 || w[2] != 0 || w[3] != 0) {
    let r: u64 = 0;
    for (const j of 0..4) {
      const cur = (r << 32) | (w[j] as u64);
      w[j] = (cur / 1000000000) as u32;
      r = cur % 1000000000;
    }
    chunks[k] = r;
    k += 1;
  }
  // The most significant chunk as it is, every other to nine digits.
  o.decimal(chunks[k - 1]);
  while (k > 1) {
    k -= 1;
    let tmp: u8[9] = repeat(0 as u8);
    let x = chunks[k - 1];
    for (const j of 0..9) { tmp[8 - j] = b'0' + ((x % 10) as u8); x = x / 10; }
    o.digits(tmp, 0, 9);
  }
  o.n
}
