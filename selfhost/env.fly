// The program: loaded modules, their declarations, and elaboration of syntax into types.

import { Span, Diagnostic, diag } from "./diag";
import {
  Ident, Module as AstModule, Item, ItemKind, Field, TagDecl, TagPayload, ImplDecl, FnSig, FnDecl, TypeParam, RowItem,
  Type, TypeKind, Expr, ExprKind, FnMode as AstFnMode,
} from "./ast";
import { parseModule, parseDeclarations } from "./parse";
import {
  Sym, Prim, Region, Tail, Row, Eff, EffRow, FnMode, FnTy, Len, GArg, Ty, pure, voidTy, boolTy, primFromName, showTy,
  writeEffs, writeArg, labelSet, labelGet, keyArgs, eraseRegions,
} from "./types";
import { containerMessage } from "./traits";
import { CV, expander } from "./comptime";
import { HashMap, HashSet } from "std/collections";
import { File } from "std/io";

// Positions at or above this belong to code `comptime` expanded.
export const SYNTH_BASE: usize = 1 << 40;

// The standard library's modules, in the order the Rust prototype loads them.
const STD: str[] = ["std/prelude.fly", "std/region.d.fly", "std/net.d.fly", "std/io.d.fly", "std/collections.d.fly",
  "std/par.fly", "std/layout.fly", "std/sync.d.fly", "std/json.fly", "std/world.d.fly", "std/fs.fly", "std/process.fly", "std/time.fly", "std/unicode.fly", "std/regex.fly", "std/crypto.d.fly", "std/http.fly"];

export enum Binding { #Def(usize), #Fn(usize), #Const(usize) }
impl Clone for Binding;
impl Eq for Binding;

// The runtime's modules in Flyscript (selfhost/rt), which the C of every native and WebAssembly
// program calls: loaded with every program compiled to C or LLVM.
export const RUNTIME: str[] = ["format.fly", "sched.fly"];

export struct ModInfo {
  name: String;
  file: String;
  source: String;
  ast: AstModule;
  isStd: bool;
  scope: HashMap<String, Binding>;
  exports: HashMap<String, Binding>;
}

// A module-level constant (§8.1).
export struct ConstInfo { name: String; module: usize; ty: Ty; value: Expr }

export enum PKind { #Type, #Region, #Row, #Len }
impl Clone for PKind;
impl Eq for PKind;

export struct GParam {
  sym: Sym;
  kind: PKind;
  bounds: Vec<Ty>;
  default: Option<GArg>;
  // `comptime T: Type`: a template parameter, whose functions are specialized for each type
  // they are used at (§7.1).
  isComptime: bool;
}
impl Clone for GParam;

export struct Scheme {
  tparams: Vec<GParam>;
  params: Vec<[String, Ty]>;
  ret: Ty;
  // `#None`: not declared, to be inferred from the body (non-exported functions only).
  effects: Option<EffRow>;
  // The parameters a returned borrow may come from (`from a, b`); empty if not written.
  retFrom: Vec<String>;
}
impl Clone for Scheme;

export function emptyScheme(): Scheme {
  Scheme { tparams: Vec.new(), params: Vec.new(), ret: #Error, effects: #None, retFrom: Vec.new() }
}

export enum DefKind {
  #Struct { fields: Option<Vec<[String, Ty]>> },
  // Tags sorted by name.
  #Enum { tags: Vec<[String, Ty]> },
  #Alias { ty: Ty },
  // `selfSym` is the parameter standing for `Self` in the methods' schemes.
  #Interface { methods: Vec<[String, Scheme]>; assoc: Vec<String>; selfSym: Sym; supers: Vec<Ty> },
  #Effect { ops: Vec<[String, Scheme]> },
}
impl Clone for DefKind;

export struct Def {
  name: String;
  module: usize;
  params: Vec<GParam>;
  kind: DefKind;
  span: Span;
  // Fields visible only in the declaring module.
  private: Vec<String>;
  // Declared `view` (§3.3).
  view: bool;
  // An enum's tags in declaration order, which derivations follow (`Ord`, §3.5).
  tagOrder: Vec<String>;
  // A template struct's fields as written, computed per instance (§7.1).
  templateFields: Option<Vec<Field>>;
  // `@layout(c)`: laid out as C lays it out, so C may take it (§8.2); and the alignment asked.
  cLayout: bool;
  align: Option<u64>;
}

export type DeclRef = { module: usize; item: usize; method: Option<usize> };

export struct FnInfo {
  name: String;
  module: usize;
  scheme: Scheme;
  decl: DeclRef;
  exported: bool;
  implId: Option<usize>;
  hasBody: bool;
  // `extern "C"`: a function of C's, or one C calls (§8.2).
  foreign: bool;
  // For an interface's method called through a bound: the interface. Its first generic
  // parameter is `Self`, resolved to an impl when called.
  iface: Option<usize>;
}

export struct Impl {
  // `impl I for T;`: `T` asks for `I`'s derivation, the template impl of `I` (§7.3).
  derived: bool;
  // Associated types as written, and elaborated (for an impl that is not a template).
  assoc: Vec<[String, Type]>;
  assocTys: HashMap<String, Ty>;
  module: usize;
  params: Vec<GParam>;
  target: Ty;
  iface: Option<[usize, Vec<GArg>]>;
  methods: Vec<usize>;
  // The `impl` item, in its module.
  item: usize;
}

// The checker's results for one function body, by expression and pattern ids.
export struct Typed {
  exprs: HashMap<usize, Ty>;
  // Types of `Bind` patterns, including parameters' bindings.
  bindings: HashMap<usize, Ty>;
  params: Vec<[String, Ty]>;
  // `==`, `!=` and `${e}` that call an interface's method (`Eq.eq`, `Show.show`), with `Self`'s
  // type (§3.5).
  ops: HashMap<usize, [usize, Vec<GArg>]>;
  shows: HashMap<usize, [usize, Vec<GArg>]>;
  // The function each call or method call resolved to, and its generic arguments.
  calls: HashMap<usize, usize>;
  targs: HashMap<usize, Vec<GArg>>;
  // The type each part of a tag, record or list literal was checked against.
  slots: HashMap<usize, Ty>;
  // Tag constructions `#A(x)` whose one argument is the whole of a larger payload (§3.2).
  whole: HashSet<usize>;
  // The effects each call, operation, `yield` or `throw` may perform; `#None` in the list stands
  // for effects a row variable leaves open.
  performs: HashMap<usize, Vec<Option<usize>>>;
  // The effect each `handle` expression handles.
  handled: HashMap<usize, usize>;
  // `match` scrutinees that are places nothing may be moved out of — behind a borrow, or an
  // element of a collection — matched through a borrow (`true` if `mut`).
  lentScrutinees: HashMap<usize, bool>;
  // For a `for` over something `Iterable`, by the iterated expression's id: the id the implicit
  // call of its `each` is recorded under.
  eaches: HashMap<usize, usize>;
  // Types of closures' and handler arms' parameters, by the position of the name.
  names: HashMap<usize, Ty>;
  // What the ownership pass found: each move out of a binding, by the moving expression's span,
  // with the field path moved; and the bindings each closure moves in, by its span.
  moves: HashMap<Span, Vec<String>>;
  capturedMoves: HashMap<Span, Vec<[String, Ty]>>;
  // Match arms on an owned place that borrow it `mut`, changing what they bind in place.
  lentArms: HashSet<Span>;
  // The region each `region` block opens, by the block's id.
  regions: HashMap<usize, Sym>;
}

export function emptyTyped(): Typed {
  Typed {
    exprs: HashMap.new(), bindings: HashMap.new(), params: Vec.new(), ops: HashMap.new(), shows: HashMap.new(),
    calls: HashMap.new(), targs: HashMap.new(), slots: HashMap.new(), whole: HashSet.new(), performs: HashMap.new(),
    handled: HashMap.new(), lentScrutinees: HashMap.new(), eaches: HashMap.new(), names: HashMap.new(),
    moves: HashMap.new(), capturedMoves: HashMap.new(), lentArms: HashSet.new(), regions: HashMap.new(),
  }
}

// Elaboration scope: generic parameters in scope, `Self`, and the region used for elision.
export struct TyScope {
  module: usize;
  params: HashMap<String, [Sym, PKind]>;
  selfTy: Option<Ty>;
  elidedRegion: Option<Region>;
}
impl Clone for TyScope;

export function moduleScope(module: usize): TyScope {
  TyScope { module, params: HashMap.new(), selfTy: #None, elidedRegion: #None }
}

impl TyScope {
  export function withParams(self: readonly Self, params: readonly Vec<GParam>): TyScope {
    let s = self.clone();
    for (const p of params) { s.params.insert(p.sym.name.clone(), [p.sym.clone(), p.kind]); }
    let regions: Vec<Sym> = Vec.new();
    for (const p of params) { if (p.kind == #Region) { regions.push(p.sym.clone()); } }
    if (regions.len() == 1) { s.elidedRegion = #Some(#Param(regions[0].clone())); }
    s
  }
}

export struct Program {
  modules: Vec<ModInfo>;
  defs: Vec<Def>;
  consts: Vec<ConstInfo>;
  fns: Vec<FnInfo>;
  impls: Vec<Impl>;
  diags: Vec<[usize, Diagnostic]>;
  nextSym: u32;
  // Well-known declarations the checker needs by identity.
  known: HashMap<String, usize>;
  // Effects inferred for functions declared without `uses`; `#None` while being inferred.
  inferred: HashMap<usize, Option<EffRow>>;
  // Functions whose bodies have been checked.
  checked: HashSet<usize>;
  // Per checked function: final types of its expressions and bindings, for later passes.
  typed: HashMap<usize, Typed>;
  // Functions whose ownership has been checked, their moves recorded in `typed`.
  owned: HashSet<usize>;
  // Each interface method, as a function called through a bound, by `iface:name`.
  ifaceFns: HashMap<String, usize>;
  // Types computed by `comptime` code, referred to from expanded syntax.
  spliced: Vec<Ty>;
  // Bodies after `comptime` expansion, for templates' specializations and functions that use
  // `comptime` code.
  bodies: HashMap<usize, FnDecl>;
  // The source position each position in expanded code came from.
  synth: HashMap<usize, Span>;
  nextSynth: usize;
  // The next id for an expression or pattern `comptime` expansion makes.
  nextId: usize;
  // Specializations of templates, by template and `comptime` arguments.
  specs: HashMap<String, usize>;
  // Template impls' associated types, by impl, arguments and name.
  assocInstances: HashMap<String, Ty>;
  // Template structs' fields, by struct and arguments.
  instances: HashMap<String, Vec<[String, Ty]>>;
  // For a specialization: its template, and how diagnostics name it.
  specOf: HashMap<usize, usize>;
  specNotes: HashMap<usize, String>;
  // For a derivation's specialization: the type that asked for it, whose private fields it may
  // use (§7.3).
  specRequested: HashMap<usize, usize>;
  // Functions called while their effects were being inferred, so assumed pure there.
  assumedPure: HashMap<usize, [usize, Span]>;
  // Type aliases not yet elaborated, and those being elaborated.
  pendingAliases: HashMap<usize, [usize, usize]>;
  aliasing: Vec<usize>;
  // While a specialization is checked: which one, for its diagnostics.
  note: Option<String>;
  // Where packages are found: the directory that holds the installation's `std` (§8.1), and the
  // directories the build names for packages of its own, by name (`FLY_PACKAGES`).
  root: String;
  packages: HashMap<String, String>;
  // Per nominal type, by def: what its own fields and payloads contribute to its class and to
  // whether it hides a borrow, its arguments aside (`summarize`).
  shapes: Vec<Shape>;
  // The methods of impls, by name, in the order declared: where a call of a method looks. The
  // specializations made later are never looked up by name.
  methods: HashMap<String, Vec<usize>>;
}

// What a nominal type's fields and payloads, as declared, make of it whatever its arguments,
// which count for themselves. A template struct's fields depend on its arguments, so it has no
// shape (`known` false), and is walked whole each time. `drop`: it has a `Drop` implementation.
export struct Shape { class: u8; hides: bool; known: bool; drop: bool }
impl Clone for Shape;

function isRelative(path: str): bool { path.startsWith("./") || path.startsWith("../") }

// Lexically normalizes a path (`a/./b/../c` → `a/c`), so one file is one module however it is
// reached.
export function normalize(p: str): String {
  let out: Vec<String> = Vec.new();
  const absolute = p.startsWith("/");
  for (const c of p.split("/")) {
    if (c == "" || c == ".") { continue; }
    if (c == "..") {
      const up = match (out.last()) { #Some(q) => q != "..", #None => false };
      if (up) { out.pop(); } else { out.push("..".toString()); }
      continue;
    }
    out.push(c.clone());
  }
  const joined = out.join("/");
  if (absolute) { `/${joined}` } else { joined }
}

// The directory part of a path, without its final `/`.
export function parent(p: str): String {
  const bytes = p.asBytes();
  let i = bytes.len();
  while (i > 0) {
    if (bytes[i - 1] == b'/') { return p.slice(0, i - 1).toString(); }
    i -= 1;
  }
  String.new()
}

function joinPath(dir: str, rel: str): String { if (dir.len() == 0) { rel.toString() } else { `${dir}/${rel}` } }

function readFile(path: str): Option<String> uses Io {
  try {
    let f = File.open(path);
    #Some(f.readText())
  } catch (_) { #None }
}

// ---- substitution of generic parameters ----

// Arguments for generic parameters, by the parameter's symbol id.
export type SubstMap = HashMap<u32, GArg>;

export function substMap(params: readonly Vec<GParam>, args: readonly Vec<GArg>): SubstMap {
  let map: SubstMap = HashMap.new();
  for (const i of 0..min(params.len(), args.len())) { map.insert(params[i].sym.id, args[i].clone()); }
  map
}

// Substitutes generic parameters by arguments.
export function substParams(t: readonly Ty, params: readonly Vec<GParam>, args: readonly Vec<GArg>): Ty {
  subst(t, substMap(params, args))
}

export function subst(t: readonly Ty, map: readonly SubstMap): Ty {
  match (t) {
    #Param(s) => match (map.get(s.id)) {
      #Some(#Ty(x)) => x.clone(),
      _ => t.clone(),
    },
    #Named(d, args) => {
      let out: Vec<GArg> = Vec.new();
      for (const a of args) { out.push(substArg(a, map)); }
      #Named(d, out)
    }
    #Record(r) => #Record(substRow(r, map)),
    #Union(r) => #Union(substRow(r, map)),
    #Tuple(ts) => {
      let out: Vec<Ty> = Vec.new();
      for (const x of ts) { out.push(subst(x, map)); }
      // A payload of one `void` is no payload (§3.2).
      if (out.len() == 1 && out[0] == voidTy()) { voidTy() } else { #Tuple(out) }
    }
    #Array(e, l) => #Array(Box.new(subst(e, map)), substLen(l, map)),
    #Slice(e) => #Slice(Box.new(subst(e, map))),
    #Borrow(m, e) => #Borrow(m, Box.new(subst(e, map))),
    #Fn(f) => {
      let params: Vec<Ty> = Vec.new();
      for (const p of f.params) { params.push(subst(p, map)); }
      #Fn(Box.new(FnTy { mode: f.mode, params, ret: subst(f.ret, map), effects: substEffs(f.effects, map) }))
    }
    #Assoc(base, n) => #Assoc(Box.new(subst(base, map)), n.clone()),
    _ => t.clone(),
  }
}

export function substArg(a: readonly GArg, map: readonly SubstMap): GArg {
  match (a) {
    #Ty(t) => #Ty(subst(t, map)),
    #Region(r) => #Region(substRegion(r, map)),
    #Row(r) => #Row(substEffs(r, map)),
    #Len(l) => #Len(substLen(l, map)),
  }
}

export function substRegion(r: readonly Region, map: readonly SubstMap): Region {
  match (r) {
    #Param(s) => match (map.get(s.id)) { #Some(#Region(x)) => x.clone(), _ => r.clone() },
    _ => r.clone(),
  }
}

function substLen(l: readonly Len, map: readonly SubstMap): Len {
  match (l) {
    #Param(s) => match (map.get(s.id)) { #Some(#Len(x)) => x.clone(), _ => l.clone() },
    _ => l.clone(),
  }
}

function substRow(r: readonly Row, map: readonly SubstMap): Row {
  let labels: Vec<[String, Ty]> = Vec.new();
  for (const [k, t] of r.labels) { labels.push([k.clone(), subst(t, map)]); }
  Row { labels, tail: r.tail.clone() }
}

export function substEffs(r: readonly EffRow, map: readonly SubstMap): EffRow {
  let effs: Vec<Eff> = Vec.new();
  for (const e of r.effs) {
    let regions: Vec<Region> = Vec.new();
    for (const x of e.regions) { regions.push(substRegion(x, map)); }
    let args: Vec<Ty> = Vec.new();
    for (const t of e.args) { args.push(subst(t, map)); }
    effs.push(Eff { def: e.def, regions, args });
  }
  let tail = r.tail.clone();
  if (const #Param(s) = r.tail && const #Some(#Row(row)) = map.get(s.id)) {
    for (const e of row.effs) { effs.push(e.clone()); }
    tail = row.tail.clone();
  }
  EffRow { effs, tail }
}

// Whether a type mentions a generic parameter or an inference variable.
export function containsParams(t: readonly Ty): bool {
  match (t) {
    #Param(_) | #Var(_) => true,
    #Named(_, args) => args.iter().some((a) => match (a) { #Ty(x) => containsParams(x), _ => false }),
    #Tuple(ts) => ts.iter().some((x) => containsParams(x)),
    #Record(r) | #Union(r) => r.labels.iter().some(([_, x]) => containsParams(x)),
    #Array(e, _) | #Slice(e) | #Borrow(_, e) => containsParams(e),
    _ => false,
  }
}

// Whether a generic argument is known: no parameter or inference variable in it.
export function concreteArg(a: readonly GArg): bool {
  match (a) {
    #Ty(t) => !containsParams(t),
    #Len(l) => match (l) { #Known(_) => true, _ => false },
    _ => true,
  }
}

export function paramArg(g: readonly GParam): GArg {
  match (g.kind) {
    #Type => #Ty(#Param(g.sym.clone())),
    #Region => #Region(#Param(g.sym.clone())),
    #Row => #Row(EffRow { effs: Vec.new(), tail: #Param(g.sym.clone()) }),
    #Len => #Len(#Param(g.sym.clone())),
  }
}

impl Program {
  // Loads the given entry files, everything they import, and the standard library from `std`,
  // the directory that holds it.
  export function load(entries: readonly Vec<String>, std: str): Program uses Io {
    let p = Program {
      modules: Vec.new(), defs: Vec.new(), consts: Vec.new(), fns: Vec.new(), impls: Vec.new(), diags: Vec.new(),
      nextSym: 0, known: HashMap.new(), inferred: HashMap.new(), checked: HashSet.new(), typed: HashMap.new(), owned: HashSet.new(),
      ifaceFns: HashMap.new(), spliced: Vec.new(), bodies: HashMap.new(), synth: HashMap.new(), nextSynth: SYNTH_BASE,
      nextId: 1 << 32, specs: HashMap.new(), assocInstances: HashMap.new(), instances: HashMap.new(),
      specOf: HashMap.new(), specNotes: HashMap.new(), specRequested: HashMap.new(), assumedPure: HashMap.new(),
      pendingAliases: HashMap.new(), aliasing: Vec.new(), note: #None, root: parent(std), packages: HashMap.new(), shapes: Vec.new(), methods: HashMap.new(),
    };
    // `name=dir:name=dir`, as `fly` sets it.
    if (const #Some(map) = Io.env("FLY_PACKAGES")) {
      for (const entry of map.asStr().split(":")) {
        match (entry.asStr().indexOf("=")) {
          #Some(k) => { p.packages.insert(entry.slice(0, k).toString(), entry.slice(k + 1, entry.len()).toString()); }
          #None => {}
        }
      }
    }
    for (const file of STD) {
      const name = file.replaceAll(".d.fly", "").replaceAll(".fly", "");
      const source = match (readFile(joinPath(std, file.slice(4, file.len())).asStr())) {
        #Some(s) => s,
        #None => String.new(),
      };
      p.addModule(name, `<${file}>`, source, true, true);
    }
    let queue: Vec<String> = Vec.new();
    for (const e of entries) { queue.push(normalize(e.asStr())); }
    while (const #Some(path) = queue.pop()) {
      const name = path.replaceAll(".fly", "");
      if (p.modules.iter().some((m) => m.name == name)) { continue; }
      const source = match (readFile(path.asStr())) {
        #Some(s) => s,
        #None => {
          p.diags.push([0xffffffff, diag({ start: 0, end: 0 }, `${path}: cannot be read`.asStr())]);
          continue;
        }
      };
      const idx = p.addModule(name, path.clone(), source, false, false);
      for (const item of p.modules[idx].ast.items) {
        if (const #Import { names: _, from } = item.kind) {
          if (isRelative(from.asStr())) {
            queue.push(normalize(joinPath(parent(path.asStr()).asStr(), `${from}.fly`.asStr()).asStr()));
          } else if (!from.asStr().startsWith("std/")) {
            queue.push(normalize(p.packageFile(`${from}.fly`.asStr()).asStr()));
          }
        }
      }
    }
    p.declare();
    p.summarize();
    for (const [f, info] of p.fns.iter().enumerate()) {
      if (info.implId.isNone()) { continue; }
      match (p.methods.getMut(info.name)) {
        #Some(fs) => fs.push(f),
        #None => { p.methods.insert(info.name.clone(), [f]); }
      }
    }
    p
  }

  // Where a package's module is: in the directory the build names for the package, or else the
  // installation's, beside `std` (§8.1). `path` is the import's, `web/ui`, or its file's.
  function packageFile(self: readonly Self, path: str): String {
    const [name, rest] = match (path.indexOf("/")) { #Some(k) => [path.slice(0, k), path.slice(k + 1, path.len())], #None => [path, ""] };
    match (self.packages.get(name)) {
      #Some(dir) => joinPath(dir.asStr(), rest),
      #None => joinPath(self.root.asStr(), path),
    }
  }

  function addModule(self: mut Self, name: String, file: String, source: String, isStd: bool, declarations: bool): usize {
    const idx = self.modules.len();
    const parsed: AstModule = try {
      if (declarations) { parseDeclarations(source.asStr()) } else { parseModule(source.asStr()) }
    } catch (d) {
      self.diags.push([idx, d]);
      { items: Vec.new() }
    };
    self.modules.push(ModInfo { name, file, source, ast: parsed, isStd, scope: HashMap.new(), exports: HashMap.new() });
    idx
  }

  export function error(self: mut Self, module: usize, span: Span, msg: str): void {
    const at = self.sourceSpan(span);
    let message = msg.toString();
    if (const #Some(n) = self.note) { message = `${message} (${n})`; }
    const d = diag(at, message.asStr());
    // Repeated copies of generated code report a problem once.
    if (!self.diags.iter().some(([m, e]) => m == module && e == d)) { self.diags.push([module, d]); }
  }

  // The source position of a position, which may be in expanded code.
  export function sourceSpan(self: readonly Self, span: Span): Span {
    if (span.start < SYNTH_BASE) { return span; }
    match (self.synth.get(span.start)) { #Some(s) => s, #None => ({ start: 0, end: 0 }) }
  }

  export function show(self: readonly Self, t: readonly Ty): String { showTy(t, self.defNames()) }

  export function defNames(self: readonly Self): Vec<String> {
    let out: Vec<String> = Vec.new();
    for (const d of self.defs) { out.push(d.name.clone()); }
    out
  }

  // A template struct's instance whose `comptime` code failed, already reported.
  export function failedInstance(self: readonly Self, d: usize, args: readonly Vec<GArg>): bool {
    self.defs[d].templateFields.isSome() && args.iter().every((a) => concreteArg(a)) && !self.instances.has(`${d}|${keyArgs(args)}`.asStr())
  }

  // A struct's fields with its arguments substituted: for a template, those of the instance,
  // once it has been computed (`ensureInstance`).
  export function structFields(self: readonly Self, d: usize, args: readonly Vec<GArg>): Option<Vec<[String, Ty]>> {
    if (self.defs[d].templateFields.isSome()) {
      return match (self.instances.get(`${d}|${keyArgs(args)}`.asStr())) { #Some(fs) => #Some(fs.clone()), #None => #None };
    }
    match (self.defs[d].kind) {
      #Struct { fields: #Some(fs) } => {
        let out: Vec<[String, Ty]> = Vec.new();
        for (const [k, t] of fs) { out.push([k.clone(), substParams(t, self.defs[d].params, args)]); }
        #Some(out)
      }
      _ => #None,
    }
  }

  // A function's declaration: its expanded body if it has one.
  export function fnDecl(self: readonly Self, fid: usize): Option<FnDecl> {
    match (self.fnDeclOf(fid)) { #Some(d) => #Some(d.clone()), #None => #None }
  }

  // The same, lent rather than copied.
  export function fnDeclOf(self: readonly Self, fid: usize): Option<readonly FnDecl> from self {
    if (const #Some(d) = self.bodies.get(fid)) { return #Some(d); }
    const decl = self.fns[fid].decl;
    if (decl.module >= self.modules.len()) { return #None; }
    if (decl.item >= self.modules[decl.module].ast.items.len()) { return #None; }
    match (self.modules[decl.module].ast.items[decl.item].kind) {
      #Function(f) => if (decl.method.isNone()) { #Some(f) } else { #None },
      #Impl(imp) => match (decl.method) { #Some(k) => #Some(imp.methods[k].decl), #None => #None },
      _ => #None,
    }
  }

  // Computes a template struct's fields for these arguments, if they are known (§7.1).
  export function ensureInstance(self: mut Self, d: usize, args: readonly Vec<GArg>): void {
    const fields = match (self.defs[d].templateFields) { #Some(fs) => fs.clone(), #None => return };
    const key = `${d}|${keyArgs(args)}`;
    if (self.instances.has(key.asStr()) || !args.iter().every((a) => concreteArg(a))) { return; }
    // Registered first, so a field of the same instance's type does not recurse forever.
    self.instances.insert(key.clone(), Vec.new());
    const params = self.defs[d].params.clone();
    const module = self.defs[d].module;
    let env: Vec<[String, CV]> = Vec.new();
    for (const i of 0..min(params.len(), args.len())) {
      match (args[i]) {
        #Ty(t) if params[i].isComptime => env.push([params[i].sym.name.clone(), #Type(t.clone())]),
        #Len(#Known(n)) => env.push([params[i].sym.name.clone(), #Int(n as i128)]),
        _ => {}
      }
    }
    let ex = expander(mut self, module, #None, env);
    const expanded = match (ex.structFields(fields)) {
      #Some(fs) => fs,
      // Its `comptime` code failed and said why; the instance has no fields to report on.
      #None => {
        self.instances.remove(key.asStr());
        return;
      }
    };
    const scope = moduleScope(module).withParams(params);
    let fs: Vec<[String, Ty]> = Vec.new();
    for (const f of expanded) {
      const t = self.elabTy(f.ty, scope);
      fs.push([f.name.name.clone(), substParams(t, params, args)]);
    }
    // Each instance is checked as the struct it is: unless declared `view`, it holds no borrow (§3.3).
    if (!self.defs[d].view) {
      if (const #Some([name, t]) = fs.iter().find(([_, t]) => self.class(t) == 2)) {
        const shown = self.show(#Named(d, args.clone()));
        const ft = self.show(t);
        self.error(module, self.defs[d].span, `\`${shown}\` holds a borrow in \`${name}\` (\`${ft}\`): declare it \`view struct\` if it is a temporary view`.asStr());
      }
    }
    self.instances.insert(key, fs);
  }

  export function freshSym(self: mut Self, name: str): Sym {
    self.nextSym += 1;
    { id: self.nextSym, name: name.toString() }
  }

  // `name`, with where to import it from if a standard module exports it.
  export function unknown(self: readonly Self, what: str, name: str): String {
    match (self.modules.iter().find((m) => m.isStd && m.name != "std/prelude" && m.exports.has(name))) {
      #Some(m) => `unknown ${what} \`${name}\`: import it with \`import { ${name} } from "${m.name}";\``,
      #None => match (tsHint(what, name)) {
        #Some(hint) => `unknown ${what} \`${name}\`: ${hint}`,
        #None => `unknown ${what} \`${name}\``,
      },
    }
  }

  export function moduleNamed(self: readonly Self, name: str): Option<usize> {
    self.modules.iter().findIndex((m) => m.name == name)
  }

  // The file an entry path names, as its module records it.
  export function entryFile(self: readonly Self, entry: str): String { normalize(entry) }

  export function lookup(self: readonly Self, module: usize, name: str): Option<Binding> {
    match (self.modules[module].scope.get(name)) { #Some(b) => #Some(b.clone()), #None => #None }
  }

  export function knownDef(self: readonly Self, name: str): Option<usize> {
    match (self.known.get(name)) { #Some(d) => #Some(d), #None => #None }
  }

  export function isKnown(self: readonly Self, d: usize, name: str): bool { self.knownDef(name) == #Some(d) }

  // ---- declaration ----

  function declare(self: mut Self): void {
    // Pass 1: names.
    for (const m of 0..self.modules.len()) {
      const items = self.modules[m].ast.items.clone();
      for (const [i, item] of items.iter().enumerate()) {
        const named: Option<[String, Binding]> = match (item.kind) {
          #Struct(s) => #Some([s.name.name.clone(), #Def(self.placeholder(s.name, m))]),
          #Enum(e) => #Some([e.name.name.clone(), #Def(self.placeholder(e.name, m))]),
          #TypeAlias(a) => #Some([a.name.name.clone(), #Def(self.placeholder(a.name, m))]),
          #Interface(x) => {
            const id = self.placeholder(x.name, m);
            // Kinds are known before elaboration, so declarations may refer to themselves.
            const selfSym = self.freshSym("Self");
            self.defs[id].kind = #Interface { methods: Vec.new(), assoc: Vec.new(), selfSym, supers: Vec.new() };
            #Some([x.name.name.clone(), #Def(id)])
          }
          #Effect(e) => {
            const id = self.placeholder(e.name, m);
            self.defs[id].kind = #Effect { ops: Vec.new() };
            #Some([e.name.name.clone(), #Def(id)])
          }
          #Const { name, ty: _, value } => {
            self.consts.push(ConstInfo { name: name.name.clone(), module: m, ty: #Error, value: value.clone() });
            #Some([name.name.clone(), #Const(self.consts.len() - 1)])
          }
          #Function(f) => {
            const id = self.fns.len();
            self.fns.push(FnInfo {
              name: f.sig.name.name.clone(), module: m, scheme: emptyScheme(), decl: { module: m, item: i, method: #None },
              exported: item.exported, implId: #None, hasBody: f.body.isSome(), foreign: f.sig.foreign, iface: #None,
            });
            #Some([f.sig.name.name.clone(), #Fn(id)])
          }
          _ => #None,
        };
        if (const #Some([name, binding]) = named) {
          if (self.modules[m].scope.has(name.asStr())) {
            self.error(m, item.span, `\`${name}\` is declared twice`.asStr());
          }
          self.modules[m].scope.insert(name.clone(), binding.clone());
          if (item.exported || self.modules[m].isStd) { self.modules[m].exports.insert(name, binding); }
        }
      }
    }
    const prelude = match (self.moduleNamed("std/prelude")) { #Some(i) => i, #None => 0 };
    const layout = match (self.moduleNamed("std/layout")) { #Some(i) => i, #None => 0 };
    for (const name of ["Fail", "Yield", "Region", "Io", "String", "Ref", "Vec", "Iterable", "LentBy", "Copy", "Send", "Eq", "Show", "Ord", "Cont", "Box", "Arc", "Ptr", "Unsafe"]) {
      const found = match (self.modules[prelude].exports.get(name)) {
        #Some(b) => #Some(b.clone()),
        #None => match (self.modules[layout].exports.get(name)) { #Some(b) => #Some(b.clone()), #None => #None },
      };
      if (const #Some(#Def(d)) = found) { self.known.insert(name.toString(), d); }
    }
    // Pass 2: imports and the prelude.
    let preludeExports: Vec<[String, Binding]> = Vec.new();
    for (const [k, v] of self.modules[prelude].exports.entries()) { preludeExports.push([k.clone(), v.clone()]); }
    for (const m of 0..self.modules.len()) {
      if (m != prelude) {
        for (const [k, v] of preludeExports) {
          if (!self.modules[m].scope.has(k.asStr())) { self.modules[m].scope.insert(k.clone(), v.clone()); }
        }
      }
      const items = self.modules[m].ast.items.clone();
      for (const item of items) {
        if (const #Import { names, from } = item.kind) {
          const target = if (isRelative(from.asStr())) {
            self.moduleNamed(normalize(joinPath(parent(self.modules[m].name.asStr()).asStr(), from.asStr()).asStr()).asStr())
          } else if (from.asStr().startsWith("std/")) {
            self.moduleNamed(from.asStr())
          } else {
            // A package's module is known by its file, however it was reached.
            self.moduleNamed(normalize(self.packageFile(from.asStr()).asStr()).asStr())
          };
          const t = match (target) {
            #Some(t) => t,
            #None => {
              self.error(m, item.span, `no module \`${from}\``.asStr());
              continue;
            }
          };
          for (const [n, local] of names) {
            match (self.modules[t].exports.get(n.name.asStr())) {
              #Some(b) => { self.modules[m].scope.insert(local.name.clone(), b.clone()); }
              #None => {
                const name = n.name.clone();
                const inPrelude = self.modules[prelude].exports.has(name.asStr());
                const home = self.modules.iter().find((x) => x.isStd && x.name != "std/prelude" && x.exports.has(name.asStr()));
                const hint = if (inPrelude) {
                  `: \`${name}\` is in the prelude, so it needs no import`
                } else {
                  match (home) { #Some(h) => `: it is in \`${h.name}\``, #None => String.new() }
                };
                self.error(m, n.span, `module \`${from}\` does not export \`${name}\`${hint}`.asStr());
              }
            }
          }
        }
      }
    }
    // Pass 3: elaborate declarations, then impls, then function signatures. Aliases come first,
    // so a declaration may use one written after it (`interface Ord` returning `Ordering`).
    for (const m of 0..self.modules.len()) {
      const items = self.modules[m].ast.items.clone();
      for (const item of items) { self.elaborateParams(m, item); }
    }
    for (const m of 0..self.modules.len()) {
      for (const [i, item] of self.modules[m].ast.items.iter().enumerate()) {
        if (const #TypeAlias(a) = item.kind) {
          if (const #Some(#Def(id)) = self.lookup(m, a.name.name.asStr())) { self.pendingAliases.insert(id, [m, i]); }
        }
      }
    }
    for (const aliases of [true, false]) {
      for (const m of 0..self.modules.len()) {
        const items = self.modules[m].ast.items.clone();
        for (const item of items) {
          const isAlias = match (item.kind) { #TypeAlias(_) => true, _ => false };
          if (isAlias == aliases) { self.elaborateDef(m, item); }
        }
      }
    }
    self.checkViews();
    self.elaborateConsts();
    for (const m of 0..self.modules.len()) {
      const items = self.modules[m].ast.items.clone();
      for (const [i, item] of items.iter().enumerate()) {
        match (item.kind) {
          #Impl(imp) => self.elaborateImpl(m, i, imp),
          #Function(f) => {
            const scope = moduleScope(m);
            let scheme = self.elaborateSig(f.sig, scope, #None);
            if (const #Some(#Fn(id)) = self.lookup(m, f.sig.name.name.asStr())) {
              if (f.sig.foreign) { scheme = self.foreignScheme(m, f, scheme); }
              // A template is checked only per specialization, so it states its effects (§7.1).
              const template = scheme.tparams.iter().some((g) => g.isComptime);
              let s = scheme;
              if ((item.exported || template) && s.effects.isNone()) { s.effects = #Some(pure()); }
              self.fns[id].scheme = s;
            }
          }
          _ => {}
        }
      }
    }
    self.checkImpls();
  }

  // An impl of an interface has exactly the interface's methods, each taking what the interface's
  // takes, giving what it gives, and performing nothing it does not declare: code that calls it
  // through the interface knows only the interface's (§3.4).
  function checkImpls(self: mut Self): void {
    for (const i of 0..self.impls.len()) {
      const [iface, iargs] = match (self.impls[i].iface) { #Some(x) => x.clone(), #None => continue };
      if (self.impls[i].derived || self.impls[i].params.iter().some((g) => g.isComptime)) { continue; }
      const [methods, selfSym] = match (self.defs[iface].kind) {
        #Interface { methods, assoc: _, selfSym, supers: _ } => [methods.clone(), selfSym.clone()],
        _ => continue,
      };
      const m = self.impls[i].module;
      const target = self.impls[i].target.clone();
      const fids = self.impls[i].methods.clone();
      const nouter = self.impls[i].params.len();
      const iname = self.defs[iface].name.clone();
      const shownTarget = self.show(target);
      const implSpan = self.modules[m].ast.items[self.impls[i].item].span;
      for (const [name, want] of methods) {
        const found: Option<usize> = match (fids.iter().find((f) => self.fns[f].name == name)) { #Some(f) => #Some(f), #None => #None };
        const fid = match (found) {
          #Some(f) => f,
          #None => {
            self.error(m, { start: implSpan.start, end: implSpan.start }, `\`${shownTarget}\` does not implement \`${iname}\`: it has no \`${name}\``.asStr());
            continue;
          }
        };
        const have = self.fns[fid].scheme.clone();
        const span = match (self.fnDecl(fid)) { #Some(d) => d.sig.name.span, #None => implSpan };
        // The interface's method as this impl has it: `Self` the target, the interface's parameters
        // its arguments, and its own type parameters the impl method's.
        let own: Vec<GParam> = Vec.new();
        for (const k of min(nouter, have.tparams.len())..have.tparams.len()) { own.push(have.tparams[k].clone()); }
        if (own.len() != want.tparams.len() || have.params.len() != want.params.len()) {
          self.error(m, span, `\`${name}\` does not match \`${iname}\`'s: it takes other parameters`.asStr());
          continue;
        }
        let params: Vec<GParam> = [GParam { sym: selfSym.clone(), kind: #Type, bounds: Vec.new(), default: #None, isComptime: false }];
        for (const g of self.defs[iface].params) { params.push(g.clone()); }
        for (const g of want.tparams) { params.push(g.clone()); }
        let args: Vec<GArg> = [#Ty(target.clone())];
        for (const a of iargs) { args.push(a.clone()); }
        for (const g of own) { args.push(paramArg(g)); }
        const map = substMap(params, args);
        const assoc = self.impls[i].assocTys.clone();
        let wantParams: Vec<Ty> = Vec.new();
        for (const [_, t] of want.params) { wantParams.push(ownAssoc(subst(t, map), target, assoc)); }
        const wantRet = ownAssoc(subst(want.ret, map), target, assoc);
        let fits = eraseRegions(have.ret) == eraseRegions(wantRet);
        for (const k of 0..have.params.len()) {
          const [_, ht] = have.params[k].clone();
          if (eraseRegions(ht) != eraseRegions(wantParams[k])) { fits = false; }
        }
        if (!fits) {
          let shown: Vec<String> = Vec.new();
          for (const t of wantParams) { shown.push(self.show(t)); }
          self.error(m, span, `\`${name}\` does not match \`${iname}\`'s, which takes \`(${shown.join(", ")})\` and gives \`${self.show(wantRet)}\``.asStr());
          continue;
        }
        const wantRow = substEffs(match (want.effects) { #Some(r) => r.clone(), #None => pure() }, map);
        const haveRow = match (have.effects) { #Some(r) => r.clone(), #None => pure() };
        if (const #Some(e) = self.beyond(haveRow, wantRow)) {
          const what = self.show(#Named(e.def, Vec.new()));
          self.error(m, span, `\`${name}\` performs \`${what}\`, which \`${iname}\`'s \`${name}\` does not declare: code calling it through \`${iname}\` would not handle it`.asStr());
        }
      }
      for (const fid of fids) {
        const name = self.fns[fid].name.clone();
        if (!methods.iter().some(([n, _]) => n == name)) {
          const span = match (self.fnDecl(fid)) { #Some(d) => d.sig.name.span, #None => implSpan };
          self.error(m, span, `\`${name}\` is not a method of \`${iname}\``.asStr());
        }
      }
    }
  }

  // An effect `have` performs that `want` does not allow, if there is one: one of another effect,
  // or a failure with a tag `want`'s failures lack. A row left open allows anything.
  function beyond(self: readonly Self, have: readonly EffRow, want: readonly EffRow): Option<Eff> {
    if (want.tail != #Closed) { return #None; }
    const fail = self.known.get("Fail");
    for (const e of have.effs) {
      const w = match (want.effs.iter().find((w) => w.def == e.def)) { #Some(w) => w.clone(), #None => return #Some(e.clone()) };
      if (fail == #Some(e.def)) {
        if (const #Some(#Union(he)) = e.args.first() && const #Some(#Union(we)) = w.args.first()) {
          if (we.tail == #Closed && he.labels.iter().some(([k, _]) => !we.labels.iter().some(([j, _]) => j == k))) {
            return #Some(e.clone());
          }
        }
      }
    }
    #None
  }

  function placeholder(self: mut Self, name: readonly Ident, module: usize): usize {
    self.defs.push(Def {
      name: name.name.clone(), module, params: Vec.new(), kind: #Struct { fields: #None }, span: name.span,
      private: Vec.new(), view: false, tagOrder: Vec.new(), templateFields: #None, cLayout: false, align: #None,
    });
    self.defs.len() - 1
  }

  export function typeParams(self: mut Self, params: readonly Vec<TypeParam>, scope: readonly TyScope): Vec<GParam> {
    let out: Vec<GParam> = Vec.new();
    for (const p of params) {
      const [name, kind, isComptime]: [Ident, PKind, bool] = match (p) {
        #Region { name, default: _ } => [name.clone(), #Region, false],
        #Row { name, bounds: _, default: _ } => [name.clone(), #Row, false],
        #Comptime { name, ty } => match (ty.kind) {
          #Path { segments, args: _ } if segments.len() == 1 && segments[0].name == "Type" => [name.clone(), #Type, true],
          _ => [name.clone(), #Len, false],
        },
        #Type { name, bounds: _, default: _ } => [name.clone(), #Type, false],
      };
      const sym = self.freshSym(name.name.asStr());
      out.push(GParam { sym, kind, bounds: Vec.new(), default: #None, isComptime });
    }
    // Bounds and defaults may mention earlier parameters.
    const inner = scope.withParams(out);
    for (const i of 0..out.len()) {
      match (params[i]) {
        #Type { name: _, bounds, default } => {
          let bs: Vec<Ty> = Vec.new();
          for (const b of bounds) { bs.push(self.elabTy(b, inner)); }
          out[i].bounds = bs;
          if (const #Some(d) = default) { out[i].default = #Some(#Ty(self.elabTy(d, inner))); }
        }
        #Row { name: _, bounds, default } => {
          let bs: Vec<Ty> = Vec.new();
          for (const b of bounds) { bs.push(self.elabTy(b, inner)); }
          out[i].bounds = bs;
          if (const #Some(d) = default) { out[i].default = #Some(#Row(self.elabRowType(d, inner))); }
        }
        #Region { name: _, default: #Some(d) } => { out[i].default = #Some(#Region(self.elabRegion(d, inner))); }
        _ => {}
      }
    }
    out
  }

  // A declaration's generic parameters, before any declaration's body: an alias may be
  // elaborated before the generic type it applies.
  function elaborateParams(self: mut Self, m: usize, item: readonly Item): void {
    const scope = moduleScope(m);
    const [name, params]: [String, Vec<TypeParam>] = match (item.kind) {
      #Struct(s) => [s.name.name.clone(), s.params.clone()],
      #Enum(e) => [e.name.name.clone(), e.params.clone()],
      #TypeAlias(a) => [a.name.name.clone(), a.params.clone()],
      #Interface(x) => [x.name.name.clone(), x.params.clone()],
      #Effect(e) => [e.name.name.clone(), e.params.clone()],
      _ => return,
    };
    if (const #Some(#Def(id)) = self.lookup(m, name.asStr())) {
      const gps = self.typeParams(params, scope);
      self.defs[id].params = gps;
    }
  }

  export function elaborateDef(self: mut Self, m: usize, item: readonly Item): void {
    const scope = moduleScope(m);
    const name: String = match (item.kind) {
      #Struct(s) => s.name.name.clone(),
      #Enum(e) => e.name.name.clone(),
      #TypeAlias(a) => a.name.name.clone(),
      #Interface(x) => x.name.name.clone(),
      #Effect(e) => e.name.name.clone(),
      _ => return,
    };
    const id = match (self.lookup(m, name.asStr())) { #Some(#Def(d)) => d, _ => return };
    const gparams = self.defs[id].params.clone();
    const inner = scope.withParams(gparams);
    match (item.kind) {
      #Struct(s) => {
        self.defs[id].view = s.view;
        if (const #Some(l) = s.layout) {
          if (l.name != "c" && l.name != "packed") { self.error(m, l.span, "`@layout` takes `c` or `packed`"); }
          self.defs[id].cLayout = l.name == "c";
        }
        if (const #Some(a) = s.align) {
          if (a == 0 || (a & (a - 1)) != 0) { self.error(m, s.name.span, "an alignment is a power of two"); }
          self.defs[id].align = #Some(a);
        }
        let private: Vec<String> = Vec.new();
        if (const #Some(fs) = s.fields) { for (const f of fs) { if (f.private) { private.push(f.name.name.clone()); } } }
        self.defs[id].private = private;
        // A struct with a type parameter that is `comptime`, or `comptime` code among its
        // fields, is a template: its fields are computed for each instance.
        const generated = match (s.fields) {
          #Some(fs) => fs.iter().some((f) => f.generate.isSome() || f.computed.isSome()),
          #None => false,
        };
        if (generated || gparams.iter().some((g) => g.isComptime)) {
          self.defs[id].templateFields = s.fields.clone();
          self.defs[id].kind = #Struct { fields: #Some(Vec.new()) };
          return;
        }
        const fields: Option<Vec<[String, Ty]>> = match (s.fields) {
          #Some(fs) => {
            let out: Vec<[String, Ty]> = Vec.new();
            for (const f of fs) { out.push([f.name.name.clone(), self.elabTy(f.ty, inner)]); }
            #Some(out)
          }
          #None => #None,
        };
        self.defs[id].kind = #Struct { fields };
      }
      #Enum(e) => {
        self.defs[id].view = e.view;
        let order: Vec<String> = Vec.new();
        for (const t of e.tags) { order.push(t.name.name.clone()); }
        self.defs[id].tagOrder = order;
        let tags: Vec<[String, Ty]> = Vec.new();
        for (const t of e.tags) {
          const payload = self.elabPayload(t.payload, inner);
          labelSet(mut tags, t.name.name.asStr(), payload);
        }
        self.defs[id].kind = #Enum { tags };
      }
      #TypeAlias(a) => {
        if (self.pendingAliases.remove(id).isNone()) { return; }
        self.aliasing.push(id);
        const ty = self.elabTy(a.ty, inner);
        self.aliasing.pop();
        self.defs[id].kind = #Alias { ty };
      }
      #Interface(x) => {
        const selfSym = match (self.defs[id].kind) { #Interface { methods: _, assoc: _, selfSym, supers: _ } => selfSym.clone(), _ => return };
        let supers: Vec<Ty> = Vec.new();
        for (const t of x.extends) { supers.push(self.elabTy(t, inner)); }
        let selfScope = inner.clone();
        selfScope.selfTy = #Some(#Param(selfSym.clone()));
        let methods: Vec<[String, Scheme]> = Vec.new();
        let assoc: Vec<String> = Vec.new();
        for (const member of x.members) {
          match (member) {
            #Method(sig) => {
              const s = self.elaborateSig(sig, selfScope, #None);
              methods.push([sig.name.name.clone(), s]);
            }
            #AssocType { name, bounds: _ } => assoc.push(name.name.clone()),
          }
        }
        self.declareIfaceFns(id, m, methods, selfSym);
        self.defs[id].kind = #Interface { methods, assoc, selfSym, supers };
      }
      #Effect(e) => {
        let ops: Vec<[String, Scheme]> = Vec.new();
        for (const sig of e.ops) {
          const s = self.elaborateSig(sig, inner, #None);
          ops.push([sig.name.name.clone(), s]);
        }
        self.defs[id].kind = #Effect { ops };
      }
      _ => {}
    }
  }

  // Registers each method of interface `iface` as a function callable through a bound. Its
  // generic parameters are `Self`, then the interface's, then the method's own.
  function declareIfaceFns(self: mut Self, iface: usize, module: usize, methods: readonly Vec<[String, Scheme]>, selfSym: readonly Sym): void {
    const iparams = self.defs[iface].params.clone();
    let iargs: Vec<GArg> = Vec.new();
    for (const g of iparams) { iargs.push(paramArg(g)); }
    const bound: Ty = #Named(iface, iargs);
    for (const [name, scheme] of methods) {
      let tparams: Vec<GParam> = [GParam { sym: selfSym.clone(), kind: #Type, bounds: [bound.clone()], default: #None, isComptime: false }];
      for (const g of iparams) { tparams.push(g.clone()); }
      for (const g of scheme.tparams) { tparams.push(g.clone()); }
      const id = self.fns.len();
      let s = scheme.clone();
      s.tparams = tparams;
      // An interface method states its effects; none means pure.
      if (s.effects.isNone()) { s.effects = #Some(pure()); }
      self.fns.push(FnInfo {
        name: name.clone(), module, scheme: s, decl: { module, item: 0xffffffff, method: #None }, exported: true,
        implId: #None, hasBody: false, foreign: false, iface: #Some(iface),
      });
      self.ifaceFns.insert(`${iface}:${name}`, id);
    }
  }

  // A nominal type that holds a borrow must be declared `view` (§3.3).
  function checkViews(self: mut Self): void {
    for (const d of 0..self.defs.len()) {
      const module = self.defs[d].module;
      if (self.modules[module].isStd) { continue; }
      const parts: Vec<[String, Ty]> = match (self.defs[d].kind) {
        #Struct { fields: #Some(fs) } => fs.clone(),
        #Enum { tags } => {
          let out: Vec<[String, Ty]> = Vec.new();
          for (const [k, t] of tags) { out.push([`#${k}`, t.clone()]); }
          out
        }
        _ => continue,
      };
      for (const [_, ty] of parts) {
        if (const #Some([c, arg]) = self.borrowInContainer(ty)) {
          const msg = containerMessage(self, c, arg);
          self.error(module, self.defs[d].span, msg.asStr());
        }
      }
      if (self.defs[d].view) { continue; }
      for (const [name, ty] of parts) {
        if (self.class(ty) == 2) {
          const shown = self.show(ty);
          const hint = if (shown.includes("str") && !shown.includes("u8")) { "use an owned `String`" } else { "use an owned type such as `Vec<T>`" };
          const tname = self.defs[d].name.clone();
          self.error(module, self.defs[d].span, `\`${tname}\` holds a borrow in \`${name}\` (\`${shown}\`): ${hint}, or declare \`view\` if \`${tname}\` is a temporary view`.asStr());
          break;
        }
      }
    }
  }

  // Module-level constants: their declared type, or a literal's.
  function elaborateConsts(self: mut Self): void {
    for (const c of 0..self.consts.len()) {
      const m = self.consts[c].module;
      const cname = self.consts[c].name.clone();
      let ann: Option<Type> = #None;
      for (const it of self.modules[m].ast.items) {
        if (const #Const { name, ty, value: _ } = it.kind) {
          if (name.name == cname) { ann = ty.clone(); break; }
        }
      }
      const scope = moduleScope(m);
      const ty: Ty = match (ann) {
        #Some(t) => self.elabTy(t, scope),
        #None => match (self.consts[c].value.kind) {
          #Int(_) => #Prim(#I32),
          #Float(_) => #Prim(#F64),
          #Str(_) => #Prim(#Str),
          #Bool(_) => boolTy(),
          #Byte(_) => #Prim(#U8),
          _ => {
            self.error(m, self.consts[c].value.span, "give this constant a type: `const NAME: Type = …;`");
            #Error
          }
        },
      };
      self.consts[c].ty = ty;
    }
  }

  function elaborateImpl(self: mut Self, m: usize, item: usize, imp: readonly ImplDecl): void {
    const scope = moduleScope(m);
    const params = self.typeParams(imp.params, scope);
    const inner = scope.withParams(params);
    const target = self.elabTy(imp.target, inner);
    let iface: Option<[usize, Vec<GArg>]> = #None;
    if (const #Some(t) = imp.iface && const #Path { segments, args } = t.kind && segments.len() == 1) {
      match (self.lookup(m, segments[0].name.asStr())) {
        #Some(#Def(d)) if match (self.defs[d].kind) { #Interface { methods: _ } => true, _ => false } => {
          const gargs = self.elabArgs(d, args, inner, t.span);
          iface = #Some([d, gargs]);
        }
        found => {
          const name = segments[0].name.clone();
          const msg = if (found.isNone()) { self.unknown("interface", name.asStr()) } else { `\`${name}\` is not an interface` };
          self.error(m, t.span, msg.asStr());
        }
      }
    }
    const id = self.impls.len();
    const template = params.iter().some((g) => g.isComptime);
    let assocTys: HashMap<String, Ty> = HashMap.new();
    if (!template) {
      for (const [n, t] of imp.assoc) {
        const at = self.elabTy(t, inner);
        assocTys.insert(n.name.clone(), at);
      }
    }
    let assoc: Vec<[String, Type]> = Vec.new();
    for (const [n, t] of imp.assoc) { assoc.push([n.name.clone(), t.clone()]); }
    const hasIface = imp.iface.isSome();
    self.impls.push(Impl { derived: imp.derived, assoc, assocTys, module: m, params: params.clone(), target: target.clone(), iface, methods: Vec.new(), item });
    let methodScope = inner.clone();
    methodScope.selfTy = #Some(target);
    for (const [k, method] of imp.methods.iter().enumerate()) {
      let scheme = self.elaborateSig(method.decl.sig, methodScope, #Some(params.clone()));
      const fid = self.fns.len();
      const exported = method.exported || self.modules[m].isStd || hasIface;
      if (exported && scheme.effects.isNone()) { scheme.effects = #Some(pure()); }
      self.fns.push(FnInfo {
        name: method.decl.sig.name.name.clone(), module: m, scheme, decl: { module: m, item, method: #Some(k) },
        exported, implId: #Some(id), hasBody: method.decl.body.isSome(), foreign: false, iface: #None,
      });
      self.impls[id].methods.push(fid);
    }
  }

  // A function signature. `outer` are the enclosing impl's parameters, which become the leading
  // generic parameters of the scheme.
  export function elaborateSig(self: mut Self, sig: readonly FnSig, scope: readonly TyScope, outer: Option<Vec<GParam>>): Scheme {
    const own = self.typeParams(sig.typeParams, scope);
    let inner = scope.withParams(own);
    // Region elision: exactly one region parameter across the impl and the function.
    let all: Vec<GParam> = match (outer) { #Some(o) => o, #None => Vec.new() };
    for (const g of own) { all.push(g.clone()); }
    let regions: Vec<Sym> = Vec.new();
    for (const g of all) { if (g.kind == #Region) { regions.push(g.sym.clone()); } }
    if (regions.len() == 1) { inner.elidedRegion = #Some(#Param(regions[0].clone())); }
    let params: Vec<[String, Ty]> = Vec.new();
    for (const p of sig.params) {
      const ty: Ty = match (p.ty) { #Some(t) => self.elabTy(t, inner), #None => #Error };
      params.push([p.name.name.clone(), ty]);
    }
    const ret = self.elabTy(sig.ret.ty, inner);
    const effects: Option<EffRow> = match (sig.uses) { #Some(row) => #Some(self.elabEffects(row, inner)), #None => #None };
    let retFrom: Vec<String> = Vec.new();
    for (const i of sig.ret.from) { retFrom.push(i.name.clone()); }
    Scheme { tparams: all, params, ret, effects, retFrom }
  }

  // The scheme of an `extern "C"` function (§8.2): what it takes and gives must be what C has;
  // one of C's performs `Unsafe` besides what it declares, and one C calls performs nothing.
  function foreignScheme(self: mut Self, m: usize, f: readonly FnDecl, scheme0: Scheme): Scheme {
    let scheme = scheme0;
    let tys: Vec<[Ty, Span]> = Vec.new();
    for (const [i, [_, t]] of scheme.params.iter().enumerate()) {
      const p = f.sig.params[i].clone();
      tys.push([t.clone(), match (p.ty) { #Some(x) => x.span, #None => p.name.span }]);
    }
    tys.push([scheme.ret.clone(), f.sig.ret.ty.span]);
    for (const [t, span] of tys) {
      if (!self.cRepresentable(t)) {
        const shown = self.show(t);
        self.error(m, span, `an \`extern "C"\` function takes and gives only what C has — integers, floats, \`bool\`, pointers and \`@layout(c)\` structs of them — not \`${shown}\``.asStr());
      }
    }
    if (scheme.tparams.len() > 0) { self.error(m, f.sig.name.span, "an `extern \"C\"` function is not generic"); }
    if (f.body.isNone()) {
      let row = match (scheme.effects) { #Some(r) => r.clone(), #None => pure() };
      if (const #Some(d) = self.known.get("Unsafe")) { row.effs.push(Eff { def: d, regions: Vec.new(), args: Vec.new() }); }
      scheme.effects = #Some(row);
    } else {
      const performs = match (scheme.effects) { #Some(r) => r.effs.len() > 0 || r.tail != #Closed, #None => false };
      if (performs) { self.error(m, f.sig.name.span, "a function C calls performs nothing: C cannot handle an effect, nor a failure"); }
      scheme.effects = #Some(pure());
    }
    scheme
  }

  // Whether C has values of the type: a number, a `bool`, a pointer, `void`, or a struct laid out
  // as C lays it out, of those.
  export function cRepresentable(self: readonly Self, t: readonly Ty): bool {
    match (t) {
      #Prim(p) => match (p) { #Str | #Never | #Type | #I128 => false, _ => true },
      #Named(d, args) => {
        if (self.known.get("Ptr") == #Some(d)) { return true; }
        self.defs[d].cLayout && match (self.structFields(d, args)) {
          #Some(fs) => fs.iter().every(([_, x]) => self.cRepresentable(x)),
          #None => false,
        }
      }
      _ => false,
    }
  }

  // ---- elaboration of types ----

  export function elabPayload(self: mut Self, p: readonly TagPayload, scope: readonly TyScope): Ty {
    match (p) {
      #None => voidTy(),
      #Tuple(ts) => {
        let out: Vec<Ty> = Vec.new();
        for (const t of ts) { out.push(self.elabTy(t, scope)); }
        #Tuple(out)
      }
      #Record(fs) => {
        let labels: Vec<[String, Ty]> = Vec.new();
        for (const f of fs) {
          const ft = self.elabTy(f.ty, scope);
          labelSet(mut labels, f.name.name.asStr(), ft);
        }
        #Record(Row { labels, tail: #Closed })
      }
    }
  }

  export function elabTy(self: mut Self, t: readonly Type, scope: readonly TyScope): Ty {
    const m = scope.module;
    match (t.kind) {
      #Spliced(i) => self.spliced[i].clone(),
      #Path { segments, args } if segments.len() == 2 => {
        const base: Type = { kind: #Path { segments: [segments[0].clone()], args: Vec.new() }, span: segments[0].span };
        const b = self.elabTy(base, scope);
        if (args.len() > 0) { self.error(m, t.span, "an associated type takes no arguments"); }
        #Assoc(Box.new(b), segments[1].name.clone())
      }
      #Path { segments, args } => {
        const name = segments[0].name.clone();
        // `Type` is the one built-in name a module may declare for itself: a compiler written in
        // Flyscript has a `Type` of its own (§1, goal 6).
        if (const #Some(p) = primFromName(name.asStr())) {
          if (p != #Type || !self.modules[m].scope.has(name.asStr())) { return #Prim(p); }
        }
        if (name == "Self") {
          return match (scope.selfTy) {
            #Some(s) => s.clone(),
            #None => {
              self.error(m, t.span, "`Self` is only meaningful in an `impl` or `interface`");
              #Error
            }
          };
        }
        if (const #Some([sym, kind]) = scope.params.get(name.asStr())) {
          if (kind != #Type) {
            self.error(m, t.span, `\`${name}\` is not a type`.asStr());
            return #Error;
          }
          return #Param(sym.clone());
        }
        const found = self.lookup(m, name.asStr());
        if (const #Some(#Def(d)) = found) {
          if (self.aliasing.includes(d)) {
            self.error(m, t.span, `\`${name}\` refers to itself, but a type alias names a structural type, which cannot be recursive: declare it as an \`enum\` or a \`struct\` (§3.3)`.asStr());
            return #Error;
          }
          if (const #Some([am, ai]) = self.pendingAliases.get(d)) {
            const aliasItem = self.modules[am].ast.items[ai].clone();
            self.elaborateDef(am, aliasItem);
          }
        }
        match (found) {
          #Some(#Def(d)) => {
            const gargs = self.elabArgs(d, args, scope, t.span);
            match (self.defs[d].kind) {
              #Alias { ty } => {
                const aty = ty.clone();
                const params = self.defs[d].params.clone();
                substParams(aty, params, gargs)
              }
              #Struct { fields: _ } | #Enum { tags: _ } => {
                self.ensureInstance(d, gargs);
                #Named(d, gargs)
              }
              // Effects and interfaces are namespaces in expressions, not types.
              _ => #Named(d, gargs),
            }
          }
          #Some(#Fn(_)) => {
            self.error(m, t.span, `\`${name}\` is a function, not a type`.asStr());
            #Error
          }
          #Some(#Const(_)) => {
            self.error(m, t.span, `\`${name}\` is a constant, not a type`.asStr());
            #Error
          }
          #None => {
            const msg = self.unknown("type", name.asStr());
            self.error(m, t.span, msg.asStr());
            #Error
          }
        }
      }
      #Record { fields, rest } => {
        let labels: Vec<[String, Ty]> = Vec.new();
        for (const f of fields) {
          const ft = self.elabTy(f.ty, scope);
          labelSet(mut labels, f.name.name.asStr(), ft);
        }
        const tail: Tail = match (rest) { #Some(r) => self.rowTail(r, scope), #None => #Closed };
        #Record(Row { labels, tail })
      }
      #Union { tags, includes, rest } => {
        let labels: Vec<[String, Ty]> = Vec.new();
        for (const tg of tags) {
          const pt = self.elabPayload(tg.payload, scope);
          labelSet(mut labels, tg.name.name.asStr(), pt);
        }
        // A named union's tags are part of this one, as rows compose (§3.2).
        for (const inc of includes) {
          match (self.elabTy(inc, scope)) {
            #Union(r) if r.tail == #Closed => {
              for (const [k, v] of r.labels) {
                if (const #Some(w) = labelGet(labels, k.asStr())) {
                  if (w != v) { self.error(m, inc.span, `\`#${k}\` is in this union twice, carrying different payloads`.asStr()); }
                }
                labelSet(mut labels, k.asStr(), v.clone());
              }
            }
            #Error => {}
            _ => self.error(m, inc.span, "only a closed tag union can be part of a union: an enum is a type of its own"),
          }
        }
        const tail: Tail = match (rest) { #Some(r) => self.rowTail(r, scope), #None => #Closed };
        #Union(Row { labels, tail })
      }
      #Tuple(ts) => {
        let out: Vec<Ty> = Vec.new();
        for (const x of ts) { out.push(self.elabTy(x, scope)); }
        #Tuple(out)
      }
      #EmptyRow => {
        self.error(m, t.span, "`[]` is an empty effect row, not a type");
        #Error
      }
      #Fn { mode, params, ret, uses: row } => {
        const fmode: FnMode = match (mode) { #Shared => #Shared, #Mut => #Mut, #Once => #Once };
        let ps: Vec<Ty> = Vec.new();
        for (const p of params) { ps.push(match (p.ty) { #Some(pt) => self.elabTy(pt, scope), #None => #Error }); }
        const r = self.elabTy(ret.ty, scope);
        const effects = match (row) { #Some(u) => self.elabEffects(u, scope), #None => pure() };
        #Fn(Box.new(FnTy { mode: fmode, params: ps, ret: r, effects }))
      }
      #Array { elem, len } => {
        const e = self.elabTy(elem, scope);
        match (len) {
          #None => #Slice(Box.new(e)),
          #Some(x) => #Array(Box.new(e), self.elabLen(x, scope)),
        }
      }
      #Mut(inner) => #Borrow(true, Box.new(self.elabTy(inner, scope))),
      #Readonly(inner) => #Borrow(false, Box.new(self.elabTy(inner, scope))),
      // `T*` is the library's `Ptr<T>` (§8.2).
      #Ptr(inner) => {
        const elem = self.elabTy(inner, scope);
        match (self.known.get("Ptr")) { #Some(d) => #Named(d, [#Ty(elem)]), #None => #Error }
      }
      #Dyn(_) => {
        self.error(m, t.span, "`dyn` is not supported yet");
        #Error
      }
      #Expr(_) => {
        self.error(m, t.span, "expected a type");
        #Error
      }
    }
  }

  function elabLen(self: mut Self, e: readonly Expr, scope: readonly TyScope): Len {
    match (e.kind) {
      #Int(s) => #Known(match (parseInt(s.asStr())) { #Some(n) => n as u64, #None => 0 }),
      #Ident(n) => match (scope.params.get(n.asStr())) {
        #Some([sym, #Len]) => #Param(sym.clone()),
        _ => {
          self.error(scope.module, e.span, `\`${n}\` is not a \`comptime\` length`.asStr());
          #Known(0)
        }
      },
      _ => {
        self.error(scope.module, e.span, "array lengths must be literals or `comptime` parameters for now");
        #Known(0)
      }
    }
  }

  function rowTail(self: mut Self, name: readonly Ident, scope: readonly TyScope): Tail {
    match (scope.params.get(name.name.asStr())) {
      #Some([sym, #Row]) => #Param(sym.clone()),
      _ => {
        self.error(scope.module, name.span, `\`${name.name}\` is not a row parameter`.asStr());
        #Closed
      }
    }
  }

  export function elabRegion(self: mut Self, t: readonly Type, scope: readonly TyScope): Region {
    if (const #Path { segments, args } = t.kind && segments.len() == 1 && args.len() == 0) {
      const name = segments[0].name.clone();
      if (name == "Heap") { return #Heap; }
      if (const #Some([sym, #Region]) = scope.params.get(name.asStr())) { return #Param(sym.clone()); }
    }
    self.error(scope.module, t.span, "expected a region");
    #Heap
  }

  // A row given as a generic argument: `[]`, `[Io, Fail<E>]`, or a row parameter `E`.
  function elabRowType(self: mut Self, t: readonly Type, scope: readonly TyScope): EffRow {
    match (t.kind) {
      #EmptyRow => pure(),
      #Tuple(items) => {
        let row: Vec<RowItem> = Vec.new();
        for (const i of items) { row.push(#Effect(i.clone())); }
        self.elabEffects(row, scope)
      }
      #Path { segments, args } if segments.len() == 1 && args.len() == 0 => {
        match (scope.params.get(segments[0].name.asStr())) {
          #Some([sym, #Row]) => EffRow { effs: Vec.new(), tail: #Param(sym.clone()) },
          _ => self.elabEffects([#Effect(t.clone())], scope),
        }
      }
      _ => {
        self.error(scope.module, t.span, "expected a row");
        pure()
      }
    }
  }

  export function elabEffects(self: mut Self, row: readonly Vec<RowItem>, scope: readonly TyScope): EffRow {
    let effs: Vec<Eff> = Vec.new();
    let tail: Tail = #Closed;
    for (const item of row) {
      match (item) {
        #Spread(name) => { tail = self.rowTail(name, scope); }
        #Effect(t) => {
          if (const #Path { segments, args } = t.kind) {
            const name = segments[0].name.clone();
            match (self.lookup(scope.module, name.asStr())) {
              #Some(#Def(d)) if match (self.defs[d].kind) { #Effect { ops: _ } => true, _ => false } => {
                const gargs = self.elabArgs(d, args, scope, t.span);
                let regions: Vec<Region> = Vec.new();
                let targs: Vec<Ty> = Vec.new();
                for (const a of gargs) {
                  match (a) {
                    #Region(r) => regions.push(r.clone()),
                    #Ty(x) => targs.push(x.clone()),
                    _ => {}
                  }
                }
                effs.push(Eff { def: d, regions, args: targs });
              }
              _ => self.error(scope.module, t.span, `\`${name}\` is not an effect`.asStr()),
            }
          }
        }
      }
    }
    EffRow { effs, tail }
  }

  // Generic arguments for `def`, by parameter kind, with region elision and defaults.
  export function elabArgs(self: mut Self, def: usize, args: readonly Vec<Type>, scope: readonly TyScope, span: Span): Vec<GArg> {
    const params = self.defs[def].params.clone();
    let regions: usize = 0;
    for (const p of params) { if (p.kind == #Region) { regions += 1; } }
    const elide = args.len() < params.len() && regions > 0 && args.len() + regions <= params.len() && scope.elidedRegion.isSome();
    let given: usize = 0;
    let out: Vec<GArg> = Vec.new();
    for (const p of params) {
      if (p.kind == #Region && elide) {
        out.push(#Region(match (scope.elidedRegion) { #Some(r) => r.clone(), #None => #Heap }));
        continue;
      }
      const arg: GArg = if (given < args.len()) {
        const a = args[given].clone();
        given += 1;
        match (p.kind) {
          #Type => #Ty(self.elabTy(a, scope)),
          #Region => #Region(self.elabRegion(a, scope)),
          #Row => #Row(self.elabRowType(a, scope)),
          #Len => match (a.kind) {
            #Expr(e) => #Len(self.elabLen(e, scope)),
            #Path { segments, args: _ } => {
              self.nextId += 1;
              const e: Expr = { kind: #Ident(segments[0].name.clone()), span: a.span, id: self.nextId };
              #Len(self.elabLen(e, scope))
            }
            _ => #Len(#Known(0)),
          },
        }
      } else {
        match (p.default) {
          #Some(d) => d.clone(),
          #None => {
            // Missing arguments are inferred where the type is used in a body; in a signature
            // they are an error.
            if (args.len() > 0) {
              self.error(scope.module, span, `\`${self.defs[def].name}\` takes ${params.len()} arguments`.asStr());
            }
            match (p.kind) {
              #Type => #Ty(#Error),
              #Region => #Region(#Heap),
              #Row => #Row(pure()),
              #Len => #Len(#Known(0)),
            }
          }
        }
      };
      out.push(arg);
    }
    if (given < args.len()) {
      self.error(scope.module, span, `\`${self.defs[def].name}\` takes ${params.len()} arguments`.asStr());
    }
    out
  }
}

// ---- description, for comparison with the Rust prototype's `flyc schemes` ----

function pkindName(k: PKind): str { match (k) { #Type => "Type", #Region => "Region", #Row => "Row", #Len => "Len" } }

function describeParams(p: readonly Program, gs: readonly Vec<GParam>): String {
  let parts: Vec<String> = Vec.new();
  for (const g of gs) {
    let bounds: Vec<String> = Vec.new();
    for (const b of g.bounds) { bounds.push(p.show(b)); }
    parts.push(`${if (g.isComptime) { "comptime " } else { "" }}${g.sym.name}:${pkindName(g.kind)}[${bounds.join(" & ")}]`);
  }
  parts.join(", ")
}

function describeScheme(p: readonly Program, s: readonly Scheme): String {
  let ps: Vec<String> = Vec.new();
  for (const [n, t] of s.params) { ps.push(`${n}: ${p.show(t)}`); }
  const effs = match (s.effects) {
    #Some(e) => {
      let out = String.new();
      writeEffs(e, p.defNames(), mut out);
      out
    }
    #None => "?".toString(),
  };
  `<${describeParams(p, s.tparams)}>(${ps.join(", ")}): ${p.show(s.ret)} uses ${effs} from ${s.retFrom.join(",")}`
}

export function describe(p: readonly Program): Vec<String> {
  let out: Vec<String> = Vec.new();
  for (const [i, d] of p.defs.iter().enumerate()) {
    const kind: String = match (d.kind) {
      #Struct { fields } => match (fields) {
        #Some(fs) => {
          let parts: Vec<String> = Vec.new();
          for (const [k, t] of fs) { parts.push(`${k}: ${p.show(t)}`); }
          `struct { ${parts.join("; ")} }`
        }
        #None => "struct opaque".toString(),
      },
      #Enum { tags } => {
        let parts: Vec<String> = Vec.new();
        for (const [k, t] of tags) { parts.push(`#${k} ${p.show(t)}`); }
        `enum ${parts.join(" | ")}`
      }
      #Alias { ty } => `alias ${p.show(ty)}`,
      #Interface { methods, assoc, selfSym: _, supers } => {
        let ext: Vec<String> = Vec.new();
        for (const t of supers) { ext.push(p.show(t)); }
        let ms: Vec<String> = Vec.new();
        for (const [n, s] of methods) { ms.push(`${n}${describeScheme(p, s)}`); }
        `interface extends [${ext.join(", ")}] assoc [${assoc.join(", ")}] ${ms.join("; ")}`
      }
      #Effect { ops } => {
        let ms: Vec<String> = Vec.new();
        for (const [n, s] of ops) { ms.push(`${n}${describeScheme(p, s)}`); }
        `effect ${ms.join("; ")}`
      }
    };
    out.push(`def ${i} ${d.name} <${describeParams(p, d.params)}> ${kind}`);
  }
  for (const [i, c] of p.consts.iter().enumerate()) { out.push(`const ${i} ${c.name}: ${p.show(c.ty)}`); }
  for (const [i, f] of p.fns.iter().enumerate()) {
    out.push(`fn ${i} ${p.modules[f.module].name} ${f.name}${describeScheme(p, f.scheme)}`);
  }
  for (const [i, imp] of p.impls.iter().enumerate()) {
    const iface = match (imp.iface) {
      #Some([d, args]) => {
        let parts: Vec<String> = Vec.new();
        for (const a of args) {
          let s = String.new();
          writeArg(a, p.defNames(), mut s);
          parts.push(s);
        }
        `${p.defs[d].name}<${parts.join(", ")}>`
      }
      #None => String.new(),
    };
    let ms: Vec<String> = Vec.new();
    for (const m of imp.methods) { ms.push(`${m}`); }
    out.push(`impl ${i} <${describeParams(p, imp.params)}> ${iface} for ${p.show(imp.target)} methods [${ms.join(", ")}]`);
  }
  for (const [m, d] of p.diags) {
    const #Diagnostic { span, message } = d;
    out.push(`error ${m} ${span.start}..${span.end}: ${message}`);
  }
  out
}

// What Flyscript has where a TypeScript programmer reaches for something it does not (§2.1).
function tsHint(what: str, name: str): Option<str> {
  if (what == "type") {
    if (name == "string") { return #Some("Flyscript's strings are `str`, a borrowed view of text, and `String`, which owns its bytes"); }
    if (name == "number") { return #Some("Flyscript's numbers have sizes: `i32`, `i64`, `u32`, `usize`, `f64` and the rest"); }
    if (name == "boolean") { return #Some("Flyscript's is `bool`"); }
    if (name == "Array") { return #Some("a list that grows is a `Vec<T>`, and a fixed one `T[N]`"); }
    if (name == "Map") { return #Some("a map is a `HashMap`, from `std/collections`"); }
    if (name == "Set") { return #Some("a set is a `HashSet`, from `std/collections`"); }
    if (name == "Promise") { return #Some("there is no `async`: I/O is the `Io` effect, and tasks run in `Io.scope`"); }
    if (name == "any" || name == "unknown") { return #Some("every value has a type; a value of one of several types is a tag union, `#A(T) | #B(U)`"); }
  }
  if (what == "name") {
    if (name == "console") { return #Some("print with `println`, from `std/io`"); }
    if (name == "null" || name == "undefined") { return #Some("there is no null: a value that may be missing is an `Option`, `#Some(x)` or `#None`"); }
  }
  #None
}

// A type of an interface's method as an impl of it has it: the target's associated types its own
// (`Self.Slice` the impl's `Slice`).
function ownAssoc(t: readonly Ty, target: readonly Ty, assoc: readonly HashMap<String, Ty>): Ty {
  match (t) {
    #Assoc(base, n) if base.get() == target => match (assoc.get(n.asStr())) { #Some(x) => x.clone(), #None => t.clone() },
    #Named(d, args) => {
      let out: Vec<GArg> = Vec.new();
      for (const a of args) { out.push(match (a) { #Ty(x) => #Ty(ownAssoc(x, target, assoc)), other => other.clone() }); }
      #Named(d, out)
    }
    #Tuple(ts) => {
      let out: Vec<Ty> = Vec.new();
      for (const x of ts) { out.push(ownAssoc(x, target, assoc)); }
      #Tuple(out)
    }
    #Array(x, l) => #Array(Box.new(ownAssoc(x.get(), target, assoc)), l.clone()),
    #Slice(x) => #Slice(Box.new(ownAssoc(x.get(), target, assoc))),
    #Borrow(m, x) => #Borrow(m, Box.new(ownAssoc(x.get(), target, assoc))),
    #Record(r) => #Record(ownAssocRow(r, target, assoc)),
    #Union(r) => #Union(ownAssocRow(r, target, assoc)),
    _ => t.clone(),
  }
}

function ownAssocRow(r: readonly Row, target: readonly Ty, assoc: readonly HashMap<String, Ty>): Row {
  let labels: Vec<[String, Ty]> = Vec.new();
  for (const [k, x] of r.labels) { labels.push([k.clone(), ownAssoc(x, target, assoc)]); }
  { labels, tail: r.tail.clone() }
}
