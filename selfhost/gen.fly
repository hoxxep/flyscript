// JavaScript from Flyscript's syntax tree. The output runs on `runtime.js`, which gives values
// their representation: integers are BigInts and floats numbers, strings hold one byte per
// character, structs are objects carrying `$t`, tags objects carrying `$tag` and their payload
// in `$`. What depends on a type (a method's impl, `==`, display) is decided by the runtime from
// the value.

import { Span, Diagnostic } from "./diag";
import {
  Ident, Module, Item, ItemKind, Field, TagDecl, TagPayload, ImplDecl, Method, FnSig, FnDecl, Param, Type, TypeKind,
  RowItem, Block, Stmt, Expr, ExprKind, FieldInit, TagArgs, TemplatePiece, MatchArm, Pattern, PatternKind, TagPatArgs,
} from "./ast";
import { HashMap, HashSet } from "std/collections";

// Where a statement's value goes.
enum Dest { #Discard, #Return, #Assign(String) }

type Local = { js: String; isRef: bool };

const RESERVED: str[] = ["arguments", "await", "case", "catch", "class", "debugger", "default", "delete", "do",
  "else", "enum", "eval", "export", "extends", "finally", "function", "implements", "import", "in",
  "instanceof", "interface", "let", "new", "null", "package", "private", "protected", "public", "static",
  "super", "switch", "this", "typeof", "undefined", "var", "void", "with", "yield", "NaN", "Infinity"];

// Methods that replace their receiver (a string's `push`, an option's `take`): they are given a
// reference to the place it came from.
const WRITEBACK: str[] = ["push", "clear", "take"];

// Functions of the standard library the runtime provides under the same name.
const BUILTINS: str[] = ["println", "min", "max", "panic", "replace", "swap", "alloc", "allocAll",
  "writeFile", "parseInt", "parseFloat", "fmt", "copyUtf8", "repeat", "writeQuoted", "generate", "channel"];

const HEX: str = "0123456789abcdef";

// A string as a JavaScript literal: printable ASCII as it is, every other byte escaped.
export function quote(s: str): String {
  const bytes = s.asBytes();
  let out = "\"".toString();
  let run: usize = 0;
  let i: usize = 0;
  while (i < bytes.len()) {
    const b = bytes[i];
    const plain = b >= 0x20 && b < 0x7f && b != b'"' && b != b'\\';
    if (!plain) {
      // Every byte of a character beyond ASCII is escaped, so runs of plain bytes never start
      // inside one; an empty run may.
      if (run < i) { out.push(s.slice(run, i)); }
      if (b == b'"') { out.push("\\\""); }
      else if (b == b'\\') { out.push("\\\\"); }
      else if (b == b'\n') { out.push("\\n"); }
      else {
        const h = (b >> 4) as usize;
        const l = (b & 15) as usize;
        out.push("\\x");
        out.push(HEX.slice(h, h + 1));
        out.push(HEX.slice(l, l + 1));
      }
      run = i + 1;
    }
    i += 1;
  }
  out.push(s.slice(run, bytes.len()));
  out.push("\"");
  out
}

function mangle(n: str): String {
  if (RESERVED.includes(n)) { `${n}$` } else { n.toString() }
}

// The name an impl's methods are registered under: a type's last path segment.
export function typeName(t: readonly Type): String {
  match (t.kind) {
    #Path { segments, args: _ } => segments[segments.len() - 1].name.clone(),
    #Array { elem: _, len } => if (len.isSome()) { "$array".toString() } else { "$slice".toString() },
    #Mut(x) | #Readonly(x) | #Ptr(x) => typeName(x),
    #Tuple(_) => "$tuple".toString(),
    _ => "$other".toString(),
  }
}

// Whether a function performs `Yield`: it is then a generator.
export function isGenerator(sig: readonly FnSig): bool {
  match (sig.uses) {
    #Some(row) => row.iter().some((item) => match (item) {
      #Effect(t) => typeName(t) == "Yield",
      #Spread(_) => false,
    }),
    #None => false,
  }
}

// What every module's code consults: the program's types and which functions are generators.
export struct World {
  types: HashSet<String>;
  // Each struct's fields, in the order they are declared.
  structs: HashMap<String, Vec<String>>;
  // The JavaScript names of the generator functions.
  generators: HashSet<String>;
  // The names of generator methods.
  genMethods: HashSet<String>;
}
impl Clone for World;

// The types and generators every module declares.
export function survey(modules: readonly Module[]): World {
  let types: HashSet<String> = HashSet.new();
  let structs: HashMap<String, Vec<String>> = HashMap.new();
  let generators: HashSet<String> = HashSet.new();
  let genMethods: HashSet<String> = HashSet.new();
  for (const [k, m] of modules.iter().enumerate()) {
    for (const item of m.items) {
      match (item.kind) {
        #Struct(s) => {
          types.insert(s.name.name.clone());
          let fields: Vec<String> = Vec.new();
          if (const #Some(fs) = s.fields) { for (const f of fs) { fields.push(f.name.name.clone()); } }
          structs.insert(s.name.name.clone(), fields);
        }
        #Enum(e) => { types.insert(e.name.name.clone()); }
        #TypeAlias(a) => { types.insert(a.name.name.clone()); }
        #Interface(i) => { types.insert(i.name.name.clone()); }
        #Effect(e) => { types.insert(e.name.name.clone()); }
        #Function(f) => { if (isGenerator(f.sig)) { generators.insert(`m${k}$${f.sig.name.name}`); } }
        #Impl(imp) => {
          for (const m of imp.methods) { if (isGenerator(m.decl.sig)) { genMethods.insert(m.decl.sig.name.name.clone()); } }
        }
        _ => {}
      }
    }
  }
  { types, structs, generators, genMethods }
}

export struct Gen {
  out: String;
  indent: usize;
  tmp: usize;
  scopes: Vec<HashMap<String, Local>>;
  // Module-level names: functions, constants and what is imported, as JavaScript names.
  names: HashMap<String, String>;
  world: World;
  inGenerator: bool;
}

impl Gen {
  function new(names: HashMap<String, String>, world: World): Gen {
    Gen { out: String.new(), indent: 0, tmp: 0, scopes: Vec.new(), names, world, inGenerator: false }
  }

  function fail(self: readonly Self, span: Span, message: str): never uses Fail<Diagnostic> {
    throw #Diagnostic { span, message: message.toString() }
  }
  function unsupported(self: readonly Self, span: Span, what: str): never uses Fail<Diagnostic> {
    self.fail(span, `${what} is not supported by this compiler yet`)
  }

  function line(self: mut Self, s: str): void {
    for (const _ of 0..self.indent) { self.out.push("  "); }
    self.out.push(s);
    self.out.push("\n");
  }

  function fresh(self: mut Self): String {
    self.tmp += 1;
    `$${self.tmp}`
  }

  // A value kept in a temporary, so that what runs next cannot change it.
  function save(self: mut Self, v: String): String {
    const t = self.fresh();
    self.line(`const ${t} = ${v};`);
    t
  }

  // ---- scopes ----

  function push(self: mut Self): void { self.scopes.push(HashMap.new()); }
  function pop(self: mut Self): void { self.scopes.pop(); }

  // Declares a local, renamed if this scope already has one of its name (Flyscript shadows;
  // JavaScript does not let a block declare a name twice).
  function declare(self: mut Self, name: str, isRef: bool): String {
    const top = self.scopes.len() - 1;
    let js = if (name == "_") { self.fresh() } else { mangle(name) };
    if (self.scopes[top].has(name)) { js = `${js}$${self.fresh()}`; }
    self.scopes[top].insert(name.toString(), { js: js.clone(), isRef });
    js
  }

  function local(self: readonly Self, name: str): Option<Local> {
    let i = self.scopes.len();
    while (i > 0) {
      i -= 1;
      if (const #Some(l) = self.scopes[i].get(name)) { return #Some(l.clone()); }
    }
    #None
  }

  // A type's name, where a value's could be: types are capitalized, constants are values a
  // module names (`BINARY` is in `names`), and locals shadow both.
  function isType(self: readonly Self, name: str): bool {
    if (self.local(name).isSome() || self.names.has(name)) { return false; }
    const b = name.asBytes()[0];
    self.world.types.has(name) || (b >= b'A' && b <= b'Z')
  }

  // ---- whether an expression needs statements ----

  function simple(e: readonly Expr): bool {
    match (e.kind) {
      #Int(_) | #Float(_) | #Str(_) | #Byte(_) | #Bool(_) | #Ident(_) | #Lambda { params: _ } => true,
      #Template(parts) => parts.iter().every((p) => match (p) { #Lit(_) => true, #Expr(x) => Gen.simple(x) }),
      #Field { target, name: _ } => Gen.simple(target),
      #Unary { op: _, operand } => Gen.simple(operand),
      #Cast { expr, ty: _ } => Gen.simple(expr),
      #BorrowMut(x) | #Yield(x) | #Comptime(x) => Gen.simple(x),
      #Index { target, index } => Gen.simple(target) && Gen.simple(index),
      #Binary { op: _, lhs, rhs } => Gen.simple(lhs) && Gen.simple(rhs),
      #Assign { op: _, target, value } => Gen.simple(target) && Gen.simple(value),
      #Range { lo, hi } => Gen.simpleOpt(lo) && Gen.simpleOpt(hi),
      #Call { callee, typeArgs: _, args } => Gen.simple(callee) && args.iter().every((a) => Gen.simple(a)),
      #List(items) => items.iter().every((a) => Gen.simple(a)),
      #Tag { name: _, args } => match (args) {
        #None => true,
        #Tuple(es) => es.iter().every((a) => Gen.simple(a)),
        #Record(fs) => Gen.simpleInits(fs),
      },
      #Record { name: _, fields } => Gen.simpleInits(fields),
      #Block(b) => b.stmts.len() == 0 && Gen.simpleOpt(b.tail),
      #If { cond, then, otherwise } => Gen.simple(cond) && then.stmts.len() == 0 && Gen.simpleOpt(then.tail) && Gen.simpleOpt(otherwise),
      _ => false,
    }
  }
  function simpleOpt(e: readonly Option<Box<Expr>>): bool {
    match (e) { #Some(x) => Gen.simple(x), #None => true }
  }
  function simpleInits(fs: readonly Vec<FieldInit>): bool {
    fs.iter().every((f) => match (f.value) { #Some(v) => Gen.simple(v), #None => true })
  }

  // ---- expressions ----

  // The JavaScript for an expression, after emitting what it needs done first.
  function ex(self: mut Self, e: readonly Expr): String uses Fail<Diagnostic> {
    match (e.kind) {
      #Int(n) => `${n}n`,
      #Float(n) => n.clone(),
      #Str(s) => quote(s),
      #Byte(b) => `${b}n`,
      #Bool(b) => if (b) { "true".toString() } else { "false".toString() },
      #Template(parts) => {
        let out = "(\"\"".toString();
        for (const p of parts) {
          match (p) {
            #Lit(s) => { if (s.len() > 0) { out.push(" + "); out.push(quote(s).asStr()); } }
            #Expr(x) => { const v = self.ex(x); out.push(` + $rt.str(${v})`); }
          }
        }
        out.push(")");
        out
      }
      #Ident(n) => self.ident(n, e.span),
      #Field { target, name } => {
        const t = self.ex(target);
        `${t}.${name.name}`
      }
      #Index { target, index } => match (index.kind) {
        #Range { lo, hi } => {
          const t = self.ex(target);
          const l = match (lo) { #Some(x) => self.ex(x), #None => "0n".toString() };
          const h = match (hi) { #Some(x) => self.ex(x), #None => "undefined".toString() };
          `$rt.slice(${t}, ${l}, ${h})`
        }
        _ => {
          const [a, b] = self.pair(target, index);
          `$rt.idx(${a}, ${b})`
        }
      },
      #Call { callee, typeArgs: _, args } => self.call(callee, args, false),
      #Unary { op, operand } => {
        const v = self.ex(operand);
        `(${op}${v})`
      }
      #Binary { op, lhs, rhs } => self.binary(op, lhs, rhs),
      #Assign { op, target, value } => {
        const v = self.ex(value);
        // A place assigned is a copy of it: the value may be a `Copy` struct, which JavaScript shares.
        const copied = if (Gen.isPlace(value)) { `$rt.copy(${v})` } else { v };
        const place = self.place(target);
        `(${place} ${op} ${copied})`
      }
      #Tag { name, args } => self.tag(name, args),
      #Record { name, fields } => {
        const n: Option<String> = match (name) { #Some(path) => #Some(path[path.len() - 1].name.clone()), #None => #None };
        self.record(n, fields)
      }
      #List(items) => {
        const vs = self.list(items);
        `[${vs.join(", ")}]`
      }
      #Lambda { params, body } => self.lambda(params, body),
      #Range { lo, hi } => {
        const x = match (lo) { #Some(v) => self.ex(v), #None => "0n".toString() };
        const y = match (hi) { #Some(v) => self.ex(v), #None => self.unsupported(e.span, "a range without an end") };
        `$rt.range(${x}, ${y})`
      }
      #Yield(x) => {
        if (!self.inGenerator) { self.fail(e.span, "`yield` outside a generator"); }
        const v = self.ex(x);
        `(yield ${v})`
      }
      #Cast { expr, ty } => {
        const v = self.ex(expr);
        `$rt.cast(${v}, ${quote(typeName(ty))})`
      }
      // What `comptime` computes, the program computes as it runs: the same value.
      #Comptime(x) => self.ex(x),
      #BorrowMut(_) => self.fail(e.span, "`mut` lends only to a call's argument"),
      #Return(_) | #Break | #Continue | #Throw(_) => {
        self.into(e, #Discard);
        "undefined".toString()
      }
      #Block(b) if b.stmts.len() == 0 && Gen.simpleOpt(b.tail) => match (b.tail) {
        #Some(t) => self.ex(t),
        #None => "undefined".toString(),
      },
      #If { cond, then, otherwise } if Gen.simple(e) => {
        const c = self.ex(cond);
        const a = match (then.tail) { #Some(x) => self.ex(x), #None => "undefined".toString() };
        const b = match (otherwise) { #Some(x) => self.ex(x), #None => "undefined".toString() };
        `(${c} ? ${a} : ${b})`
      }
      #TagAt { name: _, args: _ } => self.unsupported(e.span, "a tag named by `comptime` code"),
      #TypeRef(_) => self.unsupported(e.span, "a type `comptime` code computed"),
      #FieldAt { target: _, name: _ } => self.unsupported(e.span, "a field named by `comptime` code"),
      _ => {
        const t = self.fresh();
        self.line(`let ${t};`);
        self.into(e, #Assign(t.clone()));
        t
      }
    }
  }

  function isPlace(e: readonly Expr): bool {
    match (e.kind) { #Ident(_) | #Field { target: _ } | #Index { target: _ } => true, _ => false }
  }

  // Two operands in order: the first is saved if the second needs statements run first.
  function pair(self: mut Self, a: readonly Expr, b: readonly Expr): [String, String] uses Fail<Diagnostic> {
    let x = self.ex(a);
    if (!Gen.simple(b)) { x = self.save(x); }
    const y = self.ex(b);
    [x, y]
  }

  // Expressions in order, as `pair` keeps two.
  function list(self: mut Self, es: readonly Vec<Expr>): Vec<String> uses Fail<Diagnostic> {
    let last: usize = 0;
    for (const [i, e] of es.iter().enumerate()) { if (!Gen.simple(e)) { last = i; } }
    let out: Vec<String> = Vec.new();
    for (const [i, e] of es.iter().enumerate()) {
      const v = self.ex(e);
      out.push(if (i < last) { self.save(v) } else { v });
    }
    out
  }

  function ident(self: mut Self, n: str, span: Span): String uses Fail<Diagnostic> {
    if (const #Some(l) = self.local(n)) {
      return if (l.isRef) { `${l.js}.v` } else { l.js };
    }
    if (const #Some(js) = self.names.get(n)) { return js.clone(); }
    if (BUILTINS.includes(n)) { return `$rt.${n}`; }
    self.fail(span, `unknown name \`${n}\``)
  }

  // The JavaScript for a place, to assign or lend.
  function place(self: mut Self, e: readonly Expr): String uses Fail<Diagnostic> {
    match (e.kind) {
      #Ident(n) => self.ident(n, e.span),
      #Field { target, name } => {
        // Evaluated once, though a lent place is read and written by two closures.
        const t = match (target.kind) { #Ident(_) => self.ex(target), _ => { const v = self.ex(target); self.save(v) } };
        `${t}.${name.name}`
      }
      #Index { target, index } => {
        if (const #Range { lo: _ } = index.kind) { self.unsupported(e.span, "lending or assigning a slice"); }
        const [a, b] = self.pair(target, index);
        const at = self.save(a);
        `${at}[$rt.at(${at}, ${b})]`
      }
      _ => self.fail(e.span, "this is not a place"),
    }
  }

  // A reference to a place lent `mut`: an object whose `v` reads and writes it.
  function lend(self: mut Self, e: readonly Expr): String uses Fail<Diagnostic> {
    if (const #Ident(n) = e.kind) {
      if (const #Some(l) = self.local(n)) { if (l.isRef) { return l.js; } }
    }
    const p = self.place(e);
    `$rt.ref(() => ${p}, ($v) => ${p} = $v)`
  }

  function binary(self: mut Self, op: str, a: readonly Expr, b: readonly Expr): String uses Fail<Diagnostic> {
    if (op == "&&" || op == "||") {
      const x = self.ex(a);
      if (Gen.simple(b)) {
        const y = self.ex(b);
        return `(${x} ${op} ${y})`;
      }
      // The right operand's statements run only when it is evaluated.
      const t = self.fresh();
      self.line(`let ${t} = ${x};`);
      self.line(if (op == "&&") { `if (${t}) {` } else { `if (!${t}) {` });
      self.indent += 1;
      const y = self.ex(b);
      self.line(`${t} = ${y};`);
      self.indent -= 1;
      self.line("}");
      return t;
    }
    const [x, y] = self.pair(a, b);
    if (op == "==") { return `$rt.eq(${x}, ${y})`; }
    if (op == "!=") { return `!$rt.eq(${x}, ${y})`; }
    if (op == "<" || op == ">" || op == "<=" || op == ">=") { return `$rt.cmpOp(${x}, ${y}, ${quote(op)})`; }
    `(${x} ${op} ${y})`
  }

  function tag(self: mut Self, name: str, args: readonly TagArgs): String uses Fail<Diagnostic> {
    match (args) {
      #None => `{ $tag: ${quote(name)} }`,
      #Tuple(es) => {
        const vs = self.list(es);
        if (vs.len() == 1) { `{ $tag: ${quote(name)}, $: ${vs[0]} }` } else { `{ $tag: ${quote(name)}, $: [${vs.join(", ")}] }` }
      }
      #Record(fields) => {
        const rec = self.record(#None, fields);
        `{ $tag: ${quote(name)}, $: ${rec} }`
      }
    }
  }

  function record(self: mut Self, name: readonly Option<String>, fields: readonly Vec<FieldInit>): String uses Fail<Diagnostic> {
    let last: usize = 0;
    for (const [i, f] of fields.iter().enumerate()) {
      if (f.generate.isSome() || f.computed.isSome()) { self.unsupported(f.name.span, "a record entry `comptime` code names or generates"); }
      match (f.value) { #Some(v) => { if (!Gen.simple(v)) { last = i; } } #None => {} }
    }
    let vs: Vec<String> = Vec.new();
    for (const [i, f] of fields.iter().enumerate()) {
      const x = match (f.value) { #Some(v) => self.ex(v), #None => self.ident(f.name.name.asStr(), f.name.span) };
      vs.push(if (i < last) { self.save(x) } else { x });
    }
    let entries: Vec<String> = Vec.new();
    if (const #Some(n) = name) { entries.push(`$t: ${quote(n)}`); }
    // A struct's fields in the order it declares them, which is the order it is shown in.
    let order: Vec<usize> = Vec.new();
    if (const #Some(n) = name) {
      if (const #Some(declared) = self.world.structs.get(n)) {
        for (const d of declared) {
          if (const #Some(i) = fields.iter().findIndex((f) => f.name.name == d)) { order.push(i); }
        }
      }
    }
    if (order.len() != fields.len()) {
      order = Vec.new();
      for (const i of 0..fields.len()) { order.push(i); }
    }
    for (const i of order) { entries.push(`${fields[i].name.name}: ${vs[i]}`); }
    `{ ${entries.join(", ")} }`
  }

  function call(self: mut Self, callee: readonly Expr, args: readonly Vec<Expr>, statement: bool): String uses Fail<Diagnostic> {
    // `T.f(…)`: a function of a type.
    if (const #Field { target, name } = callee.kind) {
      if (const #Ident(t) = target.kind) {
        if (self.isType(t)) {
          const vs = self.args(args);
          return `$rt.st(${quote(t)}, ${quote(name.name)})(${vs.join(", ")})`;
        }
      }
      // A method: the runtime finds the impl from the receiver.
      const m = name.name.asStr();
      const writeback = WRITEBACK.includes(m) && Gen.isPlace(target);
      const recv = if (writeback) { self.lend(target) } else { self.ex(target) };
      const vs = self.args(args);
      let all: Vec<String> = Vec.new();
      all.push(recv);
      all.push(quote(m));
      for (const v of vs) { all.push(v.clone()); }
      const fn = if (writeback) { "$rt.callRef" } else { "$rt.call" };
      const yields = statement && self.inGenerator && self.world.genMethods.has(m);
      return `${if (yields) { "yield* " } else { "" }}${fn}(${all.join(", ")})`;
    }
    let generator = false;
    const f: String = match (callee.kind) {
      #Ident(n) => {
        const js = self.ident(n, callee.span);
        generator = self.world.generators.has(js);
        js
      }
      _ => {
        const c = self.ex(callee);
        `(${c})`
      }
    };
    const vs = self.args(args);
    const yields = statement && self.inGenerator && generator;
    `${if (yields) { "yield* " } else { "" }}${f}(${vs.join(", ")})`
  }

  function args(self: mut Self, args: readonly Vec<Expr>): Vec<String> uses Fail<Diagnostic> {
    let last: usize = 0;
    for (const [i, a] of args.iter().enumerate()) { if (!Gen.simple(a)) { last = i; } }
    let out: Vec<String> = Vec.new();
    for (const [i, a] of args.iter().enumerate()) {
      const x = match (a.kind) { #BorrowMut(p) => self.lend(p), _ => self.ex(a) };
      out.push(if (i < last) { self.save(x) } else { x });
    }
    out
  }

  function lambda(self: mut Self, params: readonly Vec<Param>, body: readonly Expr): String uses Fail<Diagnostic> {
    const saved = replace(mut self.out, String.new());
    const savedIndent = replace(mut self.indent, 1);
    const generator = Gen.yields(body);
    const savedGen = replace(mut self.inGenerator, generator);
    self.push();
    let names: Vec<String> = Vec.new();
    for (const p of params) { names.push(self.declare(p.name.name.asStr(), false)); }
    self.into(body, #Return);
    self.pop();
    const inner = replace(mut self.out, saved);
    self.indent = savedIndent;
    self.inGenerator = savedGen;
    let close = String.new();
    for (const _ of 0..self.indent) { close.push("  "); }
    if (generator) { `(function* (${names.join(", ")}) {\n${inner}${close}})` } else { `((${names.join(", ")}) => {\n${inner}${close}})` }
  }

  // Whether an expression yields, outside the closures in it: a closure that does is a generator.
  function yields(e: readonly Expr): bool {
    match (e.kind) {
      #Yield(_) => true,
      #Lambda { params: _ } => false,
      #Template(parts) => parts.iter().some((p) => match (p) { #Lit(_) => false, #Expr(x) => Gen.yields(x) }),
      #Field { target, name: _ } => Gen.yields(target),
      #Unary { op: _, operand } => Gen.yields(operand),
      #Cast { expr, ty: _ } => Gen.yields(expr),
      #BorrowMut(x) | #Throw(x) | #Comptime(x) => Gen.yields(x),
      #Index { target, index } => Gen.yields(target) || Gen.yields(index),
      #Binary { op: _, lhs, rhs } => Gen.yields(lhs) || Gen.yields(rhs),
      #Assign { op: _, target, value } => Gen.yields(target) || Gen.yields(value),
      #Range { lo, hi } => Gen.yieldsOpt(lo) || Gen.yieldsOpt(hi),
      #Call { callee, typeArgs: _, args } => Gen.yields(callee) || args.iter().some((a) => Gen.yields(a)),
      #List(items) => items.iter().some((a) => Gen.yields(a)),
      #Tag { name: _, args } => match (args) {
        #None => false,
        #Tuple(es) => es.iter().some((a) => Gen.yields(a)),
        #Record(fs) => Gen.initsYield(fs),
      },
      #Record { name: _, fields } => Gen.initsYield(fields),
      #Block(b) | #Unsafe(b) => Gen.blockYields(b),
      #Region { name: _, body } => Gen.blockYields(body),
      #If { cond, then, otherwise } => Gen.yields(cond) || Gen.blockYields(then) || Gen.yieldsOpt(otherwise),
      #While { cond, body } => Gen.yields(cond) || Gen.blockYields(body),
      #For { mutable: _, pat: _, iter, body } => Gen.yields(iter) || Gen.blockYields(body),
      #Match { scrutinee, arms } => Gen.yields(scrutinee) || arms.iter().some((a) => Gen.yields(a.body)),
      #Try { body, pat: _, handler } => Gen.blockYields(body) || Gen.blockYields(handler),
      #Return(v) => Gen.yieldsOpt(v),
      #Handle { body, effect: _, arms } => Gen.blockYields(body) || arms.iter().some((a) => Gen.blockYields(a.body)),
      _ => false,
    }
  }
  function yieldsOpt(e: readonly Option<Box<Expr>>): bool {
    match (e) { #Some(x) => Gen.yields(x), #None => false }
  }
  function initsYield(fs: readonly Vec<FieldInit>): bool {
    fs.iter().some((f) => match (f.value) { #Some(v) => Gen.yields(v), #None => false })
  }
  function blockYields(b: readonly Block): bool {
    b.stmts.iter().some((s) => match (s) {
      #Let { mutable: _, pat: _, ty: _, init, span: _ } => Gen.yields(init),
      #Expr(x) | #Defer(x) => Gen.yields(x),
    }) || Gen.yieldsOpt(b.tail)
  }

  // ---- patterns ----

  // The condition under which `subj` matches a pattern.
  function cond(self: mut Self, p: readonly Pattern, subj: str): String uses Fail<Diagnostic> {
    match (p.kind) {
      #Wild | #Bind(_) => "true".toString(),
      #Lit(e) => match (e.kind) {
        #Int(n) => `${subj} === ${n}n`,
        #Byte(b) => `${subj} === ${b}n`,
        #Bool(b) => `${subj} === ${b}`,
        _ => {
          const v = self.ex(e);
          `$rt.eq(${subj}, ${v})`
        }
      },
      #Tag { name, args } => {
        let parts: Vec<String> = Vec.new();
        parts.push(`${subj}.$tag === ${quote(name)}`);
        self.payloadConds(args, subj, mut parts);
        `(${parts.join(" && ")})`
      }
      #Tuple(ps) => {
        let parts: Vec<String> = Vec.new();
        for (const [i, q] of ps.iter().enumerate()) {
          const c = self.cond(q, `${subj}[${i}]`.asStr());
          if (c != "true") { parts.push(c); }
        }
        if (parts.len() == 0) { "true".toString() } else { `(${parts.join(" && ")})` }
      }
      #Record { name: _, fields } => {
        let parts: Vec<String> = Vec.new();
        self.fieldConds(fields, subj, mut parts);
        if (parts.len() == 0) { "true".toString() } else { `(${parts.join(" && ")})` }
      }
      #Or(alts) => {
        let parts: Vec<String> = Vec.new();
        for (const a of alts) { parts.push(self.cond(a, subj)); }
        `(${parts.join(" || ")})`
      }
      #TagAt { name: _, args: _ } => self.unsupported(p.span, "a tag named by `comptime` code"),
    }
  }

  function payloadConds(self: mut Self, args: readonly TagPatArgs, subj: str, parts: mut Vec<String>): void uses Fail<Diagnostic> {
    match (args) {
      #None => {}
      #Tuple(ps) => {
        if (ps.len() == 1) {
          const c = self.cond(ps[0], `${subj}.$`.asStr());
          if (c != "true") { parts.push(c); }
        } else {
          for (const [i, q] of ps.iter().enumerate()) {
            const c = self.cond(q, `${subj}.$[${i}]`.asStr());
            if (c != "true") { parts.push(c); }
          }
        }
      }
      #Record(fs) => self.fieldConds(fs, `${subj}.$`.asStr(), mut parts),
    }
  }

  function fieldConds(self: mut Self, fs: readonly Vec<[Ident, Option<Pattern>]>, subj: str, parts: mut Vec<String>): void uses Fail<Diagnostic> {
    for (const [f, q] of fs) {
      if (const #Some(q) = q) {
        const c = self.cond(q, `${subj}.${f.name}`.asStr());
        if (c != "true") { parts.push(c); }
      }
    }
  }

  // What a pattern binds, each with where it is in `subj`.
  function paths(p: readonly Pattern, subj: str, out: mut Vec<[String, String]>): void {
    match (p.kind) {
      #Bind(n) => out.push([n.clone(), subj.toString()]),
      #Tag { name: _, args } => match (args) {
        #None => {}
        #Tuple(ps) => {
          if (ps.len() == 1) { Gen.paths(ps[0], `${subj}.$`.asStr(), mut out); }
          else { for (const [i, q] of ps.iter().enumerate()) { Gen.paths(q, `${subj}.$[${i}]`.asStr(), mut out); } }
        }
        #Record(fs) => Gen.fieldPaths(fs, `${subj}.$`.asStr(), mut out),
      },
      #Tuple(ps) => { for (const [i, q] of ps.iter().enumerate()) { Gen.paths(q, `${subj}[${i}]`.asStr(), mut out); } }
      #Record { name: _, fields } => Gen.fieldPaths(fields, subj, mut out),
      #Or(alts) => { if (alts.len() > 0) { Gen.paths(alts[0], subj, mut out); } }
      _ => {}
    }
  }

  function fieldPaths(fs: readonly Vec<[Ident, Option<Pattern>]>, subj: str, out: mut Vec<[String, String]>): void {
    for (const [f, q] of fs) {
      match (q) {
        #Some(q) => Gen.paths(q, `${subj}.${f.name}`.asStr(), mut out),
        #None => out.push([f.name.clone(), `${subj}.${f.name}`]),
      }
    }
  }

  // Declares what a pattern binds, from `subj`, which it is known to match.
  function binds(self: mut Self, p: readonly Pattern, subj: str, mutable: bool): void uses Fail<Diagnostic> {
    if (const #Or(alts) = p.kind) {
      // Each alternative binds the same names: declare them, then assign from the one that matched.
      let first: Vec<[String, String]> = Vec.new();
      Gen.paths(alts[0], subj, mut first);
      if (first.len() == 0) { return; }
      let js: Vec<String> = Vec.new();
      for (const [n, _] of first) { js.push(self.declare(n, false)); }
      self.line(`let ${js.join(", ")};`);
      for (const [i, a] of alts.iter().enumerate()) {
        const c = self.cond(a, subj);
        let ps: Vec<[String, String]> = Vec.new();
        Gen.paths(a, subj, mut ps);
        let assigns: Vec<String> = Vec.new();
        for (const [k, [n, _]] of first.iter().enumerate()) {
          match (ps.iter().find(([m, _]) => m == n)) {
            #Some([_, path]) => assigns.push(`${js[k]} = ${path};`),
            #None => self.fail(a.span, `\`${n}\` is not bound by every alternative`),
          }
        }
        self.line(`${if (i == 0) { "" } else { "else " }}if (${c}) { ${assigns.join(" ")} }`);
      }
      return;
    }
    let ps: Vec<[String, String]> = Vec.new();
    Gen.paths(p, subj, mut ps);
    for (const [n, path] of ps) {
      const js = self.declare(n, false);
      self.line(`${if (mutable) { "let" } else { "const" }} ${js} = ${path};`);
    }
  }

  // ---- statements ----

  function deliver(self: mut Self, v: str, dest: readonly Dest): void {
    match (dest) {
      #Discard => { if (v != "undefined") { self.line(`${v};`); } }
      #Return => self.line(`return ${v};`),
      #Assign(t) => self.line(`${t} = ${v};`),
    }
  }

  function blockStmt(self: mut Self, b: readonly Block, dest: readonly Dest): void uses Fail<Diagnostic> {
    self.line("{");
    self.indent += 1;
    self.blockInto(b, dest);
    self.indent -= 1;
    self.line("}");
  }

  // Runs an expression as statements, sending its value to `dest`.
  function into(self: mut Self, e: readonly Expr, dest: readonly Dest): void uses Fail<Diagnostic> {
    match (e.kind) {
      #Block(b) | #Unsafe(b) => self.blockStmt(b, dest),
      // A region's arena is the garbage collector's.
      #Region { name: _, body } => self.blockStmt(body, dest),
      #If { cond, then, otherwise } => {
        const c = self.ex(cond);
        self.line(`if (${c}) {`);
        self.indent += 1;
        self.blockInto(then, dest);
        self.indent -= 1;
        match (otherwise) {
          #Some(x) => {
            self.line("} else {");
            self.indent += 1;
            self.into(x, dest);
            self.indent -= 1;
            self.line("}");
          }
          #None => {
            self.line("}");
            if (const #Assign(t) = dest) { self.line(`else ${t} = undefined;`); }
          }
        }
      }
      #Match { scrutinee, arms } => {
        const v = self.ex(scrutinee);
        const s = self.save(v);
        const label = `m${self.fresh()}`;
        self.line(`${label}: {`);
        self.indent += 1;
        for (const arm of arms) {
          if (arm.generate.isSome()) { self.unsupported(arm.pat.span, "arms generated by `comptime` code"); }
          const c = self.cond(arm.pat, s);
          self.line(`if (${c}) {`);
          self.indent += 1;
          self.push();
          self.binds(arm.pat, s, false);
          match (arm.guard) {
            #Some(g) => {
              const gv = self.ex(g);
              self.line(`if (${gv}) {`);
              self.indent += 1;
              self.into(arm.body, dest);
              self.line(`break ${label};`);
              self.indent -= 1;
              self.line("}");
            }
            #None => {
              self.into(arm.body, dest);
              self.line(`break ${label};`);
            }
          }
          self.pop();
          self.indent -= 1;
          self.line("}");
        }
        self.line(`$rt.unmatched(${s});`);
        self.indent -= 1;
        self.line("}");
      }
      #While { cond, body } => {
        if (Gen.simple(cond)) {
          const c = self.ex(cond);
          self.line(`while (${c}) {`);
          self.indent += 1;
        } else {
          self.line("while (true) {");
          self.indent += 1;
          const c = self.ex(cond);
          self.line(`if (!(${c})) break;`);
        }
        self.blockInto(body, #Discard);
        self.indent -= 1;
        self.line("}");
        self.deliver("undefined", dest);
      }
      #For { mutable, pat, iter, body } => {
        self.push();
        // `for (const i of a..b)`: a counted loop.
        const counted = match (pat.kind) {
          #Bind(n) => match (iter.kind) {
            #Range { lo: #Some(lo), hi: #Some(hi) } => {
              const [a, b] = self.pair(lo, hi);
              const end = self.save(b);
              const js = self.declare(n, false);
              self.line(`for (let ${js} = ${a}; ${js} < ${end}; ${js}++) {`);
              true
            }
            _ => false,
          },
          _ => false,
        };
        if (!counted) {
          const it = self.ex(iter);
          const x = self.fresh();
          self.line(`for (const ${x} of $rt.iter(${it})) {`);
          self.indent += 1;
          self.binds(pat, x, mutable);
        } else {
          self.indent += 1;
        }
        self.blockInto(body, #Discard);
        self.indent -= 1;
        self.line("}");
        self.pop();
        self.deliver("undefined", dest);
      }
      #Try { body, pat, handler } => {
        self.line("try {");
        self.indent += 1;
        self.blockInto(body, dest);
        self.indent -= 1;
        const err = self.fresh();
        self.line(`} catch (${err}) {`);
        self.indent += 1;
        self.line(`if (!(${err} instanceof $rt.Fail)) throw ${err};`);
        self.push();
        const c = self.cond(pat, `${err}.value`.asStr());
        if (c != "true") { self.line(`if (!(${c})) throw ${err};`); }
        self.binds(pat, `${err}.value`.asStr(), false);
        self.blockInto(handler, dest);
        self.pop();
        self.indent -= 1;
        self.line("}");
      }
      #Return(v) => {
        match (v) {
          #Some(x) => {
            if (self.inGenerator) {
              const r = self.ex(x);
              self.line(`return ${r};`);
            } else {
              self.into(x, #Return);
            }
          }
          #None => self.line("return;"),
        }
      }
      #Break => self.line("break;"),
      #Continue => self.line("continue;"),
      #Throw(x) => {
        const v = self.ex(x);
        self.line(`throw new $rt.Fail(${v});`);
      }
      #Call { callee, typeArgs: _, args } => {
        const v = self.call(callee, args, true);
        self.deliver(v, dest);
      }
      #Handle { body: _, effect, arms: _ } => self.unsupported(e.span, `handling \`${typeName(effect)}\``),
      _ => {
        const v = self.ex(e);
        self.deliver(v, dest);
      }
    }
  }

  function blockInto(self: mut Self, b: readonly Block, dest: readonly Dest): void uses Fail<Diagnostic> {
    self.push();
    self.stmtsFrom(b, 0, dest);
    self.pop();
  }

  function stmtsFrom(self: mut Self, b: readonly Block, from: usize, dest: readonly Dest): void uses Fail<Diagnostic> {
    let i = from;
    while (i < b.stmts.len()) {
      match (b.stmts[i]) {
        #Let { mutable, pat, ty: _, init, span: _ } => {
          const v = self.ex(init);
          const copied = if (Gen.isPlace(init)) { `$rt.copy(${v})` } else { v };
          match (pat.kind) {
            #Bind(n) => {
              const js = self.declare(n, false);
              self.line(`${if (mutable) { "let" } else { "const" }} ${js} = ${copied};`);
            }
            _ => {
              const t = self.save(copied);
              const c = self.cond(pat, t);
              if (c != "true") { self.line(`if (!(${c})) $rt.unmatched(${t});`); }
              self.binds(pat, t, mutable);
            }
          }
        }
        #Expr(e) => self.into(e, #Discard),
        // What follows runs before the deferred expression, however the block is left.
        #Defer(e) => {
          self.line("try {");
          self.indent += 1;
          self.stmtsFrom(b, i + 1, dest);
          self.indent -= 1;
          self.line("} finally {");
          self.indent += 1;
          self.into(e, #Discard);
          self.indent -= 1;
          self.line("}");
          return;
        }
      }
      i += 1;
    }
    match (b.tail) {
      #Some(t) => self.into(t, dest),
      #None => self.deliver("undefined", dest),
    }
  }

  // ---- declarations ----

  function function(self: mut Self, js: str, f: readonly FnDecl): void uses Fail<Diagnostic> {
    const body = match (f.body) { #Some(b) => b, #None => return };
    self.push();
    let params: Vec<String> = Vec.new();
    for (const p of f.sig.params) {
      // A parameter lent `mut` is a reference; `self` is the object it would refer to.
      const isRef = match (p.ty) { #Some(t) => match (t.kind) { #Mut(_) => p.name.name != "self", _ => false }, #None => false };
      params.push(self.declare(p.name.name.asStr(), isRef));
    }
    const generator = isGenerator(f.sig);
    self.inGenerator = generator;
    self.line(`function${if (generator) { "*" } else { "" }} ${js}(${params.join(", ")}) {`);
    self.indent += 1;
    // The body's top level is the parameters' scope in JavaScript: a `let` shadowing a parameter
    // is renamed there.
    self.stmtsFrom(body, 0, #Return);
    self.indent -= 1;
    self.line("}");
    self.inGenerator = false;
    self.pop();
  }

  function tagsOf(tags: readonly Vec<TagDecl>): String {
    let qs: Vec<String> = Vec.new();
    for (const t of tags) { qs.push(quote(t.name.name)); }
    qs.join(", ")
  }
}

// A module's JavaScript. `prefix` names its functions and constants (`m3$`); `names` holds what
// it can see by name, its own and what it imports.
export function module(m: readonly Module, prefix: str, names: HashMap<String, String>, world: World): String uses Fail<Diagnostic> {
  let g = Gen.new(names, world);
  for (const item of m.items) {
    match (item.kind) {
      #Function(f) => g.function(`${prefix}${f.sig.name.name}`.asStr(), f),
      #Const { name, ty: _, value } => {
        g.push();
        const v = g.ex(value);
        g.pop();
        g.line(`const ${prefix}${name.name} = ${v};`);
      }
      #Impl(imp) => {
        const target = typeName(imp.target);
        for (const m of imp.methods) {
          const js = `${target}$${m.decl.sig.name.name}`;
          g.function(js.asStr(), m.decl);
          g.line(`$rt.method(${quote(target)}, ${quote(m.decl.sig.name.name)}, ${js});`);
        }
        if (const #Some(i) = imp.iface) { g.line(`$rt.implement(${quote(target)}, ${quote(typeName(i))});`); }
      }
      #Enum(e) => g.line(`$rt.enumTags(${quote(e.name.name)}, [${Gen.tagsOf(e.tags)}]);`),
      #TypeAlias(a) => {
        if (const #Union { tags, includes: _, rest: _ } = a.ty.kind) {
          g.line(`$rt.enumTags(${quote(a.name.name)}, [${Gen.tagsOf(tags)}]);`);
        }
      }
      #Struct(s) => {
        let qs: Vec<String> = Vec.new();
        if (const #Some(fs) = s.fields) { for (const f of fs) { qs.push(quote(f.name.name)); } }
        g.line(`$rt.struct(${quote(s.name.name)}, [${qs.join(", ")}]);`);
      }
      _ => {}
    }
  }
  g.out
}
