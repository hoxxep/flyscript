// C from the core IR, for a native executable with no garbage collector.
//
// Values are C's: integers, floats, structs by value; a tag union is a struct of a tag and a union
// of payloads, its tags numbered across the program so that a value of a narrowed union converts to
// a wider one by its tag. A `mut T` is a pointer, and so is a `readonly T` of anything bigger than a
// scalar. A value that owns memory is dead when it is all zero bits: a move zeroes the place it
// moves from, and a drop does nothing to a dead value.
//
// Each block's cleanups run on every way out of it: at its end and before a `break`, `continue` or
// `return` that leaves it, written out where the jump is; and on a failure or an unwinding, which go
// from block to block through each one's way out for them. A function that may fail sets `fly_err`,
// what it threw, boxed with its tag, and returns; its caller checks after the call.
//
// Code that runs apart — a `defer`'s body, a loop's body over a generator, a `handle`'s body and
// arms — is a C function of its own, given pointers to the locals it uses of the function around it.

import { Span, Diagnostic, render } from "./diag";
import { Prim, Row, Ty, FnTy, GArg, Len, isInt, isFloat, primName } from "./types";
import { Program as Prog } from "./env";
import {
  Lower, Entry, newLower, stripBorrow, viewLike, typeArg, entryTy, optionTy, ckey, mangle, unitTy, isVoidTy,
} from "./lower";
import {
  Local, LocalKind, Place, Root, Proj, ProjKind, Operand, Constant, Rvalue, Capture, Call, Callee, Stmt, Handle, Arm, Block,
  Cleanup, Func, ConstValue, MainArg, Uses, ownedIn, useBlock,
} from "./ir";
import { HashMap, HashSet } from "std/collections";

// What the code being printed is part of: a function of the program's, or code run apart from one.
enum Mode {
  #Fn,
  // A loop's body over a generator: it returns whether the generator should go on, and says why
  // it stopped in the loop's code.
  #Body,
  // A `defer`'s body.
  #Defer,
}

// A block or a construct a jump can leave, around the code being printed.
enum Scope {
  // A block's cleanups.
  #Cleanups(Vec<Cleanup>),
  // A loop or a labeled block, by its label.
  #Target(usize),
}
impl Clone for Scope;
impl Clone for Mode;

// The state of the C function being printed.
type Ctx = {
  // Each local's C lvalue, and type.
  names: HashMap<usize, String>;
  locals: Vec<Local>;
  // Each capture's C lvalue.
  captures: Vec<String>;
  // Its declarations, made at its top, zeroed.
  decls: String;
  scopes: Vec<Scope>;
  // Where a failure or an unwinding goes from here: the innermost block's way out, a `catch`, or
  // the function's.
  targets: Vec<String>;
  mode: Mode;
  // What the code's yields go to, as a C `fly_yield`.
  sink: Option<String>;
  // How the code reaches each region's arena, by the region's symbol.
  arenas: HashMap<u32, String>;
  // The C function's return type; the Flyscript function's, and where a `return` of it puts its
  // value.
  ret: Ty;
  fnRet: Ty;
  oret: String;
  // The types of a closure's captures.
  capTys: Vec<Ty>;
  // The C made so far.
  out: String;
  // Locals declared at the function's top, rather than in their blocks: what the function's or a
  // `handle` part's value is given in, read once its blocks have ended.
  hoisted: HashSet<usize>;
  // Statements the next block made starts with, after its declarations.
  prologue: String;
  // The owned locals that may hold a value here, whether code here may run, and what may hold a
  // value at each jump to a label of a failure's or an unwinding's way out.
  live: HashSet<usize>;
  reachable: bool;
  liveAt: HashMap<String, HashSet<usize>>;
  // In a direct handler's arms: a resumption gives its argument back to the operation performed.
  direct: bool;
};

function newCtx(locals: Vec<Local>, ret: Ty, mode: Mode): Ctx {
  {
    names: HashMap.new(), locals, captures: Vec.new(), decls: String.new(), scopes: Vec.new(), targets: Vec.new(), mode,
    sink: #None, arenas: HashMap.new(), ret: ret.clone(), fnRet: ret, oret: "ret_".toString(), capTys: Vec.new(), out: String.new(),
    hoisted: HashSet.new(), prologue: String.new(), live: HashSet.new(), reachable: true, liveAt: HashMap.new(), direct: false,
  }
}

// A string as a C literal: printable ASCII as it is, every other byte in octal.
export function cquote(s: str): String {
  const bytes = s.asBytes();
  let out = "\"".toString();
  for (const b of bytes) {
    if (b == b'"') { out.push("\\\""); }
    else if (b == b'\\') { out.push("\\\\"); }
    else if (b >= 0x20 && b < 0x7f && b != b'?') { out.push(byteStr(b).asStr()); }
    else { out.push(`\\${(b >> 6) & 7}${(b >> 3) & 7}${b & 7}`); }
  }
  out.push("\"");
  out
}

function byteStr(b: u8): String {
  const ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
  const i = (b - 0x20) as usize;
  ascii.slice(i, i + 1).toString()
}

// A `str` literal: a constant, so it may initialize a static.
export function strLit(s: str): String { `((fly_str){ (const uint8_t*)${cquote(s)}, ${s.len()} })` }

function intPrim(t: readonly Ty): Option<Prim> {
  match (t) {
    #Prim(p) => if (isInt(p)) { #Some(p) } else { #None },
    #Borrow(_, inner) => intPrim(inner),
    _ => #None,
  }
}

function floatTy(t: readonly Ty): bool {
  match (t) { #Prim(p) => isFloat(p), #Borrow(_, inner) => floatTy(inner), _ => false }
}

// The bounds of an integer type, as C expressions.
function bounds(p: Prim): [String, String] {
  match (p) {
    #I8 => ["-128".toString(), "127".toString()],
    #I16 => ["-32768".toString(), "32767".toString()],
    #I32 => ["INT32_MIN".toString(), "INT32_MAX".toString()],
    #I64 | #Isize => ["INT64_MIN".toString(), "INT64_MAX".toString()],
    #U8 => ["0".toString(), "255".toString()],
    #U16 => ["0".toString(), "65535".toString()],
    #U32 => ["0".toString(), "UINT32_MAX".toString()],
    #U64 | #Usize => ["0".toString(), "UINT64_MAX".toString()],
    _ => ["0".toString(), "0".toString()],
  }
}

function primType(p: Prim): str {
  match (p) {
    #I8 => "int8_t", #I16 => "int16_t", #I32 => "int32_t", #I64 | #Isize => "int64_t", #I128 => "fly_i128",
    #U8 => "uint8_t", #U16 => "uint16_t", #U32 => "uint32_t", #U64 | #Usize => "uint64_t",
    #F32 => "float", #F64 => "double", #Bool => "bool", #Str => "fly_str", _ => "fly_unit",
  }
}

// A decimal literal too wide for a C literal, as its two halves.
function wideLit(n: str): String {
  let v: i128 = 0;
  for (const b of n.bytes()) { if (b >= b'0' && b <= b'9') { v = v * 10 + ((b - b'0') as i128); } }
  const hi = (v >> 64) as i64;
  const lo = (v & 0xFFFFFFFFFFFFFFFF) as u64;
  `((fly_i128)(((unsigned __int128)(uint64_t)INT64_C(${hi}) << 64) | UINT64_C(${lo})))`
}

export struct Cgen {
  lw: Lower;
  // Closures printed so far.
  closuresDone: usize;
  // Types made so far, by key, with their C names; their forward declarations and definitions,
  // each defined after what it holds by value.
  types: HashMap<String, String>;
  defined: HashSet<String>;
  pending: Vec<Ty>;
  typeFwd: String;
  typeDefs: String;
  // Tags numbered across the program, from 1: zero is a dead value.
  tags: HashMap<String, usize>;
  // Drop functions made, by type key; their code.
  drops: HashMap<String, String>;
  // Their forms taking `void*`, for the runtime.
  anyDrops: HashSet<String>;
  dropCode: String;
  // Conversions between union types, by their keys.
  convs: HashMap<String, String>;
  // Functions made for the runtime to call — hashes, comparisons, generators' steps — by key.
  helpers: HashMap<String, String>;
  // Constants made, by index.
  consts: HashMap<usize, String>;
  protos: String;
  code: String;
  // Code run apart, and closures.
  apartCode: String;
  aparts: usize;
  tmp: usize;
  // The function being printed.
  cx: Ctx;
  // The module of the function being printed, for its diagnostics.
  module: usize;
  // The `defer`s made functions of their own, by function and flag: the statement calling each.
  defers: HashMap<String, String>;
  fnName: String;
  // Where a routine's arguments are, by index, when it is printed apart from the code calling it.
  argPlaces: Vec<String>;
  // Code that calls the program's functions from elsewhere, put after them.
  glue: String;
}

impl Cgen {
  export function fail(self: readonly Self, span: Span, message: str): never uses Fail<Diagnostic> {
    throw #Diagnostic { span: self.lw.p.sourceSpan(span), message: message.toString() }
  }
  export function unsupported(self: readonly Self, span: Span, what: str): never uses Fail<Diagnostic> {
    self.fail(span, `${what} is not supported by the C back end yet`)
  }

  function fresh(self: mut Self): String {
    self.tmp += 1;
    `t${self.tmp}`
  }

  export function isString(self: readonly Self, t: readonly Ty): bool { self.lw.isString(t) }
  export function namedIs(self: readonly Self, t: readonly Ty, name: str): bool { self.lw.namedIs(t, name) }
  export function needsDrop(self: readonly Self, t: readonly Ty): bool { self.lw.needsDrop(t) }

  // ---- C types ----

  // Whether a value of the type is a scalar, passed and borrowed `readonly` by value.
  export function scalar(self: readonly Self, t: readonly Ty): bool {
    match (t) {
      #Prim(_) | #Slice(_) | #Fn(_) => true,
      #Borrow(_, _) => true,
      #Named(d, _) => self.lw.p.isKnown(d, "Box") || self.lw.p.isKnown(d, "Ref") || self.lw.p.isKnown(d, "Arc") || self.lw.p.isKnown(d, "Ptr") || self.namedIs(t, "Cell") || self.namedIs(t, "RegionList")
        || self.namedIs(t, "Scope") || self.namedIs(t, "Fiber") || self.namedIs(t, "Sender") || self.namedIs(t, "Receiver")
        || self.namedIs(t, "Reply") || self.namedIs(t, "Pending") || self.namedIs(t, "Mutex") || self.namedIs(t, "Listener") || self.namedIs(t, "Db"),
      _ => false,
    }
  }

  // Whether a value of the borrow type `t` is a pointer in C: a `mut` borrow, or a `readonly`
  // borrow of anything bigger than a scalar. A borrow of a view — a `str`, a slice, a function — is
  // the view: it points at what it shows already.
  export function pointerBorrow(self: readonly Self, t: readonly Ty): bool {
    match (t) {
      #Borrow(m, inner) => match (inner.get()) {
        // A borrow of a borrow is the inner borrow.
        #Borrow(_, _) => self.pointerBorrow(inner),
        x => !viewLike(x) && (m || !self.scalar(x)),
      },
      _ => false,
    }
  }

  export function ctype(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    match (t) {
      #Prim(p) => primType(p).toString(),
      #Borrow(_, inner) if match (inner.get()) { #Borrow(_, _) => true, _ => false } => self.ctype(inner, span),
      #Borrow(_, inner) => {
        if (self.pointerBorrow(t)) {
          const c = self.ctypeRef(inner, span);
          `${c}*`
        } else { self.ctype(inner, span) }
      }
      #Slice(_) => "fly_slice".toString(),
      #Fn(_) => "fly_fn".toString(),
      #Named(d, args) => {
        if (self.lw.p.isKnown(d, "String")) { return "fly_String".toString(); }
        if (self.lw.p.isKnown(d, "Vec")) { return "fly_vec".toString(); }
        if (self.namedIs(t, "HashMap")) { return "fly_map".toString(); }
        if (self.namedIs(t, "Gen")) { return "fly_gen".toString(); }
        if (self.namedIs(t, "Hasher")) { return "fly_Hasher".toString(); }
        if (self.namedIs(t, "File")) { return "fly_File".toString(); }
        // A region's handles point into its arena; a raw pointer is C's.
        if (self.lw.p.isKnown(d, "Ref") || self.namedIs(t, "Cell") || self.lw.p.isKnown(d, "Arc") || self.lw.p.isKnown(d, "Ptr")) {
          const inner: Ty = match (args.last()) { #Some(#Ty(x)) => x.clone(), _ => #Error };
          const c = self.ctypeRef(inner, span);
          return `${c}*`;
        }
        if (self.namedIs(t, "RegionList")) { return "fly_rlist*".toString(); }
        if (self.lw.p.isKnown(d, "Cont")) { return "fly_cont".toString(); }
        // The scheduler's handles: a scope or a task by its number, a channel's ends.
        if (self.namedIs(t, "Scope") || self.namedIs(t, "Fiber") || self.namedIs(t, "Listener") || self.namedIs(t, "Db")) { return "int".toString(); }
        if (self.namedIs(t, "Sender") || self.namedIs(t, "Receiver") || self.namedIs(t, "Reply") || self.namedIs(t, "Pending")) { return "fly_chan".toString(); }
        if (self.namedIs(t, "Socket")) { return "fly_socket".toString(); }
        // A lock holds its state on the heap, shared by the tasks that borrow it.
        if (self.namedIs(t, "Mutex")) {
          const c = self.ctypeRef(typeArg(t, 0), span);
          return `${c}*`;
        }
        if (self.lw.p.isKnown(d, "Box")) {
          return match (args.first()) {
            #Some(#Ty(x)) => {
              const c = self.ctypeRef(x, span);
              `${c}*`
            }
            _ => self.fail(span, "a `Box` without a type"),
          };
        }
        match (self.lw.p.defs[d].kind) {
          #Struct { fields: #Some(_) } => self.structType(t, span),
          #Enum { tags: _ } => self.unionType(t, span),
          _ => self.unsupported(span, `the type \`${self.lw.p.show(t)}\``),
        }
      }
      #Record(_) | #Tuple(_) => self.structType(t, span),
      #Union(_) => self.unionType(t, span),
      #Array(_, _) => self.structType(t, span),
      #Error => "fly_unit".toString(),
      _ => self.unsupported(span, `the type \`${self.lw.p.show(t)}\``),
    }
  }

  // A struct's C name, declared ahead of its definition, so pointers to it may be made first.
  function typeName(self: mut Self, t: readonly Ty): String {
    const key = ckey(t);
    if (const #Some(n) = self.types.get(key.asStr())) { return n.clone(); }
    const name = `T${self.types.len()}`;
    self.types.insert(key, name.clone());
    self.typeFwd.push(`typedef struct ${name} ${name};\n`);
    name
  }

  // Whether the type is a struct C defines here: what may be recursive through a pointer.
  function aggregate(self: readonly Self, t: readonly Ty): bool {
    match (t) {
      #Record(_) | #Tuple(_) | #Union(_) | #Array(_, _) => true,
      #Named(d, _) => match (self.lw.p.defs[d].kind) {
        #Struct { fields: #Some(_) } | #Enum { tags: _ } => true,
        _ => false,
      },
      _ => false,
    }
  }

  // The C type a pointer points at: a struct need only be named, and is defined at the end.
  function ctypeRef(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    if (!self.aggregate(t) || self.isString(t) || self.namedIs(t, "Vec")) { return self.ctype(t, span); }
    if (!self.defined.has(ckey(t))) { self.pending.push(t.clone()); }
    self.typeName(t)
  }

  // The fields of a struct-like type, with their C names and Flyscript types.
  export function cfields(self: readonly Self, t: readonly Ty): Vec<[String, Ty]> {
    let out: Vec<[String, Ty]> = Vec.new();
    const tuple = match (t) { #Tuple(_) => true, _ => false };
    for (const [k, x] of self.lw.fieldsOf(t)) { out.push([if (tuple) { `f${k}` } else { mangle(k.asStr()) }, x.clone()]); }
    out
  }

  // The C name of a field of a value of type `t`.
  export function fieldName(self: readonly Self, t: readonly Ty, k: str): String {
    match (t) { #Tuple(_) => `f${k}`, _ => mangle(k) }
  }

  // A struct, record, tuple or array, made once.
  function structType(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const name = self.typeName(t);
    if (!self.defined.insert(ckey(t))) { return name; }
    let body = String.new();
    if (self.liveByte(t)) { body.push("  bool live;\n"); }
    match (t) {
      #Array(e, l) => {
        const c = self.ctype(e, span);
        const n = match (l) { #Known(n) => n, _ => self.fail(span, "an array of unknown length") };
        body.push(`  ${c} data[${max(n, 1)}];\n`);
      }
      _ => {
        for (const [f, ft] of self.cfields(t)) {
          const c = self.ctype(ft, span);
          body.push(`  ${c} ${f};\n`);
        }
        if (body.len() == 0) { body.push("  fly_unit empty;\n"); }
      }
    }
    // A struct laid out for C may ask for an alignment.
    const align = match (t) { #Named(d, _) => match (self.lw.p.defs[d].align) { #Some(a) => ` __attribute__((aligned(${a})))`, #None => String.new() }, _ => String.new() };
    self.typeDefs.push(`struct ${name} {\n${body}}${align};\n`);
    name
  }

  // A tag's number, the same in every union.
  export function tagId(self: mut Self, name: str): usize {
    if (const #Some(i) = self.tags.get(name)) { return i; }
    const i = self.tags.len() + 1;
    self.tags.insert(name.toString(), i);
    i
  }

  function unionType(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const name = self.typeName(t);
    if (!self.defined.insert(ckey(t))) { return name; }
    let members = String.new();
    for (const [tag, pt] of self.lw.tagsOf(t)) {
      self.tagId(tag.asStr());
      if (!isVoidTy(pt)) {
        const c = self.ctype(self.lw.payloadTy(pt), span);
        members.push(`    ${c} ${mangle(tag.asStr())};\n`);
      }
    }
    if (members.len() == 0) { members.push("    fly_unit none;\n"); }
    const live = if (self.liveByte(t)) { "  bool live;\n" } else { "" };
    self.typeDefs.push(`struct ${name} {\n${live}  uint32_t tag;\n  union {\n${members}  } u;\n};\n`);
    name
  }

  // Whether a type has a `Drop` impl of its own, so its values carry a byte saying they live.
  export function liveByte(self: readonly Self, t: readonly Ty): bool {
    match (t) { #Named(d, _) => self.lw.p.hasDrop(d), _ => false }
  }

  // ---- drops ----

  // The function that drops a value of the type in place, made once: it runs the type's `Drop` if
  // the value lives, drops its parts, and leaves it dead.
  export function dropFn(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const key = ckey(t);
    if (const #Some(n) = self.drops.get(key.asStr())) { return n.clone(); }
    const name = `drop${self.drops.len()}`;
    self.drops.insert(key, name.clone());
    const c = self.ctype(t, span);
    self.protos.push(`static void ${name}(${c}* v);\n`);
    let body = String.new();
    match (t) {
      #Named(d, args) => {
        if (self.lw.p.isKnown(d, "String")) {
          body.push("  fly_String_drop(v);\n");
        } else if (self.namedIs(t, "Gen")) {
          body.push("  fly_gen_drop(v);\n");
        } else if (self.namedIs(t, "File")) {
          body.push("  fly_File_drop(v);\n");
        } else if (self.lw.p.isKnown(d, "Cont")) {
          body.push("  fly_cont_drop(v);\n");
        } else if (self.lw.p.isKnown(d, "Arc")) {
          const inner = typeArg(t, 0);
          const d2 = if (self.needsDrop(inner)) { `${self.dropFn(inner, span)}(*v); ` } else { "" };
          body.push(`  if (*v && fly_arc_release(*v)) { ${d2}fly_arc_free(*v); }\n  *v = NULL;\n`);
        } else if (self.namedIs(t, "Sender") || self.namedIs(t, "Reply")) {
          body.push("  fly_sender_drop(v);\n");
        } else if (self.namedIs(t, "Receiver") || self.namedIs(t, "Pending")) {
          body.push("  fly_receiver_drop(v);\n");
        } else if (self.namedIs(t, "Mutex")) {
          const inner = typeArg(t, 0);
          if (self.needsDrop(inner)) { body.push(`  if (*v) ${self.dropFn(inner, span)}(*v);\n`); }
          body.push("  fly_mutex_free(*v);\n  *v = NULL;\n");
        } else if (self.namedIs(t, "HashMap")) {
          const e = entryTy(t);
          if (self.needsDrop(e)) {
            const f = self.dropFn(e, span);
            const ec = self.ctype(e, span);
            body.push(`  for (size_t i = 0; i < v->len; i++) ${f}(&((${ec}*)v->entries)[i]);\n`);
          }
          body.push("  fly_map_free(v);\n");
        } else if (self.lw.p.isKnown(d, "Vec")) {
          if (const #Some(#Ty(e)) = args.first() && self.needsDrop(e)) {
            const f = self.dropFn(e, span);
            const ec = self.ctype(e, span);
            body.push(`  for (size_t i = 0; i < v->len; i++) ${f}(&((${ec}*)v->ptr)[i]);\n`);
          }
          body.push("  fly_vec_free(v);\n");
        } else if (self.lw.p.isKnown(d, "Box")) {
          if (const #Some(#Ty(e)) = args.first() && self.needsDrop(e)) {
            const f = self.dropFn(e, span);
            body.push(`  if (*v) ${f}(*v);\n`);
          }
          body.push("  free(*v);\n  *v = NULL;\n");
        } else {
          if (self.lw.p.hasDrop(d)) {
            const call = self.dropCall(t, span);
            body.push(`  if (v->live) { v->live = false; fly_unwind_state u_ = fly_cleanup_begin(); ${call}; fly_cleanup_end(u_); }\n`);
          }
          match (self.lw.p.defs[d].kind) {
            #Enum { tags: _ } => self.dropTags(mut body, t, span),
            _ => self.dropFields(mut body, t, span),
          }
        }
      }
      #Record(_) | #Tuple(_) => self.dropFields(mut body, t, span),
      #Union(_) => self.dropTags(mut body, t, span),
      #Array(e, l) => {
        if (self.needsDrop(e)) {
          const f = self.dropFn(e, span);
          const n = match (l) { #Known(n) => n, _ => 0 };
          body.push(`  for (size_t i = 0; i < ${n}; i++) ${f}(&v->data[i]);\n`);
        }
      }
      #Fn(_) => body.push("  if (v->drop) v->drop(v->env);\n  *v = (fly_fn){ 0 };\n"),
      _ => {}
    }
    self.dropCode.push(`static void ${name}(${c}* v) {\n${body}}\n`);
    name
  }

  // The drop function of `t` for the runtime, which knows a value only by its address: called
  // through a pointer of a type of its own, as C requires.
  function anyDropFn(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const d = self.dropFn(t, span);
    const name = `${d}_any`;
    if (self.anyDrops.insert(name.clone())) {
      self.protos.push(`static void ${name}(void* v);\n`);
      self.dropCode.push(`static void ${name}(void* v) { ${d}(v); }\n`);
    }
    name
  }

  function dropFields(self: mut Self, body: mut String, t: readonly Ty, span: Span): void uses Fail<Diagnostic> {
    for (const [f, ft] of self.cfields(t)) {
      if (self.needsDrop(ft)) {
        const d = self.dropFn(ft, span);
        body.push(`  ${d}(&v->${f});\n`);
      }
    }
  }

  function dropTags(self: mut Self, body: mut String, t: readonly Ty, span: Span): void uses Fail<Diagnostic> {
    for (const [tag, pt] of self.lw.tagsOf(t)) {
      if (!isVoidTy(pt) && self.needsDrop(pt)) {
        const id = self.tagId(tag.asStr());
        const d = self.dropFn(self.lw.payloadTy(pt), span);
        body.push(`  if (v->tag == ${id}) ${d}(&v->u.${mangle(tag.asStr())});\n`);
      }
    }
    body.push("  v->tag = 0;\n");
  }

  // A call of the type's `Drop.drop` on `*v`.
  function dropCall(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const [c, _] = self.lw.ifaceMethod("Drop", "drop", t, span);
    match (c) {
      #Inst(i) => `${self.lw.insts[i].name}(v)`,
      #Builtin(k) => `fly_${k}(v)`,
      _ => self.fail(span, "a `Drop` of no function"),
    }
  }

  // ---- unions ----

  // The function converting a value of union `from` to union `to`, made once.
  export function conversion(self: mut Self, from: readonly Ty, to: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const key = `${ckey(from)}=>${ckey(to)}`;
    if (const #Some(n) = self.convs.get(key.asStr())) { return n.clone(); }
    const name = `conv${self.convs.len()}`;
    self.convs.insert(key, name.clone());
    const a = self.ctype(from, span);
    const b = self.ctype(to, span);
    let body = String.new();
    // Only the tags both have: a value of a narrowed union cannot have the others.
    const into = self.lw.tagsOf(to);
    for (const [tag, pt] of self.lw.tagsOf(from)) {
      if (!into.iter().some(([k, _]) => k == tag)) { continue; }
      const id = self.tagId(tag.asStr());
      if (isVoidTy(pt)) { body.push(`  if (v.tag == ${id}) return (${b}){ .tag = ${id} };\n`); }
      else {
        const m = mangle(tag.asStr());
        body.push(`  if (v.tag == ${id}) return (${b}){ .tag = ${id}, .u.${m} = v.u.${m} };\n`);
      }
    }
    body.push(`  return (${b}){ 0 };\n`);
    self.protos.push(`static ${b} ${name}(${a} v);\n`);
    self.dropCode.push(`static ${b} ${name}(${a} v) {\n${body}}\n`);
    name
  }

  // An `Option` of type `t`: `#Some(v)`, or `#None`.
  function some(self: mut Self, t: readonly Ty, v: str, span: Span): String uses Fail<Diagnostic> {
    const c = self.ctype(t, span);
    `((${c}){ .tag = ${self.tagId("Some")}, .u.Some = ${v} })`
  }
  function none(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const c = self.ctype(t, span);
    `((${c}){ .tag = ${self.tagId("None")} })`
  }

  // ---- constants ----

  function intLit(self: readonly Self, t: readonly Ty, n0: str): String {
    const neg = n0.startsWith("-");
    const n = if (neg) { n0.slice(1, n0.len()) } else { n0 };
    if (floatTy(t)) { return `${n0}.0`; }
    // The least `i64` has no positive counterpart to negate.
    if (neg && n == "9223372036854775808" && match (intPrim(t)) { #Some(#I64) | #Some(#Isize) => true, _ => false }) { return "INT64_MIN".toString(); }
    // Folded `comptime` arithmetic may leave a literal wider than its type, which the operations
    // around it bring back in range: it is made at 128 bits, as they are.
    const lit = if (n.len() > 19 && !n.startsWith("0x")) { wideLit(n) } else {
      match (intPrim(t)) {
        #Some(#U64) | #Some(#Usize) => `UINT64_C(${n})`,
        #Some(#I64) | #Some(#Isize) => `INT64_C(${n})`,
        #Some(#I128) => if (n.len() > 18 && !n.startsWith("0x")) { wideLit(n) } else { `((fly_i128)${n})` },
        _ => n.toString(),
      }
    };
    if (neg) { `(-${lit})` } else { lit }
  }

  function constant(self: mut Self, c: readonly Constant, span: Span): String uses Fail<Diagnostic> {
    match (c) {
      #Int(n, t) => self.intLit(t, n.asStr()),
      #Float(n, _) => n.clone(),
      #Str(s) => strLit(s.asStr()),
      #Byte(b) => `((uint8_t)${b})`,
      #Bool(b) => if (b) { "true".toString() } else { "false".toString() },
      #Unit => "((fly_unit)0)".toString(),
      #Named(k, _) => self.named(k, span),
      #Zero(t) => if (unitTy(t)) { "((fly_unit)0)".toString() } else {
        const ct = self.ctype(t, span);
        `((${ct}){ 0 })`
      },
    }
  }

  // A module-level constant, made once as a function of no arguments.
  export function named(self: mut Self, c: usize, span: Span): String uses Fail<Diagnostic> {
    if (const #Some(n) = self.consts.get(c)) { return `${n}()`; }
    const name = `const${c}`;
    self.consts.insert(c, name.clone());
    const ty = self.lw.p.consts[c].ty.clone();
    const value = self.lw.constValue(c);
    const v = self.constValue(value, span);
    const ct = self.ctype(ty, span);
    self.protos.push(`static ${ct} ${name}(void);\n`);
    self.dropCode.push(`static ${ct} ${name}(void) { return ${v}; }\n`);
    `${name}()`
  }

  function constValue(self: mut Self, v: readonly ConstValue, span: Span): String uses Fail<Diagnostic> {
    match (v) {
      #Lit(c) => self.constant(c, span),
      #Unary(op, x, _) => {
        const a = self.constValue(x, span);
        `(${op}${a})`
      }
      #Binary(op, x, y, ty) => {
        const a = self.constValue(x, span);
        const b = self.constValue(y, span);
        const c = self.ctype(ty, span);
        `((${c})((${c})${a} ${op} (${c})${b}))`
      }
      #List(items, ty) => {
        const elem: Ty = match (ty) { #Array(x, _) | #Slice(x) => x.get().clone(), _ => #Error };
        match (ty) {
          #Slice(_) => {
            const name = self.constArray(items, elem, span);
            `((fly_slice){ (void*)${name}, ${items.len()} })`
          }
          _ => {
            let vs: Vec<String> = Vec.new();
            for (const it of items) { vs.push(self.constInit(it, elem, span)); }
            const ct = self.ctype(ty, span);
            `((${ct}){ { ${vs.join(", ")} } })`
          }
        }
      }
    }
  }

  // A constant slice's elements: a static array of the program's, named.
  function constArray(self: mut Self, items: readonly Vec<ConstValue>, elem: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const ec = self.ctype(elem, span);
    let vs: Vec<String> = Vec.new();
    for (const it of items) { vs.push(self.constInit(it, elem, span)); }
    const name = `carr${self.helpers.len()}`;
    self.helpers.insert(name.clone(), name.clone());
    self.dropCode.push(`static ${ec} ${name}[] = { ${vs.join(", ")} };\n`);
    name
  }

  // A constant as it initializes an element of a static array: a brace list, not a value.
  function constInit(self: mut Self, v: readonly ConstValue, ty: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    match (v) {
      #Lit(#Str(s)) => `{ (const uint8_t*)${cquote(s.asStr())}, ${s.len()} }`,
      #List(items, #Slice(e)) => {
        const name = self.constArray(items, e, span);
        `{ (void*)${name}, ${items.len()} }`
      }
      _ => self.constValue(v, span),
    }
  }
}

// ---- places, operands, values ----

impl Cgen {
  // The type of a local, or of a capture.
  function rootTy(self: readonly Self, r: readonly Root): Ty {
    match (r) {
      #Local(l) => self.cx.locals[l].ty.clone(),
      #Capture(k) => self.captureTy(k),
    }
  }

  function captureTy(self: readonly Self, k: usize): Ty {
    match (self.cx.capTys.get(k)) { #Some(t) => t.clone(), #None => #Error }
  }

  function placeTy(self: readonly Self, p: readonly Place): Ty {
    match (p.path.last()) { #Some(x) => x.ty.clone(), #None => self.rootTy(p.root) }
  }

  // A local's C lvalue.
  function local(self: readonly Self, l: usize): String {
    match (self.cx.names.get(l)) { #Some(n) => n.clone(), #None => `v${l}_${self.cx.locals[l].name}` }
  }

  function lvalue(self: mut Self, p: readonly Place, span: Span): String uses Fail<Diagnostic> {
    let s = match (p.root) {
      #Local(l) => self.local(l),
      #Capture(k) => match (self.cx.captures.get(k)) { #Some(c) => c.clone(), #None => self.fail(span, "a capture out of reach") },
    };
    let t = self.rootTy(p.root);
    for (const proj of p.path) {
      s = match (proj.kind) {
        #Field(n) => `(${s}).${self.fieldName(t, n.asStr())}`,
        #Payload(tag) => `(${s}).u.${mangle(tag.asStr())}`,
        #Deref => match (t) {
          #Borrow(_, _) => if (self.pointerBorrow(t)) { `(*${s})` } else { s },
          _ => `(*${s})`,
        },
        #Index(i) => {
          const iv = self.operand(i, span);
          const ec = self.ctype(proj.ty, span);
          match (t) {
            #Array(_, #Known(n)) => {
              const at = self.ctype(t, span);
              `(*({ ${at}* a_ = &(${s}); uint64_t i_ = ${iv}; if (i_ >= ${n}) fly_panicf("index %llu out of bounds (length %d)", (unsigned long long)i_, ${n}); &a_->data[i_]; }))`
            }
            #Slice(_) => `(*({ fly_slice s_ = ${s}; uint64_t i_ = ${iv}; (${ec}*)fly_slice_at(s_, i_, sizeof(${ec})); }))`,
            #Prim(#Str) => `(*({ fly_str s_ = ${s}; uint64_t i_ = ${iv}; (uint8_t*)fly_slice_at((fly_slice){ (void*)s_.ptr, s_.len }, i_, 1); }))`,
            _ => `(*({ fly_vec* v_ = &(${s}); uint64_t i_ = ${iv}; (${ec}*)fly_vec_at(v_, i_, sizeof(${ec})); }))`,
          }
        }
      };
      t = proj.ty.clone();
    }
    s
  }

  function operandTy(self: readonly Self, op: readonly Operand): Ty {
    match (op) {
      #Copy(p) | #Move(p) => self.placeTy(p),
      #Const(c) => match (c) {
        #Int(_, t) | #Float(_, t) | #Named(_, t) | #Zero(t) => t.clone(),
        #Str(_) => #Prim(#Str),
        #Byte(_) => #Prim(#U8),
        #Bool(_) => #Prim(#Bool),
        #Unit => #Prim(#Void),
      },
    }
  }

  function operand(self: mut Self, op: readonly Operand, span: Span): String uses Fail<Diagnostic> {
    match (op) {
      #Copy(p) => self.lvalue(p, span),
      #Move(p) => {
        const lv = self.lvalue(p, span);
        const t = self.placeTy(p);
        if (!self.needsDrop(t) || match (t) { #Borrow(_, _) => true, _ => false }) { return lv; }
        const c = self.ctype(t, span);
        `({ ${c}* p_ = &(${lv}); ${c} m_ = *p_; memset(p_, 0, sizeof(${c})); m_; })`
      }
      #Const(c) => self.constant(c, span),
    }
  }

  function checked(self: readonly Self, p: Prim, wide: str): String {
    const [lo, hi] = bounds(p);
    const name = primName(p);
    match (p) {
      #I128 => `((${primType(p)})(${wide}))`,
      _ => `FLY_CHECK(${primType(p)}, ${cquote(name)}, ${lo}, ${hi}, ${wide})`,
    }
  }

  // `x op y` on integers of type `p`, checked for overflow at their own width; `i128`'s, the
  // widest, by the runtime's.
  function native(self: readonly Self, p: Prim, op: str, x: str, y: str): String {
    match (p) {
      #I128 => {
        const f = match (op) { "ADD" => "fly_add128", "SUB" => "fly_sub128", _ => "fly_mul128" };
        `${f}((fly_i128)(${x}), (fly_i128)(${y}))`
      }
      _ => `FLY_${op}(${primType(p)}, ${cquote(primName(p))}, ${x}, ${y})`,
    }
  }

  // An rvalue other than a call, as a C expression of type `ty`.
  function rvalue(self: mut Self, rv: readonly Rvalue, ty: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    match (rv) {
      #Use(op) => self.operand(op, span),
      #Borrow(m, p) => {
        const lv = self.lvalue(p, span);
        const bt: Ty = #Borrow(m, Box.new(self.placeTy(p)));
        if (self.pointerBorrow(bt)) { `(&${lv})` } else { lv }
      }
      #View(p) => {
        const lv = self.lvalue(p, span);
        const t = self.placeTy(p);
        match (t) {
          #Array(_, #Known(n)) => `((fly_slice){ (void*)(${lv}).data, ${n} })`,
          #Slice(_) | #Prim(#Str) => lv,
          _ => if (self.isString(t)) { `fly_String_as_str(&(${lv}))` } else { `fly_vec_slice(&(${lv}))` },
        }
      }
      #Unary(op, v) => {
        const x = self.operand(v, span);
        if (op == "-") {
          match (intPrim(ty)) {
            #Some(p) => self.native(p, "SUB", "0", x.asStr()),
            #None => `(-${x})`,
          }
        } else if (op == "~") {
          const c = self.ctype(ty, span);
          `((${c})~(${x}))`
        } else { `(${op}${x})` }
      }
      #Binary(op, a, b) => {
        const x = self.operand(a, span);
        const y = self.operand(b, span);
        if (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
          return `(${x} ${op} ${y})`;
        }
        match (intPrim(ty)) {
          #Some(p) => match (op) {
            "+" => self.native(p, "ADD", x.asStr(), y.asStr()),
            "-" => self.native(p, "SUB", x.asStr(), y.asStr()),
            "*" => self.native(p, "MUL", x.asStr(), y.asStr()),
            "/" | "%" => {
              const c = primType(p);
              `({ ${c} x_ = ${x}; ${c} y_ = ${y}; if (y_ == 0) fly_div_zero(); (${c})(x_ ${op} y_); })`
            }
            "<<" => self.checked(p, `((fly_i128)(${x}) << (${y}))`),
            _ => `((${primType(p)})((${x}) ${op} (${y})))`,
          },
          #None => if (op == "%") { `fmod(${x}, ${y})` } else { `(${x} ${op} ${y})` },
        }
      }
      #Cast(v, to) => {
        const x = self.operand(v, span);
        const c = self.ctype(to, span);
        `((${c})(${x}))`
      }
      #IsTag(p, tag) => {
        const lv = self.lvalue(p, span);
        `((${lv}).tag == ${self.tagId(tag.asStr())})`
      }
      #Tag(name, vs) => {
        const ct = self.ctype(ty, span);
        const id = self.tagId(name.asStr());
        const live = if (self.liveByte(ty)) { ".live = true, " } else { "" };
        match (vs.first()) {
          #None => `((${ct}){ ${live}.tag = ${id} })`,
          #Some(v) => {
            const x = self.operand(v, span);
            `((${ct}){ ${live}.tag = ${id}, .u.${mangle(name.asStr())} = ${x} })`
          }
        }
      }
      #Fields(fs) => {
        const ct = self.ctype(ty, span);
        let inits: Vec<String> = Vec.new();
        if (self.liveByte(ty)) { inits.push(".live = true".toString()); }
        for (const [k, v] of fs) {
          const x = self.operand(v, span);
          inits.push(`.${self.fieldName(ty, k.asStr())} = ${x}`);
        }
        `((${ct}){ ${inits.join(", ")} })`
      }
      #List(vs) => {
        let xs: Vec<String> = Vec.new();
        for (const v of vs) { xs.push(self.operand(v, span)); }
        match (ty) {
          #Array(_, _) => {
            const ct = self.ctype(ty, span);
            `((${ct}){ { ${xs.join(", ")} } })`
          }
          _ => {
            if (xs.len() == 0) { return "((fly_vec){ 0 })".toString(); }
            const elem = typeArg(ty, 0);
            const ec = self.ctype(elem, span);
            `({ ${ec} a_[] = { ${xs.join(", ")} }; fly_vec_from(a_, ${xs.len()}, sizeof(${ec})); })`
          }
        }
      }
      #Convert(v) => {
        const from = self.operandTy(v);
        const x = self.operand(v, span);
        if (ckey(from) == ckey(ty)) { return x; }
        const f = self.conversion(from, ty, span);
        `${f}(${x})`
      }
      #Closure(k, caps, lent) => self.closure(k, caps, lent, span),
      #FnRef(i) => self.fnValue(i, span),
      #AddressOf(p) => {
        const lv = self.lvalue(p, span);
        const ct = self.ctype(ty, span);
        `((${ct})&(${lv}))`
      }
      #Call(_) => self.fail(span, "a call where a value was expected"),
    }
  }
}

// ---- statements ----

impl Cgen {
  function line(self: mut Self, s: str): void {
    self.cx.out.push(s);
    self.cx.out.push("\n");
  }

  // Where a failure or an unwinding goes from here.
  function target(self: readonly Self): String {
    match (self.cx.targets.last()) { #Some(t) => t.clone(), #None => "fail".toString() }
  }

  // ---- what may hold a value ----

  // A jump to `label` from here, where the owned locals in `live` may hold values.
  function noteJump(self: mut Self, label: String): void {
    let set: HashSet<usize> = match (self.cx.liveAt.get(label.asStr())) { #Some(s) => s.clone(), #None => HashSet.new() };
    for (const l of self.cx.live.iter()) { set.insert(l); }
    self.cx.liveAt.insert(label, set);
  }

  // A failure or an unwinding may leave from here.
  function dynamicExit(self: mut Self): void {
    const t = self.target();
    self.noteJump(t);
  }

  function gen(self: mut Self, l: usize): void {
    if (self.lw.owned(self.cx.locals[l].ty)) { self.cx.live.insert(l); }
  }

  // What reading an operand does to what may hold a value: taking a whole local empties it.
  function flowOperand(self: mut Self, op: readonly Operand): void {
    if (const #Move(p) = op && p.path.len() == 0 && const #Local(l) = p.root) { self.cx.live.remove(l); }
  }

  function flowRvalue(self: mut Self, rv: readonly Rvalue): void {
    match (rv) {
      #Use(op) | #Unary(_, op) | #Cast(op, _) | #Convert(op) => self.flowOperand(op),
      #Binary(_, a, b) => { self.flowOperand(a); self.flowOperand(b); }
      #Tag(_, vs) | #List(vs) => { for (const v of vs) { self.flowOperand(v); } }
      #Fields(fs) => { for (const [_, v] of fs) { self.flowOperand(v); } }
      #Call(c) => self.flowCall(c),
      #Closure(_, caps, _) => { for (const c of caps) { if (const #Value(op) = c) { self.flowOperand(op); } } }
      _ => {}
    }
  }

  function flowCall(self: mut Self, c: readonly Call): void {
    for (const a of c.args) { self.flowOperand(a); }
    if (const #Value(f, _) = c.callee) { self.flowOperand(f); }
  }

  // The locals code in blocks may give a value to: what may hold one after a loop, which may run
  // its body any number of times, or after code left by jumps.
  function assignedIn(self: readonly Self, bs: readonly Vec<Block>): HashSet<usize> {
    let u: Uses = { locals: HashSet.new(), captures: HashSet.new() };
    for (const b of bs) { useBlock(b, mut u); }
    let out: HashSet<usize> = HashSet.new();
    for (const l of u.locals.iter()) { if (self.lw.owned(self.cx.locals[l].ty)) { out.insert(l); } }
    out
  }

  // ---- cleanups ----

  // The C that runs a cleanup; a drop of what holds no value is left out.
  function cleanupCode(self: mut Self, c: readonly Cleanup, live: readonly HashSet<usize>, span: Span): String uses Fail<Diagnostic> {
    match (c) {
      #Drop(l) => {
        if (!live.has(l)) { return String.new(); }
        const t = self.cx.locals[l].ty.clone();
        if (!self.needsDrop(t)) { return String.new(); }
        const d = self.dropFn(t, span);
        `${d}(&${self.local(l)}); `
      }
      #Defer(flag, body) => {
        const call = self.deferCall(flag, body, span);
        const f = self.local(flag);
        `if (${f}) { ${f} = false; fly_unwind_state u_ = fly_cleanup_begin(); ${call} fly_cleanup_end(u_); } `
      }
      #Arena(l) => `fly_arena_free(&${self.local(l)}); `,
    }
  }

  function cleanups(self: mut Self, cs: readonly Vec<Cleanup>, live: readonly HashSet<usize>, span: Span): String uses Fail<Diagnostic> {
    let out = String.new();
    let k = cs.len();
    while (k > 0) {
      k -= 1;
      const c = self.cleanupCode(cs[k], live, span);
      out.push(c.asStr());
    }
    out
  }

  // The cleanups of the blocks a jump to `label` leaves — of every block in this C function, for
  // `#None` — and whether the label is in reach.
  function exitTo(self: mut Self, label: Option<usize>, span: Span): [String, bool] uses Fail<Diagnostic> {
    let out = String.new();
    const live = self.cx.live.clone();
    let i = self.cx.scopes.len();
    while (i > 0) {
      i -= 1;
      const s = self.cx.scopes[i].clone();
      match (s) {
        #Target(l) => { if (label == #Some(l)) { return [out, true]; } }
        #Cleanups(cs) => {
          const c = self.cleanups(cs, live, span);
          out.push(c.asStr());
        }
      }
    }
    [out, false]
  }

  // What code does when what it yields to wants no more: a generator function unwinds; a loop's
  // body within one stops the generator the loop is over, saying why.
  function stop(self: mut Self, span: Span): String uses Fail<Diagnostic> {
    match (self.cx.mode) {
      #Body => {
        const [all, _] = self.exitTo(#None, span);
        `*env->code_ = 4; ${all}ret_ = false; goto ret;`
      }
      _ => {
        self.dynamicExit();
        `fly_stopping = true; goto ${self.target()};`
      }
    }
  }

  // The declarations of a block's locals, each zeroed: what owns memory is dead until given a value.
  function declarations(self: mut Self, b: readonly Block, span: Span): void uses Fail<Diagnostic> {
    for (const l of b.locals) {
      if (self.cx.hoisted.has(l) || self.cx.names.has(l)) { continue; }
      const t = self.cx.locals[l].ty.clone();
      const n = self.local(l);
      match (self.cx.locals[l].kind) {
        #Arena => self.line(`fly_arena ${n} = { 0 };`),
        _ => {
          if (unitTy(t)) { continue; }
          const ct = self.ctype(t, span);
          self.line(`${ct} ${n} = { 0 };`);
        }
      }
    }
  }

  function block(self: mut Self, b: readonly Block, span: Span): void uses Fail<Diagnostic> {
    self.line("{");
    self.declarations(b, span);
    const pro = replace(mut self.cx.prologue, String.new());
    if (pro.len() > 0) { self.line(pro.asStr()); }
    if (b.cleanups.len() == 0) {
      for (const s of b.stmts) { self.stmt(s, span); }
      self.line("}");
      return;
    }
    self.tmp += 1;
    const k = self.tmp;
    const parent = self.target();
    const unw = `unw${k}`;
    self.cx.scopes.push(#Cleanups(b.cleanups.clone()));
    self.cx.targets.push(unw.clone());
    for (const s of b.stmts) { self.stmt(s, span); }
    self.cx.targets.pop();
    self.cx.scopes.pop();
    if (self.cx.reachable) {
      const live = self.cx.live.clone();
      const c = self.cleanups(b.cleanups, live, span);
      self.line(c.asStr());
    }
    // A failure or an unwinding left the block: what may hold a value at any jump here is dropped.
    if (const #Some(at) = self.cx.liveAt.get(unw.asStr())) {
      const at2 = at.clone();
      const c = self.cleanups(b.cleanups, at2, span);
      self.line(`goto end${k};`);
      self.line(`${unw}: ;`);
      self.line(`${c}goto ${parent};`);
      // What is dropped here holds nothing in the code the jump goes on to.
      let rest = at2.clone();
      for (const cl of b.cleanups) { if (const #Drop(l) = cl) { rest.remove(l); } }
      let set: HashSet<usize> = match (self.cx.liveAt.get(parent.asStr())) { #Some(s) => s.clone(), #None => HashSet.new() };
      for (const l of rest.iter()) { set.insert(l); }
      self.cx.liveAt.insert(parent.clone(), set);
      self.line(`end${k}: ;`);
    }
    for (const l of b.locals) { self.cx.live.remove(l); }
    self.line("}");
  }

  function stmt(self: mut Self, s: readonly Stmt, span: Span): void uses Fail<Diagnostic> {
    match (s) {
      #Let(l, rv) => {
        const t = self.cx.locals[l].ty.clone();
        self.flowRvalue(rv);
        self.gen(l);
        const dest: Option<String> = if (unitTy(t)) { #None } else { #Some(self.local(l)) };
        self.assignTo(dest, rv, t, span);
      }
      #Store(p, rv) => {
        const t = self.placeTy(p);
        self.flowRvalue(rv);
        if (p.path.len() == 0 && const #Local(l) = p.root) { self.gen(l); }
        const lv = self.lvalue(p, span);
        self.assignTo(#Some(lv), rv, t, span);
      }
      #Drop(p) => {
        const t = self.placeTy(p);
        const whole: Option<usize> = if (p.path.len() == 0 && const #Local(l) = p.root) { #Some(l) } else { #None };
        const known = match (whole) { #Some(l) => self.cx.live.has(l) || !self.lw.owned(self.cx.locals[l].ty), #None => true };
        if (known && self.needsDrop(t)) {
          const d = self.dropFn(t, span);
          const lv = self.lvalue(p, span);
          self.line(`${d}(&${lv});`);
        }
        if (const #Some(l) = whole) { self.cx.live.remove(l); }
      }
      #If(c, a, b) => {
        const x = self.operand(c, span);
        self.line(`if (${x})`);
        const before = self.cx.live.clone();
        self.block(a, span);
        const liveA = replace(mut self.cx.live, before);
        const reachA = replace(mut self.cx.reachable, true);
        if (b.stmts.len() > 0) {
          self.line("else");
          self.block(b, span);
        }
        const reachB = self.cx.reachable;
        if (reachA && reachB) { for (const l of liveA.iter()) { self.cx.live.insert(l); } }
        else if (reachA) { self.cx.live = liveA; }
        self.cx.reachable = reachA || reachB;
      }
      #Loop(l, body, step) => {
        const assigned = self.assignedIn([body.clone(), step.clone()]);
        for (const x of assigned.iter()) { self.cx.live.insert(x); }
        const head = self.cx.live.clone();
        self.line("for (;;) {");
        self.cx.scopes.push(#Target(l));
        self.block(body, span);
        self.cx.live = head.clone();
        self.cx.reachable = true;
        self.line(`cont${l}: ;`);
        self.block(step, span);
        self.cx.scopes.pop();
        self.line("}");
        self.line(`brk${l}: ;`);
        self.cx.live = head;
        self.cx.reachable = true;
      }
      #Labeled(l, b) => {
        const assigned = self.assignedIn([b.clone()]);
        let after = self.cx.live.clone();
        for (const x of assigned.iter()) { after.insert(x); }
        self.cx.scopes.push(#Target(l));
        self.block(b, span);
        self.cx.scopes.pop();
        self.line(`brk${l}: ;`);
        self.cx.live = after;
        self.cx.reachable = true;
      }
      #Break(l) | #Continue(l) => {
        const brk = match (s) { #Break(_) => true, _ => false };
        const [c, found] = self.exitTo(#Some(l), span);
        if (found) {
          self.line(`${c}goto ${if (brk) { "brk" } else { "cont" }}${l};`);
        } else {
          // In a loop's body over a generator: the next item, or none.
          const [all, _] = self.exitTo(#None, span);
          if (brk) { self.line(`*env->code_ = 1; ${all}ret_ = false; goto ret;`); } else { self.line(`${all}ret_ = true; goto ret;`); }
        }
        self.cx.reachable = false;
      }
      #Return(op) => {
        const v = self.operand(op, span);
        self.flowOperand(op);
        const [all, _] = self.exitTo(#None, span);
        match (self.cx.mode) {
          #Body => {
            const o = self.cx.oret.clone();
            const store = if (unitTy(self.cx.fnRet)) { "" } else { `${o} = ${v}; ` };
            self.line(`${store}*env->code_ = 2; ${all}ret_ = false; goto ret;`);
          }
          _ => {
            const store = if (unitTy(self.cx.ret)) { "" } else { `ret_ = ${v}; ` };
            self.line(`${store}${all}goto ret;`);
          }
        }
        self.cx.reachable = false;
      }
      #Throw(op, t) => {
        const v = self.operand(op, span);
        self.flowOperand(op);
        const ct = self.ctype(t, span);
        const boxed = self.boxErr("e_", t);
        self.dynamicExit();
        self.line(`{ ${ct} e_ = ${v}; ${boxed}goto ${self.target()}; }`);
        self.cx.reachable = false;
      }
      #Panic(m) => {
        self.line(`fly_panic(${cquote(m.asStr())});`);
        self.cx.reachable = false;
      }
      #Block(b) => self.block(b, span),
      #Try(b, err, h) => {
        self.tmp += 1;
        const k = self.tmp;
        const parent = self.target();
        const catchL = `catch${k}`;
        const before = self.cx.live.clone();
        self.cx.targets.push(catchL.clone());
        self.block(b, span);
        self.cx.targets.pop();
        const liveB = self.cx.live.clone();
        const reachB = self.cx.reachable;
        self.line(`goto done${k};`);
        self.line(`${catchL}: ;`);
        // What may hold a value where a failure was caught: what did where it was raised.
        self.cx.live = match (self.cx.liveAt.get(catchL.asStr())) { #Some(x) => x.clone(), #None => before };
        self.cx.reachable = true;
        self.dynamicExit();
        self.line(`if (fly_unwinding || fly_stopping) goto ${parent};`);
        const et = self.cx.locals[err].ty.clone();
        const ec = self.ctype(et, span);
        const e = self.local(err);
        const take = self.takeErr(e.asStr(), et);
        self.cx.prologue = `memset(&${e}, 0, sizeof(${ec})); ${take}`;
        self.gen(err);
        self.block(h, span);
        self.line(`done${k}: ;`);
        if (reachB) { for (const l of liveB.iter()) { self.cx.live.insert(l); } }
        self.cx.reachable = self.cx.reachable || reachB;
      }
      #Arm(flag) => self.line(`${self.local(flag)} = true;`),
      #Yield(op, t) => {
        const y = match (self.cx.sink) { #Some(y) => y.clone(), #None => return self.fail(span, "`yield` outside a generator") };
        const tc = self.ctype(t, span);
        const v = self.operand(op, span);
        self.flowOperand(op);
        const stop = self.stop(span);
        self.line(`{ ${tc} y__ = ${v}; if (!(${y}).fn((${y}).env, &y__)) { ${stop} } }`);
      }
      #ForGen(l, c, item, body) => {
        self.flowCall(c);
        self.forGen(l, c, item, body, span);
      }
      #Region(sym, arena, b) => {
        self.cx.arenas.insert(sym, `(&${self.local(arena)})`);
        self.block(b, span);
        self.cx.arenas.remove(sym);
      }
      #Perform(d, op, args, r) => {
        for (const a of args) { self.flowOperand(a); }
        self.gen(r);
        self.perform(d, op, args, r, span);
      }
      #Handle(h) => {
        self.gen(h.result);
        self.handle(h);
      }
      #Resume(k, arg, r) => {
        self.flowOperand(k);
        if (const #Some(a) = arg) { self.flowOperand(a); }
        self.gen(r);
        if (self.cx.direct) {
          // The arm's last act: the operation gives the argument, and the body goes on.
          if (const #Some(a) = arg) {
            const at = self.operandTy(a);
            if (!unitTy(at)) {
              const ac = self.ctype(at, span);
              const v = self.operand(a, span);
              self.line(`*(${ac}*)result_ = ${v};`);
            }
          }
        } else { self.resume(k, arg, r, span); }
      }
      #At(_) => {}
    }
  }

  // Statements putting the value of `rv`, a `t`, in `dest`, or evaluating it if there is none.
  function assignTo(self: mut Self, dest: Option<String>, rv: readonly Rvalue, t: readonly Ty, span: Span): void uses Fail<Diagnostic> {
    if (const #Call(c) = rv) {
      self.call(dest, c);
      return;
    }
    match (dest) {
      #Some(d) => {
        const v = self.rvalue(rv, t, span);
        self.line(`${d} = ${v};`);
      }
      // A value of nothing is made only for what making it does.
      #None => {
        if (const #Use(#Move(_)) = rv) {
          const v = self.rvalue(rv, t, span);
          self.line(`${v};`);
        }
      }
    }
  }

  // Whether values of the type are tagged: a union, or an enum.
  export function tagged(self: readonly Self, t: readonly Ty): bool { self.lw.tagged(t) }

  // Statements raising the failure `v`, a `t`: boxed by its tag, so a `catch` of a wider or a
  // narrower union of tags takes it out as its own.
  function boxErr(self: readonly Self, v: str, t: readonly Ty): String {
    if (self.tagged(t)) { `fly_err_box(${v}.tag, &${v}.u, sizeof(${v}.u)); ` } else { `fly_err_box(0, &${v}, sizeof(${v})); ` }
  }

  // Statements taking the failure raised into `lv`, a `t`.
  function takeErr(self: readonly Self, lv: str, t: readonly Ty): String {
    if (self.tagged(t)) { `${lv}.tag = fly_err_tag(); fly_err_take(&${lv}.u, sizeof(${lv}.u)); ` } else { `fly_err_take(&${lv}, sizeof(${lv})); ` }
  }
}


// ---- calls ----

impl Cgen {
  // A call: its value put in `dest`, if there is one; then where a failure, an unwinding, or a
  // stop it reports goes.
  function call(self: mut Self, dest: Option<String>, c: readonly Call): void uses Fail<Diagnostic> {
    const span = c.span;
    let vs: Vec<String> = Vec.new();
    for (const a of c.args) { vs.push(self.operand(a, span)); }
    let arenas: Vec<String> = Vec.new();
    for (const r of c.regions) {
      match (self.cx.arenas.get(r)) {
        #Some(a) => arenas.push(a.clone()),
        #None => self.fail(span, "a region's arena is out of reach here"),
      }
    }
    if (c.yields) {
      match (self.cx.sink) {
        #Some(y) => arenas.push(y.clone()),
        #None => self.fail(span, "a generator is called by `for`, or by a generator"),
      }
    }
    const expr = match (c.callee) {
      #Inst(i) => {
        let all = vs.clone();
        for (const a of arenas) { all.push(a.clone()); }
        `${self.lw.insts[i].name}(${all.join(", ")})`
      }
      #Builtin(k) => self.builtin(k.asStr(), c, vs, arenas),
      #Value(f, isOnce) => {
        const fv = self.operand(f, span);
        const rt = self.ctype(c.ret, span);
        let ptypes: Vec<String> = ["void*".toString()];
        for (const p of c.params) { ptypes.push(self.ctype(p, span)); }
        let all: Vec<String> = ["f_.env".toString()];
        for (const v of vs) { all.push(v.clone()); }
        if (c.yields) {
          ptypes.push("fly_yield".toString());
          all.push(arenas[arenas.len() - 1].clone());
        }
        const callExpr = `((${rt} (*)(${ptypes.join(", ")}))f_.fn)(${all.join(", ")})`;
        // Calling a `once` closure consumes it: it is dropped once called.
        if (isOnce) { `({ fly_fn f_ = ${fv}; ${rt} c_ = ${callExpr}; if (f_.drop) f_.drop(f_.env); c_; })` } else { `({ fly_fn f_ = ${fv}; ${callExpr}; })` }
      }
    };
    match (dest) {
      #Some(d) => self.line(`${d} = ${expr};`),
      #None => self.line(`${expr};`),
    }
    if (c.yields) {
      const stop = self.stop(span);
      self.line(`if (fly_stopping) { ${stop} }`);
    }
    if (c.suspends || c.fails) { self.dynamicExit(); }
    if (c.suspends) { self.line(`if (fly_unwinding) goto ${self.target()};`); }
    if (c.fails) { self.line(`if (FLY_FAILED) goto ${self.target()};`); }
  }

  // A call of interface `iface`'s `method` for `selfTy`, each argument given as a pointer to it.
  export function ifaceCall(self: mut Self, iface: str, method: str, selfTy: readonly Ty, args: readonly Vec<String>, span: Span): String uses Fail<Diagnostic> {
    const [c, ptys] = self.lw.ifaceMethod(iface, method, selfTy, span);
    const fname = match (c) {
      #Inst(i) => self.lw.insts[i].name.clone(),
      #Builtin(k) => `fly_${k}`,
      _ => self.fail(span, "an interface method of no function"),
    };
    let vs: Vec<String> = Vec.new();
    for (const [i, a] of args.iter().enumerate()) {
      vs.push(if (i < ptys.len() && !self.pointerBorrow(ptys[i])) { `(*${a})` } else { a.clone() });
    }
    `${fname}(${vs.join(", ")})`
  }

  // A pointer to what `ptr`, a pointer to a `k`, lends as a `q`, and the statements that make it.
  function lentPtr(self: mut Self, ptr: String, k: Ty, q: readonly Ty, stmts: mut String, span: Span): String uses Fail<Diagnostic> {
    if (ckey(k) == ckey(q)) { return ptr; }
    if (self.isString(k) && match (q) { #Prim(#Str) => true, _ => false }) {
      const n = self.fresh();
      stmts.push(`fly_str ${n} = fly_String_as_str(${ptr}); `);
      return `&${n}`;
    }
    if (self.namedIs(k, "Vec") && match (q) { #Slice(_) => true, _ => false }) {
      const n = self.fresh();
      stmts.push(`fly_slice ${n} = fly_vec_slice(${ptr}); `);
      return `&${n}`;
    }
    if (self.lw.boxLike(k)) {
      const inner: Ty = match (k) { #Named(_, args) => match (args.last()) { #Some(#Ty(t)) => t.clone(), _ => #Error }, _ => #Error };
      return self.lentPtr(`(*${ptr})`, inner, q, mut stmts, span);
    }
    self.fail(span, `a \`${self.lw.p.show(k)}\` does not lend a \`${self.lw.p.show(q)}\``)
  }

  // The hash of a `q`, given a pointer to it, as `Hash` makes it.
  function hashFn(self: mut Self, q: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const key = `hash:${ckey(q)}`;
    if (const #Some(n) = self.helpers.get(key.asStr())) { return n.clone(); }
    const name = `hash${self.helpers.len()}`;
    self.helpers.insert(key, name.clone());
    const qc = self.ctype(q, span);
    self.protos.push(`static uint64_t ${name}(const void* k);\n`);
    const call = self.ifaceCall("Hash", "hash", q, [`((${qc}*)k)`, "(&h)".toString()], span);
    self.dropCode.push(`static uint64_t ${name}(const void* k) { fly_Hasher h = fly_Hasher_new(); ${call}; return h.h; }\n`);
    name
  }

  // Whether a map entry's key, a `k`, equals a `q`, given pointers to both, as the `q`'s `Eq` says.
  function keyEqFn(self: mut Self, k: readonly Ty, q: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const key = `eq:${ckey(k)}:${ckey(q)}`;
    if (const #Some(n) = self.helpers.get(key.asStr())) { return n.clone(); }
    const name = `keq${self.helpers.len()}`;
    self.helpers.insert(key, name.clone());
    const kc = self.ctype(k, span);
    const qc = self.ctype(q, span);
    let stmts = String.new();
    const kp = self.lentPtr(`((${kc}*)e)`, k.clone(), q, mut stmts, span);
    const call = self.ifaceCall("Eq", "eq", q, [kp, `((${qc}*)p)`], span);
    self.protos.push(`static bool ${name}(const void* e, const void* p);\n`);
    self.dropCode.push(`static bool ${name}(const void* e, const void* p) { ${stmts}return ${call}; }\n`);
    name
  }

  // A borrow of a `t` at address `p`, as C holds it: a pointer, or the value of a scalar.
  function borrowAt(self: mut Self, p: str, t: readonly Ty, m: bool, span: Span): String uses Fail<Diagnostic> {
    const c = self.ctype(t, span);
    const b: Ty = #Borrow(m, Box.new(t.clone()));
    if (self.pointerBorrow(b)) { `((${c}*)(${p}))` } else { `(*(${c}*)(${p}))` }
  }

  // A generator over `len` places `stride` bytes apart from `base`, each giving `item`: C in
  // terms of `p`, a `uint8_t*` to the place. `drop` drops what is left.
  function stridedGen(self: mut Self, itemTy: readonly Ty, base: str, len: str, stride: str, item: str, drop: str, span: Span): String uses Fail<Diagnostic> {
    const ic = self.ctype(itemTy, span);
    const key = `iter:${ic}:${item}`;
    const name = match (self.helpers.get(key.asStr())) {
      #Some(n) => n.clone(),
      #None => {
        const n = `gnext${self.helpers.len()}`;
        self.helpers.insert(key, n.clone());
        self.protos.push(`static bool ${n}(void* s_, void* o_);\n`);
        self.dropCode.push(`static bool ${n}(void* s_, void* o_) { fly_iter* s = s_; if (s->i >= s->len) return false; uint8_t* p = s->base + s->i++ * s->stride; *(${ic}*)o_ = ${item}; return true; }\n`);
        n
      }
    };
    `((fly_gen){ fly_iter_new((void*)(${base}), ${len}, ${stride}), ${name}, ${drop} })`
  }

  // An adapter's step, made once for each `key`: `body` is C in terms of `s`, its state.
  function step(self: mut Self, key: String, state: str, body: str): String {
    if (const #Some(n) = self.helpers.get(key.asStr())) { return n.clone(); }
    const n = `gstep${self.helpers.len()}`;
    self.helpers.insert(key, n.clone());
    self.protos.push(`static bool ${n}(void* s_, void* o_);\n`);
    self.dropCode.push(`static bool ${n}(void* s_, void* o_) { ${state}* s = s_; ${body} }\n`);
    n
  }

  // Statements finding a map's entry for the key at `probe`, a `q`: its index `i_`, or `SIZE_MAX`.
  function mapFind(self: mut Self, k: readonly Ty, q: readonly Ty, probe: str, ec: str, span: Span): String uses Fail<Diagnostic> {
    const h = self.hashFn(q, span);
    const eq = self.keyEqFn(k, q, span);
    `void* q_ = (void*)${probe}; size_t i_ = fly_map_find(m_, ${h}(q_), q_, ${eq}, sizeof(${ec})); `
  }

  // A statement raising `#OutOfMemory`.
  function outOfMemory(self: mut Self): String { `{ fly_err_box(${self.tagId("OutOfMemory")}, NULL, 0); } ` }

  // Statements raising the `IoErr` whose code, a runtime `FLY_IO_…`, is the C expression `code`.
  function ioRaise(self: mut Self, code: str): String {
    const names = ["Reset", "TimedOut", "BrokenPipe", "NotFound", "PermissionDenied", "AddrInUse", "Refused"];
    let pick = String.new();
    for (const [i, n] of names.iter().enumerate()) { pick.push(`(${code}) == ${i + 1} ? ${self.tagId(n)} : `); }
    pick.push(`${self.tagId("Reset")}`);
    `fly_err_box(${pick}, NULL, 0); `
  }

  // Statements raising the `IoErr` with tag `name`, which has no payload.
  function ioErr(self: mut Self, name: str): String {
    `fly_err_box(${self.tagId(name)}, NULL, 0); `
  }

  // A call of the runtime's, as a C expression. A routine that fails sets the failure and gives a
  // value of nothing, which the check after the call leaves.
  export function builtin(self: mut Self, key: str, c: readonly Call, vs: Vec<String>, arenas: Vec<String>): String uses Fail<Diagnostic> {
    const span = c.span;
    const rt = c.ret.clone();
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    // What the runtime does by element type, made here.
    const recv: Ty = match (c.argTys.first()) { #Some(t) => stripBorrow(t), #None => #Error };
    const elem: Ty = match (recv) {
      #Named(_, args) => match (args.first()) { #Some(#Ty(x)) => x.clone(), _ => #Error },
      #Slice(x) => x.get().clone(),
      #Array(x, _) => x.get().clone(),
      _ => #Error,
    };
    if (key.startsWith("perform:Io:")) { return self.ioOp(key.slice(11, key.len()), c, vs.clone()); }
    // Whether a handler of the program's own handles `Io` around here.
    if (key == "Io_handled") {
      return match (self.lw.p.knownDef("Io")) { #Some(d) => `fly_handled(${d})`, #None => "false".toString() };
    }
    if (key.startsWith("extern:")) { return self.foreignCall(key.slice(7, key.len()), c, vs.clone()); }
    if (const #Some(r) = self.memory(key, c, vs.clone())) { return r; }
    match (key) {
      "println" => `({ fly_println(${arg(0)}); (fly_unit)0; })`,
      "eprintln" => `({ fly_eprintln(${arg(0)}); (fly_unit)0; })`,
      "exit" => `({ fly_exit(${arg(0)}); (fly_unit)0; })`,
      "panic" => `({ fly_str m_ = ${arg(0)}; fly_panicf("%.*s", (int)m_.len, (const char*)m_.ptr); (fly_unit)0; })`,
      "String_new" => "fly_String_new()".toString(),
      "String_push" => `({ fly_String_push(${arg(0)}, ${arg(1)}); (fly_unit)0; })`,
      "String_pushShown" => {
        const p: Prim = match (c.argTys.get(1)) { #Some(#Prim(p)) => p, _ => #I64 };
        const v = arg(1);
        match (p) {
          #Str => `({ fly_String_push(${arg(0)}, ${v}); (fly_unit)0; })`,
          _ => {
            const shown = match (p) {
              #Bool => `fly_show_bool(${v})`,
              #F32 | #F64 => `fly_show_f64(${v})`,
              #U64 | #Usize => `fly_show_u128(${v})`,
              _ => `fly_show_i128(${v})`,
            };
            `({ fly_String n_ = ${shown}; fly_String_push(${arg(0)}, fly_String_as_str(&n_)); fly_String_drop(&n_); (fly_unit)0; })`
          }
        }
      }
      "String_asStr" => `fly_String_as_str(${arg(0)})`,
      "String_len" => `((uint64_t)(${arg(0)})->len)`,
      "String_clone" => `fly_String_clone(${arg(0)})`,
      "str_len" => `((uint64_t)(${arg(0)}).len)`,
      "str_toString" => `fly_String_from(${arg(0)})`,
      "str_slice" => `fly_str_slice(${arg(0)}, ${arg(1)}, ${arg(2)})`,
      "str_eq" => `fly_str_eq(${arg(0)}, ${arg(1)})`,
      "str_cmp" => `((int32_t)fly_str_cmp(${arg(0)}, ${arg(1)}))`,
      "str_nextLine" | "str_nextWord" => {
        const next = if (key == "str_nextWord") { "fly_str_next_word" } else { "fly_str_next_line" };
        const yes = self.some(rt, "x_", span);
        const no = self.none(rt, span);
        const at = self.placeArg(c, 0);
        `({ fly_str x_; ${next}(&${at}, &x_) ? ${yes} : ${no}; })`
      }
      "slice_range" => {
        const ec = self.ctype(match (rt) { #Slice(x) => x.get().clone(), _ => #Error }, span);
        `fly_slice_range(${arg(0)}, ${arg(1)}, ${arg(2)}, sizeof(${ec}))`
      }
      "File_text" => `fly_String_as_str(&(${arg(0)})->text)`,
      "Listener_next" => {
        const yes = self.some(rt, "x_", span);
        const no = self.none(rt, span);
        `({ fly_socket x_; fly_accept(${arg(0)}, &x_) ? ${yes} : ${no}; })`
      }
      "RegionList_at" => {
        const ec = self.ctype(stripBorrow(rt), span);
        self.borrowAt(`fly_rlist_at(${arg(0)}, ${arg(1)})`.asStr(), stripBorrow(rt), false, span)
      }
      "Vec_new" => "((fly_vec){ 0 })".toString(),
      "Vec_len" => `((uint64_t)(${arg(0)})->len)`,
      "slice_len" => `((uint64_t)(${arg(0)}).len)`,
      "Vec_push" => {
        const ec = self.ctype(elem, span);
        `({ ${ec} x_ = ${arg(1)}; fly_vec_push(${arg(0)}, &x_, sizeof(${ec})); (fly_unit)0; })`
      }
      "Vec_pop" => {
        const ec = self.ctype(elem, span);
        const oc = self.ctype(rt, span);
        const some = self.tagId("Some");
        const none = self.tagId("None");
        `({ ${ec} x_; fly_vec_pop(${arg(0)}, &x_, sizeof(${ec})) ? (${oc}){ .tag = ${some}, .u.Some = x_ } : (${oc}){ .tag = ${none} }; })`
      }
      "Vec_truncate" => {
        if (self.needsDrop(elem)) {
          const ec = self.ctype(elem, span);
          const d = self.dropFn(elem, span);
          `({ fly_vec* v_ = ${arg(0)}; uint64_t n_ = ${arg(1)}; while (v_->len > n_) { v_->len--; ${d}(&((${ec}*)v_->ptr)[v_->len]); } (fly_unit)0; })`
        } else { `({ fly_vec_truncate_raw(${arg(0)}, ${arg(1)}); (fly_unit)0; })` }
      }
      "Box_new" => {
        const ec = self.ctype(stripBorrow(c.argTys[0]), span);
        `({ ${ec} x_ = ${arg(0)}; (${ec}*)fly_box(&x_, sizeof(${ec})); })`
      }
      // A box lends what it holds: the box itself where the borrow is a pointer, else its value.
      "Box_get" => if (self.pointerBorrow(rt)) { arg(0) } else { `(*${arg(0)})` },
      "Box_tryNew" => {
        const t = stripBorrow(c.argTys[0]);
        const ec = self.ctype(t, span);
        const d = if (self.needsDrop(t)) { `${self.dropFn(t, span)}(&x_); ` } else { "" };
        `({ ${ec} x_ = ${arg(0)}; ${ec}* p_ = malloc(sizeof(${ec})); if (p_) *p_ = x_; else { ${d}${self.outOfMemory()}} p_; })`
      }
      "String_tryReserve" => `({ if (!fly_String_try_reserve(${arg(0)}, ${arg(1)})) ${self.outOfMemory()}(fly_unit)0; })`,
      "Vec_tryReserve" => {
        const ec = self.ctype(elem, span);
        `({ if (!fly_vec_try_reserve(${arg(0)}, ${arg(1)}, sizeof(${ec}))) ${self.outOfMemory()}(fly_unit)0; })`
      }
      "HashMap_tryReserve" => {
        const ec = self.ctype(entryTy(recv), span);
        `({ if (!fly_map_try_reserve(${arg(0)}, ${arg(1)}, sizeof(${ec}))) ${self.outOfMemory()}(fly_unit)0; })`
      }
      _ => {
        if (const #Some(r) = self.regionLib(key, c, vs.clone(), arenas)) { return r; }
        match (self.library(key, c, vs.clone())) {
          #Some(r) => r,
          #None => self.unsupported(span, `the library function \`${key}\``),
        }
      }
    }
  }

  // A call of a function of C's, by its symbol: declared once, under a name of the program's, so
  // a C header that declares it otherwise does not conflict.
  function foreignCall(self: mut Self, name: str, c: readonly Call, vs: Vec<String>): String uses Fail<Diagnostic> {
    const key = `extern:${name}`;
    if (!self.helpers.has(key.asStr())) {
      self.helpers.insert(key.clone(), name.toString());
      let ps: Vec<String> = Vec.new();
      for (const p of c.params) { ps.push(self.ctype(p, c.span)); }
      const rt = if (isVoidTy(c.ret)) { "void".toString() } else { self.ctype(c.ret, c.span) };
      self.protos.push(`extern ${rt} fly_c_${name}(${if (ps.len() == 0) { "void".toString() } else { ps.join(", ") }}) FLY_SYMBOL(${name});\n`);
    }
    const call = `fly_c_${name}(${vs.join(", ")})`;
    if (isVoidTy(c.ret)) { `({ ${call}; (fly_unit)0; })` } else { call }
  }

  // Raw memory: pointers, atomics, fences, sizes (§8.2).
  function memory(self: mut Self, key: str, c: readonly Call, vs: Vec<String>): Option<String> uses Fail<Diagnostic> {
    const span = c.span;
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    const rc = self.ctype(c.ret, span);
    const targ = (k: usize) => match (c.targs.get(k)) { #Some(t) => t.clone(), #None => #Error };
    #Some(match (key) {
      "Ptr_at" => `((${rc})(uintptr_t)(${arg(0)}))`,
      "Ptr_address" => `((uint64_t)(uintptr_t)(${arg(0)}))`,
      "Ptr_add" => `(${arg(0)} + ${arg(1)})`,
      "Ptr_cast" => `((${rc})(${arg(0)}))`,
      "Ptr_read" => `(*(${arg(0)}))`,
      "Ptr_write" => `({ *(${arg(0)}) = ${arg(1)}; (fly_unit)0; })`,
      "Ptr_readVolatile" => `(*(volatile __typeof__(*(${arg(0)}))*)(${arg(0)}))`,
      "Ptr_writeVolatile" => `({ *(volatile __typeof__(*(${arg(0)}))*)(${arg(0)}) = ${arg(1)}; (fly_unit)0; })`,
      "Ptr_loadAcquire" => `__atomic_load_n(${arg(0)}, __ATOMIC_ACQUIRE)`,
      "Ptr_storeRelease" => `({ __atomic_store_n(${arg(0)}, ${arg(1)}, __ATOMIC_RELEASE); (fly_unit)0; })`,
      "Ptr_fetchAdd" => `__atomic_fetch_add(${arg(0)}, ${arg(1)}, __ATOMIC_SEQ_CST)`,
      "Ptr_compareExchange" => `({ __typeof__(*(${arg(0)})) e_ = ${arg(1)}; bool ok_ = __atomic_compare_exchange_n(${arg(0)}, &e_, ${arg(2)}, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); (${rc}){ .f0 = e_, .f1 = ok_ }; })`,
      "sizeOf" => {
        const t = targ(0);
        if (unitTy(t)) { "((uint64_t)0)".toString() } else { `((uint64_t)sizeof(${self.ctype(t, span)}))` }
      }
      "alignOf" => {
        const t = targ(0);
        if (unitTy(t)) { "((uint64_t)1)".toString() } else { `((uint64_t)_Alignof(${self.ctype(t, span)}))` }
      }
      "zeroed" => if (unitTy(c.ret)) { "((fly_unit)0)".toString() } else { `((${rc}){ 0 })` },
      "fence" => "({ __atomic_thread_fence(__ATOMIC_SEQ_CST); (fly_unit)0; })".toString(),
      "fenceAcquire" => "({ __atomic_thread_fence(__ATOMIC_ACQUIRE); (fly_unit)0; })".toString(),
      "fenceRelease" => "({ __atomic_thread_fence(__ATOMIC_RELEASE); (fly_unit)0; })".toString(),
      _ => return #None,
    })
  }

  // The lvalue of a place an argument reads, for a routine that changes it.
  function placeArg(self: mut Self, c: readonly Call, i: usize): String uses Fail<Diagnostic> {
    if (i < self.argPlaces.len()) { return self.argPlaces[i].clone(); }
    match (c.args.get(i)) {
      #Some(#Copy(p)) | #Some(#Move(p)) => self.lvalue(p, c.span),
      _ => self.fail(c.span, "a routine changes what is not a place"),
    }
  }

  // `Io`'s operations: the runtime's, against the simulated world. Each is a scheduling point.
  function ioOp(self: mut Self, op: str, c: readonly Call, vs: Vec<String>): String uses Fail<Diagnostic> {
    const rc = self.ctype(c.ret, c.span);
    match (op) {
      "now" => `({ fly_point(); (${rc}){ .nanos = fly_now() }; })`,
      // Sleeping waits for the virtual clock, which is its scheduling point.
      "sleep" => `({ __auto_type d_ = ${vs[0]}; fly_sleep(d_.nanos); (fly_unit)0; })`,
      "park" => "((fly_unit)0)".toString(),
      "write" => {
        const ok = self.tagId("Ok");
        `({ fly_slice b_ = ${vs[1]}; fly_point(); fwrite(b_.ptr, 1, b_.len, stdout); (${rc}){ .tag = ${ok}, .u.Ok = b_.len }; })`
      }
      _ => {
        const ok = self.tagId("Ok");
        `({ fly_point(); (${rc}){ .tag = ${ok}, .u.Ok = 0 }; })`
      }
    }
  }

  // A call of the library's regions: what places a value in one is given its arena.
  function regionLib(self: mut Self, key: str, c: readonly Call, vs: Vec<String>, arenas: Vec<String>): Option<String> uses Fail<Diagnostic> {
    if (key != "alloc" && key != "fmt" && key != "allocAll" && key != "copyUtf8" && !key.startsWith("Cell_") && !key.startsWith("RegionList_") && !key.startsWith("Ref_")) { return #None; }
    const span = c.span;
    const rt = c.ret.clone();
    const ptys = c.params.clone();
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    const ar = match (arenas.first()) { #Some(a) => a.clone(), #None => "NULL".toString() };
    const held = typeArg(rt, 1);
    #Some(match (key) {
      "alloc" | "Cell_new" => {
        const tc = self.ctype(held, span);
        `({ ${tc} v_ = ${arg(0)}; ${tc}* p_ = fly_arena_alloc(${ar}, sizeof(${tc})); *p_ = v_; p_; })`
      }
      "fmt" => `fly_arena_str(${ar}, ${arg(0)})`,
      "allocAll" => {
        const ec = self.ctype(match (held) { #Slice(x) => x.get().clone(), _ => #Error }, span);
        `fly_arena_slice(${ar}, ${arg(0)}, sizeof(${ec}))`
      }
      "copyUtf8" => {
        const id = self.tagId("MalformedUtf8");
        `({ fly_slice b_ = ${arg(0)}; fly_str* r_ = NULL; if (!fly_utf8_valid(b_)) fly_err_box(${id}, NULL, 0); else r_ = fly_arena_str(${ar}, (fly_str){ (const uint8_t*)b_.ptr, b_.len }); r_; })`
      }
      "Cell_get" => `(*${arg(0)})`,
      "Cell_set" => `({ __auto_type c_ = ${arg(0)}; *c_ = ${arg(1)}; (fly_unit)0; })`,
      "Cell_clone" | "RegionList_clone" | "Ref_clone" => arg(0),
      "RegionList_new" => {
        const tc = self.ctype(held, span);
        `fly_rlist_new(${ar}, sizeof(${tc}))`
      }
      "RegionList_push" => {
        const tc = self.ctype(typeArg(stripBorrow(ptys[0]), 1), span);
        `({ fly_rlist* l_ = ${arg(0)}; ${tc} v_ = ${arg(1)}; fly_rlist_push(l_, &v_); (fly_unit)0; })`
      }
      "RegionList_len" => `((uint64_t)(${arg(0)})->len)`,
      // A `Ref` lends what it points at.
      "Ref_get" => if (self.pointerBorrow(rt)) { arg(0) } else { `(*${arg(0)})` },
      _ => return #None,
    })
  }
  // What runs one half of a `join` giving a `t`: it calls the closure, puts its result where it is
  // told, and drops the closure, which is `once`.
  function halfRunner(self: mut Self, t: readonly Ty, span: Span): String uses Fail<Diagnostic> {
    const tc = self.ctype(t, span);
    const key = `half:${tc}`;
    if (const #Some(n) = self.helpers.get(key.asStr())) { return n.clone(); }
    const n = `half${self.helpers.len()}`;
    self.helpers.insert(key, n.clone());
    self.protos.push(`static void ${n}(void* f, void* out);\n`);
    self.dropCode.push(`static void ${n}(void* f, void* out) { fly_fn* fn = f; ${tc} v = ((${tc} (*)(void*))fn->fn)(fn->env); *(${tc}*)out = v; if (fn->drop) fn->drop(fn->env); }\n`);
    n
  }

  // A call of the prelude's functions on strings, lists, options and failures.
  function prelude(self: mut Self, key: str, c: readonly Call, vs: readonly Vec<String>): Option<String> uses Fail<Diagnostic> {
    const ptys = c.params.clone();
    const span = c.span;
    const rt = c.ret.clone();
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    const recv: Ty = match (c.argTys.first()) { #Some(t) => stripBorrow(t), #None => #Error };
    const elem: Ty = match (recv) { #Slice(x) | #Array(x, _) => x.get().clone(), _ => typeArg(recv, 0) };
    const ec = if (match (elem) { #Error => false, _ => true }) { self.ctype(elem, span) } else { "fly_unit".toString() };
    // Float arithmetic, as <math.h> has it: what a processor does in one instruction by the
    // compiler's builtins, which need no library.
    if (key.startsWith("f64_") || key.startsWith("f32_")) {
      const f = if (key.startsWith("f32_")) { "f" } else { "" };
      const op = key.slice(4, key.len());
      return #Some(match (op) {
        "sqrt" => `__builtin_sqrt${f}(${arg(0)})`,
        "abs" => `__builtin_fabs${f}(${arg(0)})`,
        "floor" => `__builtin_floor${f}(${arg(0)})`,
        "ceil" => `__builtin_ceil${f}(${arg(0)})`,
        "round" => `__builtin_round${f}(${arg(0)})`,
        "trunc" => `__builtin_trunc${f}(${arg(0)})`,
        "min" => `__builtin_fmin${f}(${arg(0)}, ${arg(1)})`,
        "max" => `__builtin_fmax${f}(${arg(0)}, ${arg(1)})`,
        "ln" => `log${f}(${arg(0)})`,
        "atan2" | "pow" => `${op}${f}(${arg(0)}, ${arg(1)})`,
        "toFixed" => `fly_float_fixed((double)(${arg(0)}), ${arg(1)})`,
        _ => `${op}${f}(${arg(0)})`,
      });
    }
    // Wrapping arithmetic, on the unsigned type of the same width.
    if (key.endsWith("_wrappingAdd") || key.endsWith("_wrappingSub") || key.endsWith("_wrappingMul")) {
      const p = match (intPrim(rt)) { #Some(p) => p, #None => return #None };
      const c = primType(p);
      const u = match (p) {
        #I8 | #U8 => "uint8_t", #I16 | #U16 => "uint16_t", #I32 | #U32 => "uint32_t", #I128 => "unsigned __int128", _ => "uint64_t",
      };
      const op = if (key.endsWith("Add")) { "+" } else if (key.endsWith("Sub")) { "-" } else { "*" };
      return #Some(`((${c})(${u})((${u})(${arg(0)}) ${op} (${u})(${arg(1)})))`);
    }
    #Some(match (key) {
      "str_asBytes" => `({ fly_str s_ = ${arg(0)}; (fly_slice){ (void*)s_.ptr, s_.len }; })`,
      "str_includes" => `({ uint64_t i_; fly_str_find(${arg(0)}, ${arg(1)}, &i_); })`,
      "str_startsWith" => `fly_str_starts(${arg(0)}, ${arg(1)})`,
      "str_endsWith" => `fly_str_ends(${arg(0)}, ${arg(1)})`,
      "str_trim" => `fly_str_trim(${arg(0)})`,
      "str_toUpperCase" => `fly_str_case(${arg(0)}, true)`,
      "str_toLowerCase" => `fly_str_case(${arg(0)}, false)`,
      "str_replaceAll" => `fly_str_replace_all(${arg(0)}, ${arg(1)}, ${arg(2)})`,
      "str_split" => `fly_str_split(${arg(0)}, ${arg(1)})`,
      "str_indexOf" => {
        const yes = self.some(rt, "i_", span);
        const no = self.none(rt, span);
        `({ uint64_t i_; fly_str_find(${arg(0)}, ${arg(1)}, &i_) ? ${yes} : ${no}; })`
      }
      "String_fromUtf8" => {
        // The bytes become the string's: a `Vec<u8>` and a `String` are laid out alike.
        const yes = self.some(rt, "(fly_String){ (uint8_t*)b_.ptr, b_.len, b_.cap }", span);
        `({ fly_vec b_ = ${arg(0)}; ${yes}; })`
      }
      "parseInt" => {
        const yes = self.some(rt, "v_", span);
        const no = self.none(rt, span);
        `({ int64_t v_; fly_parse_int(${arg(0)}, &v_) ? ${yes} : ${no}; })`
      }
      "parseFloat" => {
        const yes = self.some(rt, "v_", span);
        const no = self.none(rt, span);
        `({ double v_; fly_parse_float(${arg(0)}, &v_) ? ${yes} : ${no}; })`
      }
      "slice_len" => `((uint64_t)(${arg(0)}).len)`,
      "array_len" => match (recv) { #Array(_, #Known(n)) => `((uint64_t)${n})`, _ => return #None },
      // `std/par`'s views of a list: the whole as a slice, two halves, one element.
      "slice_slice" => arg(0),
      "Vec_slice" => if (match (stripBorrow(ptys[0])) { #Slice(_) => true, _ => false }) { arg(0) } else { `fly_vec_slice(${arg(0)})` },
      "array_slice" => match (stripBorrow(ptys[0])) { #Array(_, #Known(n)) => `((fly_slice){ (void*)(${arg(0)})->data, ${n} })`, _ => return #None },
      "slice_split" | "array_split" | "Vec_split" => {
        const tc = self.ctype(rt, span);
        const ec2 = self.ctype(match (stripBorrow(ptys[0])) { #Slice(x) => x.get().clone(), _ => #Error }, span);
        `({ fly_slice s_ = ${arg(0)}; uint64_t i_ = ${arg(1)}; if (i_ > s_.len) fly_panicf("index %llu out of bounds (length %zu)", (unsigned long long)i_, s_.len); (${tc}){ .f0 = { s_.ptr, i_ }, .f1 = { (uint8_t*)s_.ptr + i_ * sizeof(${ec2}), s_.len - i_ } }; })`
      }
      "slice_viewAt" | "array_viewAt" | "Vec_viewAt" => {
        const et = stripBorrow(rt);
        const ec2 = self.ctype(et, span);
        const at = self.borrowAt(`fly_slice_at(s_, i_, sizeof(${ec2}))`.asStr(), et, true, span);
        `({ fly_slice s_ = ${arg(0)}; uint64_t i_ = ${arg(1)}; ${at}; })`
      }
      "slice_readAt" | "array_readAt" | "Vec_readAt" => {
        const et = stripBorrow(rt);
        const ec2 = self.ctype(et, span);
        const whole = match (stripBorrow(ptys[0])) {
          #Array(_, #Known(n)) => `((fly_slice){ (void*)(${arg(0)})->data, ${n} })`,
          #Slice(_) => arg(0),
          _ => `fly_vec_slice(${arg(0)})`,
        };
        const at = self.borrowAt(`fly_slice_at(s_, i_, sizeof(${ec2}))`.asStr(), et, false, span);
        `({ fly_slice s_ = ${whole}; uint64_t i_ = ${arg(1)}; ${at}; })`
      }
      "slice_reverse" => `({ fly_slice_reverse(${arg(0)}, sizeof(${ec})); (fly_unit)0; })`,
      "slice_splitAt" => {
        const tc = self.ctype(rt, span);
        `({ fly_slice s_ = ${arg(0)}; uint64_t i_ = ${arg(1)}; if (i_ > s_.len) fly_panicf("index %llu out of bounds (length %zu)", (unsigned long long)i_, s_.len); (${tc}){ .f0 = { s_.ptr, i_ }, .f1 = { (uint8_t*)s_.ptr + i_ * sizeof(${ec}), s_.len - i_ } }; })`
      }
      "slice_sortBy" => {
        // The comparison gets each element as the closure takes it: a pointer, or a scalar's value.
        const pt: Ty = #Borrow(false, Box.new(elem.clone()));
        const pc = self.ctype(pt, span);
        const at = if (self.pointerBorrow(pt)) { "" } else { "*" };
        const ordTy: Ty = match (stripBorrow(ptys[1])) { #Fn(f) => f.ret.clone(), _ => #Error };
        const oc = self.ctype(ordTy, span);
        const less = self.tagId("Less");
        const greater = self.tagId("Greater");
        const sortKey = `sort:${ec}:${pc}`;
        const cmp = match (self.helpers.get(sortKey.asStr())) {
          #Some(n) => n.clone(),
          #None => {
            const n = `sortcmp${self.helpers.len()}`;
            self.helpers.insert(sortKey, n.clone());
            self.protos.push(`static int ${n}(void* ctx, const void* a, const void* b);\n`);
            self.dropCode.push(`static int ${n}(void* ctx, const void* a, const void* b) { fly_fn* f = ctx; ${oc} o = ((${oc} (*)(void*, ${pc}, ${pc}))f->fn)(f->env, ${at}(${ec}*)a, ${at}(${ec}*)b); return o.tag == ${less} ? -1 : o.tag == ${greater} ? 1 : 0; }\n`);
            n
          }
        };
        `({ fly_fn f_ = ${arg(1)}; fly_sort(${arg(0)}, sizeof(${ec}), ${cmp}, &f_); (fly_unit)0; })`
      }
      "Vec_remove" => `({ fly_vec* v_ = ${arg(0)}; uint64_t i_ = ${arg(1)}; ${ec} x_; fly_vec_remove(v_, i_, &x_, sizeof(${ec})); x_; })`,
      "Vec_insert" => `({ fly_vec* v_ = ${arg(0)}; uint64_t i_ = ${arg(1)}; ${ec} x_ = ${arg(2)}; fly_vec_insert(v_, i_, &x_, sizeof(${ec})); (fly_unit)0; })`,
      "Vec_retain" => {
        const pt: Ty = #Borrow(false, Box.new(elem.clone()));
        const pc = self.ctype(pt, span);
        const x = if (self.pointerBorrow(pt)) { "x_" } else { "*x_" };
        const d = if (self.needsDrop(elem)) { `else ${self.dropFn(elem, span)}(x_); ` } else { "" };
        `({ fly_vec* v_ = ${arg(0)}; fly_fn f_ = ${arg(1)}; size_t j_ = 0; for (size_t i_ = 0; i_ < v_->len; i_++) { ${ec}* x_ = &((${ec}*)v_->ptr)[i_]; if (((bool (*)(void*, ${pc}))f_.fn)(f_.env, ${x})) { ((${ec}*)v_->ptr)[j_++] = *x_; } ${d}} v_->len = j_; (fly_unit)0; })`
      }
      "writeFile" => {
        const boxed = self.ioErr("PermissionDenied");
        `({ if (!fly_write_file(${arg(0)}, ${arg(1)})) { ${boxed}} (fly_unit)0; })`
      }
      "File_open" => {
        const boxed = self.ioErr("NotFound");
        `({ fly_File f_ = { 0 }; if (!fly_read_file(${arg(0)}, &f_.text)) { ${boxed}} f_; })`
      }
      "File_readText" => `fly_String_clone(&(${arg(0)})->text)`,
      "File_readBytes" => `({ fly_File* f_ = ${arg(0)}; fly_vec_from(f_->text.ptr, f_->text.len, 1); })`,
      // `std/par`'s `join`: each half run by a function the runtime calls, maybe on another core.
      "join" => {
        const [ta, tb] = match (rt) { #Tuple(ts) if ts.len() == 2 => [ts[0].clone(), ts[1].clone()], _ => return #Some(self.fail(span, "`join` gives a pair")) };
        const ra = self.halfRunner(ta, span);
        const rb = self.halfRunner(tb, span);
        const ac = self.ctype(ta, span);
        const bc = self.ctype(tb, span);
        const tc = self.ctype(rt, span);
        `({ fly_fn fa_ = ${arg(0)}; fly_fn fb_ = ${arg(1)}; ${ac} ra_; ${bc} rb_; fly_par_join(${ra}, &fa_, &ra_, ${rb}, &fb_, &rb_); (${tc}){ .f0 = ra_, .f1 = rb_ }; })`
      }
      "Arc_new" => {
        const tc = self.ctype(typeArg(rt, 0), span);
        `({ ${tc} v_ = ${arg(0)}; ${tc}* p_ = fly_arc_new(sizeof(${tc})); *p_ = v_; p_; })`
      }
      "Arc_get" => if (self.pointerBorrow(rt)) { arg(0) } else { `(*${arg(0)})` },
      "Arc_clone" => `fly_arc_retain(${arg(0)})`,
      "repeat" => {
        const tc = self.ctype(rt, span);
        const n = match (rt) { #Array(_, #Known(n)) => n, _ => 0 };
        `({ __auto_type v_ = ${arg(0)}; ${tc} r_; for (size_t i_ = 0; i_ < ${n}; i_++) r_.data[i_] = v_; r_; })`
      }
      "Box_into" => {
        const c = self.ctype(rt, span);
        `({ ${c}* b_ = ${arg(0)}; ${c} x_ = *b_; free(b_); x_; })`
      }
      "replace" => {
        const c = self.ctype(rt, span);
        if (!self.pointerBorrow(ptys[0])) { return #None; }
        `({ ${c}* p_ = ${arg(0)}; ${c} v_ = ${arg(1)}; ${c} o_ = *p_; *p_ = v_; o_; })`
      }
      "swap" => {
        if (!self.pointerBorrow(ptys[0])) { return #None; }
        const c = self.ctype(stripBorrow(ptys[0]), span);
        `({ ${c}* a_ = ${arg(0)}; ${c}* b_ = ${arg(1)}; ${c} t_ = *a_; *a_ = *b_; *b_ = t_; (fly_unit)0; })`
      }
      "Option_isSome" => {
        const o = if (self.pointerBorrow(ptys[0])) { `(*${arg(0)})` } else { arg(0) };
        `((${o}).tag == ${self.tagId("Some")})`
      }
      "Option_take" => {
        const c = self.ctype(rt, span);
        const no = self.none(rt, span);
        `({ ${c}* o_ = ${arg(0)}; ${c} r_ = *o_; *o_ = ${no}; r_; })`
      }
      "Option_unwrapOr" => {
        const c = self.ctype(rt, span);
        const oc = self.ctype(stripBorrow(ptys[0]), span);
        const d = if (self.needsDrop(rt)) { `${self.dropFn(rt, span)}(&d_); ` } else { "" };
        `({ ${oc} o_ = ${arg(0)}; ${c} d_ = ${arg(1)}; ${c} r_; if (o_.tag == ${self.tagId("Some")}) { r_ = o_.u.Some; ${d}} else r_ = d_; r_; })`
      }
      "Option_cloned" => {
        const t = self.lw.payloadOf(rt, "Some");
        const oc = self.ctype(stripBorrow(ptys[0]), span);
        const pt: Ty = #Borrow(false, Box.new(t.clone()));
        const p = if (self.pointerBorrow(pt)) { "o_.u.Some" } else { "&o_.u.Some" };
        const call = self.ifaceCall("Clone", "clone", t, [p.toString()], span);
        const yes = self.some(rt, call.asStr(), span);
        const no = self.none(rt, span);
        `({ ${oc} o_ = ${arg(0)}; o_.tag == ${self.tagId("Some")} ? ${yes} : ${no}; })`
      }
      "Result_unwrap" => {
        const c = self.ctype(stripBorrow(ptys[0]), span);
        const errTy = self.lw.payloadOf(stripBorrow(ptys[0]), "Err");
        const ec2 = self.ctype(errTy, span);
        const boxed = self.boxErr("e_", errTy);
        const okTy = self.lw.payloadOf(stripBorrow(ptys[0]), "Ok");
        const oc = self.ctype(okTy, span);
        `({ ${c} r_ = ${arg(0)}; ${oc} o_ = { 0 }; if (r_.tag == ${self.tagId("Err")}) { ${ec2} e_ = r_.u.Err; ${boxed}} else o_ = r_.u.Ok; o_; })`
      }
      "Fail_capture" => {
        const t = self.lw.payloadOf(rt, "Ok");
        const errTy = self.lw.payloadOf(rt, "Err");
        const tc = self.ctype(t, span);
        const rc = self.ctype(rt, span);
        const etc = self.ctype(errTy, span);
        const take = self.takeErr("e_", errTy);
        `({ fly_fn f_ = ${arg(0)}; ${tc} v_ = ((${tc} (*)(void*))f_.fn)(f_.env); if (f_.drop) f_.drop(f_.env); ${rc} r_; if (FLY_FAILED) { ${etc} e_; memset(&e_, 0, sizeof e_); ${take}r_ = (${rc}){ .tag = ${self.tagId("Err")}, .u.Err = e_ }; } else r_ = (${rc}){ .tag = ${self.tagId("Ok")}, .u.Ok = v_ }; r_; })`
      }
      "Fail_map" => {
        const tc = self.ctype(rt, span);
        const bodyTy: FnTy = match (stripBorrow(ptys[0])) { #Fn(f) => f.get().clone(), _ => return #None };
        const wrapTy: FnTy = match (stripBorrow(ptys[1])) { #Fn(f) => f.get().clone(), _ => return #None };
        const errTy = match (wrapTy.params.first()) { #Some(t) => t.clone(), #None => #Error };
        const etc = self.ctype(errTy, span);
        const ftc = self.ctype(wrapTy.ret, span);
        const take = self.takeErr("e_", errTy);
        const boxed = self.boxErr("w_", wrapTy.ret);
        `({ fly_fn f_ = ${arg(0)}; fly_fn w0_ = ${arg(1)}; ${tc} v_ = ((${tc} (*)(void*))f_.fn)(f_.env); if (f_.drop) f_.drop(f_.env); if (FLY_FAILED) { ${etc} e_; memset(&e_, 0, sizeof e_); ${take}${ftc} w_ = ((${ftc} (*)(void*, ${etc}))w0_.fn)(w0_.env, e_); ${boxed}} if (w0_.drop) w0_.drop(w0_.env); v_; })`
      }
      _ => return #None,
    })
  }

  // A call of the scheduler's: scopes and tasks, channels, locks; and of the simulated network
  // and database. What may be a scheduling point checks for a cancellation delivered there.
  function tasksLib(self: mut Self, key: str, c: readonly Call, vs: readonly Vec<String>): Option<String> uses Fail<Diagnostic> {
    const ptys = c.params.clone();
    const span = c.span;
    const rt = c.ret.clone();
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    // The type of what a channel's end carries.
    const carried = match (c.argTys.first()) { #Some(t) => typeArg(stripBorrow(t), 0), #None => #Error };
    #Some(match (key) {
      "Io_scope" => {
        const tc = self.ctype(rt, span);
        `({ int sid_ = fly_scope_open(); int s_ = sid_; fly_fn f_ = ${arg(0)}; ${tc} r_ = ((${tc} (*)(void*, int*))f_.fn)(f_.env, &s_); if (f_.drop) f_.drop(f_.env); fly_scope_close(sid_, false); r_; })`
      }
      "Scope_spawn" => `({ int* s_ = ${arg(0)}; fly_fn f_ = ${arg(1)}; fly_spawn(*s_, fly_task_void, fly_box(&f_, sizeof f_), 0); (fly_unit)0; })`,
      "Scope_fork" => {
        const t = typeArg(rt, 0);
        const tc = self.ctype(t, span);
        const entryKey = `fork:${ckey(t)}`;
        const entry = match (self.helpers.get(entryKey.asStr())) {
          #Some(n) => n.clone(),
          #None => {
            const n = `tentry${self.helpers.len()}`;
            self.helpers.insert(entryKey, n.clone());
            self.protos.push(`static void ${n}(void* t, void* c);\n`);
            self.dropCode.push(`static void ${n}(void* t, void* c) { fly_fn* f = c; ${tc} v = ((${tc} (*)(void*))f->fn)(f->env); *(${tc}*)fly_task_result(t) = v; if (f->drop) f->drop(f->env); free(f); }\n`);
            n
          }
        };
        `({ int* s_ = ${arg(0)}; fly_fn f_ = ${arg(1)}; int t_ = fly_spawn(*s_, ${entry}, fly_box(&f_, sizeof f_), sizeof(${tc})); t_; })`
      }
      "Fiber_join" => {
        const tc = self.ctype(rt, span);
        `({ ${tc} r_; fly_join(${arg(0)}, &r_); r_; })`
      }
      "channel" | "Reply_new" => {
        const tc = self.ctype(rt, span);
        // What drops a message left in the channel, or sent to it once no one receives.
        const msg = match (rt) { #Tuple(ts) if ts.len() > 0 => typeArg(ts[0], 0), _ => #Error };
        const drop = if (self.needsDrop(msg)) { self.anyDropFn(msg, span) } else { "NULL".toString() };
        `({ fly_chan c_ = fly_channel(${drop}); (${tc}){ .f0 = c_, .f1 = c_ }; })`
      }
      "Sender_send" => {
        const tc = self.ctype(carried, span);
        `({ fly_chan c_ = ${arg(0)}; ${tc} v_ = ${arg(1)}; fly_send(c_, &v_, sizeof(${tc})); })`
      }
      // A reply sent is done with: its channel's sending end is gone.
      "Reply_send" => {
        const tc = self.ctype(carried, span);
        `({ fly_chan c_ = ${arg(0)}; ${tc} v_ = ${arg(1)}; fly_send(c_, &v_, sizeof(${tc})); fly_sender_drop(&c_); (fly_unit)0; })`
      }
      "Receiver_recv" => {
        const tc = self.ctype(carried, span);
        const yes = self.some(rt, "x_", span);
        const no = self.none(rt, span);
        `({ ${tc} x_; bool ok_ = fly_recv(${arg(0)}, &x_, sizeof(${tc})); ok_ ? ${yes} : ${no}; })`
      }
      "Pending_wait" => {
        const tc = self.ctype(rt, span);
        `({ fly_chan c_ = ${arg(0)}; ${tc} x_; bool ok_ = fly_recv(c_, &x_, sizeof(${tc})); fly_receiver_drop(&c_); if (!ok_ && !fly_unwinding) fly_panic("the reply was dropped unsent"); x_; })`
      }
      "Sender_close" => `({ fly_close(${arg(0)}); (fly_unit)0; })`,
      "Sender_clone" => `({ fly_chan c_ = ${arg(0)}; fly_sender_clone(&c_); })`,
      "Mutex_new" => {
        const tc = self.ctype(typeArg(rt, 0), span);
        `({ ${tc} v_ = ${arg(0)}; (${tc}*)fly_mutex_new(&v_, sizeof(${tc})); })`
      }
      "Mutex_lock" => {
        const tc = self.ctype(rt, span);
        const pc = match (stripBorrow(ptys[1])) { #Fn(f) => match (f.params.first()) { #Some(p) => self.ctype(p, span), #None => "void*".toString() }, _ => "void*".toString() };
        `({ __auto_type m_ = ${arg(0)}; fly_fn f_ = ${arg(1)}; fly_point(); fly_lock(m_); ${tc} r_ = ((${tc} (*)(void*, ${pc}))f_.fn)(f_.env, m_); fly_unlock(m_); if (f_.drop) f_.drop(f_.env); r_; })`
      }
      "Db_connect" => "0".toString(),
      "Listener_bind" => {
        const raise = self.ioRaise("-l_");
        `({ int l_ = fly_listen(${arg(0)}); if (l_ < 0) { ${raise}} l_; })`
      }
      "Listener_port" => `fly_listener_port(${arg(0)})`,
      "Socket_close" => `({ fly_sock_close(${arg(0)}); (fly_unit)0; })`,
      "Socket_connect" => {
        const raise = self.ioRaise("e_");
        `({ fly_socket s_; int e_ = fly_connect(${arg(0)}, ${arg(1)}, &s_); if (e_) { ${raise}} s_; })`
      }
      "Socket_read" => {
        const raise = self.ioRaise("e_");
        `({ uint64_t n_ = 0; int e_ = fly_sock_read(${arg(0)}, ${arg(1)}, &n_); if (e_) { ${raise}} n_; })`
      }
      "Socket_write" => {
        const raise = self.ioRaise("e_");
        `({ int e_ = fly_sock_write(${arg(0)}, ${arg(1)}); if (e_) { ${raise}} (fly_unit)0; })`
      }
      // The simulated client's transcript doubles as the program's output.
      "Socket_writeStatus" => {
        const raise = self.ioRaise("e_");
        `({ int e_ = fly_sock_status(${arg(0)}, ${arg(1)}, ${arg(2)}); if (e_) { ${raise}} (fly_unit)0; })`
      }
      "Db_fetchProfile" => {
        const tc = self.ctype(rt, span);
        const timedOut = self.ioErr("TimedOut");
        const notFound = self.ioErr("NotFound");
        `({ fly_str u_ = ${arg(1)}; fly_str n_; ${tc} r_ = { 0 }; if (fly_fault()) { ${timedOut}} else if (!fly_world_profile(u_, &n_)) { ${notFound}} else r_ = (${tc}){ .displayName = fly_String_from(n_) }; r_; })`
      }
      "Db_checkQuota" => {
        const tc = self.ctype(rt, span);
        const timedOut = self.ioErr("TimedOut");
        `({ fly_str t_ = ${arg(1)}; ${tc} r_ = { 0 }; if (fly_fault()) { ${timedOut}} else r_ = (${tc}){ .allowed = fly_world_quota(t_) }; r_; })`
      }
      _ => return #None,
    })
  }

  // A call of the library's maps, generators and hashing, which the runtime holds untyped.
  function library(self: mut Self, key: str, c: readonly Call, vs: readonly Vec<String>): Option<String> uses Fail<Diagnostic> {
    const ptys = c.params.clone();
    const span = c.span;
    const rt = c.ret.clone();
    const arg = (i: usize) => if (i < vs.len()) { vs[i].clone() } else { "0".toString() };
    const recv: Ty = match (c.argTys.first()) { #Some(t) => stripBorrow(t), #None => #Error };
    // A pointer to a lookup's key, which is lent `readonly`: a scalar's is put in a variable.
    const probe = if (ptys.len() > 1 && self.pointerBorrow(ptys[1])) { arg(1) } else { `({ q0_ = ${arg(1)}; &q0_; })` };
    const probeDecl = if (ptys.len() > 1 && !self.pointerBorrow(ptys[1])) { `__typeof__(${arg(1)}) q0_; ` } else { "".toString() };
    if (key.startsWith("HashMap_")) {
      const k = typeArg(recv, 0);
      const v = typeArg(recv, 1);
      const et = entryTy(recv);
      const ec = self.ctype(et, span);
      const q = if (ptys.len() > 1) { stripBorrow(ptys[1]) } else { k.clone() };
      return #Some(match (key) {
        "HashMap_new" => "((fly_map){ 0 })".toString(),
        "HashMap_len" => `((uint64_t)(${arg(0)})->len)`,
        "HashMap_insert" => {
          const h = self.hashFn(k, span);
          const eq = self.keyEqFn(k, k, span);
          const kc = self.ctype(k, span);
          const vc = self.ctype(v, span);
          const d = if (self.needsDrop(et)) { `${self.dropFn(et, span)}(e_); ` } else { "" };
          `({ fly_map* m_ = ${arg(0)}; ${kc} k_ = ${arg(1)}; ${vc} v_ = ${arg(2)}; uint64_t h_ = ${h}(&k_); size_t i_ = fly_map_find(m_, h_, &k_, ${eq}, sizeof(${ec})); ${ec}* e_; if (i_ == SIZE_MAX) e_ = fly_map_append(m_, h_, sizeof(${ec})); else { e_ = (${ec}*)m_->entries + i_; ${d}} e_->f0 = k_; e_->f1 = v_; (fly_unit)0; })`
        }
        "HashMap_has" => {
          const f = self.mapFind(k, q, probe.asStr(), ec.asStr(), span);
          `({ fly_map* m_ = (fly_map*)${arg(0)}; ${probeDecl}${f}i_ != SIZE_MAX; })`
        }
        "HashMap_get" | "HashMap_getMut" => {
          const f = self.mapFind(k, q, probe.asStr(), ec.asStr(), span);
          const found = self.borrowAt(`&((${ec}*)m_->entries)[i_].f1`.asStr(), v, key == "HashMap_getMut", span);
          const yes = self.some(rt, found.asStr(), span);
          const no = self.none(rt, span);
          `({ fly_map* m_ = (fly_map*)${arg(0)}; ${probeDecl}${f}i_ == SIZE_MAX ? ${no} : ${yes}; })`
        }
        "HashMap_remove" => {
          const f = self.mapFind(k, q, probe.asStr(), ec.asStr(), span);
          const dk = if (self.needsDrop(k)) { `${self.dropFn(k, span)}(&x_.f0); ` } else { "" };
          const yes = self.some(rt, "x_.f1", span);
          const no = self.none(rt, span);
          `({ fly_map* m_ = ${arg(0)}; ${probeDecl}${f}${ec} x_; if (i_ != SIZE_MAX) { fly_map_remove_at(m_, i_, &x_, sizeof(${ec})); ${dk}} i_ == SIZE_MAX ? ${no} : ${yes}; })`
        }
        "HashMap_keys" | "HashMap_values" | "HashMap_valuesMut" | "HashMap_entries" => {
          const itemTy = typeArg(rt, 0);
          const off = `p + offsetof(${ec}, f1)`;
          const item = match (key) {
            "HashMap_keys" => self.borrowAt("p", k, false, span),
            "HashMap_values" => self.borrowAt(off.asStr(), v, false, span),
            "HashMap_valuesMut" => self.borrowAt(off.asStr(), v, true, span),
            _ => {
              const tc = self.ctype(itemTy, span);
              const a = self.borrowAt("p", k, false, span);
              const b = self.borrowAt(off.asStr(), v, false, span);
              `((${tc}){ .f0 = ${a}, .f1 = ${b} })`
            }
          };
          const g = self.stridedGen(itemTy, "m_->entries", "m_->len", `sizeof(${ec})`.asStr(), item.asStr(), "free", span);
          `({ fly_map* m_ = (fly_map*)${arg(0)}; ${g}; })`
        }
        "HashMap_intoEntries" => `({ fly_map m_ = ${arg(0)}; fly_vec v_ = fly_vec_from(m_.entries, m_.len, sizeof(${ec})); fly_map_free(&m_); v_; })`,
        _ => return #None,
      });
    }
    if (key.startsWith("Hasher_")) {
      return #Some(match (key) {
        "Hasher_new" => "fly_Hasher_new()".toString(),
        "Hasher_finish" => `fly_Hasher_finish(${arg(0)})`,
        _ => `({ fly_${key}(${arg(0)}, ${arg(1)}); (fly_unit)0; })`,
      });
    }
    match (key) {
      "Vec_iter" | "slice_iter" | "Vec_iterMut" | "slice_iterMut" => {
        const itemTy = typeArg(rt, 0);
        const elem = stripBorrow(itemTy);
        const ec = self.ctype(elem, span);
        const item = self.borrowAt("p", elem, key.endsWith("Mut"), span);
        const list = if (key.startsWith("Vec")) { `fly_vec_slice(${arg(0)})` } else { arg(0) };
        const g = self.stridedGen(itemTy, "l_.ptr", "l_.len", `sizeof(${ec})`.asStr(), item.asStr(), "free", span);
        return #Some(`({ fly_slice l_ = ${list}; ${g}; })`);
      }
      "Vec_drain" => {
        const itemTy = typeArg(rt, 0);
        const ec = self.ctype(itemTy, span);
        const key2 = `drain:${ckey(itemTy)}`;
        const drop = match (self.helpers.get(key2.asStr())) {
          #Some(n) => n.clone(),
          #None => {
            const n = `gdrain${self.helpers.len()}`;
            self.helpers.insert(key2, n.clone());
            const d = if (self.needsDrop(itemTy)) { `for (; s->i < s->len; s->i++) ${self.dropFn(itemTy, span)}((${ec}*)(s->base + s->i * s->stride)); ` } else { "" };
            self.protos.push(`static void ${n}(void* s_);\n`);
            self.dropCode.push(`static void ${n}(void* s_) { fly_iter* s = s_; ${d}free(s->base); free(s); }\n`);
            n
          }
        };
        const g = self.stridedGen(itemTy, "v_->ptr", "v_->len", `sizeof(${ec})`.asStr(), `*(${ec}*)p`.asStr(), drop.asStr(), span);
        return #Some(`({ fly_vec* v_ = ${arg(0)}; fly_gen g_ = ${g}; *v_ = (fly_vec){ 0 }; g_; })`);
      }
      _ => {}
    }
    if (const #Some(r) = self.prelude(key, c, vs)) { return #Some(r); }
    if (const #Some(r) = self.tasksLib(key, c, vs)) { return #Some(r); }
    // `generate(f)` runs `f` on a fiber, pulled for each item.
    if (key == "generate") {
      const ic = self.ctype(typeArg(rt, 0), span);
      return #Some(`fly_generate(${arg(0)}, sizeof(${ic}))`);
    }
    if (!key.startsWith("Gen_")) { return #None; }
    const t = typeArg(recv, 0);
    const tc = self.ctype(t, span);
    const out = typeArg(rt, 0);
    const oc = if (self.namedIs(rt, "Gen")) { self.ctype(out, span) } else { String.new() };
    const dropT = if (self.needsDrop(t)) { `${self.dropFn(t, span)}(&x); ` } else { "" };
    #Some(match (key) {
      "Gen_next" => {
        const yes = self.some(rt, "x_", span);
        const no = self.none(rt, span);
        `({ fly_gen* g_ = ${arg(0)}; ${tc} x_; g_->next(g_->st, &x_) ? ${yes} : ${no}; })`
      }
      "Gen_collect" => {
        const d = self.dropFn(rt, span);
        `({ fly_gen g_ = ${arg(0)}; fly_vec v_ = { 0 }; ${tc} x_; while (g_.next(g_.st, &x_)) fly_vec_push(&v_, &x_, sizeof(${tc})); fly_gen_drop(&g_); if (FLY_FAILED) ${d}(&v_); v_; })`
      }
      "Gen_map" => {
        const st = self.step(`map:${tc}:${oc}`, "fly_gmap", `${tc} x; if (!s->in.next(s->in.st, &x)) return false; *(${oc}*)o_ = ((${oc} (*)(void*, ${tc}))s->f.fn)(s->f.env, x); return !FLY_FAILED;`.asStr());
        `((fly_gen){ fly_gmap_new(${arg(0)}, ${arg(1)}), ${st}, fly_gmap_drop })`
      }
      "Gen_filter" => {
        const pt: Ty = #Borrow(false, Box.new(t.clone()));
        const pc = self.ctype(pt, span);
        // An item that is a borrow already is lent as it is: a borrow of a borrow is the borrow.
        const x = if (self.pointerBorrow(pt) && !match (t) { #Borrow(_, _) => true, _ => false }) { "&x" } else { "x" };
        const st = self.step(`filter:${tc}`, "fly_gmap", `${tc} x; while (s->in.next(s->in.st, &x)) { if (((bool (*)(void*, ${pc}))s->f.fn)(s->f.env, ${x})) { *(${tc}*)o_ = x; return !FLY_FAILED; } ${dropT}if (FLY_FAILED) return false; } return false;`.asStr());
        `((fly_gen){ fly_gmap_new(${arg(0)}, ${arg(1)}), ${st}, fly_gmap_drop })`
      }
      "Gen_take" => {
        const st = self.step(`take:${tc}`, "fly_gcount", "if (s->n == 0) return false; s->n--; return s->in.next(s->in.st, o_);");
        `((fly_gen){ fly_gcount_new(${arg(0)}, ${arg(1)}), ${st}, fly_gcount_drop })`
      }
      "Gen_enumerate" => {
        const st = self.step(`enumerate:${tc}`, "fly_gcount", `${tc} x; if (!s->in.next(s->in.st, &x)) return false; *(${oc}*)o_ = (${oc}){ .f0 = s->n++, .f1 = x }; return true;`.asStr());
        `((fly_gen){ fly_gcount_new(${arg(0)}, 0), ${st}, fly_gcount_drop })`
      }
      "Gen_zip" => {
        const u = typeArg(stripBorrow(ptys[1]), 0);
        const uc = self.ctype(u, span);
        const st = self.step(`zip:${tc}:${uc}`, "fly_gzip", `${tc} x; if (!s->a.next(s->a.st, &x)) return false; ${uc} y; if (!s->b.next(s->b.st, &y)) { ${dropT}return false; } *(${oc}*)o_ = (${oc}){ .f0 = x, .f1 = y }; return true;`.asStr());
        `((fly_gen){ fly_gzip_new(${arg(0)}, ${arg(1)}), ${st}, fly_gzip_drop })`
      }
      "Gen_drop" => `({ fly_gen_drop(${arg(0)}); (fly_unit)0; })`,
      _ => return #None,
    })
  }

}

// ---- code run apart ----

// What a C function made of code apart from its function is given: its environment's fields and
// their initializers, and how it reaches the locals and captures it uses of the code around it.
type Apart = { fields: String; inits: Vec<String>; names: HashMap<usize, String>; captures: Vec<String>; arenas: HashMap<u32, String> };

impl Cgen {
  // The environment of code apart, the blocks `bs`: a pointer to each local and capture it uses
  // of the code around it, and the arenas in reach.
  function apart(self: mut Self, bs: readonly Vec<Block>, span: Span): Apart uses Fail<Diagnostic> {
    let own: HashSet<usize> = HashSet.new();
    let u: Uses = { locals: HashSet.new(), captures: HashSet.new() };
    for (const b of bs) {
      ownedIn(b, mut own);
      useBlock(b, mut u);
    }
    let fields = String.new();
    let inits: Vec<String> = Vec.new();
    let names: HashMap<usize, String> = HashMap.new();
    let used: Vec<usize> = Vec.new();
    for (const l of u.locals.iter()) { if (!own.has(l)) { used.push(l); } }
    used.sortBy((a, b) => a.cmp(b));
    for (const l of used) {
      const t = self.cx.locals[l].ty.clone();
      if (unitTy(t)) { continue; }
      const ct = match (self.cx.locals[l].kind) { #Arena => "fly_arena".toString(), _ => self.ctype(t, span) };
      fields.push(`  ${ct}* l${l};\n`);
      inits.push(`.l${l} = &(${self.local(l)})`);
      names.insert(l, `(*env->l${l})`);
    }
    let captures: Vec<String> = Vec.new();
    let k: usize = 0;
    while (k < self.cx.captures.len()) {
      if (u.captures.has(k)) {
        const ct = self.ctype(self.captureTy(k), span);
        fields.push(`  ${ct}* c${k};\n`);
        inits.push(`.c${k} = &(${self.cx.captures[k]})`);
        captures.push(`(*env->c${k})`);
      } else { captures.push("/* not captured */0".toString()); }
      k += 1;
    }
    let arenas: HashMap<u32, String> = HashMap.new();
    for (const [id, c] of self.cx.arenas.entries()) {
      fields.push(`  fly_arena* ar_${id};\n`);
      inits.push(`.ar_${id} = ${c}`);
      arenas.insert(id, `env->ar_${id}`);
    }
    { fields, inits, names, captures, arenas }
  }

  // A context for code apart: the function's locals, reached as `ap` says.
  function apartCtx(self: readonly Self, ap: readonly Apart, ret: Ty, mode: Mode): Ctx {
    let cx = newCtx(self.cx.locals.clone(), ret, mode);
    cx.names = ap.names.clone();
    cx.captures = ap.captures.clone();
    cx.capTys = self.cx.capTys.clone();
    cx.arenas = ap.arenas.clone();
    cx.fnRet = self.cx.fnRet.clone();
    cx
  }

  // A `defer`'s body, made a C function of its own: the statement calling it here.
  function deferCall(self: mut Self, flag: usize, body: readonly Block, span: Span): String uses Fail<Diagnostic> {
    if (const #Some(c) = self.defers.get(`${self.fnName}:${flag}`.asStr())) { return c.clone(); }
    self.aparts += 1;
    const n = self.aparts;
    const ap = self.apart([body.clone()], span);
    const envT = `denv_${n}`;
    const fields = if (ap.fields.len() == 0) { "  fly_unit empty;\n".toString() } else { ap.fields.clone() };
    self.typeDefs.push(`typedef struct {\n${fields}} ${envT};\n`);
    const call = `{ ${envT} e_ = { ${ap.inits.join(", ")} }; defer_${n}(&e_); }`;
    self.defers.insert(`${self.fnName}:${flag}`, call.clone());
    let cx = self.apartCtx(ap, #Prim(#Void), #Defer);
    cx.sink = self.cx.sink.clone();
    const saved = replace(mut self.cx, cx);
    self.block(body, span);
    const code = replace(mut self.cx.out, String.new());
    const more = replace(mut self.cx.decls, String.new());
    self.cx = saved;
    self.protos.push(`static void defer_${n}(${envT}* env);\n`);
    self.apartCode.push(`static void defer_${n}(${envT}* env) {\n  (void)env;\n${more}${code}  return;\nfail: ;\nret: ;\n}\n`);
    call
  }

  // `for` over a generator: the body is made a C function the generator calls with each item, and
  // what stopped the generator early — a `break`, a `return`, a failure, a yield nothing wants — is
  // acted on once it has unwound.
  function forGen(self: mut Self, l: usize, c: readonly Call, item: usize, body: readonly Block, span: Span): void uses Fail<Diagnostic> {
    self.aparts += 1;
    const n = self.aparts;
    const ap = self.apart([body.clone()], span);
    const envT = `benv_${n}`;
    const ret = self.cx.fnRet.clone();
    const rt = self.ctype(ret, span);
    let fields = ap.fields.clone();
    fields.push(`  ${rt}* oret_;\n  int* code_;\n  fly_yield* y_;\n`);
    self.typeDefs.push(`typedef struct {\n${fields}} ${envT};\n`);
    const code = self.fresh();
    self.cx.decls.push(`  int ${code} = 0;\n`);
    let inits = ap.inits.clone();
    inits.push(`.oret_ = &(${self.cx.oret})`);
    inits.push(`.code_ = &${code}`);
    inits.push(`.y_ = ${match (self.cx.sink) { #Some(y) => `&(${y})`, #None => "NULL".toString() }}`);
    // The body.
    let cx = self.apartCtx(ap, #Prim(#Bool), #Body);
    cx.oret = "(*env->oret_)".toString();
    if (self.cx.sink.isSome()) { cx.sink = #Some("(*env->y_)".toString()); }
    const saved = replace(mut self.cx, cx);
    const it = self.cx.locals[item].ty.clone();
    const ic = self.ctype(it, span);
    // The item the generator gives is the body's.
    if (!unitTy(it)) { self.cx.prologue = `${self.localIn(item, ap)} = *(${ic}*)item_;`; }
    self.gen(item);
    self.block(body, span);
    const bodyCode = replace(mut self.cx.out, String.new());
    const more = replace(mut self.cx.decls, String.new());
    self.cx = saved;
    self.protos.push(`static bool body_${n}(void* env_, void* item_);\n`);
    self.apartCode.push(`static bool body_${n}(void* env_, void* item_) {\n  ${envT}* env = env_; (void)env; (void)item_;\n${more}  bool ret_ = true;\n${bodyCode}  goto ret;\nfail: return false;\nret: return ret_;\n}\n`);
    // The call, the body its yields go to.
    const envv = self.fresh();
    self.cx.decls.push(`  ${envT} ${envv};\n`);
    let vs: Vec<String> = Vec.new();
    for (const a of c.args) { vs.push(self.operand(a, span)); }
    for (const r of c.regions) {
      match (self.cx.arenas.get(r)) {
        #Some(a) => vs.push(a.clone()),
        #None => self.fail(span, "a region's arena is out of reach here"),
      }
    }
    vs.push(`((fly_yield){ &${envv}, body_${n} })`);
    const f = match (c.callee) { #Inst(i) => self.lw.insts[i].name.clone(), _ => return self.fail(span, "a loop over no generator") };
    self.line(`${code} = 0; ${envv} = (${envT}){ ${inits.join(", ")} };`);
    self.line(`${f}(${vs.join(", ")});`);
    self.dynamicExit();
    self.line(`fly_stopping = false; if (fly_unwinding) goto ${self.target()}; if (FLY_FAILED) goto ${self.target()};`);
    const [all, _] = self.exitTo(#None, span);
    const returning = match (self.cx.mode) { #Body => `*env->code_ = 2; ${all}ret_ = false; goto ret;`, _ => `${all}goto ret;` };
    const stop = self.stop(span);
    self.line(`if (${code} == 2) { ${returning} } if (${code} == 4) { ${stop} }`);
  }

  // How a C function made apart reaches a local it holds.
  function localIn(self: readonly Self, l: usize, ap: readonly Apart): String {
    match (ap.names.get(l)) { #Some(n) => n.clone(), #None => `v${l}_${self.cx.locals[l].name}` }
  }

  // `Eff.op(args)`: the arguments, as the operation takes them, are put where the handler finds
  // them, and the body suspends until it is resumed with the result, or unwound.
  function perform(self: mut Self, d: usize, op: usize, args: readonly Vec<Operand>, r: usize, span: Span): void uses Fail<Diagnostic> {
    const rt = self.cx.locals[r].ty.clone();
    const rc = self.ctype(rt, span);
    let tys: Vec<Ty> = Vec.new();
    let vs: Vec<String> = Vec.new();
    for (const a of args) {
      tys.push(self.operandTy(a));
      vs.push(self.operand(a, span));
    }
    const store = if (unitTy(rt)) { "".toString() } else { `${self.local(r)} = r_; ` };
    if (tys.len() == 0) {
      self.line(`{ ${rc} r_; fly_perform(${d}, ${op}, NULL, &r_); ${store}}`);
    } else {
      const tc = self.ctype(#Tuple(tys), span);
      let inits: Vec<String> = Vec.new();
      for (const [i, v] of vs.iter().enumerate()) { inits.push(`.f${i} = ${v}`); }
      self.line(`{ ${tc} a_ = { ${inits.join(", ")} }; ${rc} r_; fly_perform(${d}, ${op}, &a_, &r_); ${store}}`);
    }
    self.dynamicExit();
    // A direct handler's arm, run by the operation, may have failed.
    self.line(`if (fly_unwinding) goto ${self.target()}; if (FLY_FAILED) goto ${self.target()};`);
  }

  // `k(a)`: the continuation is consumed, and the body resumed with `a`.
  function resume(self: mut Self, k: readonly Operand, arg: readonly Option<Operand>, r: usize, span: Span): void uses Fail<Diagnostic> {
    const b = self.cx.locals[r].ty.clone();
    const bc = self.ctype(b, span);
    const kv = self.operand(k, span);
    const store = if (unitTy(b)) { "".toString() } else { `${self.local(r)} = r_; ` };
    match (arg) {
      #None => self.line(`{ fly_cont k_ = ${kv}; ${bc} r_ = ((${bc} (*)(void*))k_.resume)(k_.frame); ${store}}`),
      #Some(a) => {
        const at = self.operandTy(a);
        const ac = self.ctype(at, span);
        const av = self.operand(a, span);
        self.line(`{ fly_cont k_ = ${kv}; ${ac} a_ = ${av}; ${bc} r_ = ((${bc} (*)(void*, ${ac}))k_.resume)(k_.frame, a_); ${store}}`);
      }
    }
    self.dynamicExit();
    self.line(`if (fly_unwinding) goto ${self.target()}; if (FLY_FAILED) goto ${self.target()};`);
  }

  // `handle { body } with Eff { arms }`: the body runs on a fiber of its own, in a frame on the
  // heap that the `handle` and each continuation of it share; the arms run where it is handled,
  // or where a continuation is resumed, which is the same code: the handler is deep.
  function handle(self: mut Self, h: readonly Handle): void uses Fail<Diagnostic> {
    if (h.direct) { return self.handleDirect(h); }
    const span = h.span;
    const d = h.effect;
    const ops = match (self.lw.p.defs[d].kind) { #Effect { ops } => ops.clone(), _ => Vec.new() };
    const b = self.cx.locals[h.result].ty.clone();
    const bc = self.ctype(b, span);
    self.aparts += 1;
    const n = self.aparts;
    const frame = `hframe_${n}`;
    let blocks: Vec<Block> = [h.body.clone()];
    for (const a of h.arms) { blocks.push(a.body.clone()); }
    const ap = self.apart(blocks, span);
    let fields = ap.fields.clone();
    let inits = ap.inits.clone();
    const yields = self.cx.sink.isSome();
    if (yields) {
      fields.push("  fly_yield* y_;\n");
      inits.push(`.y_ = &(${match (self.cx.sink) { #Some(y) => y.clone(), #None => String.new() }})`);
    }
    self.typeDefs.push(`typedef struct {\n  fly_handler h;\n  int refs;\n  ${bc} result;\n${fields}} ${frame};\n`);
    // The body. Under a handler of `Yield`, its yields perform the operation.
    const handlesYield = self.lw.p.defs[d].name == "Yield" && self.lw.p.modules[self.lw.p.defs[d].module].isStd;
    if (handlesYield) {
      self.apartCode.push(`static bool hyield_${n}(void* env, void* item) { (void)env; fly_unit r; fly_perform(${d}, 0, item, &r); return !fly_unwinding; }\n`);
      self.protos.push(`static bool hyield_${n}(void* env, void* item);\n`);
    }
    let cx = self.apartCtx(ap, b.clone(), #Fn);
    cx.fnRet = b.clone();
    if (handlesYield) { cx.sink = #Some("y_".toString()); } else if (yields) { cx.sink = #Some("(*env->y_)".toString()); }
    const saved = replace(mut self.cx, cx);
    // The body's value is read once its block has ended.
    let decls = String.new();
    if (!unitTy(b)) {
      self.cx.hoisted.insert(h.value);
      decls.push(`  ${bc} ${self.local(h.value)} = { 0 };\n`);
    }
    if (handlesYield) { decls.push(`  fly_yield y_ = { NULL, hyield_${n} };\n`); }
    self.block(h.body, span);
    const bodyCode = replace(mut self.cx.out, String.new());
    decls.push(replace(mut self.cx.decls, String.new()).asStr());
    const bodyValue = if (unitTy(b)) { "(fly_unit)0".toString() } else { self.local(h.value) };
    self.cx = saved;
    // The arms, one function choosing by the operation performed.
    let cx2 = self.apartCtx(ap, b.clone(), #Fn);
    cx2.fnRet = b.clone();
    if (yields) { cx2.sink = #Some("(*env->y_)".toString()); }
    const saved2 = replace(mut self.cx, cx2);
    let decls2 = String.new();
    for (const a of h.arms) {
      if (!unitTy(b)) {
        self.cx.hoisted.insert(a.value);
        decls2.push(`  ${bc} ${self.local(a.value)} = { 0 };\n`);
      }
    }
    let resumes = String.new();
    for (const arm of h.arms) {
      // The operation's arguments become the arm's: an abortive arm takes them before the body unwinds.
      let binds = String.new();
      let tys: Vec<Ty> = Vec.new();
      for (const p of arm.params) { tys.push(self.cx.locals[p].ty.clone()); }
      if (tys.len() > 0) {
        const tc = self.ctype(#Tuple(tys.clone()), span);
        for (const [i, p] of arm.params.iter().enumerate()) {
          binds.push(`${self.local(p)} = ((${tc}*)env->h.args)->f${i}; `);
        }
      }
      match (arm.cont) {
        #Some(k) => {
          binds.push(`env->refs++; ${self.local(k)} = (fly_cont){ env, (void*)hres_${n}_${arm.op}, hdrop_${n} }; `);
          // How the continuation of this operation resumes the body with its result.
          const kt = self.cx.locals[k].ty.clone();
          const a = typeArg(kt, 0);
          const sig = if (unitTy(a)) { "void* f".toString() } else { `void* f, ${self.ctype(a, span)} a` };
          const store = if (unitTy(a)) { "" } else { `*(__typeof__(a)*)env->h.result = a; ` };
          resumes.push(`static ${bc} hres_${n}_${arm.op}(${sig}) { ${frame}* env = f; ${store}fly_handle_resume(&env->h); return hrun_${n}(env); }\n`);
        }
        #None => { binds.push("fly_handle_unwind(&env->h); "); }
      }
      self.line(`if (env->h.op == ${arm.op}) {`);
      // The arm's parameters and continuation are its block's, given values as it starts.
      self.cx.prologue = binds;
      for (const p of arm.params) { self.gen(p); }
      if (const #Some(k) = arm.cont) { self.gen(k); }
      self.cx.reachable = true;
      self.block(arm.body, span);
      const av = if (unitTy(b)) { "(fly_unit)0".toString() } else { self.local(arm.value) };
      self.line(`ret_ = ${av}; goto ret; }`);
    }
    const armsCode = replace(mut self.cx.out, String.new());
    const more2 = replace(mut self.cx.decls, String.new());
    self.cx = saved2;
    self.protos.push(`static ${bc} hbody_${n}(${frame}* env);\nstatic ${bc} harms_${n}(${frame}* env);\nstatic ${bc} hrun_${n}(${frame}* env);\nstatic void hdrop_${n}(void* f);\n`);
    for (const [oi, _] of ops.iter().enumerate()) {
      self.protos.push(`static ${bc} hres_${n}_${oi}();\n`);
    }
    self.apartCode.push(`static ${bc} hbody_${n}(${frame}* env) {\n  (void)env;\n${decls}  ${bc} ret_ = { 0 };\n${bodyCode}  return ${bodyValue};\nfail: return (${bc}){ 0 };\nret: return ret_;\n}\n`);
    self.apartCode.push(`static ${bc} harms_${n}(${frame}* env) {\n${decls2}${more2}  ${bc} ret_ = { 0 };\n${armsCode}  fly_panic("an operation no arm handles");\nfail: return (${bc}){ 0 };\nret: return ret_;\n}\n`);
    self.apartCode.push(`static void hentry_${n}(void* f) { ${frame}* env = f; env->result = hbody_${n}(env); }\n`);
    self.apartCode.push(`static void hrelease_${n}(${frame}* env) { if (--env->refs == 0) { fly_handle_free(&env->h); free(env); } }\n`);
    self.apartCode.push(`static ${bc} hrun_${n}(${frame}* env) { ${bc} v; if (fly_handle_done(&env->h)) { v = env->result; memset(&env->result, 0, sizeof v); } else v = harms_${n}(env); hrelease_${n}(env); return v; }\n`);
    self.apartCode.push(`static void hdrop_${n}(void* f) { ${frame}* env = f; fly_handle_unwind(&env->h); hrelease_${n}(env); }\n`);
    self.apartCode.push(resumes.asStr());
    const store = if (unitTy(b)) { "".toString() } else { `${self.local(h.result)} = v_; ` };
    self.line(`{ ${frame}* f_ = fly_alloc(sizeof(${frame})); *f_ = (${frame}){ .refs = 1, .h = { .effect = ${d} }${if (inits.len() > 0) { ", " } else { "" }}${inits.join(", ")} }; fly_handle_start(&f_->h, hentry_${n}, f_); ${bc} v_ = hrun_${n}(f_); ${store}}`);
    self.dynamicExit();
    self.line(`if (fly_unwinding) goto ${self.target()}; if (FLY_FAILED) goto ${self.target()};`);
  }
}

impl Cgen {
  // A direct `handle`: its body runs here, under a handler whose operations call a function of its
  // arms, given pointers to what the arms reach of the code around; each arm returns the result
  // its resumption gives. However the body is left, the handler is removed.
  function handleDirect(self: mut Self, h: readonly Handle): void uses Fail<Diagnostic> {
    const span = h.span;
    const d = h.effect;
    const b = self.cx.locals[h.result].ty.clone();
    self.aparts += 1;
    const n = self.aparts;
    const frame = `hdframe_${n}`;
    let blocks: Vec<Block> = Vec.new();
    for (const a of h.arms) { blocks.push(a.body.clone()); }
    const ap = self.apart(blocks, span);
    let fields = ap.fields.clone();
    let inits = ap.inits.clone();
    const yields = self.cx.sink.isSome();
    if (yields) {
      fields.push("  fly_yield* y_;\n");
      inits.push(`.y_ = &(${match (self.cx.sink) { #Some(y) => y.clone(), #None => String.new() }})`);
    }
    if (fields.len() == 0) { fields.push("  fly_unit empty;\n"); }
    self.typeDefs.push(`typedef struct {\n${fields}} ${frame};\n`);
    // The arms.
    let cx = self.apartCtx(ap, #Prim(#Void), #Fn);
    cx.direct = true;
    if (yields) { cx.sink = #Some("(*env->y_)".toString()); }
    const saved = replace(mut self.cx, cx);
    for (const arm of h.arms) {
      let binds = String.new();
      let tys: Vec<Ty> = Vec.new();
      for (const p of arm.params) { tys.push(self.cx.locals[p].ty.clone()); }
      if (tys.len() > 0) {
        const tc = self.ctype(#Tuple(tys.clone()), span);
        for (const [i, p] of arm.params.iter().enumerate()) {
          if (unitTy(self.cx.locals[p].ty)) { continue; }
          binds.push(`${self.local(p)} = ((${tc}*)args_)->f${i}; `);
        }
      }
      self.line(`if (op_ == ${arm.op}) {`);
      self.cx.prologue = binds;
      for (const p of arm.params) { self.gen(p); }
      self.cx.reachable = true;
      self.block(arm.body, span);
      self.line("goto ret; }");
    }
    const armsCode = replace(mut self.cx.out, String.new());
    const more = replace(mut self.cx.decls, String.new());
    self.cx = saved;
    self.protos.push(`static void harm_${n}(void* env_, int op_, void* args_, void* result_);\n`);
    self.apartCode.push(`static void harm_${n}(void* env_, int op_, void* args_, void* result_) {\n  ${frame}* env = env_; (void)env; (void)args_; (void)result_;\n${more}${armsCode}  fly_panic("an operation no arm handles");\nfail: ;\nret: ;\n}\n`);
    // The handler, installed for the body.
    const hf = self.fresh();
    const hh = self.fresh();
    self.cx.decls.push(`  ${frame} ${hf};\n  fly_handler ${hh};\n`);
    self.line(`${hf} = (${frame}){ ${inits.join(", ")} }; ${hh} = (fly_handler){ .effect = ${d}, .op = -1, .outer = fly_handlers, .direct = harm_${n}, .frame = &${hf} }; fly_handlers = &${hh};`);
    if (!unitTy(b)) {
      self.cx.hoisted.insert(h.value);
      const bc = self.ctype(b, span);
      const vl = self.local(h.value);
      self.cx.decls.push(`  ${bc} ${vl} = { 0 };\n`);
    }
    self.tmp += 1;
    const k = self.tmp;
    const parent = self.target();
    const out = `hx${k}`;
    self.cx.targets.push(out.clone());
    self.block(h.body, span);
    self.cx.targets.pop();
    if (self.cx.reachable) {
      const store = if (unitTy(b)) { String.new() } else { `${self.local(h.result)} = ${self.local(h.value)}; ` };
      self.line(`fly_handlers = ${hh}.outer; ${store}`);
    }
    // A failure or an unwinding leaving the body leaves the handler too.
    if (const #Some(at) = self.cx.liveAt.get(out.asStr())) {
      const at2 = at.clone();
      self.line(`goto hdone${k};`);
      self.line(`${out}: fly_handlers = ${hh}.outer; goto ${parent};`);
      let set: HashSet<usize> = match (self.cx.liveAt.get(parent.asStr())) { #Some(x) => x.clone(), #None => HashSet.new() };
      for (const l of at2.iter()) { set.insert(l); }
      self.cx.liveAt.insert(parent.clone(), set);
      self.line(`hdone${k}: ;`);
    }
  }
}

// ---- closures and functions ----

impl Cgen {
  // A closure: an environment holding values is the closure's own, on the heap, dropped with it;
  // one that only borrows lives as long as the function around it, which the closure cannot
  // outlive if it is only lent.
  function closure(self: mut Self, k: usize, caps: readonly Vec<Capture>, lent: bool, span: Span): String uses Fail<Diagnostic> {
    const f = self.lw.closures[k].clone();
    let inits: Vec<String> = Vec.new();
    let held = false;
    for (const [i, c] of caps.iter().enumerate()) {
      match (c) {
        #Value(op) => {
          held = true;
          inits.push(`.c${i} = ${self.operand(op, span)}`);
        }
        #Ref(_, p) => inits.push(`.c${i} = &(${self.lvalue(p, span)})`),
      }
    }
    for (const r of f.regions) {
      match (self.cx.arenas.get(r)) {
        #Some(a) => inits.push(`.ar_${r} = ${a}`),
        #None => {}
      }
    }
    if (inits.len() == 0) { return `((fly_fn){ NULL, NULL, (void*)lam_${k} })`; }
    if (held || !lent) {
      return `({ env_${k}* e_ = fly_alloc(sizeof(env_${k})); *e_ = (env_${k}){ ${inits.join(", ")} }; (fly_fn){ e_, envdrop_${k}, (void*)lam_${k} }; })`;
    }
    const env = self.fresh();
    self.cx.decls.push(`  env_${k} ${env};\n`);
    `({ ${env} = (env_${k}){ ${inits.join(", ")} }; (fly_fn){ &${env}, NULL, (void*)lam_${k} }; })`
  }

  // A function instance as a value: a closure with no environment.
  function fnValue(self: mut Self, i: usize, span: Span): String uses Fail<Diagnostic> {
    const fid = self.lw.insts[i].fid;
    const args = self.lw.insts[i].args.clone();
    const params = self.lw.paramTys(fid, args);
    let pcs: Vec<String> = Vec.new();
    let names: Vec<String> = Vec.new();
    for (const [k, t] of params.iter().enumerate()) {
      pcs.push(`${self.ctype(t, span)} a${k}`);
      names.push(`a${k}`);
    }
    const rt = self.ctype(self.lw.concreteRet(fid, self.lw.insts[i].args), span);
    const name = `fnv_${i}`;
    if (!self.helpers.has(name.asStr())) {
      self.helpers.insert(name.clone(), name.clone());
      const sep = if (pcs.len() > 0) { ", " } else { "" };
      self.apartCode.push(`static ${rt} ${name}(void* env${sep}${pcs.join(", ")}) { (void)env; return ${self.lw.insts[i].name}(${names.join(", ")}); }\n`);
      self.protos.push(`static ${rt} ${name}(void* env${sep}${pcs.join(", ")});\n`);
    }
    `((fly_fn){ NULL, NULL, (void*)${name} })`
  }

  // A function's C body: its locals, zeroed; its parameters; its body; its ways out.
  function body(self: mut Self, f: readonly Func, inits: str): String uses Fail<Diagnostic> {
    const ret = self.cx.ret.clone();
    const rt = self.ctype(ret, f.span);
    // The function's value is read once its blocks have ended.
    let decls = String.new();
    if (!unitTy(f.ret)) {
      self.cx.hoisted.insert(f.value);
      decls.push(`  ${rt} ${self.local(f.value)} = { 0 };\n`);
    }
    // The parameters are the outermost block's, given their values as it starts.
    self.cx.prologue = inits.toString();
    for (const l of f.params) { self.gen(l); }
    self.block(f.body, f.span);
    const code = replace(mut self.cx.out, String.new());
    const value = if (unitTy(f.ret)) { "(fly_unit)0".toString() } else { self.local(f.value) };
    const more = replace(mut self.cx.decls, String.new());
    `${decls}${more}  ${rt} ret_ = { 0 };\n${code}  return ${value};\nfail: return (${rt}){ 0 };\nret: return ret_;\n`
  }

  // Function instance `i`, lowered as `f`.
  function emit(self: mut Self, i: usize, f: Func): void uses Fail<Diagnostic> {
    self.fnName = f.name.clone();
    self.cx = newCtx(f.locals.clone(), f.ret.clone(), #Fn);
    let params: Vec<String> = Vec.new();
    let inits = String.new();
    for (const [k, l] of f.params.iter().enumerate()) {
      const pc = self.ctype(f.locals[l].ty, f.span);
      params.push(`${pc} p${k}`);
      inits.push(`${self.local(l)} = p${k}; `);
    }
    // A function that performs `Region<R>` is given R's arena.
    for (const id of f.regions) {
      params.push(`fly_arena* ar_${id}`);
      self.cx.arenas.insert(id, `ar_${id}`);
    }
    // A generator function is given what its yields go to.
    if (f.yields.isSome()) {
      params.push("fly_yield y_".toString());
      self.cx.sink = #Some("y_".toString());
    }
    const rt = self.ctype(f.ret, f.span);
    const b = self.body(f, inits.asStr());
    const sig = `static ${rt} ${f.name}(${if (params.len() == 0) { "void".toString() } else { params.join(", ") }})`;
    self.protos.push(`${sig};\n`);
    self.code.push(`${sig} {\n${b}}\n`);
  }

  // Closure `k`: its body a C function of its environment, which holds the values it holds and
  // pointers to what it borrows.
  function emitClosure(self: mut Self, k: usize): void uses Fail<Diagnostic> {
    const f = self.lw.closures[k].clone();
    self.fnName = f.name.clone();
    self.module = f.module;
    self.cx = newCtx(f.locals.clone(), f.ret.clone(), #Fn);
    let fields = String.new();
    let owned = String.new();
    for (const [i, [_, t, byValue]] of f.captures.iter().enumerate()) {
      const ct = self.ctype(t, f.span);
      if (byValue) {
        fields.push(`  ${ct} c${i};\n`);
        self.cx.captures.push(`env->c${i}`);
        if (self.needsDrop(t)) { owned.push(`${self.dropFn(t, f.span)}(&e->c${i}); `); }
      } else {
        fields.push(`  ${ct}* c${i};\n`);
        self.cx.captures.push(`(*env->c${i})`);
      }
      self.cx.capTys.push(t.clone());
    }
    for (const r of f.regions) {
      fields.push(`  fly_arena* ar_${r};\n`);
      self.cx.arenas.insert(r, `env->ar_${r}`);
    }
    if (fields.len() == 0) { fields.push("  fly_unit empty;\n"); }
    self.typeDefs.push(`typedef struct {\n${fields}} env_${k};\n`);
    self.protos.push(`static void envdrop_${k}(void* p);\n`);
    self.apartCode.push(`static void envdrop_${k}(void* p) { env_${k}* e = p; ${owned}free(e); }\n`);
    let pcs: Vec<String> = Vec.new();
    let inits = String.new();
    for (const [i, l] of f.params.iter().enumerate()) {
      const pc = self.ctype(f.locals[l].ty, f.span);
      pcs.push(`${pc} p${i}`);
      inits.push(`${self.local(l)} = p${i}; `);
    }
    // A closure that yields is given what its yields go to, as a generator function is.
    if (f.yields.isSome()) {
      pcs.push("fly_yield y_".toString());
      self.cx.sink = #Some("y_".toString());
    }
    const rt = self.ctype(f.ret, f.span);
    const b = self.body(f, inits.asStr());
    const sep = if (pcs.len() > 0) { ", " } else { "" };
    self.protos.push(`static ${rt} lam_${k}(void* env_${sep}${pcs.join(", ")});\n`);
    self.apartCode.push(`static ${rt} lam_${k}(void* env_${sep}${pcs.join(", ")}) {\n  env_${k}* env = env_; (void)env;\n${b}}\n`);
  }

  // A diagnostic, rendered in the module it arose in.
  export function failed(self: readonly Self, d: Diagnostic, module: usize): #Failed(String) {
    #Failed(render(d, self.lw.p.modules[module].file.asStr(), self.lw.p.modules[module].source.asStr()))
  }

  // The C for a checked program whose entry module is `entry`.
  export function program(self: mut Self, entry: usize, runtime: str, freestanding: bool): String uses Fail<#Failed(String)> {
    const ent = self.lw.entry(entry, freestanding);
    const uncaught = self.uncaught(ent, entry);
    let next: usize = 0;
    while (next < self.lw.insts.len() || self.closuresDone < self.lw.closures.len()) {
      if (next < self.lw.insts.len()) {
        const i = next;
        next += 1;
        const r = try {
          match (self.lw.func(i)) {
            #Some(f) => {
              self.module = f.module;
              self.emit(i, f);
            }
            #None => {}
          }
          #Ok
        } catch (d) { #Err(d) };
        if (const #Err(d) = r) { throw self.failed(d, self.lw.module) }
      } else {
        const k = self.closuresDone;
        self.closuresDone += 1;
        const r = try { self.emitClosure(k); #Ok } catch (d) { #Err(d) };
        if (const #Err(d) = r) { throw self.failed(d, self.module) }
      }
    }
    self.assemble(ent, uncaught, runtime)
  }

  // What `main` does with a failure nothing caught: shows it, as the reference shows it.
  export function uncaught(self: mut Self, ent: readonly Entry, entry: usize): String uses Fail<#Failed(String)> {
    const errTy = match (ent.fails) { #Some(t) => t.clone(), #None => return "  if (FLY_FAILED) { printf(\"<uncaught failure>\\n\"); return 1; }\n".toString() };
    const r = try {
      const ec = self.ctype(errTy, { start: 0, end: 0 });
      const take = self.takeErr("e", errTy);
      const show = self.ifaceCall("Show", "show", errTy, ["(&e)".toString(), "(&s)".toString()], { start: 0, end: 0 });
      #Ok(`  if (FLY_FAILED) {\n    ${ec} e;\n    memset(&e, 0, sizeof e);\n    ${take}\n    fly_String s = fly_String_new();\n    ${show};\n    printf("<uncaught: %.*s>\\n", (int)s.len, (const char*)s.ptr);\n    return 1;\n  }\n`)
    } catch (d) { #Err(d) };
    match (r) {
      #Ok(u) => u,
      #Err(d) => throw self.failed(d, entry),
    }
  }

  // The C file: the runtime, the program's types and code, the functions C calls, and `main`.
  export function assemble(self: mut Self, ent: readonly Entry, uncaught: str, runtime: str): String uses Fail<#Failed(String)> {
    // The structs only pointers were made to.
    while (self.pending.len() > 0) {
      const t = match (self.pending.pop()) { #Some(t) => t, #None => break };
      const r = try { self.ctype(t, { start: 0, end: 0 }); #Ok } catch (d) { #Err(d) };
      if (const #Err(d) = r) { throw self.failed(d, 0) }
    }
    // `main` is given the command line, as its parameters' types read it; the lists it is lent are
    // freed once it returns.
    let args: Vec<String> = Vec.new();
    let lists = String.new();
    let frees = String.new();
    for (const [k, a] of ent.args.iter().enumerate()) {
      args.push(match (a) {
        #Int(t) => `(${self.primOf(t)})fly_arg_int(${k})`,
        #Float(t) => `(${self.primOf(t)})fly_arg_float(${k})`,
        #Str => `fly_arg_str(${k})`,
        #Strings | #Strs => {
          const strings = match (a) { #Strings => true, _ => false };
          lists.push(`fly_slice a${k} = fly_arg_${if (strings) { "strings" } else { "strs" }}(${k}); `);
          frees.push(` fly_args_free(a${k}, ${strings});`);
          `a${k}`
        }
      });
    }
    // The functions C calls, by their own symbols.
    let exports = String.new();
    for (const i of ent.exports) {
      const r = try { #Ok(self.exportWrapper(i)) } catch (d) { #Err(d) };
      match (r) {
        #Ok(w) => exports.push(w.asStr()),
        #Err(d) => throw self.failed(d, self.lw.p.fns[self.lw.insts[i].fid].module),
      }
    }
    // A program that starts tasks runs them on every core: the runtime's state is each thread's.
    let out = if (ent.tasks) { "#define FLY_TASKS 1\n".toString() } else { String.new() };
    out.push(runtime);
    out.push("\n// ---- the program ----\n");
    out.push(self.typeFwd.asStr());
    out.push(self.typeDefs.asStr());
    out.push(self.protos.asStr());
    out.push(self.dropCode.asStr());
    out.push(self.apartCode.asStr());
    out.push(self.code.asStr());
    out.push(self.glue.asStr());
    out.push(exports.asStr());
    const main = match (ent.main) { #Some(m) => self.lw.insts[m].name.clone(), #None => return out };
    out.push(`static void fly_main_run(void) { ${lists}${main}(${args.join(", ")});${frees} }\n`);
    // A program that starts tasks, or makes channels or locks, runs `main` as the first task.
    const run = if (ent.tasks) { "fly_tasks_run(fly_main_run)" } else { "fly_main_run()" };
    out.push(`int main(int argc, char** argv) {\n  fly_argc = argc;\n  fly_argv = argv;\n  ${run};\n${uncaught}  return 0;\n}\n`);
    out
  }

  // A function C calls: its symbol, calling its instance.
  function exportWrapper(self: mut Self, i: usize): String uses Fail<Diagnostic> {
    const fid = self.lw.insts[i].fid;
    const args = self.lw.insts[i].args.clone();
    const ps = self.lw.paramTys(fid, args.clone());
    const ret = self.lw.concreteRet(fid, args);
    let decls: Vec<String> = Vec.new();
    let names: Vec<String> = Vec.new();
    for (const [k, t] of ps.iter().enumerate()) {
      decls.push(`${self.ctype(t, { start: 0, end: 0 })} a${k}`);
      names.push(`a${k}`);
    }
    const name = self.lw.p.fns[fid].name.clone();
    const params = if (decls.len() == 0) { "void".toString() } else { decls.join(", ") };
    const call = `${self.lw.insts[i].name}(${names.join(", ")})`;
    // Declared under a name of the program's bound to the symbol, so a C declaration of the same
    // symbol with types C spells differently does not conflict.
    const rt = if (isVoidTy(ret)) { "void".toString() } else { self.ctype(ret, { start: 0, end: 0 }) };
    const body = if (isVoidTy(ret)) { `{ ${call}; }` } else { `{ return ${call}; }` };
    `${rt} fly_export_${name}(${params}) FLY_SYMBOL(${name});\n${rt} fly_export_${name}(${params}) ${body}\n`
  }

  function primOf(self: readonly Self, t: readonly Ty): str {
    match (t) { #Prim(p) => primType(p), _ => "int64_t" }
  }
}

// A printer of C for the program.
export function newCgen(p: Prog): Cgen {
  Cgen {
    lw: newLower(p), closuresDone: 0, types: HashMap.new(), defined: HashSet.new(), pending: Vec.new(), typeFwd: String.new(),
    typeDefs: String.new(), tags: HashMap.new(), drops: HashMap.new(), anyDrops: HashSet.new(), dropCode: String.new(), convs: HashMap.new(),
    helpers: HashMap.new(), consts: HashMap.new(), protos: String.new(), code: String.new(), apartCode: String.new(), aparts: 0,
    tmp: 0, cx: newCtx(Vec.new(), #Prim(#Void), #Fn), module: 0, defers: HashMap.new(), fnName: String.new(),
    argPlaces: Vec.new(), glue: String.new(),
  }
}

// The C for a checked program: the runtime, then the code its `main` reaches.
export function cProgram(p: Prog, entry: usize, runtime: str, freestanding: bool): String uses Fail<#Failed(String)> {
  let c = newCgen(p);
  c.program(entry, runtime, freestanding)
}
