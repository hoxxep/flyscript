// expect: index: /
// expect: todo 7
// expect: todo a b, q: x y
// expect: no match
// expect: no match
// expect: docs a/b c
// expect: no match
// expect: all ''
// expect: all x
// Routes as their files name them: `index` answers its directory, `[id]` any one segment, `[...p]`
// one or more, and `[[...p]]` any number.
import { println } from "std/io";
import { matches } from "../../web/router";

export function main(): void uses Io {
  if (const #Some(_) = matches("/", "/")) { println("index: /"); }
  if (const #Some(p) = matches("/todos/[id]", "/todos/7")) { println(`todo ${p.get("id")}`); }
  if (const #Some(p) = matches("/todos/[id]", "/todos/a%20b?q=x+y")) {
    const q = match (p.query("q")) { #Some(v) => v, #None => String.new() };
    println(`todo ${p.get("id")}, q: ${q}`);
  }
  match (matches("/todos/[id]", "/todos")) { #Some(_) => println("matched"), #None => println("no match") }
  match (matches("/about", "/todos")) { #Some(_) => println("matched"), #None => println("no match") }
  if (const #Some(p) = matches("/docs/[...path]", "/docs/a/b%20c")) { println(`docs ${p.get("path")}`); }
  match (matches("/docs/[...path]", "/docs")) { #Some(_) => println("matched"), #None => println("no match") }
  if (const #Some(p) = matches("/all/[[...path]]", "/all")) { println(`all '${p.get("path")}'`); }
  if (const #Some(p) = matches("/all/[[...path]]", "/all/x")) { println(`all ${p.get("path")}`); }
}
