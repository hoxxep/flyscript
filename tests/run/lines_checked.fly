// expect: 6000 lines, none read otherwise than checked, 3297 well formed, hash 3718650177653788371
// The line reader checks a line's UTF-8 as it finds its end: each line read is what checking its
// bytes gives, for lines of up to 80 bytes, mostly ASCII with code points of every length among it,
// half of them then corrupted by one byte that decides UTF-8 — a lead, a continuation, an
// overlong, surrogate or too-large edge — or cut short before the `\n`, so that every kind of
// error meets every place in the first blocks of sixteen a line is scanned in, and the `\n`.
import { println, File } from "std/io";

const EDGES: u8[] = [0x00, 0x41, 0x7F, 0x80, 0x8F, 0x90, 0x9F, 0xA0, 0xBF, 0xC0, 0xC1, 0xC2, 0xDF, 0xE0, 0xE1, 0xED, 0xEE, 0xEF, 0xF0, 0xF1, 0xF3, 0xF4, 0xF5, 0xFF];
const POINTS: u32[] = [0xE9, 0x7FF, 0x800, 0x4E2D, 0xD7FF, 0xE000, 0xFFFD, 0x10000, 0x1F600, 0x10FFFF];

function next(seed: mut u64): u64 {
  seed = seed.wrappingMul(6364136223846793005).wrappingAdd(1442695040888963407);
  seed >> 33
}

function encode(out: mut Vec<u8>, cp: u32): void {
  if (cp < 0x80) { out.push(cp as u8); }
  else if (cp < 0x800) { out.push((0xC0 | (cp >> 6)) as u8); out.push((0x80 | (cp & 0x3F)) as u8); }
  else if (cp < 0x10000) { out.push((0xE0 | (cp >> 12)) as u8); out.push((0x80 | ((cp >> 6) & 0x3F)) as u8); out.push((0x80 | (cp & 0x3F)) as u8); }
  else { out.push((0xF0 | (cp >> 18)) as u8); out.push((0x80 | ((cp >> 12) & 0x3F)) as u8); out.push((0x80 | ((cp >> 6) & 0x3F)) as u8); out.push((0x80 | (cp & 0x3F)) as u8); }
}

export function main(): void uses Io, Fail<IoErr> {
  let seed: u64 = 7919;
  let lines: Vec<Vec<u8>> = Vec.new();
  let all: Vec<u8> = Vec.new();
  for (const _ of 0..6000) {
    let b: Vec<u8> = Vec.new();
    const n = (next(mut seed) % 81) as usize;
    while (b.len() < n) {
      if (next(mut seed) % 6 == 0) { encode(mut b, POINTS[(next(mut seed) % 10) as usize]); }
      else { b.push((0x61 + next(mut seed) % 26) as u8); }
    }
    match (next(mut seed) % 4) {
      0 => { if (b.len() > 0) { const at = (next(mut seed) % b.len() as u64) as usize; b[at] = EDGES[(next(mut seed) % 24) as usize]; } },
      1 => { encode(mut b, POINTS[(next(mut seed) % 10) as usize]); b.pop(); },
      _ => {},
    }
    all.extend(b);
    all.push(10);
    lines.push(b);
  }
  let w = File.create("lines.txt");
  w.write(all);
  w.close();
  let r = File.open("lines.txt");
  let i: usize = 0;
  let differ: u64 = 0;
  let valid: u64 = 0;
  let h: u64 = 0;
  for (const l of r.lines()) {
    const want = String.fromUtf8Lossy(lines[i].clone());
    if (l != want) { differ += 1; }
    if (want.len() == lines[i].len() && want.asBytes() == lines[i]) { valid += 1; }
    for (const c of l.asBytes()) { h = (h ^ c as u64).wrappingMul(1099511628211); }
    i += 1;
  }
  r.close();
  const none = if (differ == 0) { "none" } else { "some" };
  println(`${i} lines, ${none} read otherwise than checked, ${valid} well formed, hash ${h}`);
}
