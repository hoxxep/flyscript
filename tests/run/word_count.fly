// file: b.txt=cat hat
// expect: missing.txt: #NotFound
// expect: 3 the
// expect: 2 cat
// expect: 2 hat
// expect: 1 end
import { main as count } from "../../examples/word_count";

export function main(): void uses Io {
  const files: String[3] = [String.fromStr("a.txt"), String.fromStr("missing.txt"), String.fromStr("b.txt")];
  count(files);
}
