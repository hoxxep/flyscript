// expect: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
// expect: cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7
// expect: ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f
// expect: 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// expect: 164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737
// expect: 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
// expect: 522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662 76fc6ece0f4e1768cddf8853bb2d551b
// expect: opened true, forged #None #None
// expect: d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a
// expect: e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b
// expect: verified true, tampered false false
// expect: true false false
// expect: 16 fc289bca3a601bdc false
// expect: 0707070707070707
// Cryptography (std/crypto) against the standards' own test vectors: FIPS 180-4's SHA-2, RFC 4231's
// HMAC, RFC 5869's HKDF, the GCM specification's AES-256 case, and RFC 8032's Ed25519. Random
// bytes are `Io.random`'s, of the simulated world's seed here; a handler may give its own.
import { println } from "std/io";
import { sha256, sha384, sha512, hmacSha256, hmacSha512, hkdfSha256, aesGcmSeal, aesGcmOpen, ed25519PublicKey, ed25519Sign, ed25519Verify, constantTimeEqual } from "std/crypto";

function hex(b: readonly u8[]): String {
  const digits = "0123456789abcdef".asBytes();
  let out: Vec<u8> = Vec.new();
  for (const x of b) { out.push(digits[(x >> 4) as usize]); out.push(digits[(x & 15) as usize]); }
  String.fromUtf8(out).unwrap()
}

function unhex(s: str): Vec<u8> {
  const b = s.asBytes();
  let out: Vec<u8> = Vec.new();
  let i: usize = 0;
  while (i + 1 < b.len()) {
    const d = (c: u8) => if (c >= 97) { c - 87 } else { c - 48 };
    out.push(d(b[i]) * 16 + d(b[i + 1]));
    i += 2;
  }
  out
}

export function main(): void uses Io {
  const abc = "abc".asBytes();
  println(hex(sha256(abc)));
  println(hex(sha384(abc)));
  println(hex(sha512(abc)));
  const jefe = "Jefe".asBytes();
  const want = "what do ya want for nothing?".asBytes();
  println(hex(hmacSha256(jefe, want)));
  println(hex(hmacSha512(jefe, want)));
  println(hex(hkdfSha256(unhex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), unhex("000102030405060708090a0b0c"), unhex("f0f1f2f3f4f5f6f7f8f9"), 42)));
  const key = unhex("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308");
  const nonce = unhex("cafebabefacedbaddecaf888");
  const plain = unhex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39");
  const aad = unhex("feedfacedeadbeeffeedfacedeadbeefabaddad2");
  const sealed = aesGcmSeal(key, nonce, plain, aad);
  println(`${hex(sealed[0..sealed.len() - 16])} ${hex(sealed[sealed.len() - 16..sealed.len()])}`);
  const opened = aesGcmOpen(key, nonce, sealed, aad);
  let forged = sealed.clone();
  forged[0] = forged[0] ^ 1;
  println(`opened ${opened == #Some(plain)}, forged ${aesGcmOpen(key, nonce, forged, aad)} ${aesGcmOpen(key, nonce, sealed, "other".asBytes())}`);
  const secret = unhex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
  const public = ed25519PublicKey(secret);
  println(hex(public));
  const empty: u8[] = [];
  const signature = ed25519Sign(secret, empty);
  println(hex(signature));
  let bent = signature.clone();
  bent[63] = bent[63] ^ 0x40;
  println(`verified ${ed25519Verify(public, empty, signature)}, tampered ${ed25519Verify(public, abc, signature)} ${ed25519Verify(public, empty, bent)}`);
  println(`${constantTimeEqual(abc, "abc".asBytes())} ${constantTimeEqual(abc, "abd".asBytes())} ${constantTimeEqual(abc, "ab".asBytes())}`);
  let a: u8[16] = repeat(0 as u8);
  let b: u8[16] = repeat(0 as u8);
  Io.random(mut a);
  Io.random(mut b);
  println(`${a.len()} ${hex(a[0..8])} ${a == b}`);
  // A test answers `random` itself, as any of `Io`'s operations.
  let fixed: u8[8] = repeat(0 as u8);
  handle { Io.random(mut fixed); } with Io { random(buf) resumes k => { for (const i of 0..buf.len()) { buf[i] = 7; } k() } }
  println(hex(fixed));
}
