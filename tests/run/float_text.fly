// expect: 0.30000000000000004
// expect: 0.3333333333333333
// expect: -2.5
// expect: -0.0
// expect: 1000000000000000
// expect: 1000000000000000000000
// expect: 123456789012345680000
// expect: 0.00000015
// expect: 0.
// expect: 1797693134862315500
// expect: inf
// expect: -inf
// expect: NaN
// expect: 0.12
// expect: 0.38
// expect: 2
// expect: -0.00
// expect: 1.00
// expect: 1000000000000000000000.0
// expect: 123.4560000000
// expect: 1 -> 1.0
// expect: -1.5 -> -1.5
// expect: +.5 -> 0.5
// expect: 5. -> 5.0
// expect: 1e3 -> 1000.0
// expect: 2.5E-3 -> 0.0025
// expect: 1e -> none
// expect: . -> none
// expect:  1 -> none
// expect: 1  -> none
// expect: inf -> none
// expect: 0x10 -> none
// expect: 9007199254740993 -> 9007199254740992
// expect: 4.9406564584124654e-324 -> 0.
// expect: 1e400 -> inf
// How floats are written and read (std): the fewest digits that read back as the float, the nearest
// of them, in full and without an exponent; `toFixed` to the nearest, halfway to the even; and
// `parseFloat`, an optional sign, digits around a point and an exponent, read to the nearest.
import { println } from "std/io";

function show(v: f64): void uses Io { println(`${v}`); }

export function main(): void uses Io {
  show(0.1 + 0.2);
  show(1.0 / 3.0);
  show(-2.5);
  show(-0.0);
  show(1e15);
  show(1e21);
  show(123456789012345680000.0);
  show(1.5e-7);
  show(5e-324);
  show(1.7976931348623157e308 / 1e290);
  show(2.0 / 0.0);
  show(-1.0 / 0.0);
  show(0.0 / 0.0);
  println((0.125).toFixed(2));
  println((0.375).toFixed(2));
  println((2.5).toFixed(0));
  println((-0.001).toFixed(2));
  println((1.005).toFixed(2));
  println((1e21).toFixed(1));
  println((123.456).toFixed(10));
  for (const t of ["1", "-1.5", "+.5", "5.", "1e3", "2.5E-3", "1e", ".", " 1", "1 ", "inf", "0x10", "9007199254740993", "4.9406564584124654e-324", "1e400"]) {
    match (parseFloat(t)) {
      #Some(v) => println(`${t} -> ${v}`),
      #None => println(`${t} -> none`),
    }
  }
}
