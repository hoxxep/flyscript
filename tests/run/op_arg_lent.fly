// expect: [log] hello
// expect: after hello
// expect: stopped: disk full
// A resumptive arm uses a borrowed argument before it resumes; an arm that does not resume takes
// an owned one (§5.3).
import { println } from "std/io";
effect Log { log(msg: str): void; }
effect Stop { stop(why: String): never; }
export function main(): void uses Io {
  handle {
    const line = "hello".toString();
    Log.log(line.asStr());
    println(`after ${line}`);
  } with Log { log(msg) resumes k => { println(`[log] ${msg}`); k() } }
  const r = handle { Stop.stop("disk full".toString()) } with Stop { stop(why) => why };
  println(`stopped: ${r}`);
}
