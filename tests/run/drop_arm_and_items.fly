// expect: kept a; a: [1, 2], b: [9]
// expect: items: [1, 2]
// What an arm takes and does not move on is dropped where the arm ends, and what it moves is
// dropped where it goes; each item a loop takes is dropped where its iteration ends (§5.6). A
// destructor performs nothing, so each value notes its drop in a log it borrows.
import { println } from "std/io";

view struct Noisy { log: mut Vec<u32>; n: u32 }
impl Drop for Noisy { function drop(self: mut Self): void { self.log.push(self.n); } }

function keep(n: Noisy): void {
  n.log.push(1);
  const m = n;
  gone(m);
}
function gone(n: Noisy): void {}

export function main(): void uses Io {
  let la: Vec<u32> = Vec.new();
  let lb: Vec<u32> = Vec.new();
  {
    const pair = [Noisy { log: mut la, n: 2 }, Noisy { log: mut lb, n: 9 }];
    match (pair) {
      [a, b] => { keep(a); }
    }
  }
  println(`kept a; a: ${la}, b: ${lb}`);
  let li: Vec<u32> = Vec.new();
  for (const i of 1..3) {
    const it = Noisy { log: mut li, n: i };
  }
  println(`items: ${li}`);
}
