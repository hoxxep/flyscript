// expect: [true, null, "hi", [true]]
// expect: error: #Unexpected(1)
import { Json, parseJson } from "../../examples/json";
import { println } from "std/io";

function show<region R>(j: Ref<Json>): String {
  match (j) {
    #Null => "null".toString(),
    #Bool(b) => `${b}`,
    #Num(n) => `${n}`,
    #Str(s) => `"${s}"`,
    #Arr(items) => {
      let out = "[".toString();
      let first = true;
      for (const item of items) {
        if (!first) { out.push(", "); }
        first = false;
        out.push(show(item));
      }
      out.push("]");
      out
    },
    #Obj(_) => ("{...}").toString(),
  }
}

export function main(): void uses Io {
  for (const text of ["[true, null, \"hi\", [true]]", "[?]"]) {
    region (R) {
      try { println(show(parseJson(text))); } catch (e) { println(`error: ${e}`); }
    }
  }
}
