// expect: 1
// expect: 2
// expect: 10 11
// `while (const|let Pat = e)` loops while `e` matches the pattern (§3.6).
import { println } from "std/io";
import { channel } from "std/sync";
function below(n: i32, limit: i32): Option<i32> {
  if (n < limit) { #Some(n) } else { #None }
}
export function main(): void uses Io {
  const [tx, rx] = channel<i32>();
  tx.send(1);
  tx.send(2);
  tx.close();
  while (const #Some(m) = rx.recv()) {
    println(`${m}`);
  }
  let n = 0;
  let seen = "";
  while (let #Some(x) = below(n, 2)) {
    x += 10;
    seen = if (seen == "") { `${x}` } else { `${seen} ${x}` };
    n += 1;
  }
  println(seen);
}
