// expect: caught outer
// A generator dropped as a failure unwinds past it runs its cleanup, which fails and catches a
// failure of its own: the failure unwinding past it is still the one caught (§5.3, §5.6).
import { println } from "std/io";

function nums(): void uses Yield<i32> {
  defer {
    try { throw #Ignore; } catch (_) {}
  };
  yield 1;
  yield 2;
}

function risky(): void uses Fail<#OuterErr> {
  let g = generate(() => nums());
  const _ = g.next();
  throw #OuterErr;
}

export function main(): void uses Io {
  try { risky(); } catch (e) { match (e) { #OuterErr => println("caught outer") } }
}
