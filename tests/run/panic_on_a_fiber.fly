// A panic on a fiber (a generator's, or under a handler) unwinds the task as one anywhere does:
// the generator's own cleanup runs, then the task that pulled from it unwinds.
// expect: #Some(1) #Some(2)
// expect: the generator cleans up
// expect: the consumer cleans up
// expect: <panic: producer gave up>
import { println } from "std/io";
export function main(): void uses Io {
  defer println("the consumer cleans up");
  let g = generate(() => {
    defer println("the generator cleans up");
    yield 1;
    yield 2;
    panic("producer gave up");
  });
  println(`${g.next()} ${g.next()}`);
  println(`${g.next()}`);
}
