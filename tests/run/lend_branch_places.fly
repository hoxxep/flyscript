// expect: none
// expect: n1
// expect: n2
// expect: x
// expect: x
// A branch lent that ends in a place lends the place, not a copy of it: the place still owns what it
// holds, which the borrow must not drop (§4.1, §5.6).
import { println } from "std/io";
function show(s: readonly String): void uses Io { println(s.asStr()); }
export function main(): void uses Io {
  const fallback = "none".toString();
  for (const i of 0..3) {
    const narrowed: Option<String> = if (i > 0) { #Some(`n${i}`) } else { #None };
    show(match (narrowed) { #Some(n) => n, #None => fallback.clone() });
  }
  const s = "x".toString();
  show(if (s.len() > 0) { s } else { fallback.clone() });
  println(s.asStr());
}
