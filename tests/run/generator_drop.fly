// expect: #Some(0) #Some(1)
// expect: producer cleaned up
// expect: after the block
// Dropping a generator before it finishes unwinds it, running its cleanup (§5.5, §5.6).
import { println } from "std/io";
// A producer whose cleanup prints when it is unwound.
function numbers(): void uses Yield<i32>, Io {
  defer println("producer cleaned up");
  let i = 0;
  while (true) { yield i; i += 1; }
}
export function main(): void uses Io {
  {
    let g = generate(() => numbers());
    println(`${g.next()} ${g.next()}`);
  }
  println("after the block");
}
