// A panic in a task ends the program at once (§5.7): the other tasks stop where they are, and
// none runs its cleanup, which could wait forever on what the panicking task never let go of.
// expect: slow task starts
// expect: body ends
// expect: <panic: index 7 out of bounds (length 3)>
import { println } from "std/io";

function risky(n: u32): u32 uses Io {
  Io.sleep(Duration.ms(5));
  const xs = [1, 2, 3];
  xs[n as usize]
}

export function main(): void uses Io {
  Io.scope((s) => {
    s.spawn(() => {
      defer println("not reached: a panic runs no cleanup");
      println("slow task starts");
      Io.sleep(Duration.ms(10));
      println("slow task ends");
    });
    s.spawn(() => { println(`got ${risky(7)}`); });
    println("body ends");
  });
  println("never printed");
}
