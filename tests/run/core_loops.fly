// expect: 63
// core: run
// In λ-fly's part of the language, and certified by the proof's checker (tests/proof.rs): loops and
// arithmetic, a `mut` borrow, a box, a struct of two lent `readonly`, a vector.
import { println } from "std/io";

struct Span { lo: i64; hi: i64 }

function sumTo(n: i64): i64 {
  let s: i64 = 0;
  let i: i64 = 1;
  while (i <= n) {
    s += i;
    i += 1;
  }
  s
}

function bump(r: mut i64): void { r += 1; }

function width(s: readonly Span): i64 { s.hi - s.lo }

function run(): i64 {
  let x: i64 = sumTo(10);
  bump(mut x);
  const b = Box.new(x);
  const sp = Span { lo: 2, hi: 9 };
  const w = width(sp);
  let v: Vec<i64> = Vec.new();
  v.push(w);
  v.push(b.get() * 2);
  if (v.len() == 2 && w > 0) { x + w } else { 0 }
}

export function main(): void uses Io { println(`${run()}`); }
