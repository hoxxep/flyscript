// expect: a,b
// expect: a,b
// expect: a;b
// Declared outside the scope, a value is lent to every task, and usable after (§6.1).
import { println } from "std/io";
export function main(): void uses Io {
  const names = ["a".toString(), "b".toString()];
  Io.scope((s) => {
    s.spawn(() => { println(names.join(",")); });
    s.spawn(() => { println(names.join(",")); });
  });
  println(names.join(";"));
}
