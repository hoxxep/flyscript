// expect: 0
// expect: 7
// A continuation that leaves its arm, resumed after its `handle` returns, finishes the body then
// (§5.3).
import { println } from "std/io";
effect Tick { tick(): void; }
enum Step { #Done(i32), #Paused(Cont<void, Step>) }
export function main(): void uses Io {
  const first: Step = handle { Tick.tick(); #Done(7) } with Tick { tick() resumes k => #Paused(k) };
  match (first) {
    #Done(v) => println(`${v}`),
    #Paused(k) => {
      println("0");
      match (k()) { #Done(v) => println(`${v}`), #Paused(_) => {} }
    },
  }
}
