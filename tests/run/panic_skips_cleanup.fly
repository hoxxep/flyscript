// expect: working
// expect: <panic: index 9 out of bounds (length 3)>
// A panic stops its task where it is (§5.7): a bug is no state to clean up from, so the task's
// `defer`s do not run and what it owns is not dropped, and the program ends.
import { println } from "std/io";

export function main(): void uses Io {
  defer { println("not reached: a panic runs no cleanup"); };
  println("working");
  const xs = [1, 2, 3];
  const i: usize = 9;
  println(`${xs[i]}`);
}
