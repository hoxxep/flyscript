// expect: <panic: index 9 out of bounds (length 3)>
// A body panics while it holds its lock, with another task asleep holding cleanup that takes the
// lock: the panic ends the program at once, on whatever core it happens (§5.7). No cleanup runs,
// so none can wait for a lock the panicking task never gave back.
import { println } from "std/io";
import { Mutex } from "std/sync";

export function main(): void uses Io {
  const counter = Mutex.new(0 as u64);
  Io.scope((s) => {
    s.spawn(() => {
      defer {
        const n = counter.lock((c) => c + 0);
        println(`not reached: a panic runs no cleanup: ${n}`);
      };
      counter.lock((c) => { c += 1; });
      Io.sleep(Duration.secs(60));
    });
    s.spawn(() => {
      while (counter.lock((c) => c + 0) < 1) { Io.sleep(Duration.ms(1)); }
      const xs = [1, 2, 3];
      const i: usize = 9;
      counter.lock((c) => { c += xs[i]; });
    });
  });
}
