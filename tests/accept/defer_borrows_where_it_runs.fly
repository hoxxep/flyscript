// A `defer` reaches what it uses as its block is left, so the block may use the same places
// meanwhile, `mut` included (§5.6).

export function closesLast(v: mut Vec<i32>): usize {
  defer v.push(0);
  v.push(1);
  const r = mut v;
  r.push(2);
  v.len()
}

// A borrow made before the `defer` and dropped with the block is gone by the time it runs.
export function readsFirst(v: mut Vec<i32>): usize {
  const s: readonly i32[] = v[0..1];
  defer v.truncate(0);
  s.len()
}

export function eachPass(v: mut Vec<i32>, xs: readonly i32[]): usize {
  for (const x of xs) {
    defer v.push(x);
    if (x > 3) {
      break;
    }
    v.push(x + 1);
  }
  v.len()
}
