// Conveniences a TypeScript programmer leans on (§4.1): a class-1 part bound through a
// `readonly` borrow is a copy, so it holds nothing; a borrow of a `Box<T>` is a borrow of the `T`;
// and a literal's part whose slot is a borrow is lent.
enum Node { #Leaf(i64), #Neg(Box<Node>) }
type Tok = #Num(i64) | #Minus;
struct Cursor { toks: Vec<Tok>, pos: usize }
impl Cursor {
  function peek(self: readonly Self): Option<readonly Tok> {
    if (self.pos < self.toks.len()) { #Some(self.toks[self.pos]) } else { #None }
  }
  function sum(self: mut Self): i64 {
    let total = 0;
    while (const #Some(#Num(n)) = self.peek()) {
      self.pos += 1;
      total += n;
    }
    total
  }
}
function value(n: readonly Node): i64 {
  match (n) { #Leaf(v) => v, #Neg(inner) => -value(inner) }
}
function build(flag: bool, base: Node): Node {
  const n: Node = if (flag) { #Leaf(1) } else { base };
  n
}
