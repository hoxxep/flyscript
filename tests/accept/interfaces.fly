// A user interface with an implementation, used through a bound.
interface Area { function area(self: readonly Self): f64; }

struct Square { side: f64; }
struct Circle { r: f64; }

impl Area for Square { function area(self: readonly Self): f64 { self.side * self.side } }
impl Area for Circle { function area(self: readonly Self): f64 { 3.14159 * self.r * self.r } }

export function total(s: Square, c: Circle): f64 { s.area() + c.area() }
