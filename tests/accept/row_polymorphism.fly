// Records: functions accept extra fields through a row variable (§3.2).
function norm<row R>(p: readonly { x: f64; y: f64; ...R }): f64 { p.x * p.x + p.y * p.y }

export function useIt(): f64 {
  const a = norm({ x: 3.0, y: 4.0 });
  const b = norm({ x: 1.0, y: 2.0, label: "b", weight: 7 });
  a + b
}
