// error: `out` cannot be used here: this `handle`'s continuation leaves its arm
// A continuation that leaves its arm may be resumed wherever it goes, so its arms use nothing of
// the code around: here the arm would change `out` after `makeLogger` returned (§5.3).
effect Log { info(msg: String): void; }
enum Step { #Done, #More(Cont<void, Step>) }
function makeLogger(): Step {
  let out: Vec<String> = Vec.new();
  handle {
    Log.info("first".toString());
    Log.info("second".toString());
    #Done
  } with Log {
    info(msg) resumes k => {
      out.push(msg);
      #More(k)
    },
  }
}
