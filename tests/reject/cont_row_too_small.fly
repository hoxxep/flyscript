// error: resuming this `handle`'s continuation performs `Io`, which its declared type does not allow
// A continuation's declared type must allow what resuming it performs (§5.3).
import { println } from "std/io";
effect Tick { tick(): void; }
enum Steps<row E> { #Done, #At(Cont<void, Steps<E>, E>) }
function steps(): Steps<[]> uses Io {
  handle {
    Tick.tick();
    println("after");
    #Done
  } with Tick { tick() resumes k => #At(k) }
}
